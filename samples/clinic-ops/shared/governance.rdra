module shared.governance

import shared.biz
import shared.entities

quality Auditability "監査可能性"
quality Performance  "性能"
quality Privacy      "プライバシー"

nfr ScheduleLookupLatency "予約枠検索の応答時間"
  metric p95_latency_ms
  target "<=500"
  window "5m"
  slo "99.5%"
  availability multi_az
  resilience retryable

constraint PatientDataPrivacy "患者情報の保護"
  privacy restricted
  logging structured
  retention "10y"

constraint BillingAuditTrail "会計の監査証跡"
  audit enabled
  retention "7y"

applies_to(ScheduleLookupLatency, ClinicOpsSystem)
qualifies(ScheduleLookupLatency, Performance)
qualifies(PatientDataPrivacy, Privacy)
qualifies(BillingAuditTrail, Auditability)
constrains(PatientDataPrivacy, PatientProfile)
constrains(PatientDataPrivacy, InsurancePolicy)
constrains(BillingAuditTrail, PaymentTransaction)
constrains(BillingAuditTrail, ClinicOpsSystem)

adr AdrSingleClinicSystem "Run clinic workflows as one system boundary"
  description "Decision record for the clinic system boundary."
  adr_status accepted
  context "Front desk, clinical, and billing workflows share patient and appointment data."
  decision "Keep every workflow inside a single ClinicOpsSystem boundary."
  consequence "Cross-workflow changes deploy together."
  accepted "Single system boundary"
  rejected "Per-department systems"
  reason "Shared patient data would otherwise need cross-system coordination."

decides(AdrSingleClinicSystem, ClinicOpsSystem)
decides(AdrSingleClinicSystem, PatientProfile)
decides(AdrSingleClinicSystem, Appointment)
