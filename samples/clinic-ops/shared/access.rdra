// 代行入力 drafts an order; the 指示 is the physician's, who checks it before it is carried out
// (mhlw-2020-dairi-nyuuryoku.txt:9, :15, :71-79).
has_permission(MedicalClerk, ProxyOrderEntry)

has_permission(Pharmacist, PrescriptionDispense)

has_permission(ClaimsClerk, BillingClaimWrite)
