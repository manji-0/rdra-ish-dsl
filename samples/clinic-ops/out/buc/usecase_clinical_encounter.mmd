%% rdra-ish diagram=usecase scope=buc:BucClinicalEncounter model=samples/clinic-ops
%% layers: value=システム価値 boundary=システム境界 system=システム
%% kinds: actor extsystem usecase screen event entity state
%% omitted: buc step medium permission field api
flowchart LR
  subgraph layer_value["システム価値"]
    actor__Clinician(["医師"]):::actor
    %% desc actor__Clinician: 診察し、診断・オーダ・処方を出し、診療記録に署名する。
    actor__Nurse(["看護師"]):::actor
    %% desc actor__Nurse: 医師の指示の下で診療の補助を行う。
    extsystem__OnlineEligibilitySystem[["オンライン資格確認等システム"]]:::extsystem
  end
  subgraph layer_boundary["システム境界"]
    usecase__AmendEncounter("署名済み記録の修正"):::usecase
    %% desc usecase__AmendEncounter: 署名済み記録の修正。
    usecase__CompleteConsultation("診察終了"):::usecase
    %% desc usecase__CompleteConsultation: 診察終了で予約を計算待ちにし、部屋を清掃中にし、会計を起動する。
    usecase__DocumentAssessment("診察・診断の記録"):::usecase
    %% desc usecase__DocumentAssessment: 診断記録と記録状態。
    usecase__IssueReferralLetter("診療情報提供書の作成・送信"):::usecase
    %% desc usecase__IssueReferralLetter: 診療情報提供書の作成・送信。
    usecase__OpenEncounter("診療記録を開く"):::usecase
    %% desc usecase__OpenEncounter: 受付済の予約から診療記録を開く。
    usecase__RecordVitals("バイタルの記録"):::usecase
    %% desc usecase__RecordVitals: バイタル記録。
    usecase__SignEncounter("診療記録の署名"):::usecase
    %% desc usecase__SignEncounter: 署名でコスト情報登録とケアプラン作成を起動する。
    screen__DiagnosisScreen["診断入力画面"]:::screen
    screen__EncounterWorkspaceScreen["診療記録画面"]:::screen
    screen__ReferralLetterScreen["診療情報提供書画面"]:::screen
    screen__VitalsScreen["バイタル入力画面"]:::screen
    event__EvAppointmentCheckedIn>"受付完了"]:::event
    event__EvConsultationCompleted>"診察終了"]:::event
    event__EvEncounterSigned>"診療記録の署名"]:::event
  end
  subgraph layer_system["システム"]
    entity__Appointment[("予約・受診")]:::entity
    entity__Diagnosis[("診断")]:::entity
    entity__Encounter[("診療記録")]:::entity
    entity__ReferralLetter[("紹介状・診療情報提供書")]:::entity
    entity__Room[("診察室")]:::entity
    entity__VitalSign[("バイタル")]:::entity
    state__Appointment_awaiting_calc((("計算待ち"))):::state
    state__Appointment_checked_in((("受付済"))):::state
    state__Appointment_in_consult((("診察中"))):::state
    state__Encounter_amended((("修正済"))):::state
    state__Encounter_documented((("記載済"))):::state
    state__Encounter_open((("記録中"))):::state
    state__Encounter_signed((("署名済"))):::state
  end
  actor__Clinician -.-> usecase__AmendEncounter
  actor__Clinician -.-> usecase__CompleteConsultation
  actor__Clinician -.-> usecase__DocumentAssessment
  actor__Clinician -.-> usecase__IssueReferralLetter
  actor__Clinician -.-> usecase__SignEncounter
  actor__Nurse -.-> usecase__OpenEncounter
  actor__Nurse -.-> usecase__RecordVitals
  event__EvAppointmentCheckedIn -.-> extsystem__OnlineEligibilitySystem
  event__EvAppointmentCheckedIn -.-> usecase__OpenEncounter
  usecase__AmendEncounter -.-> screen__EncounterWorkspaceScreen
  usecase__AmendEncounter -.->|transitions Encounter.status signed->amended| state__Encounter_amended
  usecase__AmendEncounter -.->|updates| entity__Encounter
  %% derived usecase__AmendEncounter -> entity__Encounter via api__AmendEncounterApi
  usecase__CompleteConsultation -.-> screen__EncounterWorkspaceScreen
  usecase__CompleteConsultation -.-> event__EvConsultationCompleted
  usecase__CompleteConsultation -.->|transitions Appointment.status in_consult->awaiting_calc| state__Appointment_awaiting_calc
  usecase__CompleteConsultation -.->|updates| entity__Appointment
  %% derived usecase__CompleteConsultation -> entity__Appointment via api__CompleteConsultationApi
  usecase__CompleteConsultation -.->|updates| entity__Room
  %% derived usecase__CompleteConsultation -> entity__Room via api__CompleteConsultationApi
  usecase__DocumentAssessment -.->|creates| entity__Diagnosis
  %% derived usecase__DocumentAssessment -> entity__Diagnosis via api__DocumentAssessmentApi
  usecase__DocumentAssessment -.-> screen__DiagnosisScreen
  usecase__DocumentAssessment -.->|transitions Encounter.status open->documented| state__Encounter_documented
  usecase__DocumentAssessment -.->|updates| entity__Encounter
  %% derived usecase__DocumentAssessment -> entity__Encounter via api__DocumentAssessmentApi
  usecase__IssueReferralLetter -.->|creates| entity__ReferralLetter
  %% derived usecase__IssueReferralLetter -> entity__ReferralLetter via api__IssueReferralLetterApi
  usecase__IssueReferralLetter -.-> screen__ReferralLetterScreen
  usecase__IssueReferralLetter -.->|reads| entity__Encounter
  %% derived usecase__IssueReferralLetter -> entity__Encounter via api__IssueReferralLetterApi
  usecase__OpenEncounter -.->|creates| entity__Encounter
  %% derived usecase__OpenEncounter -> entity__Encounter via api__OpenEncounterApi
  usecase__OpenEncounter -.-> screen__EncounterWorkspaceScreen
  usecase__OpenEncounter -.->|transitions Appointment.status checked_in->in_consult| state__Appointment_in_consult
  usecase__OpenEncounter -.->|updates| entity__Appointment
  %% derived usecase__OpenEncounter -> entity__Appointment via api__OpenEncounterApi
  usecase__RecordVitals -.->|creates| entity__VitalSign
  %% derived usecase__RecordVitals -> entity__VitalSign via api__RecordVitalsApi
  usecase__RecordVitals -.-> screen__VitalsScreen
  usecase__RecordVitals -.->|updates| entity__Encounter
  %% derived usecase__RecordVitals -> entity__Encounter via api__RecordVitalsApi
  usecase__SignEncounter -.-> screen__EncounterWorkspaceScreen
  usecase__SignEncounter -.-> event__EvEncounterSigned
  usecase__SignEncounter -.->|transitions Encounter.status documented->signed| state__Encounter_signed
  usecase__SignEncounter -.->|updates| entity__Encounter
  %% derived usecase__SignEncounter -> entity__Encounter via api__SignEncounterApi
  classDef actor fill:#ffe3e3,stroke:#c92a2a,color:#000;
  classDef extsystem fill:#e9ecef,stroke:#495057,color:#000;
  classDef usecase fill:#d0ebff,stroke:#1864ab,color:#000;
  classDef screen fill:#e5dbff,stroke:#5f3dc4,color:#000;
  classDef event fill:#ffdeeb,stroke:#a61e4d,color:#000;
  classDef entity fill:#fff9db,stroke:#5c940d,color:#000;
  classDef state fill:#f8f9fa,stroke:#5c940d,color:#000;
