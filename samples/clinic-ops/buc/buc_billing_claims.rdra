module buc.billing_claims

import shared.actors
import shared.entities
import shared.biz
import shared.goals

// Sources cited as file:line are under ~/research/japan-hospital-operations/sources/.

buc BucBillingClaims "レセプト作成・請求"
  description "レセプト（患者 × 診療月 × 保険者）の作成・院内点検・請求と、審査支払機関（支払基金・国保連）からの受付不能・返戻・査定・支払への対応を扱う。前月分は翌月10日までに請求し、受付不能・要確認は11日・12日に再送する。返戻は訂正して当月分と併せて再請求できるが、査定は再請求できず再審査請求で争う。資格が変わったレセプトは審査支払機関が振替・分割するので返戻にならないが、負担割合が異なる変更や公費の分割はできず返戻になる。支払は診療の翌々月。期間のうち DSL で表せないもの（10日、11・12日、5日〜月末、3か月、翌々月）はタイマーとコメントで示す。"

usecase CreateCharge "コスト情報の登録" description "署名時のカルテ由来コスト情報の登録（システム起動）。"
usecase GenerateClaimStatement "レセプト作成" description "月初のレセプト作成。"
usecase InspectClaimStatement "レセプトの院内点検" description "院内点検。"
usecase HoldClaimStatement "レセプトの保留（月遅れ）" description "保留（月遅れ）。"
usecase ReleaseHeldStatement "保留レセプトの再提出準備" description "保留レセプトの再提出準備。"
usecase SubmitClaimStatements "レセプト請求" description "毎月10日までの請求。"
usecase RecordReceiptError "受付不能・要確認の確認" description "受付不能・要確認の確認。"
usecase ResendErroredStatement "エラー分レセプトの再送" description "11日・12日のエラー分再送。"
usecase ReceiveClaimAccepted "レセプト受付（審査へ）" description "審査支払機関の受付で審査中になる。"
usecase ReviewClaimTransfer "資格の振替・分割の確認" description "資格の振替・分割の確認（参照のみ）。"
usecase RecordClaimReturn "返戻レセプトの取込" description "返戻レセプトの取込（3か月以内）。"
usecase CorrectReturnedStatement "返戻レセプトの訂正（再請求）" description "返戻の訂正と再請求。"
usecase RecordClaimAssessment "査定の取込" description "査定の取込。"
usecase RequestReexamination "再審査請求" description "再審査請求。"
usecase PostPayment "診療報酬の入金" description "診療翌々月の入金。"
usecase ReconcileBalance "未収金管理台帳の作成" description "未収金管理台帳の作成。"
usecase VoidCharge "コストの取消" description "コストの取消。"

screen ChargeWorklistScreen "コスト一覧画面"
screen ClaimScreen "レセプト画面"
screen PaymentPostingScreen "入金画面"
screen BalanceScreen "未収金画面"

api CreateChargeApi "コスト登録 API"
api GenerateClaimApi "レセプト作成 API"
api ClaimEditApi "レセプト点検・訂正 API"
api SubmitClaimApi "オンライン請求 API"
api ClaimResultApi "審査結果 API"
api PaymentPostApi "入金 API"
api BalanceApi "未収金 API"

performs(ClaimsClerk, BucBillingClaims)
// A timer or the 審査支払機関's result starts these, but the レセプト担当 does the work, so the
// model names the performer. CreateCharge and ReceiveClaimAccepted are the system's alone.
performs(ClaimsClerk, GenerateClaimStatement)
performs(ClaimsClerk, SubmitClaimStatements)
performs(ClaimsClerk, RecordReceiptError)
performs(ClaimsClerk, ResendErroredStatement)
performs(ClaimsClerk, ReviewClaimTransfer)
performs(ClaimsClerk, RecordClaimReturn)
performs(ClaimsClerk, RecordClaimAssessment)
performs(ClaimsClerk, PostPayment)
performs(ClaimsClerk, InspectClaimStatement)
performs(ClaimsClerk, HoldClaimStatement)
performs(ClaimsClerk, ReleaseHeldStatement)
performs(ClaimsClerk, CorrectReturnedStatement)
performs(ClaimsClerk, RequestReexamination)
performs(ClaimsClerk, ReconcileBalance)
performs(ClaimsClerk, VoidCharge)
belongs(BucBillingClaims, RevenueCycle).by(BillingWorkstation).by(OnlineClaimTerminal)

contains(BucBillingClaims, CreateCharge)
contains(BucBillingClaims, GenerateClaimStatement)
contains(BucBillingClaims, InspectClaimStatement)
contains(BucBillingClaims, HoldClaimStatement)
contains(BucBillingClaims, ReleaseHeldStatement)
contains(BucBillingClaims, SubmitClaimStatements)
contains(BucBillingClaims, RecordReceiptError)
contains(BucBillingClaims, ResendErroredStatement)
contains(BucBillingClaims, ReceiveClaimAccepted)
contains(BucBillingClaims, ReviewClaimTransfer)
contains(BucBillingClaims, RecordClaimReturn)
contains(BucBillingClaims, CorrectReturnedStatement)
contains(BucBillingClaims, RecordClaimAssessment)
contains(BucBillingClaims, RequestReexamination)
contains(BucBillingClaims, PostPayment)
contains(BucBillingClaims, ReconcileBalance)
contains(BucBillingClaims, VoidCharge)
contains(ClinicOpsSystem, CreateChargeApi)
contains(ClinicOpsSystem, GenerateClaimApi)
contains(ClinicOpsSystem, ClaimEditApi)
contains(ClinicOpsSystem, SubmitClaimApi)
contains(ClinicOpsSystem, ClaimResultApi)
contains(ClinicOpsSystem, PaymentPostApi)
contains(ClinicOpsSystem, BalanceApi)

// 指導・管理料、摘要欄コメント等のコスト情報 the physician registers in the chart
// (mhlw-2024-hyojun-denshi-karte-gyomuflow.txt:104). The chart hands them over when the encounter is
// signed, so this step is system-triggered and has no performer.
displays(CreateCharge, ChargeWorklistScreen)
invokes(CreateCharge, CreateChargeApi)
creates(CreateChargeApi, Charge)
reads(CreateChargeApi, Encounter)
sets(CreateCharge, Charge.status == posted)
sets(CreateCharge, Charge.posted_at == present)
sets(CreateCharge, Charge.kind == insured)
sets(CreateCharge, Charge.origin == chart)
triggers(EvEncounterSigned, BucBillingClaims)
triggers(EvEncounterSigned, CreateCharge)

// One レセプト per patient, 診療月, and payer, made from the month's 診療行為. It reads the Charges
// and does not move them: a Charge has no state that billing changes, and writing it here would tie
// the レセプト cycle to every visit's state in verify.
displays(GenerateClaimStatement, ClaimScreen)
invokes(GenerateClaimStatement, GenerateClaimApi)
creates(GenerateClaimApi, ClaimStatement)
reads(GenerateClaimApi, Charge)
reads(GenerateClaimApi, InsurancePolicy)
triggers(MonthlyClaimCreation, GenerateClaimStatement)

// レセプトを点検し…病名依頼等の付箋を貼付; 医師別に全てのレセプト点検依頼（月２回）
// (koseikan-2024-iji-shiyousyo.txt:225, :227).
displays(InspectClaimStatement, ClaimScreen)
invokes(InspectClaimStatement, ClaimEditApi)
updates(ClaimEditApi, ClaimStatement)
transitions(InspectClaimStatement, ClaimStatement.status, drafting -> inspecting)

// 月遅れレセプト、保留レセプト…の再提出処理 (koseikan-2024-iji-shiyousyo.txt:237).
displays(HoldClaimStatement, ClaimScreen)
invokes(HoldClaimStatement, ClaimEditApi)
transitions(HoldClaimStatement, ClaimStatement.status, inspecting -> on_hold)

displays(ReleaseHeldStatement, ClaimScreen)
invokes(ReleaseHeldStatement, ClaimEditApi)
transitions(ReleaseHeldStatement, ClaimStatement.status, on_hold -> inspecting)

// 各月分について翌月十日まで (egov-seikyu-meirei-351M50000100036.txt:55); 請求可能期間 5日～10日
// (ssk-online-seikyu-sousa-tejunsho.txt:748). The timer is the deadline; the DSL has no calendar.
displays(SubmitClaimStatements, ClaimScreen)
invokes(SubmitClaimStatements, SubmitClaimApi)
updates(SubmitClaimApi, ClaimStatement)
raises(SubmitClaimStatements, EvClaimStatementsSubmitted)
transitions(SubmitClaimStatements, ClaimStatement.status, inspecting -> submitted)
sets(SubmitClaimStatements, ClaimStatement.submitted_at == present)
triggers(MonthlyClaimDeadline, SubmitClaimStatements)
triggers(EvClaimStatementsSubmitted, ClaimsReviewOrganization)

// エラー分（受付不能・要確認）, resent on the 11th and 12th (ssk-online-seikyu-sousa-tejunsho.txt:2294).
displays(RecordReceiptError, ClaimScreen)
invokes(RecordReceiptError, ClaimResultApi)
updates(ClaimResultApi, ClaimStatement)
transitions(RecordReceiptError, ClaimStatement.status, submitted -> receipt_error)
raises(ClaimsReviewOrganization, EvClaimReceiptError)
triggers(EvClaimReceiptError, RecordReceiptError)

displays(ResendErroredStatement, ClaimScreen)
invokes(ResendErroredStatement, SubmitClaimApi)
transitions(ResendErroredStatement, ClaimStatement.status, receipt_error -> submitted)
triggers(ErrorResendWindow, ResendErroredStatement)

displays(ReceiveClaimAccepted, ClaimScreen)
invokes(ReceiveClaimAccepted, ClaimResultApi)
transitions(ReceiveClaimAccepted, ClaimStatement.status, submitted -> under_review)
raises(ClaimsReviewOrganization, EvClaimAccepted)
triggers(EvClaimAccepted, ReceiveClaimAccepted)

// The 審査支払機関 moves a レセプト whose 資格 changed to the new insurer instead of returning it
// (mhlw-2021-shikaku-kago-furikae.txt:11); the hospital only sees the result, so this writes nothing.
// 審査支払機関は、職権で、当該不備を補正することができる (egov-seikyu-meirei-351M50000100036.txt:41).
displays(ReviewClaimTransfer, ClaimScreen)
reads(ReviewClaimTransfer, ClaimStatement)
raises(ClaimsReviewOrganization, EvClaimTransferred)
triggers(EvClaimTransferred, ReviewClaimTransfer)

// 返戻: 事務上, 審査上, 資格関係等 (ssk-henrei-kiroku-jouken-rezept01.txt:5530-5533). The 返戻ファイル must be
// downloaded within 3 months (mhlw-online-henrei-saiseikyu.txt:119), so a timer checks for it.
displays(RecordClaimReturn, ClaimScreen)
invokes(RecordClaimReturn, ClaimResultApi)
transitions(RecordClaimReturn, ClaimStatement.status, under_review -> returned)
sets(RecordClaimReturn, ClaimStatement.return_reason == present)
raises(ClaimsReviewOrganization, EvClaimReturned)
triggers(EvClaimReturned, RecordClaimReturn)
triggers(ReturnDownloadCheck, RecordClaimReturn)

// A 資格 change that 振替・分割 cannot handle comes back as a 返戻 (mhlw-2021-shikaku-kago-furikae.txt:40, :70).
condition TransferNotPossible "振替・分割の対象外（負担割合の相違・公費）"
combines(TransferNotPossible, PayerChange)
combines(TransferNotPossible, ClaimStatement.status)
applies_to(TransferNotPossible, RecordClaimReturn)

// 返戻ファイルを修正し、当月請求のレセプトと併せて再請求 (mhlw-online-henrei-saiseikyu.txt:105-111).
displays(CorrectReturnedStatement, ClaimScreen)
invokes(CorrectReturnedStatement, ClaimEditApi)
transitions(CorrectReturnedStatement, ClaimStatement.status, returned -> inspecting)
sets(CorrectReturnedStatement, ClaimStatement.return_reason == null)

// 査定: in principle not billed again (medicom-receipt-return.md:127, vendor article); 査定減点 is analysed
// and reported (koseikan-2024-iji-shiyousyo.txt:239-241).
displays(RecordClaimAssessment, ClaimScreen)
invokes(RecordClaimAssessment, ClaimResultApi)
transitions(RecordClaimAssessment, ClaimStatement.status, under_review -> assessed)
raises(ClaimsReviewOrganization, EvClaimAssessed)
triggers(EvClaimAssessed, RecordClaimAssessment)

// 再審査へ提出すべき項目を抽出 (koseikan-2024-iji-shiyousyo.txt:238), within the 再審査等請求期間 5日～月末
// (ssk-online-seikyu-sousa-tejunsho.txt:754). The period is a comment: a use case has no calendar guard.
displays(RequestReexamination, ClaimScreen)
invokes(RequestReexamination, SubmitClaimApi)
transitions(RequestReexamination, ClaimStatement.status, assessed -> rereview)

// 診療翌々月に医療機関・薬局へ診療報酬等支払 (mhlw-2021-shikaku-kago-furikae.txt:34). A 査定 is paid at the
// reduced amount; a 再審査 is paid at its result, 原審 or 復活 (koseikan-2024-iji-shiyousyo.txt:241).
displays(PostPayment, PaymentPostingScreen)
invokes(PostPayment, PaymentPostApi)
updates(PaymentPostApi, ClaimStatement)
transitions(PostPayment, ClaimStatement.status, under_review -> paid)
transitions(PostPayment, ClaimStatement.status, assessed -> paid)
transitions(PostPayment, ClaimStatement.status, rereview -> paid)
sets(PostPayment, ClaimStatement.paid_at == present)
raises(ClaimsReviewOrganization, EvRemittance)
triggers(EvRemittance, PostPayment)

// 未収金管理台帳の作成 (毎月) (koseikan-2024-iji-shiyousyo.txt:219).
displays(ReconcileBalance, BalanceScreen)
invokes(ReconcileBalance, BalanceApi)
updates(BalanceApi, AccountBalance)
reads(BalanceApi, PaymentTransaction)
sets(ReconcileBalance, AccountBalance.is_closed == true)
sets(ReconcileBalance, AccountBalance.closed_at == present)
triggers(ReceivablesMonthlyReview, ReconcileBalance)

displays(VoidCharge, ChargeWorklistScreen)
updates(VoidCharge, Charge)
sets(VoidCharge, Charge.status == voided)

// Access constraints
requires_medium(CreateCharge, ClinicalWorkstation)

requires_permission(GenerateClaimStatement, BillingClaimWrite)
requires_medium(GenerateClaimStatement, BillingWorkstation)
requires_permission(GenerateClaimApi, BillingClaimWrite)

requires_permission(InspectClaimStatement, BillingClaimWrite)
requires_medium(InspectClaimStatement, BillingWorkstation)
requires_permission(ClaimEditApi, BillingClaimWrite)

requires_permission(HoldClaimStatement, BillingClaimWrite)
requires_medium(HoldClaimStatement, BillingWorkstation)

requires_permission(ReleaseHeldStatement, BillingClaimWrite)
requires_medium(ReleaseHeldStatement, BillingWorkstation)

requires_permission(SubmitClaimStatements, BillingClaimWrite)
requires_medium(SubmitClaimStatements, OnlineClaimTerminal)
requires_permission(SubmitClaimApi, BillingClaimWrite)

requires_permission(RecordReceiptError, BillingClaimWrite)
requires_medium(RecordReceiptError, OnlineClaimTerminal)
requires_permission(ClaimResultApi, BillingClaimWrite)

requires_permission(ResendErroredStatement, BillingClaimWrite)
requires_medium(ResendErroredStatement, OnlineClaimTerminal)

requires_permission(ReceiveClaimAccepted, BillingClaimWrite)
requires_medium(ReceiveClaimAccepted, OnlineClaimTerminal)

requires_permission(ReviewClaimTransfer, BillingClaimWrite)
requires_medium(ReviewClaimTransfer, OnlineClaimTerminal)

requires_permission(RecordClaimReturn, BillingClaimWrite)
requires_medium(RecordClaimReturn, OnlineClaimTerminal)

requires_permission(CorrectReturnedStatement, BillingClaimWrite)
requires_medium(CorrectReturnedStatement, BillingWorkstation)

requires_permission(RecordClaimAssessment, BillingClaimWrite)
requires_medium(RecordClaimAssessment, OnlineClaimTerminal)

requires_permission(RequestReexamination, BillingClaimWrite)
requires_medium(RequestReexamination, OnlineClaimTerminal)

requires_permission(PostPayment, PaymentPost)
requires_medium(PostPayment, BillingWorkstation)
requires_permission(PaymentPostApi, PaymentPost)

requires_permission(ReconcileBalance, PaymentPost)
requires_medium(ReconcileBalance, BillingWorkstation)
requires_permission(BalanceApi, PaymentPost)

requires_permission(VoidCharge, BillingClaimWrite)
requires_medium(VoidCharge, BillingWorkstation)

// Business flow
flow ClaimCycleFlow "レセプトの月次サイクル"
step CreateStatementStep "レセプト作成（月初）"
step InspectStep "院内点検"
step HoldStep "保留（月遅れ）"
step SubmitStep "請求（5日～10日）"
step ReceiptErrorStep "受付不能・要確認の再送（11日・12日）"
step ReviewStep "審査"
step ReturnStep "返戻と再請求"
step AssessStep "査定と再審査請求"
step PaidStep "支払（診療翌々月）"

contains(BucBillingClaims, ClaimCycleFlow)
contains(ClaimCycleFlow, CreateStatementStep)
contains(ClaimCycleFlow, InspectStep)
contains(ClaimCycleFlow, HoldStep)
contains(ClaimCycleFlow, SubmitStep)
contains(ClaimCycleFlow, ReceiptErrorStep)
contains(ClaimCycleFlow, ReviewStep)
contains(ClaimCycleFlow, ReturnStep)
contains(ClaimCycleFlow, AssessStep)
contains(ClaimCycleFlow, PaidStep)

precedes(CreateStatementStep, InspectStep)
precedes(InspectStep, SubmitStep)
branches(InspectStep, HoldStep)
repeats(HoldStep, InspectStep)
precedes(SubmitStep, ReviewStep)
excepts(SubmitStep, ReceiptErrorStep)
repeats(ReceiptErrorStep, SubmitStep)
precedes(ReviewStep, PaidStep)
excepts(ReviewStep, ReturnStep)
repeats(ReturnStep, InspectStep)
branches(ReviewStep, AssessStep)
precedes(AssessStep, PaidStep)

covers(CreateStatementStep, GenerateClaimStatement)
covers(CreateStatementStep, MonthlyClaimCreation)
covers(InspectStep, InspectClaimStatement)
covers(HoldStep, HoldClaimStatement)
covers(HoldStep, ReleaseHeldStatement)
covers(SubmitStep, SubmitClaimStatements)
covers(SubmitStep, MonthlyClaimDeadline)
covers(ReceiptErrorStep, RecordReceiptError)
covers(ReceiptErrorStep, ResendErroredStatement)
covers(ReceiptErrorStep, ErrorResendWindow)
covers(ReviewStep, ReceiveClaimAccepted)
covers(ReviewStep, ReviewClaimTransfer)
covers(ReturnStep, RecordClaimReturn)
covers(ReturnStep, CorrectReturnedStatement)
covers(AssessStep, RecordClaimAssessment)
covers(AssessStep, RequestReexamination)
covers(PaidStep, PostPayment)

performs(ClaimsClerk, CreateStatementStep)
performs(ClaimsClerk, InspectStep)
performs(ClaimsClerk, HoldStep)
performs(ClaimsClerk, SubmitStep)
performs(ClaimsClerk, ReceiptErrorStep)
performs(ClaimsClerk, ReviewStep)
performs(ClaimsClerk, ReturnStep)
performs(ClaimsClerk, AssessStep)
performs(ClaimsClerk, PaidStep)

// Requirement traceability
requirement ReqMonthlyClaimByTenth "前月分のレセプトを翌月10日までに請求する"
  priority "must"
  source "各月分について翌月十日まで (egov-seikyu-meirei-351M50000100036.txt:55)"
  source "請求可能期間 5日～10日 (ssk-online-seikyu-sousa-tejunsho.txt:748)"
  stakeholder "医事課 レセプト担当"
  acceptance_criteria "前月分のレセプトは院内点検の後、毎月5日から10日の間に審査支払機関へ請求される。"
  status "accepted"

requirement ReqResubmitReturned "返戻レセプトを訂正して再請求する"
  priority "must"
  source "返戻ファイルを修正し、当月請求のレセプトと併せて再請求 (mhlw-online-henrei-saiseikyu.txt:105-111, :119)"
  stakeholder "医事課 レセプト担当"
  acceptance_criteria "返戻は3か月以内に取り込まれ、訂正して当月分と併せて再請求される。査定は再請求せず再審査請求で争う。"
  status "accepted"

motivates(ReqMonthlyClaimByTenth, BucBillingClaims)
achieves(ReqMonthlyClaimByTenth, TimelyClaims)
motivates(ReqResubmitReturned, BucBillingClaims)
achieves(ReqResubmitReturned, TimelyClaims)
