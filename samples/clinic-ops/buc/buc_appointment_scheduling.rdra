module buc.appointment_scheduling

import shared.actors
import shared.entities
import shared.biz
import shared.goals

buc BucAppointmentScheduling "予約" description "空き枠の検索、仮押さえ、予約の確定・変更・取消と通知。"

usecase SearchAvailability     "空き枠の検索"
usecase ReserveAppointment     "予約の仮押さえ"
usecase BookAppointment        "予約の確定"
usecase RescheduleAppointment  "予約の変更"
usecase CancelAppointment      "予約の取消"
usecase MarkNoShow             "未来院の処理"
usecase SendAppointmentNotice  "予約の通知"

screen ScheduleSearchScreen "空き枠検索画面"
screen AppointmentScreen    "予約画面"
screen AppointmentNoticeScreen "予約通知画面"

api SearchAvailabilityApi    "空き枠検索 API"
api ReserveAppointmentApi    "予約仮押さえ API"
api BookAppointmentApi       "予約確定 API"
api RescheduleAppointmentApi "予約変更 API"
api CancelAppointmentApi     "予約取消 API"
api AppointmentNoticeApi     "予約通知 API"

performs(ReceptionClerk, BucAppointmentScheduling)
performs(ReceptionClerk, SearchAvailability)
performs(Patient, SearchAvailability)
// The patient asks by phone or at the counter (sapporo-city-hosp-yoyaku.md:102, :118); the
// reception or contracted staff take the call and enter the change at the ordering terminal
// (yokohama-cu-urahp-c16010-shiyousyo.txt:196-197, yokohama-cu-f24036-shiyousyo.txt:803).
performs(ReceptionClerk, ReserveAppointment)
performs(ReceptionClerk, BookAppointment)
performs(ReceptionClerk, RescheduleAppointment)
performs(ReceptionClerk, CancelAppointment)
performs(ReceptionClerk, MarkNoShow)
performs(ReceptionClerk, SendAppointmentNotice)
belongs(BucAppointmentScheduling, PatientAccess)
  .by(FrontDeskTerminal)
  .by(PatientMobile)
contains(BucAppointmentScheduling, SearchAvailability)
contains(BucAppointmentScheduling, ReserveAppointment)
contains(BucAppointmentScheduling, BookAppointment)
contains(BucAppointmentScheduling, RescheduleAppointment)
contains(BucAppointmentScheduling, CancelAppointment)
contains(BucAppointmentScheduling, MarkNoShow)
contains(BucAppointmentScheduling, SendAppointmentNotice)
contains(ClinicOpsSystem, SearchAvailabilityApi)
contains(ClinicOpsSystem, ReserveAppointmentApi)
contains(ClinicOpsSystem, BookAppointmentApi)
contains(ClinicOpsSystem, RescheduleAppointmentApi)
contains(ClinicOpsSystem, CancelAppointmentApi)
contains(ClinicOpsSystem, AppointmentNoticeApi)

displays(SearchAvailability, ScheduleSearchScreen)
invokes(SearchAvailability, SearchAvailabilityApi)
reads(SearchAvailabilityApi, ProviderSchedule)
reads(SearchAvailabilityApi, Provider)
reads(SearchAvailabilityApi, ClinicLocation)
shows(ScheduleSearchScreen, ProviderSchedule)
requires_permission(SearchAvailability, ScheduleRead)
requires_medium(SearchAvailability, FrontDeskTerminal)
requires_medium(SearchAvailability, PatientMobile)
requires_permission(SearchAvailabilityApi, ScheduleRead)

displays(ReserveAppointment, AppointmentScreen)
invokes(ReserveAppointment, ReserveAppointmentApi)
creates(ReserveAppointmentApi, Appointment)
updates(ReserveAppointmentApi, ProviderSchedule)
requires_permission(ReserveAppointment, ScheduleWrite)
requires_medium(ReserveAppointment, FrontDeskTerminal)
requires_medium(ReserveAppointment, PatientMobile)
requires_permission(ReserveAppointmentApi, ScheduleWrite)

displays(BookAppointment, AppointmentScreen)
invokes(BookAppointment, BookAppointmentApi)
updates(BookAppointmentApi, Appointment)
updates(BookAppointmentApi, ProviderSchedule)
raises(BookAppointment, EvAppointmentScheduled)
transitions(Appointment.status, BookAppointment, apptrequested -> apptscheduled)
requires_permission(BookAppointment, ScheduleWrite)
requires_medium(BookAppointment, FrontDeskTerminal)
requires_medium(BookAppointment, PatientMobile)
requires_permission(BookAppointmentApi, ScheduleWrite)

displays(RescheduleAppointment, AppointmentScreen)
invokes(RescheduleAppointment, RescheduleAppointmentApi)
updates(RescheduleAppointmentApi, Appointment)
updates(RescheduleAppointmentApi, ProviderSchedule)
raises(RescheduleAppointment, EvAppointmentRescheduled)
transitions(Appointment.status, RescheduleAppointment, apptscheduled -> apptscheduled)
requires_permission(RescheduleAppointment, ScheduleWrite)
requires_medium(RescheduleAppointment, FrontDeskTerminal)
requires_medium(RescheduleAppointment, PatientMobile)
requires_permission(RescheduleAppointmentApi, ScheduleWrite)

displays(CancelAppointment, AppointmentScreen)
invokes(CancelAppointment, CancelAppointmentApi)
updates(CancelAppointmentApi, Appointment)
updates(CancelAppointmentApi, ProviderSchedule)
raises(CancelAppointment, EvAppointmentCancelled)
transitions(Appointment.status, CancelAppointment, apptscheduled -> apptcancelled)
sets(CancelAppointment, Appointment, cancel_reason == present)
requires_permission(CancelAppointment, ScheduleWrite)
requires_medium(CancelAppointment, FrontDeskTerminal)
requires_medium(CancelAppointment, PatientMobile)
requires_permission(CancelAppointmentApi, ScheduleWrite)

displays(MarkNoShow, AppointmentScreen)
updates(MarkNoShow, Appointment)
transitions(Appointment.status, MarkNoShow, apptscheduled -> apptnoshow)
triggers(NoShowSweep, MarkNoShow)
requires_permission(MarkNoShow, ScheduleWrite)
requires_medium(MarkNoShow, FrontDeskTerminal)

displays(SendAppointmentNotice, AppointmentNoticeScreen)
invokes(SendAppointmentNotice, AppointmentNoticeApi)
creates(AppointmentNoticeApi, Notification)
creates(AppointmentNoticeApi, PatientMessage)
requires_permission(SendAppointmentNotice, ScheduleRead)
requires_medium(SendAppointmentNotice, FrontDeskTerminal)
sets(SendAppointmentNotice, Notification, delivered_at == present)
sets(SendAppointmentNotice, PatientMessage, status == msgsent)
sets(SendAppointmentNotice, PatientMessage, sent_at == present)
triggers(EvAppointmentScheduled, SendAppointmentNotice)
triggers(EvAppointmentRescheduled, SendAppointmentNotice)
triggers(EvAppointmentCancelled, SendAppointmentNotice)
triggers(EvAppointmentScheduled, MessagingGateway)
triggers(EvAppointmentRescheduled, MessagingGateway)
triggers(EvAppointmentCancelled, MessagingGateway)

// Business flow. A booked appointment can be changed or cancelled until the visit; the nightly
// sweep marks an appointment nobody came to as 未来院.
flow AppointmentFlow "予約の流れ"
step AvailabilityStep "空き枠の検索"
step ReserveStep      "仮押さえ"
step BookStep         "予約確定"
step NoticeStep       "予約の通知"
step RescheduleStep   "予約の変更"
step CancelStep       "予約の取消"
step NoShowStep       "未来院の処理"
contains(BucAppointmentScheduling, AppointmentFlow)
contains(AppointmentFlow, AvailabilityStep)
contains(AppointmentFlow, ReserveStep)
contains(AppointmentFlow, BookStep)
contains(AppointmentFlow, NoticeStep)
contains(AppointmentFlow, RescheduleStep)
contains(AppointmentFlow, CancelStep)
contains(AppointmentFlow, NoShowStep)
precedes(AvailabilityStep, ReserveStep)
precedes(ReserveStep, BookStep)
precedes(BookStep, NoticeStep)
branches(NoticeStep, RescheduleStep)
branches(NoticeStep, CancelStep)
repeats(RescheduleStep, NoticeStep)
excepts(NoticeStep, NoShowStep)
covers(AvailabilityStep, SearchAvailability)
covers(ReserveStep, ReserveAppointment)
covers(BookStep, BookAppointment)
covers(NoticeStep, SendAppointmentNotice)
covers(RescheduleStep, RescheduleAppointment)
covers(CancelStep, CancelAppointment)
covers(CancelStep, EvAppointmentCancelled)
covers(NoShowStep, MarkNoShow)
covers(NoShowStep, NoShowSweep)
performs(ReceptionClerk, AvailabilityStep)
performs(Patient, AvailabilityStep)
performs(ReceptionClerk, ReserveStep)
performs(ReceptionClerk, BookStep)
performs(ReceptionClerk, NoticeStep)
performs(ReceptionClerk, RescheduleStep)
performs(ReceptionClerk, CancelStep)

// Requirement traceability
requirement ReqChangeAppointmentAtDesk "予約の変更・取消を電話と窓口で受け付ける"
  priority "must"
  source "sapporo-city-hosp-yoyaku.md:102, :118"
  source "yokohama-cu-urahp-c16010-shiyousyo.txt:196-197"
  stakeholder "医事課 受付担当"
  acceptance criteria "受付担当が予約の変更・取消を入力すると、患者に通知が届く。"
  status "accepted"

motivates(ReqChangeAppointmentAtDesk, BucAppointmentScheduling)
achieves(ReqChangeAppointmentAtDesk, ShortWait)
