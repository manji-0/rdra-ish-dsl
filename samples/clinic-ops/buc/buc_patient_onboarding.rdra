module buc.patient_onboarding

import shared.actors
import shared.entities
import shared.biz

buc BucPatientOnboarding "Onboard and Maintain Patient"

usecase SearchPatient         "Search Patient"
usecase RegisterPatient       "Register Patient"
usecase UpdateDemographics    "Update Demographics"
// 新患登録 with the 保険情報 and, with consent, the 限度額情報 from the オンライン資格確認
// (mhlw-2024-hyojun-denshi-karte-gyomuflow.txt:46, :51; koseikan-2024-iji-shiyousyo.txt:92).
usecase VerifyInsurance       "保険資格・限度額情報の登録（新患登録）"
usecase CaptureConsent        "Capture Consent"
usecase SendIntakeForms       "Send Intake Forms"
usecase CompleteIntakeForms   "Complete Intake Forms"
usecase ExpireIntakeForms     "Expire Intake Forms"
usecase MergeDuplicatePatient "Merge Duplicate Patient"
usecase ArchivePatient        "Archive Patient"

screen PatientSearchScreen  "Patient Search Screen"
screen PatientProfileScreen "Patient Profile Screen"
screen InsuranceScreen      "Insurance Verification Screen"
screen ConsentScreen        "Consent Capture Screen"
screen IntakePortalScreen   "Intake Portal Screen"

api SearchPatientApi       "Search Patient API"
api RegisterPatientApi     "Register Patient API"
api UpdateDemographicsApi  "Update Demographics API"
api EligibilityApi       "Eligibility API"
api ConsentApi           "Consent API"
api IntakeMessagingApi   "Intake Messaging API"

performs(ReceptionClerk, SearchPatient)
performs(ReceptionClerk, RegisterPatient)
performs(ReceptionClerk, UpdateDemographics)
performs(ReceptionClerk, VerifyInsurance)
performs(Patient, CaptureConsent)
// Reception explains and hands out the 問診票 (yokohama-cu-f24036-shiyousyo.txt:779, :807); one
// hospital mails it home (osaka-u-kokoro-booking.txt:46). No source names who sends it: the
// reception clerk is the model's assumption.
performs(ReceptionClerk, SendIntakeForms)
performs(Patient, CompleteIntakeForms)
performs(ReceptionClerk, ExpireIntakeForms)
performs(ReceptionClerk, MergeDuplicatePatient)
performs(ReceptionClerk, ArchivePatient)
belongs(BucPatientOnboarding, PatientAccess)

contains(BucPatientOnboarding, SearchPatient)
contains(BucPatientOnboarding, RegisterPatient)
contains(BucPatientOnboarding, UpdateDemographics)
contains(BucPatientOnboarding, VerifyInsurance)
contains(BucPatientOnboarding, CaptureConsent)
contains(BucPatientOnboarding, SendIntakeForms)
contains(BucPatientOnboarding, CompleteIntakeForms)
contains(BucPatientOnboarding, ExpireIntakeForms)
contains(BucPatientOnboarding, MergeDuplicatePatient)
contains(BucPatientOnboarding, ArchivePatient)
contains(ClinicOpsSystem, SearchPatientApi)
contains(ClinicOpsSystem, RegisterPatientApi)
contains(ClinicOpsSystem, UpdateDemographicsApi)
contains(ClinicOpsSystem, EligibilityApi)
contains(ClinicOpsSystem, ConsentApi)
contains(ClinicOpsSystem, IntakeMessagingApi)

displays(SearchPatient, PatientSearchScreen)
invokes(SearchPatient, SearchPatientApi)
reads(SearchPatientApi, PatientAccount)
reads(SearchPatientApi, PatientProfile)
shows(PatientSearchScreen, PatientAccount)

displays(RegisterPatient, PatientProfileScreen)
invokes(RegisterPatient, RegisterPatientApi)
creates(RegisterPatientApi, PatientAccount)
creates(RegisterPatientApi, PatientProfile)
shows(PatientProfileScreen, PatientProfile)

displays(UpdateDemographics, PatientProfileScreen)
invokes(UpdateDemographics, UpdateDemographicsApi)
updates(UpdateDemographicsApi, PatientProfile)

displays(VerifyInsurance, InsuranceScreen)
invokes(VerifyInsurance, EligibilityApi)
reads(EligibilityApi, InsurancePolicy)
creates(EligibilityApi, EligibilityCheck)
updates(EligibilityApi, InsurancePolicy)
sets(VerifyInsurance, InsurancePolicy, verification_status == verified)
sets(VerifyInsurance, InsurancePolicy, verified_at == present)
sets(VerifyInsurance, InsurancePolicy, limit_category == obtained)
sets(VerifyInsurance, EligibilityCheck, result == eligvalid)
sets(VerifyInsurance, EligibilityCheck, reference_no == present)

displays(CaptureConsent, ConsentScreen)
invokes(CaptureConsent, ConsentApi)
creates(ConsentApi, ConsentRecord)
sets(CaptureConsent, ConsentRecord, signed_at == present)
sets(CaptureConsent, ConsentRecord, revoked == false)

displays(SendIntakeForms, IntakePortalScreen)
invokes(SendIntakeForms, IntakeMessagingApi)
creates(IntakeMessagingApi, IntakePacket)
creates(IntakeMessagingApi, PatientMessage)
sets(SendIntakeForms, IntakePacket, sent_at == present)
sets(SendIntakeForms, PatientMessage, status == msgsent)
sets(SendIntakeForms, PatientMessage, sent_at == present)
triggers(EvAppointmentScheduled, BucPatientOnboarding)
triggers(EvAppointmentScheduled, SendIntakeForms)

displays(CompleteIntakeForms, IntakePortalScreen)
updates(CompleteIntakeForms, IntakePacket)
transitions(IntakePacket.status, CompleteIntakeForms, intakesent -> intakecompleted)
sets(CompleteIntakeForms, IntakePacket, completed_at == present)

displays(ExpireIntakeForms, IntakePortalScreen)
updates(ExpireIntakeForms, IntakePacket)
transitions(IntakePacket.status, ExpireIntakeForms, intakesent -> intakeexpired)
triggers(IntakeExpiryCheck, ExpireIntakeForms)

displays(MergeDuplicatePatient, PatientProfileScreen)
updates(MergeDuplicatePatient, PatientAccount)
transitions(PatientAccount.status, MergeDuplicatePatient, patientactive -> patientmerged)

displays(ArchivePatient, PatientProfileScreen)
updates(ArchivePatient, PatientAccount)
transitions(PatientAccount.status, ArchivePatient, patientactive -> patientinactive)
sets(ArchivePatient, PatientAccount, archived_at == present)

// Access constraints
requires_permission(SearchPatient, PatientProfileRead)
requires_medium(SearchPatient, FrontDeskTerminal)
requires_permission(SearchPatientApi, PatientProfileRead)

requires_permission(RegisterPatient, PatientProfileWrite)
requires_medium(RegisterPatient, FrontDeskTerminal)
requires_permission(RegisterPatientApi, PatientProfileWrite)

requires_permission(UpdateDemographics, PatientProfileWrite)
requires_medium(UpdateDemographics, FrontDeskTerminal)
requires_permission(UpdateDemographicsApi, PatientProfileWrite)

requires_permission(VerifyInsurance, InsuranceVerify)
requires_medium(VerifyInsurance, FrontDeskTerminal)
requires_permission(EligibilityApi, InsuranceVerify)

requires_permission(CaptureConsent, ConsentCapture)
requires_medium(CaptureConsent, PatientMobile)
requires_permission(ConsentApi, ConsentCapture)

requires_permission(SendIntakeForms, IntakeManage)
requires_medium(SendIntakeForms, FrontDeskTerminal)
requires_permission(IntakeMessagingApi, PatientMessageSend)

requires_permission(CompleteIntakeForms, ConsentCapture)
requires_medium(CompleteIntakeForms, PatientMobile)

requires_permission(ExpireIntakeForms, IntakeManage)
requires_medium(ExpireIntakeForms, FrontDeskTerminal)

requires_permission(MergeDuplicatePatient, PatientProfileWrite)
requires_medium(MergeDuplicatePatient, FrontDeskTerminal)

requires_permission(ArchivePatient, PatientProfileWrite)
requires_medium(ArchivePatient, FrontDeskTerminal)

// Business flow. A new patient is searched first so the same person is not registered twice;
// the 問診票 goes out when the first appointment is booked (EvAppointmentScheduled).
flow OnboardingFlow "新患登録の流れ"
step NewPatientSearchStep "既存患者の検索"
step RegisterStep         "新患登録"
step InsuranceStep        "保険資格・限度額情報の登録"
step ConsentStep          "同意の取得"
step IntakeSendStep       "問診票の送付"
step IntakeAnswerStep     "問診票の回答"
step IntakeExpireStep     "問診票の期限切れ"
contains(BucPatientOnboarding, OnboardingFlow)
contains(OnboardingFlow, NewPatientSearchStep)
contains(OnboardingFlow, RegisterStep)
contains(OnboardingFlow, InsuranceStep)
contains(OnboardingFlow, ConsentStep)
contains(OnboardingFlow, IntakeSendStep)
contains(OnboardingFlow, IntakeAnswerStep)
contains(OnboardingFlow, IntakeExpireStep)
precedes(NewPatientSearchStep, RegisterStep)
precedes(RegisterStep, InsuranceStep)
precedes(InsuranceStep, ConsentStep)
precedes(ConsentStep, IntakeSendStep)
precedes(IntakeSendStep, IntakeAnswerStep)
excepts(IntakeAnswerStep, IntakeExpireStep)
covers(NewPatientSearchStep, SearchPatient)
covers(RegisterStep, RegisterPatient)
covers(InsuranceStep, VerifyInsurance)
covers(ConsentStep, CaptureConsent)
covers(IntakeSendStep, SendIntakeForms)
covers(IntakeSendStep, EvAppointmentScheduled)
covers(IntakeAnswerStep, CompleteIntakeForms)
covers(IntakeExpireStep, ExpireIntakeForms)
covers(IntakeExpireStep, IntakeExpiryCheck)
performs(ReceptionClerk, NewPatientSearchStep)
performs(ReceptionClerk, RegisterStep)
performs(ReceptionClerk, InsuranceStep)
performs(Patient, ConsentStep)
performs(ReceptionClerk, IntakeSendStep)
performs(Patient, IntakeAnswerStep)

flow PatientMaintenanceFlow "患者情報の保守"
step MaintainSearchStep "登録済み患者の検索"
step DemographicsStep   "患者属性の変更"
step MergeStep          "重複患者の統合"
step ArchiveStep        "患者のアーカイブ"
contains(BucPatientOnboarding, PatientMaintenanceFlow)
contains(PatientMaintenanceFlow, MaintainSearchStep)
contains(PatientMaintenanceFlow, DemographicsStep)
contains(PatientMaintenanceFlow, MergeStep)
contains(PatientMaintenanceFlow, ArchiveStep)
precedes(MaintainSearchStep, DemographicsStep)
branches(MaintainSearchStep, MergeStep)
branches(MaintainSearchStep, ArchiveStep)
covers(MaintainSearchStep, SearchPatient)
covers(DemographicsStep, UpdateDemographics)
covers(MergeStep, MergeDuplicatePatient)
covers(ArchiveStep, ArchivePatient)
performs(ReceptionClerk, MaintainSearchStep)
performs(ReceptionClerk, DemographicsStep)
performs(ReceptionClerk, MergeStep)
performs(ReceptionClerk, ArchiveStep)
