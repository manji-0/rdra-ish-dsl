module buc.clinical_encounter

import shared.actors
import shared.entities
import shared.biz
import shared.goals

buc BucClinicalEncounter "診察"

usecase OpenEncounter       "診療記録を開く"
usecase RecordVitals        "バイタルの記録"
usecase DocumentAssessment  "診察・診断の記録"
usecase SignEncounter       "診療記録の署名"
usecase AmendEncounter      "署名済み記録の修正"
// 診療情報提供書の作成・送信 (mhlw-2024-hyojun-denshi-karte-gyomuflow.txt:121); 紹介を希望した患者に紹介状を
// 手渡す (sendai-iji-gairai-shiyousyo.txt:198).
usecase IssueReferralLetter "診療情報提供書の作成・送信"
// 診察終了後, the patient brings the papers to 計算受付 (sendai-iji-gairai-shiyousyo.txt:176,
// mhlw-2024-hyojun-denshi-karte-gyomuflow.txt:141): the visit now waits for 会計計算.
usecase CompleteConsultation "診察終了"

screen EncounterWorkspaceScreen "診療記録画面"
screen VitalsScreen             "バイタル入力画面"
screen DiagnosisScreen          "診断入力画面"
screen ReferralLetterScreen     "診療情報提供書画面"

api OpenEncounterApi       "診療記録作成 API"
api RecordVitalsApi        "バイタル記録 API"
api DocumentAssessmentApi  "診察記録 API"
api SignEncounterApi       "署名 API"
api AmendEncounterApi      "記録修正 API"
api IssueReferralLetterApi "診療情報提供書 API"
api CompleteConsultationApi "診察終了 API"

performs(Nurse, OpenEncounter)
performs(Nurse, RecordVitals)
performs(Clinician, DocumentAssessment)
performs(Clinician, SignEncounter)
performs(Clinician, AmendEncounter)
performs(Clinician, IssueReferralLetter)
// 診察終了 sits in the physician's lane of the outpatient flow (mhlw-2024-hyojun-denshi-karte-gyomuflow.txt:1103-1104, figure p12).
performs(Clinician, CompleteConsultation)
belongs(BucClinicalEncounter, CareDelivery)

contains(BucClinicalEncounter, OpenEncounter)
contains(BucClinicalEncounter, RecordVitals)
contains(BucClinicalEncounter, DocumentAssessment)
contains(BucClinicalEncounter, SignEncounter)
contains(BucClinicalEncounter, AmendEncounter)
contains(BucClinicalEncounter, IssueReferralLetter)
contains(BucClinicalEncounter, CompleteConsultation)
contains(ClinicOpsSystem, OpenEncounterApi)
contains(ClinicOpsSystem, RecordVitalsApi)
contains(ClinicOpsSystem, DocumentAssessmentApi)
contains(ClinicOpsSystem, SignEncounterApi)
contains(ClinicOpsSystem, AmendEncounterApi)
contains(ClinicOpsSystem, IssueReferralLetterApi)
contains(ClinicOpsSystem, CompleteConsultationApi)

displays(OpenEncounter, EncounterWorkspaceScreen)
invokes(OpenEncounter, OpenEncounterApi)
creates(OpenEncounterApi, Encounter)
updates(OpenEncounterApi, Appointment)
transitions(Appointment.status, OpenEncounter, apptcheckedin -> apptinconsult)
triggers(EvAppointmentCheckedIn, BucClinicalEncounter)
triggers(EvAppointmentCheckedIn, OpenEncounter)

displays(RecordVitals, VitalsScreen)
invokes(RecordVitals, RecordVitalsApi)
creates(RecordVitalsApi, VitalSign)
updates(RecordVitalsApi, Encounter)

displays(DocumentAssessment, DiagnosisScreen)
invokes(DocumentAssessment, DocumentAssessmentApi)
creates(DocumentAssessmentApi, Diagnosis)
updates(DocumentAssessmentApi, Encounter)
transitions(Encounter.status, DocumentAssessment, encopen -> encdocumented)

displays(SignEncounter, EncounterWorkspaceScreen)
invokes(SignEncounter, SignEncounterApi)
updates(SignEncounterApi, Encounter)
raises(SignEncounter, EvEncounterSigned)
transitions(Encounter.status, SignEncounter, encdocumented -> encsigned)
sets(SignEncounter, Encounter, signed_at == present)

displays(AmendEncounter, EncounterWorkspaceScreen)
invokes(AmendEncounter, AmendEncounterApi)
updates(AmendEncounterApi, Encounter)
transitions(Encounter.status, AmendEncounter, encsigned -> encamended)

displays(IssueReferralLetter, ReferralLetterScreen)
invokes(IssueReferralLetter, IssueReferralLetterApi)
creates(IssueReferralLetterApi, ReferralLetter)
reads(IssueReferralLetterApi, Encounter)
sets(IssueReferralLetter, ReferralLetter, direction == outbound)

// 診察終了 is the physician's own step after signing, and its event, not the signature, starts
// 計算・会計: the visit waits for 会計計算 only once the consultation is over.
displays(CompleteConsultation, EncounterWorkspaceScreen)
invokes(CompleteConsultation, CompleteConsultationApi)
updates(CompleteConsultationApi, Appointment)
updates(CompleteConsultationApi, Room)
transitions(Appointment.status, CompleteConsultation, apptinconsult -> apptawaitingcalc)
sets(CompleteConsultation, Room, occupancy_status == roomcleaning)
raises(CompleteConsultation, EvConsultationCompleted)

// Screen fields
field ReferralDirectionField "紹介の向き" access readonly required true source system
contains(ReferralLetterScreen, ReferralDirectionField)
maps_field(ReferralDirectionField, ReferralLetter, "direction")

// Access constraints
requires_permission(OpenEncounter, EncounterOpen)
requires_medium(OpenEncounter, NurseStation)
requires_permission(OpenEncounterApi, EncounterOpen)

requires_permission(RecordVitals, VitalsRecord)
requires_medium(RecordVitals, NurseStation)
requires_permission(RecordVitalsApi, VitalsRecord)

requires_permission(DocumentAssessment, ClinicalDocument)
requires_medium(DocumentAssessment, ClinicalWorkstation)
requires_permission(DocumentAssessmentApi, ClinicalDocument)

requires_permission(SignEncounter, EncounterSign)
requires_medium(SignEncounter, ClinicalWorkstation)
requires_permission(SignEncounterApi, EncounterSign)

requires_permission(AmendEncounter, EncounterSign)
requires_medium(AmendEncounter, ClinicalWorkstation)
requires_permission(AmendEncounterApi, EncounterSign)

requires_permission(IssueReferralLetter, ReferralManage)
requires_medium(IssueReferralLetter, ClinicalWorkstation)
requires_permission(IssueReferralLetterApi, ReferralManage)

requires_permission(CompleteConsultation, EncounterOpen)
requires_medium(CompleteConsultation, NurseStation)
requires_permission(CompleteConsultationApi, EncounterOpen)

// Business flow. The nurse opens the record and takes vitals, the physician examines, writes the
// diagnosis, and signs; 診察終了 then hands the visit to 計算・会計. A signed record is amended,
// not edited.
flow EncounterFlow "診察の流れ"
step OpenStep       "診療記録を開く"
step VitalsStep     "バイタル測定"
step AssessmentStep "診察・診断の記録"
step ReferralOutStep "診療情報提供書の作成・送信"
step SignStep       "診療記録の署名"
step CompleteStep   "診察終了"
step AmendStep      "署名後の修正"
contains(BucClinicalEncounter, EncounterFlow)
contains(EncounterFlow, OpenStep)
contains(EncounterFlow, VitalsStep)
contains(EncounterFlow, AssessmentStep)
contains(EncounterFlow, ReferralOutStep)
contains(EncounterFlow, SignStep)
contains(EncounterFlow, CompleteStep)
contains(EncounterFlow, AmendStep)
precedes(OpenStep, VitalsStep)
precedes(VitalsStep, AssessmentStep)
precedes(AssessmentStep, SignStep)
branches(AssessmentStep, ReferralOutStep)
precedes(ReferralOutStep, SignStep)
precedes(SignStep, CompleteStep)
excepts(SignStep, AmendStep)
covers(OpenStep, OpenEncounter)
covers(VitalsStep, RecordVitals)
covers(AssessmentStep, DocumentAssessment)
covers(ReferralOutStep, IssueReferralLetter)
covers(SignStep, SignEncounter)
covers(CompleteStep, CompleteConsultation)
covers(AmendStep, AmendEncounter)
performs(Nurse, OpenStep)
performs(Nurse, VitalsStep)
performs(Clinician, AssessmentStep)
performs(Clinician, ReferralOutStep)
performs(Clinician, SignStep)
performs(Clinician, CompleteStep)
performs(Clinician, AmendStep)

// Requirement traceability
requirement ReqHandOffAfterConsultation "診察終了で受診を会計計算へ引き渡す"
  priority "must"
  source "診察終了後 (sendai-iji-gairai-shiyousyo.txt:176)"
  source "計算受付 (mhlw-2024-hyojun-denshi-karte-gyomuflow.txt:141)"
  stakeholder "医師"
  acceptance criteria "診察終了の後、予約は計算待ちになり、会計計算入力より前に完了しない。"
  status "accepted"

motivates(ReqHandOffAfterConsultation, BucClinicalEncounter)
achieves(ReqHandOffAfterConsultation, TimelyClaims)

// A non-goal: a requirement the model rules out, with the reason.
requirement ReqNoOnlineConsultation "オンライン診療は対象外とする"
  source "モデルの想定（一次資料なし）"
  stakeholder "医師"
  status "out-of-scope"
  rationale "診察は来院して受ける前提で業務を分けているため、ビデオ通話による受付・診察・会計は扱わない。"

motivates(ReqNoOnlineConsultation, BucClinicalEncounter)
