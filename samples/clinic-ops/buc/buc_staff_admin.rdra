module buc.staff_admin

import shared.actors
import shared.entities
import shared.biz

buc BucStaffAdministration "病院管理"

usecase ManageProviderSchedule "診療枠の管理"
usecase BlockScheduleSlot      "診療枠の停止"
usecase ConfigureRoom          "診察室の設定"
usecase ReleaseRoom            "診察室の解放"
usecase ReviewAuditEvents      "監査ログの確認"
usecase ResolveAuditFinding    "監査指摘の解決"

screen ScheduleAdminScreen "診療枠管理画面"
screen RoomAdminScreen     "診察室管理画面"
screen AuditReviewScreen   "監査ログ画面"

api ManageProviderScheduleApi "診療枠管理 API"
api BlockScheduleSlotApi      "診療枠停止 API"
api RoomAdminApi     "診察室管理 API"
api AuditApi         "監査 API"

performs(ClinicAdmin, BucStaffAdministration)
belongs(BucStaffAdministration, ClinicAdministration)

contains(BucStaffAdministration, ManageProviderSchedule)
contains(BucStaffAdministration, BlockScheduleSlot)
contains(BucStaffAdministration, ConfigureRoom)
contains(BucStaffAdministration, ReleaseRoom)
contains(BucStaffAdministration, ReviewAuditEvents)
contains(BucStaffAdministration, ResolveAuditFinding)
contains(ClinicOpsSystem, ManageProviderScheduleApi)
contains(ClinicOpsSystem, BlockScheduleSlotApi)
contains(ClinicOpsSystem, RoomAdminApi)
contains(ClinicOpsSystem, AuditApi)

displays(ManageProviderSchedule, ScheduleAdminScreen)
invokes(ManageProviderSchedule, ManageProviderScheduleApi)
creates(ManageProviderScheduleApi, ProviderSchedule)
updates(ManageProviderScheduleApi, ProviderSchedule)
updates(ManageProviderScheduleApi, Provider)

displays(BlockScheduleSlot, ScheduleAdminScreen)
invokes(BlockScheduleSlot, BlockScheduleSlotApi)
updates(BlockScheduleSlotApi, ProviderSchedule)
sets(BlockScheduleSlot, ProviderSchedule, blocked == true)

displays(ConfigureRoom, RoomAdminScreen)
invokes(ConfigureRoom, RoomAdminApi)
creates(RoomAdminApi, Room)
updates(RoomAdminApi, Room)
sets(ConfigureRoom, Room, occupancy_status == roomavailable)

displays(ReleaseRoom, RoomAdminScreen)
updates(ReleaseRoom, Room)
sets(ReleaseRoom, Room, occupancy_status == roomavailable)

displays(ReviewAuditEvents, AuditReviewScreen)
invokes(ReviewAuditEvents, AuditApi)
reads(AuditApi, AuditEvent)
reads(AuditApi, PatientAccount)
shows(AuditReviewScreen, AuditEvent)

displays(ResolveAuditFinding, AuditReviewScreen)
updates(ResolveAuditFinding, AuditEvent)
sets(ResolveAuditFinding, AuditEvent, is_resolved == true)

// Access constraints
requires_permission(ManageProviderSchedule, ProviderScheduleAdmin)
requires_medium(ManageProviderSchedule, AdminConsole)
requires_permission(ManageProviderScheduleApi, ProviderScheduleAdmin)

requires_permission(BlockScheduleSlot, ProviderScheduleAdmin)
requires_medium(BlockScheduleSlot, AdminConsole)
requires_permission(BlockScheduleSlotApi, ProviderScheduleAdmin)

requires_permission(ConfigureRoom, RoomAdmin)
requires_medium(ConfigureRoom, AdminConsole)
requires_permission(RoomAdminApi, RoomAdmin)

requires_permission(ReleaseRoom, RoomAdmin)
requires_medium(ReleaseRoom, AdminConsole)

requires_permission(ReviewAuditEvents, AuditRead)
requires_medium(ReviewAuditEvents, AdminConsole)
requires_permission(AuditApi, AuditRead)

requires_permission(ResolveAuditFinding, AuditResolve)
requires_medium(ResolveAuditFinding, AdminConsole)

// No business flow. The schedule, room, and audit work here is master maintenance an
// administrator does whenever it is needed, in no fixed order, so a flow would only restate the
// list of use cases.

// Requirement traceability
requirement ReqResolveAuditFindings "監査で見つかった問題を管理者が解決するまで追う"
  priority "must"
  source "モデルの想定（一次資料なし）"
  stakeholder "病院管理者"
  acceptance criteria "監査指摘は管理端末から解決されるまで未解決として残る。"
  status "accepted"

motivates(ReqResolveAuditFindings, BucStaffAdministration)
