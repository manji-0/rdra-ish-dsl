module shared.entities

entity Store "Store" {
  id: Int @pk
  code: String @unique
  name: String
  restock_status: Enum(normal, scheduled, blocked) @default(normal)
  next_restock_date: DateTime @null
}

entity Organization "Organization" {
  id: Int @pk
  code: String @unique
  name: String
}


relate(Store, Organization, N:1)
