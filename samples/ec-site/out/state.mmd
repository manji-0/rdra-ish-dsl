%% rdra-ish diagram=state scope=whole model=samples/ec-site
%% kinds: statemodel state usecase
%% omitted: Payment.status (Enum without transitions)
stateDiagram-v2
  state "Order.status" as statemodel__Order_status {
    [*] --> state__Order_pending
    state "pending" as state__Order_pending
    state "awaiting_capture" as state__Order_awaiting_capture
    state "paid" as state__Order_paid
    state "shipped" as state__Order_shipped
    state "delivered" as state__Order_delivered
    state "cancelled" as state__Order_cancelled
    %% transition usecase__InputPaymentInfo
    state__Order_pending --> state__Order_awaiting_capture : Enter Payment Information
    %% transition usecase__Cancel
    state__Order_pending --> state__Order_cancelled : Cancel Order
    %% transition usecase__Capture
    state__Order_awaiting_capture --> state__Order_paid : Capture Payment
    %% transition usecase__Cancel
    state__Order_awaiting_capture --> state__Order_cancelled : Cancel Order
    %% transition usecase__ShipOrder
    state__Order_paid --> state__Order_shipped : Ship Order
    %% transition usecase__DeliverOrder
    state__Order_shipped --> state__Order_delivered : Confirm Delivery
    state__Order_delivered --> [*]
    state__Order_cancelled --> [*]
  }
