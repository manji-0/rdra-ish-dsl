module buc.inspection_decision

import shared.actors
import shared.entities
import shared.biz
import shared.goals
import shared.governance

// Sources cited as file:line are under ~/research/japan-food-permit-operations/sources/.

buc BucInspectionDecision "施設検査と許可・不許可"
  description "食品衛生監視員が施設を検査し、施設基準に合わなければ改善を指示して再検査する。行政庁は基準に合うと認めれば許可しなければならず、合わなければ理由を示して不許可にする。許可すると台帳に登録して許可証を交付し、営業者は許可証を掲示して営業を始める。食品衛生責任者が申請時に未定なら、許可後速やかに定める。"

// No statute requires this inspection (see Inspection in shared/entities.rdra): 店舗の調査
// (osaka-city-eigyou-kyoka-tetsuzuki.md:104); 決済完了を保健所で確認後…施設検査の日程 (tokyo-tachikawa-shinsei-system.md:219).
usecase ScheduleInspection "施設検査の日程調整"
  description "手数料の納付を確かめた検査待の申請について、施設検査の日を決める。"

// 食品衛生監視員が基準に合っているかどうか店舗を調査します (osaka-city-eigyou-kyoka-tetsuzuki.md:105); 施設検査時に衛生管理
// 計画を確認 (tokyo-kyoka-todokede-gaiyou.md:35).
usecase ConductInspection "施設検査の実施"
  description "食品衛生監視員が施設を施設基準（共通基準・業種別基準）と照らし、衛生管理計画を確かめる。合わなければ改善を指示する。"

// 施設基準を満たしていない場合は改善後、再検査となります (tokyo-minamitama-kyoka-kigen-manryou.md:226).
usecase RequestReinspection "改善の報告と再検査の申込み" description "営業者が指示された箇所を直し、再検査を申し込む。"

// 基準に合うと認めるときは、許可をしなければならない (egov-shokuhin-eiseihou-322AC0000000233.txt:402). The 欠格事由
// (:403-409) allow a refusal and are not modeled as state (README).
usecase GrantPermit "許可の決定"
  description "施設検査で施設基準に合うと認めた新規の申請に許可を与え、有効期間（5年以上）を付ける。"

// 拒否する処分をする場合は…同時に、当該処分の理由を示さなければならない (egov-gyousei-tetsuzukihou-405AC0000000088.txt:176);
// 不服申立てをすることができる期間を書面で教示 (egov-gyousei-fufuku-shinsahou-426AC0000000068.txt:748).
usecase DenyPermit "不許可の決定"
  description "施設基準に合わないか、補正に応じないか、欠格事由に当たる申請を、理由を示し、審査請求ができることを書面で教えて拒否する。"

// 許可証を作成します。交付日は、店舗の調査時に通知書でお知らせします (osaka-city-eigyou-kyoka-tetsuzuki.md:107).
usecase RegisterPermit "許可台帳への登録"
  description "許可の決定を受けて許可番号を付け、許可台帳に登録する。電子申請ではシステムの表示を発行済にする。"

// 許可をしたときは、許可証を交付しなければならない (osaka-pref-shokuhin-eiseihou-sekou-jourei.md:17).
usecase IssueCertificate "許可証の交付" description "許可証を営業者に交付する。"

// 速やかに食品衛生責任者の選定又は講習会の受講が行われるように指導 (mhlw-2019-seishokuhatsu1227-2-sekou.txt:435).
usecase AppointHygieneManager "食品衛生責任者の選定の届出"
  description "申請時に食品衛生責任者を定めていなかった営業者が、許可後に定めて（講習会を受けて）届け出る。"

// 許可証を営業の施設の見やすい場所に掲示しなければならない (osaka-pref-shokuhin-eiseihou-sekou-jourei.md:18).
usecase StartBusiness "営業の開始・再開"
  description "営業者が許可証を掲示して営業を始める。営業停止の期間が終わった後の再開も同じ。"

screen InspectionScreen "施設検査画面"
screen DecisionScreen "許可決定画面"
screen PermitLedgerScreen "許可台帳画面"

api InspectionScheduleApi "施設検査予定 API"
  method POST
  path "/permit-applications/{id}/inspection"

api InspectionApi "施設検査 API"
  method PATCH
  path "/inspections/{id}"

api ReinspectionApi "再検査申込み API"
  method POST
  path "/inspections/{id}/reinspection"

api DecisionApi "許可決定 API"
  method POST
  path "/permit-applications/{id}/decision"

api PermitRegistrationApi "営業許可登録 API"
  method POST
  path "/permits"

api PermitApi "営業許可 API"
  method PATCH
  path "/permits/{id}"

api OperatorPermitApi "営業者の届出 API"
  method POST
  path "/permits/{id}/operator-reports"

performs(PermitClerk, ScheduleInspection)
performs(FoodSanitationInspector, ConductInspection)
performs(BusinessOperator, RequestReinspection)
performs(PermitAuthority, GrantPermit)
performs(PermitAuthority, DenyPermit)
performs(PermitClerk, RegisterPermit)
performs(PermitClerk, IssueCertificate)
performs(BusinessOperator, AppointHygieneManager)
performs(BusinessOperator, StartBusiness)
belongs(BucInspectionDecision, Licensing).by(OnSite).by(HealthCenterTerminal).by(HealthCenterCounter)

contains(BucInspectionDecision, ScheduleInspection)
contains(BucInspectionDecision, ConductInspection)
contains(BucInspectionDecision, RequestReinspection)
contains(BucInspectionDecision, GrantPermit)
contains(BucInspectionDecision, DenyPermit)
contains(BucInspectionDecision, RegisterPermit)
contains(BucInspectionDecision, IssueCertificate)
contains(BucInspectionDecision, AppointHygieneManager)
contains(BucInspectionDecision, StartBusiness)
contains(PermitLedgerSystem, InspectionScheduleApi)
contains(PermitLedgerSystem, InspectionApi)
contains(PermitLedgerSystem, ReinspectionApi)
contains(PermitLedgerSystem, DecisionApi)
contains(PermitLedgerSystem, PermitRegistrationApi)
contains(PermitLedgerSystem, PermitApi)
contains(PermitLedgerSystem, OperatorPermitApi)

displays(ScheduleInspection, InspectionScreen)
invokes(ScheduleInspection, InspectionScheduleApi)
creates(InspectionScheduleApi, Inspection)
reads(InspectionScheduleApi, PermitApplication)

// One inspection record per application (the 1:1 relate): a reinspection reopens it. Without the
// `.none`, `verify` at 2 instances scheduled a second inspection for one application.
condition AwaitingInspection "申請が検査待で、まだ検査の予定がない"
holds(AwaitingInspection, PermitApplication.status == awaiting_inspection).none(Inspection.status in (scheduled, passed, failed))
applies_to(AwaitingInspection, ScheduleInspection)

displays(ConductInspection, InspectionScreen)
invokes(ConductInspection, InspectionApi)
updates(InspectionApi, Inspection)
transitions(ConductInspection, Inspection.status, scheduled -> passed)
transitions(ConductInspection, Inspection.status, scheduled -> failed)

displays(RequestReinspection, InspectionScreen)
invokes(RequestReinspection, ReinspectionApi)
updates(ReinspectionApi, Inspection)
transitions(RequestReinspection, Inspection.status, failed -> scheduled)

// Only a facility the inspection found to meet the standard.
displays(GrantPermit, DecisionScreen)
invokes(GrantPermit, DecisionApi)
updates(DecisionApi, PermitApplication)
reads(DecisionApi, Inspection)
transitions(GrantPermit, PermitApplication.status, awaiting_inspection -> approved)
raises(GrantPermit, EvPermitGranted)
triggers(EvPermitGranted, RegisterPermit)

condition InspectionPassed "施設検査で施設基準に適合した"
holds(InspectionPassed, Inspection.status == passed)
applies_to(InspectionPassed, GrantPermit)

condition NewApplication "新規の申請である"
holds(NewApplication, PermitApplication.kind == new)
applies_to(NewApplication, GrantPermit)

// From 差戻し as well: 補正を求め、又は…拒否しなければならない (egov-gyousei-tetsuzukihou-405AC0000000088.txt:173).
displays(DenyPermit, DecisionScreen)
invokes(DenyPermit, DecisionApi)
transitions(DenyPermit, PermitApplication.status, awaiting_inspection -> denied)
transitions(DenyPermit, PermitApplication.status, returned -> denied)
sets(DenyPermit, PermitApplication, reason_shown == true)
raises(DenyPermit, EvApplicationReturned)

// The event gives no order (#30), so `check` also lets a permit be registered before any
// application is granted; no rule reads both, so the over-approximation hides nothing here.
displays(RegisterPermit, PermitLedgerScreen)
invokes(RegisterPermit, PermitRegistrationApi)
creates(PermitRegistrationApi, BusinessPermit)
raises(RegisterPermit, EvPermitIssued)
triggers(EvPermitIssued, FoodSanitationSystem)

displays(IssueCertificate, PermitLedgerScreen)
invokes(IssueCertificate, PermitApi)
updates(PermitApi, BusinessPermit)
sets(IssueCertificate, BusinessPermit, certificate_issued == true)

condition PermitValid "許可が有効である"
holds(PermitValid, BusinessPermit.status == valid)
applies_to(PermitValid, IssueCertificate)
applies_to(PermitValid, AppointHygieneManager)

displays(AppointHygieneManager, PermitLedgerScreen)
invokes(AppointHygieneManager, OperatorPermitApi)
updates(OperatorPermitApi, BusinessPermit)
sets(AppointHygieneManager, BusinessPermit, hygiene_manager_appointed == true)

// 営業の許可後速やかに食品衛生責任者を選定 (mhlw-2019-seishokuhatsu1227-2-sekou.txt:435): a valid permit
// without one ends with one appointed, or with the permit's end, once the operator's
// notification is not starved. `verify` checks it on the permit's cone (README).
property HygieneManagerEventuallyAppointed "有効な許可には食品衛生責任者が選定される"
  leads_to((BusinessPermit.status == valid) and (BusinessPermit.hygiene_manager_appointed == false), (BusinessPermit.hygiene_manager_appointed == true) or (BusinessPermit.status != valid)).fair(AppointHygieneManager)

displays(StartBusiness, PermitLedgerScreen)
invokes(StartBusiness, OperatorPermitApi)
sets(StartBusiness, BusinessPermit, operating == true)

condition CertifiedAndValid "許可が有効で、許可証の交付を受けている"
holds(CertifiedAndValid, BusinessPermit.status == valid, BusinessPermit.certificate_issued == true)
applies_to(CertifiedAndValid, StartBusiness)

// Access constraints
requires_permission(ScheduleInspection, ApplicationReview)
requires_medium(ScheduleInspection, HealthCenterTerminal)
requires_permission(ConductInspection, FacilityInspect)
requires_medium(ConductInspection, OnSite)
requires_permission(InspectionApi, FacilityInspect)
requires_permission(RequestReinspection, ApplicationSubmit)
requires_medium(RequestReinspection, HealthCenterCounter)
requires_permission(GrantPermit, PermitDecide)
requires_medium(GrantPermit, HealthCenterTerminal)
requires_permission(DecisionApi, PermitDecide)
requires_permission(DenyPermit, PermitDecide)
requires_medium(DenyPermit, HealthCenterTerminal)
requires_permission(RegisterPermit, PermitRegister)
requires_medium(RegisterPermit, HealthCenterTerminal)
requires_permission(IssueCertificate, PermitRegister)
requires_medium(IssueCertificate, HealthCenterCounter)
requires_permission(AppointHygieneManager, ApplicationSubmit)
requires_medium(AppointHygieneManager, HealthCenterCounter)
requires_permission(StartBusiness, ApplicationSubmit)
requires_medium(StartBusiness, OnSite)

applies_to(StandardProcessingPeriod, GrantPermit)
applies_to(StandardProcessingPeriod, DenyPermit)

// Screen transitions: the model's assumption.
navigates(InspectionScreen, DecisionScreen).via(ConductInspection)
navigates(DecisionScreen, PermitLedgerScreen).via(GrantPermit)

field InspectionResultField "検査結果"
  access editable
  required true
  source actor

field ReasonShownField "不許可の理由の提示"
  access readonly
  required true
  source system

field CertificateField "許可証の交付"
  access readonly
  required true
  source system

contains(InspectionScreen, InspectionResultField)
contains(DecisionScreen, ReasonShownField)
contains(PermitLedgerScreen, CertificateField)
maps_field(InspectionResultField, Inspection.status)
maps_field(ReasonShownField, PermitApplication.reason_shown)
maps_field(CertificateField, BusinessPermit.certificate_issued)

// Business flow
flow InspectionDecisionFlow "施設検査と許可の流れ"
step ScheduleStep "検査日の調整"
step InspectStep "施設検査"
step ImproveStep "改善と再検査"
step GrantStep "許可の決定"
step DenyStep "不許可（理由の提示）"
step RegisterStep "台帳登録と許可証の交付"
step OpenStep "許可証の掲示と営業の開始"
step HygieneManagerStep "食品衛生責任者の選定"

contains(BucInspectionDecision, InspectionDecisionFlow)
contains(InspectionDecisionFlow, ScheduleStep)
contains(InspectionDecisionFlow, InspectStep)
contains(InspectionDecisionFlow, ImproveStep)
contains(InspectionDecisionFlow, GrantStep)
contains(InspectionDecisionFlow, DenyStep)
contains(InspectionDecisionFlow, RegisterStep)
contains(InspectionDecisionFlow, OpenStep)
contains(InspectionDecisionFlow, HygieneManagerStep)

precedes(ScheduleStep, InspectStep)
precedes(InspectStep, GrantStep)
excepts(InspectStep, ImproveStep)
repeats(ImproveStep, InspectStep)
branches(InspectStep, DenyStep)
precedes(GrantStep, RegisterStep)
precedes(RegisterStep, OpenStep)
branches(RegisterStep, HygieneManagerStep)

covers(ScheduleStep, ScheduleInspection)
covers(InspectStep, ConductInspection)
covers(ImproveStep, RequestReinspection)
covers(GrantStep, GrantPermit)
covers(DenyStep, DenyPermit)
covers(RegisterStep, RegisterPermit)
covers(RegisterStep, IssueCertificate)
covers(OpenStep, StartBusiness)
covers(HygieneManagerStep, AppointHygieneManager)

performs(PermitClerk, ScheduleStep)
performs(FoodSanitationInspector, InspectStep)
performs(BusinessOperator, ImproveStep)
performs(PermitAuthority, GrantStep)
performs(PermitAuthority, DenyStep)
performs(PermitClerk, RegisterStep)
performs(BusinessOperator, OpenStep)
performs(BusinessOperator, HygieneManagerStep)

// Rules
// 基準に合うと認めるときは、許可をしなければならない (egov-shokuhin-eiseihou-322AC0000000233.txt:402); 検査時に施設基準
// に適合しない場合には営業許可は更新できません (toshima-ku-kyoka-go-tetsuzuki.md:38).
forbidden(PermitApplication, Inspection, PermitApplication.status == approved, Inspection.status != passed).along(PermitApplication, Inspection).label("施設基準に適合しない施設には許可しない")

invariant(PermitApplication).when(status == denied).then(reason_shown == true).label("不許可には理由を同時に示す")

// 決済完了を保健所で確認後…施設検査 (tokyo-tachikawa-shinsei-system.md:219).
invariant(PermitApplication).when(status in (awaiting_inspection, approved)).then(fee_paid == true).label("手数料を納めた申請だけが検査と許可に進む")

// 許可証を…掲示しなければならない (osaka-pref-shokuhin-eiseihou-sekou-jourei.md:18).
invariant(BusinessPermit).when(operating == true).then(certificate_issued == true).label("許可証の交付を受けてから営業する")

// Requirement traceability
requirement ReqPermitOnlyCompliantFacility "施設基準に適合した施設にだけ許可し、不許可には理由を示す"
  priority "must"
  source "基準に合うと認めるときは、許可をしなければならない (egov-shokuhin-eiseihou-322AC0000000233.txt:402)"
  source "理由の提示 (egov-gyousei-tetsuzukihou-405AC0000000088.txt:176)"
  source "改善後、再検査 (tokyo-minamitama-kyoka-kigen-manryou.md:226)"
  stakeholder "営業者"
  stakeholder "食品衛生監視員"
  stakeholder "都道府県知事等"
  acceptance_criteria "許可した申請の施設検査は適合であり、不許可の申請には理由が示されている。"
  status "accepted"

motivates(ReqPermitOnlyCompliantFacility, BucInspectionDecision)
achieves(ReqPermitOnlyCompliantFacility, NoUnlicensedOperation)
achieves(ReqPermitOnlyCompliantFacility, TimelyDecision)

requirement ReqHygieneManagerAfterPermit "申請時に食品衛生責任者が未定なら、許可後速やかに定めさせる"
  priority "should"
  source "食品衛生責任者を定めること (egov-shokuhin-eiseihou-shikoukisoku-323M40000100023.txt:3220)"
  source "営業の許可後速やかに (mhlw-2019-seishokuhatsu1227-2-sekou.txt:431, :435)"
  stakeholder "営業者"
  acceptance_criteria "有効な許可で食品衛生責任者のいない状態は、いずれ責任者の選定か許可の終了に至る。"
  status "accepted"

motivates(ReqHygieneManagerAfterPermit, BucInspectionDecision)
achieves(ReqHygieneManagerAfterPermit, NoUnlicensedOperation)
