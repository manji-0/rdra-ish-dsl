    variation__OpinionProcedure__omitted["意見陳述の省略（行政手続法13条2項3号）"]:::value
  end
  subgraph variation__PermitBusinessType["許可業種"]
    variation__PermitBusinessType__restaurant["飲食店営業"]:::value
