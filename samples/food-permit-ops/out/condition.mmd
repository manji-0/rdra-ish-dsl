flowchart LR
  condition__AwaitingInspection{"申請が検査待で、まだ検査の予定がない"}:::condition
  %% holds condition__AwaitingInspection: (PermitApplication.status == 検査待).none(Inspection)
  condition__BeforeReview{"申請が確認待か差戻し中である"}:::condition
  %% holds condition__BeforeReview: PermitApplication.status in (申請内容確認待, 差戻し・補正中)
  condition__CertifiedAndValid{"許可が有効で、許可証の交付を受けている"}:::condition
  %% holds condition__CertifiedAndValid: BusinessPermit.status == 有効, BusinessPermit.certificate_issued == true
  condition__CounterApplication{"窓口（紙）で出した申請である"}:::condition
  %% holds condition__CounterApplication: PermitApplication.channel == 保健所の窓口（紙）
  condition__DispositionDecided{"処分が決定している"}:::condition
  %% holds condition__DispositionDecided: Disposition.status in (処分決定, 確定（審査請求期間の経過）)
  condition__ExemptType{"届出も要らない営業（施行令35条の2）である"}:::condition
  %% holds condition__ExemptType: Consultation.business_type == 常温で保存できる包装食品の販売（届出不要）
  condition__ExplanationProcedure{"弁明の機会を与える処分である"}:::condition
  %% holds condition__ExplanationProcedure: Disposition.procedure == 弁明の機会の付与
  condition__FeePaid{"手数料が納められている"}:::condition
  %% holds condition__FeePaid: PermitApplication.fee_paid == true
  condition__HearingProcedure{"聴聞を執る処分である"}:::condition
  %% holds condition__HearingProcedure: Disposition.procedure == 聴聞
  condition__ImprovementOrderKind{"施設の整備改善命令である"}:::condition
  %% holds condition__ImprovementOrderKind: Disposition.kind == 施設の整備改善命令
  condition__InspectionPassed{"施設検査で施設基準に適合した"}:::condition
  %% holds condition__InspectionPassed: Inspection.status == 適合
  condition__NewApplication{"新規の申請である"}:::condition
  %% holds condition__NewApplication: PermitApplication.kind == 新規
  condition__NoPermitYet{"新規の申請で、まだ許可が登録されていない"}:::condition
  %% holds condition__NoPermitYet: (PermitApplication.kind == 新規).none(BusinessPermit).by(PermitApplication)
  condition__NotRevocation{"取消ではない処分である"}:::condition
  %% holds condition__NotRevocation: Disposition.kind in (施設の整備改善命令, 営業の停止)
  condition__NotificationRequiredType{"届出業種である"}:::condition
  %% holds condition__NotificationRequiredType: Consultation.business_type in (弁当販売業（届出）, 野菜果物販売業（届出）)
  condition__OpinionOmitted{"意見陳述を省く処分である"}:::condition
  %% holds condition__OpinionOmitted: Disposition.procedure == 意見陳述の省略（行政手続法13条2項3号）
  condition__OpinionRequired{"意見陳述の手続を執る処分である"}:::condition
  %% holds condition__OpinionRequired: Disposition.procedure in (聴聞, 弁明の機会の付与)
  condition__PermitNotEnded{"許可が終わっていない（有効か停止中）"}:::condition
  %% holds condition__PermitNotEnded: BusinessPermit.status in (有効, 営業停止中)
  condition__PermitRequiredType{"許可業種（施行令35条）である"}:::condition
  %% holds condition__PermitRequiredType: Consultation.business_type in (飲食店営業, 食肉販売業, 菓子製造業)
  condition__PermitValid{"許可が有効である"}:::condition
  %% holds condition__PermitValid: BusinessPermit.status == 有効
  condition__PlanPublished{"監視指導計画が公表されている"}:::condition
  %% holds condition__PlanPublished: MonitoringPlan.status == 公表済
  condition__RenewalApplication{"継続（更新）の申請である"}:::condition
  %% holds condition__RenewalApplication: PermitApplication.kind == 継続（更新）
  condition__RenewsValidPermit{"失効後の更新はできない"}:::condition
  %% holds condition__RenewsValidPermit: (BusinessPermit.status == 有効).by(renews)
  condition__RevocationKind{"許可の取消である"}:::condition
  %% holds condition__RevocationKind: Disposition.kind == 許可の取消
  condition__SuspensionKind{"営業の停止である"}:::condition
  %% holds condition__SuspensionKind: Disposition.kind == 営業の停止
