%% rdra-ish diagram=usecase scope=buc:BucRenewal model=samples/food-permit-ops
%% layers: value=システム価値 environment=システム外部環境 boundary=システム境界 system=システム
%% kinds: actor extsystem timer usecase screen event entity state condition
%% omitted: buc step medium permission field api
flowchart LR
  subgraph layer_value["システム価値"]
    actor__BusinessOperator(["営業者"]):::actor
    %% desc actor__BusinessOperator: 飲食店などの営業を営もうとする者と、許可・届出を受けて営業する者。事前相談をし、許可を申請し、手数料を納め、施設検査を受け、許可後は変更・承継・廃業を届け出る。
    actor__FoodSanitationInspector(["食品衛生監視員"]):::actor
    %% desc actor__FoodSanitationInspector: 事前相談で図面を見て営業の種類を判定し、許可前と更新前の施設検査、計画に沿った立入検査を行い、違反を見つけたら処分を起案する。
    actor__PermitAuthority(["都道府県知事等（保健所設置市長・特別区長）"]):::actor
    %% desc actor__PermitAuthority: 許可・不許可と、整備改善命令・営業停止・許可取消の処分を決める行政庁。
    actor__PermitClerk(["保健所 許可担当職員"]):::actor
    %% desc actor__PermitClerk: 許可申請・届出の受付と審査、差戻し、許可台帳と許可証、聴聞・弁明の事務、処分の公表、監視指導計画の取りまとめを行う。
    extsystem__FoodSanitationSystem[["食品衛生申請等システム（厚生労働省）"]]:::extsystem
  end
  subgraph layer_environment["システム外部環境"]
    timer__ExpiryNoticeDue(("満了通知の発送（有効期間満了の2か月前）")):::timer
    timer__PermitTermEnd(("有効期間の満了（5年以上、自治体が定める）")):::timer
  end
  subgraph layer_boundary["システム境界"]
    usecase__ApplyRenewal("継続（更新）の申請"):::usecase
    %% desc usecase__ApplyRenewal: 有効な許可の営業者が、満了の前に継続の許可を申請する（窓口・電子）。手数料と施設検査は新規と同じ手順で進む。
    usecase__ConductInspection("施設検査の実施"):::usecase
    %% desc usecase__ConductInspection: 食品衛生監視員が施設を施設基準（共通基準・業種別基準）と照らし、衛生管理計画を確かめる。合わなければ改善を指示する。
    usecase__ExpirePermit("有効期間の満了による失効"):::usecase
    %% desc usecase__ExpirePermit: 更新されないまま有効期間が満了した許可を失効させる。営業者は営業をやめ、続けるなら新規の許可を受ける。
    usecase__ExtendPermitTerm("有効期間の更新"):::usecase
    %% desc usecase__ExtendPermitTerm: 更新の許可を受けて、台帳の有効期間を新しい期間に書き換え、満了通知の記録を消す。
    usecase__RenewPermit("更新の許可の決定"):::usecase
    %% desc usecase__RenewPermit: 施設検査で施設基準に合うと認めた継続の申請に、許可がまだ有効なうちに許可を与える。
    usecase__ScheduleInspection("施設検査の日程調整"):::usecase
    %% desc usecase__ScheduleInspection: 手数料の納付を確かめた検査待の申請について、施設検査の日を決める。
    usecase__SendExpiryNotice("満了通知の発送"):::usecase
    %% desc usecase__SendExpiryNotice: 有効期間が満了する前に、許可営業者に満了の時期と更新の手続を知らせる。
    screen__InspectionScreen["施設検査画面"]:::screen
    screen__PermitLedgerScreen["許可台帳画面"]:::screen
    screen__RenewalScreen["更新申請画面"]:::screen
    event__EvRenewalGranted>"更新の許可"]:::event
  end
  subgraph layer_system["システム"]
    entity__BusinessPermit[("営業許可")]:::entity
    entity__Inspection[("施設検査")]:::entity
    entity__PermitApplication[("営業許可申請")]:::entity
    state__BusinessPermit_expired((("失効（有効期間満了）"))):::state
    state__BusinessPermit_suspended((("営業停止中"))):::state
    state__BusinessPermit_valid((("有効"))):::state
    state__Inspection_failed((("不適合（改善の指示）"))):::state
    state__Inspection_passed((("適合"))):::state
    state__Inspection_scheduled((("検査予定"))):::state
    state__PermitApplication_approved((("許可"))):::state
    state__PermitApplication_awaiting_inspection((("検査待"))):::state
    condition__AwaitingInspection{"申請が検査待で、まだ検査の予定がない"}:::condition
    condition__InspectionPassed{"施設検査で施設基準に適合した"}:::condition
    condition__RenewalApplication{"継続（更新）の申請である"}:::condition
  end
  actor__BusinessOperator -.-> usecase__ApplyRenewal
  actor__FoodSanitationInspector -.-> usecase__ConductInspection
  actor__FoodSanitationInspector -.-> usecase__ScheduleInspection
  %% derived actor__FoodSanitationInspector -> usecase__ScheduleInspection via step__RenewalInspectStep
  actor__PermitAuthority -.-> usecase__RenewPermit
  actor__PermitClerk -.-> usecase__ExtendPermitTerm
  actor__PermitClerk -.-> usecase__ScheduleInspection
  actor__PermitClerk -.-> usecase__SendExpiryNotice
  condition__AwaitingInspection -.->|applies_to| usecase__ScheduleInspection
  condition__InspectionPassed -.->|applies_to| usecase__RenewPermit
  condition__RenewalApplication -.->|applies_to| usecase__RenewPermit
  event__EvRenewalGranted -.-> extsystem__FoodSanitationSystem
  event__EvRenewalGranted -.-> usecase__ExtendPermitTerm
  timer__ExpiryNoticeDue -.-> usecase__SendExpiryNotice
  timer__PermitTermEnd -.-> usecase__ExpirePermit
  usecase__ApplyRenewal -.->|creates| entity__PermitApplication
  %% derived usecase__ApplyRenewal -> entity__PermitApplication via api__RenewalApi
  usecase__ApplyRenewal -.-> screen__RenewalScreen
  usecase__ApplyRenewal -.->|reads| entity__BusinessPermit
  %% derived usecase__ApplyRenewal -> entity__BusinessPermit via api__RenewalApi
  usecase__ConductInspection -.-> screen__InspectionScreen
  usecase__ConductInspection -.->|transitions Inspection.status scheduled->failed| state__Inspection_failed
  usecase__ConductInspection -.->|transitions Inspection.status scheduled->passed| state__Inspection_passed
  usecase__ConductInspection -.->|updates| entity__Inspection
  %% derived usecase__ConductInspection -> entity__Inspection via api__InspectionApi
  usecase__ExpirePermit -.->|transitions BusinessPermit.status suspended->expired| state__BusinessPermit_expired
  usecase__ExpirePermit -.->|transitions BusinessPermit.status valid->expired| state__BusinessPermit_expired
  usecase__ExpirePermit -.->|updates| entity__BusinessPermit
  %% derived usecase__ExpirePermit -> entity__BusinessPermit via api__PermitTermApi
  usecase__ExtendPermitTerm -.-> screen__PermitLedgerScreen
  usecase__ExtendPermitTerm -.->|transitions BusinessPermit.status valid->valid| state__BusinessPermit_valid
  usecase__ExtendPermitTerm -.->|updates| entity__BusinessPermit
  %% derived usecase__ExtendPermitTerm -> entity__BusinessPermit via api__PermitTermApi
  usecase__RenewPermit -.-> screen__InspectionScreen
  usecase__RenewPermit -.-> event__EvRenewalGranted
  usecase__RenewPermit -.->|reads| entity__Inspection
  %% derived usecase__RenewPermit -> entity__Inspection via api__DecisionApi
  usecase__RenewPermit -.->|transitions PermitApplication.status awaiting_inspection->approved| state__PermitApplication_approved
  usecase__RenewPermit -.->|updates| entity__PermitApplication
  %% derived usecase__RenewPermit -> entity__PermitApplication via api__DecisionApi
  usecase__ScheduleInspection -.->|creates| entity__Inspection
  %% derived usecase__ScheduleInspection -> entity__Inspection via api__InspectionScheduleApi
  usecase__ScheduleInspection -.-> screen__InspectionScreen
  usecase__ScheduleInspection -.->|reads| entity__PermitApplication
  %% derived usecase__ScheduleInspection -> entity__PermitApplication via api__InspectionScheduleApi
  usecase__SendExpiryNotice -.-> screen__PermitLedgerScreen
  usecase__SendExpiryNotice -.->|reads| entity__BusinessPermit
  usecase__SendExpiryNotice -.->|updates| entity__BusinessPermit
  %% derived usecase__SendExpiryNotice -> entity__BusinessPermit via api__PermitTermApi
  classDef actor fill:#ffe3e3,stroke:#c92a2a,color:#000;
  classDef extsystem fill:#e9ecef,stroke:#495057,color:#000;
  classDef timer fill:#ffe8cc,stroke:#d9480f,color:#000;
  classDef usecase fill:#d0ebff,stroke:#1864ab,color:#000;
  classDef screen fill:#e5dbff,stroke:#5f3dc4,color:#000;
  classDef event fill:#ffdeeb,stroke:#a61e4d,color:#000;
  classDef entity fill:#fff9db,stroke:#5c940d,color:#000;
  classDef state fill:#f8f9fa,stroke:#5c940d,color:#000;
  classDef condition fill:#f3d9fa,stroke:#862e9c,color:#000;
