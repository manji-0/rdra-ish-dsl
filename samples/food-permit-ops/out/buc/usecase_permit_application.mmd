%% rdra-ish diagram=usecase scope=buc:BucPermitApplication model=samples/food-permit-ops
%% layers: value=システム価値 boundary=システム境界 system=システム
%% kinds: actor extsystem usecase screen event entity state condition
%% omitted: buc step medium permission field api
flowchart LR
  subgraph layer_value["システム価値"]
    actor__BusinessOperator(["営業者"]):::actor
    %% desc actor__BusinessOperator: 飲食店などの営業を営もうとする者と、許可・届出を受けて営業する者。事前相談をし、許可を申請し、手数料を納め、施設検査を受け、許可後は変更・承継・廃業を届け出る。
    actor__PermitClerk(["保健所 許可担当職員"]):::actor
    %% desc actor__PermitClerk: 許可申請・届出の受付と審査、差戻し、許可台帳と許可証、聴聞・弁明の事務、処分の公表、監視指導計画の取りまとめを行う。
    extsystem__FoodSanitationSystem[["食品衛生申請等システム（厚生労働省）"]]:::extsystem
  end
  subgraph layer_boundary["システム境界"]
    usecase__PayPermitFee("許可申請手数料の納付"):::usecase
    %% desc usecase__PayPermitFee: 営業者が条例の手数料を保健所に納める（電子申請でも別途納付）。納めた手数料は還付されない。
    usecase__ReceiveOnlineApplication("電子申請の受付"):::usecase
    %% desc usecase__ReceiveOnlineApplication: 食品衛生申請等システムで提出された新規の許可申請を、管轄の保健所の確認待ち（申請内容確認待）として受け付ける。
    usecase__ResubmitApplication("補正した申請の再提出"):::usecase
    %% desc usecase__ResubmitApplication: 営業者が差戻しを受けて申請を直し、再び確認待にする。
    usecase__ReturnApplication("差戻し（補正の求め）"):::usecase
    %% desc usecase__ReturnApplication: 記載の誤りや添付書類の不足があれば、期間を定めて補正を求め、申請を差し戻す。電子申請では申請者の依頼による差戻しもある。
    usecase__ReviewApplication("申請内容の確認と受理"):::usecase
    %% desc usecase__ReviewApplication: 許可担当が記載事項（営業者・施設・営業の種類・食品衛生責任者・図面・欠格事由の有無）と手数料の納付を確かめ、施設検査に進める（検査待）。
    usecase__SubmitCounterApplication("許可申請書の提出（窓口）"):::usecase
    %% desc usecase__SubmitCounterApplication: 営業者が許可申請書（新規）に図面と食品衛生責任者の資格を証する書類を添えて、保健所の窓口に出す。
    usecase__WithdrawApplication("申請の取下げ"):::usecase
    %% desc usecase__WithdrawApplication: 営業者が許可・不許可の前に申請を取り下げる。電子申請は保健所の差戻しを受けてから取り下げる。手数料は戻らない。
    screen__ApplicationReviewScreen["申請審査画面"]:::screen
    screen__ApplicationScreen["許可申請受付画面"]:::screen
    event__EvApplicationReturned>"申請の差戻し"]:::event
    event__EvOnlineApplicationSubmitted>"電子申請の提出（整理番号 LIC）"]:::event
  end
  subgraph layer_system["システム"]
    entity__FeeSchedule[("手数料表")]:::entity
    entity__PermitApplication[("営業許可申請")]:::entity
    state__PermitApplication_awaiting_inspection((("検査待"))):::state
    state__PermitApplication_returned((("差戻し・補正中"))):::state
    state__PermitApplication_submitted((("申請内容確認待"))):::state
    state__PermitApplication_withdrawn((("取下げ"))):::state
    condition__BeforeReview{"申請が確認待か差戻し中である"}:::condition
    condition__CounterApplication{"窓口（紙）で出した申請である"}:::condition
    condition__FeePaid{"手数料が納められている"}:::condition
  end
  actor__BusinessOperator -.-> usecase__PayPermitFee
  actor__BusinessOperator -.-> usecase__ResubmitApplication
  actor__BusinessOperator -.-> usecase__SubmitCounterApplication
  actor__BusinessOperator -.-> usecase__WithdrawApplication
  actor__PermitClerk -.-> usecase__ReceiveOnlineApplication
  actor__PermitClerk -.-> usecase__ResubmitApplication
  %% derived actor__PermitClerk -> usecase__ResubmitApplication via step__ReturnStep
  actor__PermitClerk -.-> usecase__ReturnApplication
  actor__PermitClerk -.-> usecase__ReviewApplication
  condition__BeforeReview -.->|applies_to| usecase__PayPermitFee
  condition__CounterApplication -.->|when| usecase__WithdrawApplication
  %% derived condition__CounterApplication -> usecase__WithdrawApplication via transitions PermitApplication.status submitted->withdrawn, transitions PermitApplication.status awaiting_inspection->withdrawn
  condition__FeePaid -.->|applies_to| usecase__ReviewApplication
  event__EvApplicationReturned -.-> extsystem__FoodSanitationSystem
  event__EvOnlineApplicationSubmitted -.-> usecase__ReceiveOnlineApplication
  extsystem__FoodSanitationSystem -.-> event__EvOnlineApplicationSubmitted
  usecase__PayPermitFee -.-> screen__ApplicationScreen
  usecase__PayPermitFee -.->|reads| entity__FeeSchedule
  %% derived usecase__PayPermitFee -> entity__FeeSchedule via api__FeePaymentApi
  usecase__PayPermitFee -.->|updates| entity__PermitApplication
  %% derived usecase__PayPermitFee -> entity__PermitApplication via api__FeePaymentApi
  usecase__ReceiveOnlineApplication -.->|creates| entity__PermitApplication
  %% derived usecase__ReceiveOnlineApplication -> entity__PermitApplication via api__ApplicationIntakeApi
  usecase__ReceiveOnlineApplication -.-> screen__ApplicationScreen
  usecase__ResubmitApplication -.-> screen__ApplicationScreen
  usecase__ResubmitApplication -.->|transitions PermitApplication.status returned->submitted| state__PermitApplication_submitted
  usecase__ResubmitApplication -.->|updates| entity__PermitApplication
  %% derived usecase__ResubmitApplication -> entity__PermitApplication via api__ApplicationAmendApi
  usecase__ReturnApplication -.-> screen__ApplicationReviewScreen
  usecase__ReturnApplication -.-> event__EvApplicationReturned
  usecase__ReturnApplication -.->|transitions PermitApplication.status awaiting_inspection->returned| state__PermitApplication_returned
  usecase__ReturnApplication -.->|transitions PermitApplication.status submitted->returned| state__PermitApplication_returned
  usecase__ReturnApplication -.->|updates| entity__PermitApplication
  %% derived usecase__ReturnApplication -> entity__PermitApplication via api__ApplicationReviewApi
  usecase__ReviewApplication -.-> screen__ApplicationReviewScreen
  usecase__ReviewApplication -.->|transitions PermitApplication.status submitted->awaiting_inspection| state__PermitApplication_awaiting_inspection
  usecase__ReviewApplication -.->|updates| entity__PermitApplication
  %% derived usecase__ReviewApplication -> entity__PermitApplication via api__ApplicationReviewApi
  usecase__SubmitCounterApplication -.->|creates| entity__PermitApplication
  %% derived usecase__SubmitCounterApplication -> entity__PermitApplication via api__ApplicationIntakeApi
  usecase__SubmitCounterApplication -.-> screen__ApplicationScreen
  usecase__WithdrawApplication -.-> screen__ApplicationScreen
  usecase__WithdrawApplication -.->|transitions PermitApplication.status awaiting_inspection->withdrawn| state__PermitApplication_withdrawn
  usecase__WithdrawApplication -.->|transitions PermitApplication.status returned->withdrawn| state__PermitApplication_withdrawn
  usecase__WithdrawApplication -.->|transitions PermitApplication.status submitted->withdrawn| state__PermitApplication_withdrawn
  usecase__WithdrawApplication -.->|updates| entity__PermitApplication
  %% derived usecase__WithdrawApplication -> entity__PermitApplication via api__ApplicationAmendApi
  classDef actor fill:#ffe3e3,stroke:#c92a2a,color:#000;
  classDef extsystem fill:#e9ecef,stroke:#495057,color:#000;
  classDef usecase fill:#d0ebff,stroke:#1864ab,color:#000;
  classDef screen fill:#e5dbff,stroke:#5f3dc4,color:#000;
  classDef event fill:#ffdeeb,stroke:#a61e4d,color:#000;
  classDef entity fill:#fff9db,stroke:#5c940d,color:#000;
  classDef state fill:#f8f9fa,stroke:#5c940d,color:#000;
  classDef condition fill:#f3d9fa,stroke:#862e9c,color:#000;
