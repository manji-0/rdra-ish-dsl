%% rdra-ish diagram=usecase scope=buc:BucDisposition model=samples/food-permit-ops
%% layers: value=システム価値 environment=システム外部環境 boundary=システム境界 system=システム
%% kinds: actor timer usecase screen event entity state condition
%% omitted: buc step medium permission field api
flowchart LR
  subgraph layer_value["システム価値"]
    actor__FoodSanitationInspector(["食品衛生監視員"]):::actor
    %% desc actor__FoodSanitationInspector: 事前相談で図面を見て営業の種類を判定し、許可前と更新前の施設検査、計画に沿った立入検査を行い、違反を見つけたら処分を起案する。
    actor__PermitAuthority(["都道府県知事等（保健所設置市長・特別区長）"]):::actor
    %% desc actor__PermitAuthority: 許可・不許可と、整備改善命令・営業停止・許可取消の処分を決める行政庁。
    actor__PermitClerk(["保健所 許可担当職員"]):::actor
    %% desc actor__PermitClerk: 許可申請・届出の受付と審査、差戻し、許可台帳と許可証、聴聞・弁明の事務、処分の公表、監視指導計画の取りまとめを行う。
  end
  subgraph layer_environment["システム外部環境"]
    timer__AppealPeriodEnd(("審査請求期間の経過（処分を知った日の翌日から3月）")):::timer
    timer__PublicationPeriodEnd(("公表期間の経過（7日間以上）")):::timer
    timer__SuspensionTermEnd(("営業停止期間の満了（処分で定めた期間）")):::timer
  end
  subgraph layer_boundary["システム境界"]
    usecase__DecideRevocation("許可の取消の決定"):::usecase
    %% desc usecase__DecideRevocation: 聴聞を経て許可を取り消すと決める。理由を示し、審査請求ができることを書面で教える。営業者は取消から2年は新たな許可を受けられないことがある。
    usecase__DecideSuspension("営業停止の決定"):::usecase
    %% desc usecase__DecideSuspension: 弁明の機会を経て、期間を定めて営業を停止すると決める。理由を示し、審査請求ができることを書面で教える。
    usecase__DropDisposition("処分を見送る"):::usecase
    %% desc usecase__DropDisposition: 意見陳述の結果、処分しないと決める。
    usecase__EndPublication("公表の終了"):::usecase
    %% desc usecase__EndPublication: 公表期間（処分の翌日から7日以上）が過ぎたら公表をやめる。
    usecase__FinalizeDisposition("審査請求期間の経過"):::usecase
    %% desc usecase__FinalizeDisposition: 審査請求のないまま3月が過ぎたことを記録する。審査請求と訴訟の中身は対象外。
    usecase__HoldHearing("聴聞の実施"):::usecase
    %% desc usecase__HoldHearing: 聴聞の期日に名あて人の意見を聴き、記録する。取消の前には必ず行う。
    usecase__LiftSuspension("営業停止期間の満了"):::usecase
    %% desc usecase__LiftSuspension: 停止の期間が過ぎ、営業停止を終える。営業者は許可証を掲示して営業を再開できる。
    usecase__NotifyOpinionProcedure("聴聞・弁明の通知"):::usecase
    %% desc usecase__NotifyOpinionProcedure: 予定する処分の内容と根拠条項、原因となる事実、聴聞の期日または弁明書の提出期限を、名あて人に書面で通知する。
    usecase__OrderImprovement("施設の整備改善命令"):::usecase
    %% desc usecase__OrderImprovement: 施設基準に合わない設備の改善を命じる。計測などで確かめた不充足なら意見陳述を省いて命じられる。
    usecase__ProposeDisposition("処分の起案"):::usecase
    %% desc usecase__ProposeDisposition: 食品衛生監視員が違反の事実と処分基準から、処分の種類（整備改善命令・停止・取消）と意見陳述の手続（聴聞・弁明・省略）を起案する。
    usecase__PublishViolation("違反の公表"):::usecase
    %% desc usecase__PublishViolation: 処分を受けた営業者の名称、施設、処分の理由と内容をホームページと掲示場で公表する。
    usecase__ReceiveExplanation("弁明書の受理"):::usecase
    %% desc usecase__ReceiveExplanation: 停止や整備改善命令の前に、名あて人の弁明書を受け取る。期限までに出なければ、弁明の機会を与えたものとして手続を終える。
    usecase__RevokePermit("許可台帳への取消の記録"):::usecase
    %% desc usecase__RevokePermit: 取消の決定を台帳に記録し、許可を終わらせる。営業者は営業をやめる。
    usecase__SuspendBusiness("許可台帳への営業停止の記録"):::usecase
    %% desc usecase__SuspendBusiness: 停止の決定を台帳に記録する。営業者は停止の期間、営業をやめる。
    screen__DispositionScreen["不利益処分画面"]:::screen
    screen__OpinionProcedureScreen["聴聞・弁明画面"]:::screen
    screen__PermitLedgerScreen["許可台帳画面"]:::screen
    event__EvDispositionDecided>"不利益処分の決定"]:::event
    event__EvRevocationDecided>"許可の取消の決定"]:::event
    event__EvSuspensionDecided>"営業停止の決定"]:::event
    event__EvViolationFound>"立入検査での違反の発見"]:::event
  end
  subgraph layer_system["システム"]
    entity__BusinessPermit[("営業許可")]:::entity
    entity__Disposition[("不利益処分")]:::entity
    state__BusinessPermit_revoked((("取消"))):::state
    state__BusinessPermit_suspended((("営業停止中"))):::state
    state__BusinessPermit_valid((("有効"))):::state
    state__Disposition_publication_ended((("公表終了"))):::state
    state__Disposition_publication_excluded((("公表対象外"))):::state
    state__Disposition_publication_published((("公表中"))):::state
    state__Disposition_publication_unpublished((("未公表"))):::state
    state__Disposition_status_decided((("処分決定"))):::state
    state__Disposition_status_dropped((("処分しない"))):::state
    state__Disposition_status_finalized((("確定（審査請求期間の経過）"))):::state
    state__Disposition_status_heard((("意見陳述の手続終了"))):::state
    state__Disposition_status_notified((("意見陳述の通知済"))):::state
    state__Disposition_status_proposed((("処分案"))):::state
    condition__DispositionDecided{"処分が決定している"}:::condition
    condition__ExplanationProcedure{"弁明の機会を与える処分である"}:::condition
    condition__HearingProcedure{"聴聞を執る処分である"}:::condition
    condition__ImprovementOrderKind{"施設の整備改善命令である"}:::condition
    condition__NotRevocation{"取消ではない処分である"}:::condition
    condition__OpinionOmitted{"意見陳述を省く処分である"}:::condition
    condition__OpinionRequired{"意見陳述の手続を執る処分である"}:::condition
    condition__RevocationKind{"許可の取消である"}:::condition
    condition__SuspensionKind{"営業の停止である"}:::condition
  end
  actor__FoodSanitationInspector -.-> usecase__ProposeDisposition
  actor__PermitAuthority -.-> usecase__DecideRevocation
  actor__PermitAuthority -.-> usecase__DecideSuspension
  actor__PermitAuthority -.-> usecase__DropDisposition
  actor__PermitAuthority -.-> usecase__OrderImprovement
  actor__PermitClerk -.-> usecase__HoldHearing
  actor__PermitClerk -.-> usecase__NotifyOpinionProcedure
  actor__PermitClerk -.-> usecase__PublishViolation
  actor__PermitClerk -.-> usecase__ReceiveExplanation
