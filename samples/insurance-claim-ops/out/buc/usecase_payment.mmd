  usecase__DecideClaim -.->|transitions Claim.status completed->decided_payment| state__Claim_status_decided_payment
  usecase__DecideClaim -.->|updates| entity__Claim
  %% derived usecase__DecideClaim -> entity__Claim via api__DecisionApi
