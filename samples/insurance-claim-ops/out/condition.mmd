%% rdra-ish diagram=condition scope=whole model=samples/insurance-claim-ops
%% kinds: condition statemodel variation value usecase
%% omitted: (none)
flowchart LR
  condition__BothConsented{"被保険者と被害者がともに同意している"}:::condition
  %% holds condition__BothConsented: Settlement.insured_consent == true, Settlement.victim_consent == true
  condition__CaseInvestigating{"事故案件を調査しているか、損害を確定した"}:::condition
  %% holds condition__CaseInvestigating: ClaimCase.status in (調査中, 示談交渉中, 損害確定)
  condition__ClaimBeforeDecision{"請求書類の提出から決裁の前である"}:::condition
  %% holds condition__ClaimBeforeDecision: Claim.status in (請求書類の提出, 請求完了)
  condition__ClaimGuided{"請求の案内をした段階である"}:::condition
  %% holds condition__ClaimGuided: Claim.status == 請求の案内済
  condition__ClaimPaid{"保険金を支払った請求で、まだ求償していない"}:::condition
  %% holds condition__ClaimPaid: (Claim.status == 支払済).none(Subrogation)
  condition__ClaimUnderConfirmation{"請求完了の後、支払・不払を決める前である"}:::condition
  %% holds condition__ClaimUnderConfirmation: Claim.status == 請求完了
  condition__ComplaintOpen{"苦情を受け付けて解決していない"}:::condition
  %% holds condition__ComplaintOpen: Complaint.status == 苦情受付
  condition__ConsentPending{"示談代行の同意を確かめている"}:::condition
  %% holds condition__ConsentPending: Settlement.status == 同意の確認中
  condition__DenialDecided{"不払いを決めた"}:::condition
  %% holds condition__DenialDecided: Claim.status == 不払決定
  condition__FirstPartyCoverage{"車両・人身傷害の事故である"}:::condition
  %% holds condition__FirstPartyCoverage: ClaimCase.coverage in (車両, 人身傷害)
  condition__FraudSuspected{"不正請求の疑いがある"}:::condition
  %% holds condition__FraudSuspected: Claim.fraud_suspected == true
  condition__GradeExplained{"等級の変動を説明して請求の意思を確かめた"}:::condition
  %% holds condition__GradeExplained: Claim.grade_explained == true
  condition__InjuryCoverage{"対人賠償・人身傷害の事故である"}:::condition
  %% holds condition__InjuryCoverage: ClaimCase.coverage in (対人賠償, 人身傷害)
  condition__InvestigationReported{"損害調査の報告がある"}:::condition
  %% holds condition__InvestigationReported: Investigation.status == 調査報告済
  condition__LiabilityDetermined{"賠償責任の有無を判断している"}:::condition
  %% holds condition__LiabilityDetermined: ClaimCase.liability in (賠償責任あり, 過失ゼロ（賠償責任なし）)
  condition__NoFraudSuspicion{"不正請求の疑いがない"}:::condition
  %% holds condition__NoFraudSuspicion: Claim.fraud_suspected == false
  condition__NotPaidYet{"支払済みの案件は再度支払わない"}:::condition
  %% holds condition__NotPaidYet: (Claim.status == 支払決定).none(Payment)
  condition__OrdinaryProposal{"特別調停案ではない和解案である"}:::condition
  %% holds condition__OrdinaryProposal: Complaint.proposal == 和解案
  condition__ReasonExplained{"不払いの理由を説明した"}:::condition
  %% holds condition__ReasonExplained: Claim.reason_explained == true
  condition__RepairApproved{"修理着工を承認した"}:::condition
  %% holds condition__RepairApproved: RepairEstimate.approved == true
  condition__RepairCostAgreed{"修理費を協定した"}:::condition
  %% holds condition__RepairCostAgreed: RepairEstimate.status == 修理費の協定
  condition__RepairCoverage{"車両・対物賠償の事故である"}:::condition
  %% holds condition__RepairCoverage: ClaimCase.coverage in (車両, 対物賠償)
  condition__SettlementConcluded{"示談が成立したか、示談代行を終えた"}:::condition
  %% holds condition__SettlementConcluded: Settlement.status in (示談成立, 不調（調停・訴訟へ）, 示談代行を行わない)
  condition__SettlementEligible{"対人・対物賠償の事故で、被保険者に賠償責任がある"}:::condition
  %% holds condition__SettlementEligible: ClaimCase.coverage in (対人賠償, 対物賠償), ClaimCase.liability == 賠償責任あり
  statemodel__ClaimCase_liability[["ClaimCase.liability"]]:::statemodel
  statemodel__ClaimCase_status[["ClaimCase.status"]]:::statemodel
  statemodel__Claim_status[["Claim.status"]]:::statemodel
  statemodel__Complaint_status[["Complaint.status"]]:::statemodel
  statemodel__Investigation_status[["Investigation.status"]]:::statemodel
  statemodel__RepairEstimate_status[["RepairEstimate.status"]]:::statemodel
  statemodel__Settlement_status[["Settlement.status"]]:::statemodel
  subgraph variation__AdrProposal["和解案の種類"]
    variation__AdrProposal__ordinary["和解案"]:::value
    variation__AdrProposal__special["特別調停案"]:::value
  end
  subgraph variation__Coverage["担保種目"]
    variation__Coverage__bodily_liability["対人賠償"]:::value
    variation__Coverage__property_liability["対物賠償"]:::value
    variation__Coverage__vehicle["車両"]:::value
    variation__Coverage__personal_injury["人身傷害"]:::value
  end
  subgraph variation__ExtensionReason["支払期限の延長事由"]
    variation__ExtensionReason__disaster_area["災害救助法の被災地域での調査（60日）"]:::value
    variation__ExtensionReason__expert_inquiry["医療機関・専門機関の診断・鑑定の照会（90日）"]:::value
    variation__ExtensionReason__disability_inquiry["後遺障害の診断・認定審査の照会（120日）"]:::value
    variation__ExtensionReason__public_inquiry["警察・検察・消防等の捜査・調査結果の照会（180日）"]:::value
    variation__ExtensionReason__overseas["日本国外での調査（180日）"]:::value
  end
  subgraph variation__Payee["支払先"]
    variation__Payee__insured["被保険者・保険金請求権者"]:::value
    variation__Payee__victim["被害者（直接請求・一括払い）"]:::value
    variation__Payee__repair_shop["修理工場（直接支払）"]:::value
  end
  subgraph variation__SurveyMethod["損害調査の手法"]
    variation__SurveyMethod__documents["書類・写真による確認"]:::value
    variation__SurveyMethod__site_visit["事故現場の実地調査"]:::value
    variation__SurveyMethod__expert["専門家の見解の確認"]:::value
  end
  usecase__ApproveRepairStart("修理着工の承認"):::usecase
  %% desc usecase__ApproveRepairStart: 協定した修理費で修理に着工することを、保険会社が承認する。
  usecase__AssessDamage("損害の確定"):::usecase
  %% desc usecase__AssessDamage: 調査の報告を受けて損害を確定する。賠償の事故では過失を判断した後に、示談代行をしたときは示談の成立か終了の後に確定する。
  usecase__BeginNegotiation("示談交渉の開始"):::usecase
  %% desc usecase__BeginNegotiation: 双方の同意を得て、保険会社が加害者の窓口として被害者と交渉を始める。
  usecase__CloseCase("事故案件の完了"):::usecase
  %% desc usecase__CloseCase: 請求の支払・不払の通知・取下げを受けて、事故案件を完了にする。過失の判断が残っていれば先に済ませる。
  usecase__ConfirmClaimIntent("等級の変動の説明と請求意思の確認"):::usecase
  %% desc usecase__ConfirmClaimIntent: 保険金を請求すると次の契約の等級が下がる（3等級ダウン事故は1件につき3等級）ことを説明し、それでも請求するかを確かめる。
  usecase__DecideClaim("支払・不払の決裁"):::usecase
  %% desc usecase__DecideClaim: 支払決裁者が調査の結果と請求書類から、保険金を支払うか、免責・解除などで支払わないかを決める。
  usecase__DecideSuspectedClaim("疑義事案の支払・不払の決裁"):::usecase
  %% desc usecase__DecideSuspectedClaim: 不正請求の疑いがある請求を、上位の決裁者（不正請求への対応を専門とする担当）が決める。
  usecase__DetermineFault("過失割合と賠償責任の判断"):::usecase
  %% desc usecase__DetermineFault: 過去の裁判例を基準に過失割合を検討し、被保険者に法律上の損害賠償責任があるか、過失ゼロかを判断する。
  usecase__ExplainDenialReason("不払いの理由の説明"):::usecase
  %% desc usecase__ExplainDenialReason: 支払わない根拠となる約款の条項と、調査で確かめた事実を、契約者等と被害者に説明する。
  usecase__ExtendPaymentPeriod("支払期限の延長と通知"):::usecase
  %% desc usecase__ExtendPaymentPeriod: 特別な照会または調査が欠かせないとき、延長事由（被災地の調査60日、鑑定等の照会90日、後遺障害の照会120日、警察等の照会180日、国外の調査180日）を選び、確認する事項と終える時期を請求者に通知する。
  usecase__FlagSuspectedFraud("不正請求の疑いの登録"):::usecase
  %% desc usecase__FlagSuspectedFraud: 事故状況・因果関係・修理や治療の内容に不自然な点があるか、他社での事故受付が分かったとき、請求を疑義事案として登録し、深く調べる。
  usecase__GuideToAdr("相談機関の案内"):::usecase
  %% desc usecase__GuideToAdr: 了解が得られない申出人に、そんぽADRセンターなどの相談機関を案内する。
  usecase__NotifyDenial("不払いの通知"):::usecase
  %% desc usecase__NotifyDenial: 理由を説明したうえで、支払わないことを書面で通知する。了解が得られなければ、そんぽADRセンターなどの相談機関を案内する。
  usecase__OpenSettlement("示談代行の開始"):::usecase
  %% desc usecase__OpenSettlement: 対人・対物賠償の事故で、被保険者に賠償責任があると判断した案件について、示談代行の手続を開き、契約者と被害者の同意を確かめにいく。
  usecase__PayClaim("保険金の支払"):::usecase
  %% desc usecase__PayClaim: 支払金額と内訳（主たる保険金と特約・費用保険金）、算定の理由を説明して、被保険者・被害者・修理工場に払う。期限を過ぎていれば遅延利息を加える。
  usecase__RecordInsuredConsent("被保険者の同意"):::usecase
  %% desc usecase__RecordInsuredConsent: 被保険者が保険会社の解決条件に同意し、保険会社が被保険者のために示談交渉をすることに同意する。
  usecase__RecordVictimConsent("被害者の同意"):::usecase
  %% desc usecase__RecordVictimConsent: 被害者が加害者側の保険会社と直接折衝することに同意する。
  usecase__RejectProposal("和解案を受諾しない"):::usecase
  %% desc usecase__RejectProposal: 特別調停案でない和解案を受け入れないと回答する。特別調停案は受諾しなければならない。
  usecase__SendJibaisekiSurvey("自賠責損害調査の依頼"):::usecase
  %% desc usecase__SendJibaisekiSurvey: 一括払いに同意を得た人身の事故について、自賠責の請求書類を確かめて損保料率機構の自賠責損害調査事務所に送る。
  usecase__StartRepair("修理の着工"):::usecase
  %% desc usecase__StartRepair: 修理工場が保険会社の承認を受けて修理に着工する。
  usecase__StartSubrogation("求償の開始"):::usecase
  %% desc usecase__StartSubrogation: 保険金を払った請求について、被保険者から移った損害賠償請求権の額（払った額と被保険者の債権のいずれか少ない額）を確かめ、相手方への求償を始める。
  usecase__SubmitClaim("請求書類の提出"):::usecase
  %% desc usecase__SubmitClaim: 請求者が保険会社の求める請求書類を出す。賠償の保険金では、示談書と、賠償金を払ったか被害者が承諾したことを示す書類を添える。
  usecase__SubmitRepairEstimate("修理見積の提出"):::usecase
  %% desc usecase__SubmitRepairEstimate: 修理工場が損害車両の修理見積書と写真を保険会社に出す。
  condition__BothConsented -.->|applies_to| usecase__BeginNegotiation
  condition__CaseInvestigating -.->|applies_to| usecase__DetermineFault
  condition__CaseInvestigating -.-> statemodel__ClaimCase_status
  %% derived condition__CaseInvestigating -> statemodel__ClaimCase_status from holds
  condition__ClaimBeforeDecision -.->|applies_to| usecase__FlagSuspectedFraud
  condition__ClaimBeforeDecision -.-> statemodel__Claim_status
  %% derived condition__ClaimBeforeDecision -> statemodel__Claim_status from holds
  condition__ClaimGuided -.->|applies_to| usecase__ConfirmClaimIntent
  condition__ClaimGuided -.-> statemodel__Claim_status
  %% derived condition__ClaimGuided -> statemodel__Claim_status from holds
  condition__ClaimPaid -.->|applies_to| usecase__StartSubrogation
  condition__ClaimPaid -.-> statemodel__Claim_status
  %% derived condition__ClaimPaid -> statemodel__Claim_status from holds
  condition__ClaimUnderConfirmation -.->|applies_to| usecase__ExtendPaymentPeriod
  condition__ClaimUnderConfirmation -.-> statemodel__Claim_status
  %% derived condition__ClaimUnderConfirmation -> statemodel__Claim_status from holds
  condition__ComplaintOpen -.->|applies_to| usecase__GuideToAdr
  condition__ComplaintOpen -.-> statemodel__Complaint_status
  %% derived condition__ComplaintOpen -> statemodel__Complaint_status from holds
  condition__ConsentPending -.->|applies_to| usecase__RecordInsuredConsent
  condition__ConsentPending -.->|applies_to| usecase__RecordVictimConsent
  condition__ConsentPending -.-> statemodel__Settlement_status
  %% derived condition__ConsentPending -> statemodel__Settlement_status from holds
  condition__DenialDecided -.->|applies_to| usecase__ExplainDenialReason
  condition__DenialDecided -.-> statemodel__Claim_status
  %% derived condition__DenialDecided -> statemodel__Claim_status from holds
  condition__FirstPartyCoverage -.-> statemodel__ClaimCase_status
  %% derived condition__FirstPartyCoverage -> statemodel__ClaimCase_status from when
  condition__FirstPartyCoverage -.-> variation__Coverage
  %% derived condition__FirstPartyCoverage -> variation__Coverage from holds
  condition__FirstPartyCoverage -.->|when| usecase__AssessDamage
  %% derived condition__FirstPartyCoverage -> usecase__AssessDamage via transitions ClaimCase.status investigating->assessed
  condition__FraudSuspected -.->|applies_to| usecase__DecideSuspectedClaim
  condition__GradeExplained -.->|applies_to| usecase__SubmitClaim
  condition__InjuryCoverage -.->|applies_to| usecase__SendJibaisekiSurvey
  condition__InjuryCoverage -.-> variation__Coverage
  %% derived condition__InjuryCoverage -> variation__Coverage from holds
  condition__InvestigationReported -.->|applies_to| usecase__AssessDamage
  condition__InvestigationReported -.-> statemodel__Investigation_status
  %% derived condition__InvestigationReported -> statemodel__Investigation_status from holds
  condition__LiabilityDetermined -.->|applies_to| usecase__CloseCase
  condition__LiabilityDetermined -.-> statemodel__ClaimCase_liability
  %% derived condition__LiabilityDetermined -> statemodel__ClaimCase_liability from holds
  condition__LiabilityDetermined -.-> statemodel__ClaimCase_status
  %% derived condition__LiabilityDetermined -> statemodel__ClaimCase_status from when
  condition__LiabilityDetermined -.->|when| usecase__AssessDamage
  %% derived condition__LiabilityDetermined -> usecase__AssessDamage via transitions ClaimCase.status investigating->assessed
  condition__NoFraudSuspicion -.->|applies_to| usecase__DecideClaim
  condition__NotPaidYet -.->|applies_to| usecase__PayClaim
  condition__NotPaidYet -.-> statemodel__Claim_status
  %% derived condition__NotPaidYet -> statemodel__Claim_status from holds
  condition__OrdinaryProposal -.->|applies_to| usecase__RejectProposal
  condition__OrdinaryProposal -.-> variation__AdrProposal
  %% derived condition__OrdinaryProposal -> variation__AdrProposal from holds
  condition__ReasonExplained -.->|applies_to| usecase__NotifyDenial
  condition__RepairApproved -.->|applies_to| usecase__StartRepair
  condition__RepairCostAgreed -.->|applies_to| usecase__ApproveRepairStart
  condition__RepairCostAgreed -.-> statemodel__RepairEstimate_status
  %% derived condition__RepairCostAgreed -> statemodel__RepairEstimate_status from holds
  condition__RepairCoverage -.->|applies_to| usecase__SubmitRepairEstimate
  condition__RepairCoverage -.-> variation__Coverage
  %% derived condition__RepairCoverage -> variation__Coverage from holds
  condition__SettlementConcluded -.-> statemodel__ClaimCase_status
  %% derived condition__SettlementConcluded -> statemodel__ClaimCase_status from when
  condition__SettlementConcluded -.-> statemodel__Settlement_status
  %% derived condition__SettlementConcluded -> statemodel__Settlement_status from holds
  condition__SettlementConcluded -.->|when| usecase__AssessDamage
  %% derived condition__SettlementConcluded -> usecase__AssessDamage via transitions ClaimCase.status negotiating->assessed
  condition__SettlementEligible -.->|applies_to| usecase__OpenSettlement
  condition__SettlementEligible -.-> statemodel__ClaimCase_liability
  %% derived condition__SettlementEligible -> statemodel__ClaimCase_liability from holds
  condition__SettlementEligible -.-> variation__Coverage
  %% derived condition__SettlementEligible -> variation__Coverage from holds
  classDef condition fill:#f3d9fa,stroke:#862e9c,color:#000;
