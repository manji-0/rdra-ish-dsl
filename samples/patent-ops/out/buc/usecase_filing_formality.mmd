  usecase__DeemPriorityBaseWithdrawn -.->|transitions PatentApplication.status filed->priority_withdrawn| state__PatentApplication_priority_withdrawn
  usecase__DeemPriorityBaseWithdrawn -.->|updates| entity__PatentApplication
  %% derived usecase__DeemPriorityBaseWithdrawn -> entity__PatentApplication via api__PriorityBaseApi
  usecase__FileApplication -.->|creates| entity__PatentApplication
  %% derived usecase__FileApplication -> entity__PatentApplication via api__FilingApi
  usecase__FileApplication -.-> screen__FilingScreen
  usecase__FileApplication -.-> event__EvApplicationFiled
  usecase__FileApplication -.->|reads| entity__DraftingOrder
  %% derived usecase__FileApplication -> entity__DraftingOrder via api__FilingApi
  usecase__FileApplication -.->|reads| entity__FeeSchedule
  %% derived usecase__FileApplication -> entity__FeeSchedule via api__FilingApi
