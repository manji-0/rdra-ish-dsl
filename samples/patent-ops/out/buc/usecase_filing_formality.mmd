  usecase__RecordFilingReceipt -.->|transitions DraftingOrder.status approved->filed| state__DraftingOrder_filed
  usecase__RecordFilingReceipt -.->|updates| entity__DraftingOrder
  usecase__RecordPublication -.-> screen__ApplicationDocketScreen
  usecase__RecordPublication -.->|updates| entity__PatentApplication
  %% derived usecase__RecordPublication -> entity__PatentApplication via api__ApplicationDocketApi
  usecase__SubmitFormalityAmendment -.-> screen__ApplicationDocketScreen
  usecase__SubmitFormalityAmendment -.-> event__EvFormalityAmendmentFiled
  usecase__SubmitFormalityAmendment -.->|transitions PatentApplication.status formality_order->filed| state__PatentApplication_filed
  usecase__SubmitFormalityAmendment -.->|updates| entity__PatentApplication
