%% rdra-ish diagram=condition scope=buc:BucOfficeAction model=samples/patent-ops
%% kinds: condition statemodel variation value usecase
%% omitted: (none)
flowchart LR
  condition__DivisionPossible{"分割できる時期である"}:::condition
  %% holds condition__DivisionPossible: PatentApplication.status in (出願済（方式審査）, 審査請求済（審査中）, 特許査定, 拒絶査定)
  condition__ExaminationOver{"出願の審査が終わっている"}:::condition
  %% holds condition__ExaminationOver: PatentApplication.status not in (出願済（方式審査）, 手続補正指令への対応中, 審査請求済（審査中）)
  condition__FirstNoticeOnly{"最初の拒絶理由通知である"}:::condition
  %% holds condition__FirstNoticeOnly: OfficeAction.kind == 最初
  condition__NotExtendedWithinTerm{"期間内に延長していない"}:::condition
  %% holds condition__NotExtendedWithinTerm: OfficeAction.extended == false
  condition__UnderExamination{"出願が審査中である"}:::condition
  %% holds condition__UnderExamination: PatentApplication.status == 審査請求済（審査中）
  condition__WithinTermNotExtended{"応答期間内で、まだ延長していない"}:::condition
  %% holds condition__WithinTermNotExtended: OfficeAction.status == 応答期間中, OfficeAction.extended == false, OfficeAction.late_extended == false
  statemodel__OfficeAction_status[["OfficeAction.status"]]:::statemodel
  statemodel__PatentApplication_status[["PatentApplication.status"]]:::statemodel
  subgraph variation__AmendmentScope["補正の範囲"]
    variation__AmendmentScope__limited["意見書のみ、または削除・減縮・誤記の訂正・釈明に限る補正"]:::value
    variation__AmendmentScope__free["限定のない補正"]:::value
  end
  usecase__CloseOfficeActionDocket("中間処理案件の終了"):::usecase
  %% desc usecase__CloseOfficeActionDocket: 査定・取下げで出願の審査が終わった後、応答済の拒絶理由通知の案件を閉じる。
  usecase__DraftResponse("意見書・補正書案の作成"):::usecase
  %% desc usecase__DraftResponse: 弁理士が意見書と、必要なら補正書の案を作る。補正の範囲は、限定のない補正か、請求項の削除・減縮・誤記の訂正・釈明に限った補正（または意見書だけ）かを選ぶ。最後の拒絶理由通知には限った補正だけが使える。
  usecase__FileDivisionalApplication("分割出願"):::usecase
  %% desc usecase__FileDivisionalApplication: 補正できる時期、特許査定の謄本から30日、最初の拒絶査定の謄本から3月の間に、出願の一部を新たな出願にする。
  usecase__ReceiveOfficeAction("拒絶理由通知の受領"):::usecase
  %% desc usecase__ReceiveOfficeAction: 拒絶理由通知書を受け取り、応答期間の管理を始める。
  usecase__RequestLateExtension("期間経過後の延長請求"):::usecase
  %% desc usecase__RequestLateExtension: 応答期間の経過後2か月以内に延長を請求し、2か月の応答期間を得る。
  usecase__RequestTermExtension("応答期間の延長請求"):::usecase
  %% desc usecase__RequestTermExtension: 応答期間内に期間延長請求書を出し、2か月延長する。
  condition__DivisionPossible -.->|applies_to| usecase__FileDivisionalApplication
  condition__DivisionPossible -.-> statemodel__PatentApplication_status
  %% derived condition__DivisionPossible -> statemodel__PatentApplication_status from holds
  condition__ExaminationOver -.->|applies_to| usecase__CloseOfficeActionDocket
  condition__ExaminationOver -.-> statemodel__PatentApplication_status
  %% derived condition__ExaminationOver -> statemodel__PatentApplication_status from holds
  condition__FirstNoticeOnly -.-> variation__AmendmentScope
  %% derived condition__FirstNoticeOnly -> variation__AmendmentScope from when
  condition__FirstNoticeOnly -.->|when| usecase__DraftResponse
  %% derived condition__FirstNoticeOnly -> usecase__DraftResponse via chooses OfficeAction.amendment free
  condition__NotExtendedWithinTerm -.->|applies_to| usecase__RequestLateExtension
  condition__UnderExamination -.->|applies_to| usecase__ReceiveOfficeAction
  condition__UnderExamination -.-> statemodel__PatentApplication_status
  %% derived condition__UnderExamination -> statemodel__PatentApplication_status from holds
  condition__WithinTermNotExtended -.->|applies_to| usecase__RequestTermExtension
  condition__WithinTermNotExtended -.-> statemodel__OfficeAction_status
  %% derived condition__WithinTermNotExtended -> statemodel__OfficeAction_status from holds
  classDef condition fill:#f3d9fa,stroke:#862e9c,color:#000;
  classDef statemodel fill:#fff9db,stroke:#5c940d,color:#000;
  classDef variation fill:#f3d9fa,stroke:#862e9c,color:#000;
  classDef value fill:#f3d9fa,stroke:#862e9c,color:#000;
  classDef usecase fill:#d0ebff,stroke:#1864ab,color:#000;
