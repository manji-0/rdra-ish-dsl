module buc.filing_decision

import shared.actors
import shared.entities
import shared.biz
import shared.goals

// Sources cited as file:line are under ~/research/japan-patent-operations/sources/.
// Only university flowcharts describe this step (〔公式・大学〕〔大学〕); a company's 社内審査 has no
// primary source, so the committee and its three outcomes are the model's assumption.

buc BucFilingDecision "先行技術調査と出願可否の判断"
  description "受け付けた発明について先行技術を調べ、発明審査委員会が出願する、ノウハウとして秘匿する、出願しないのいずれかに決める。会社が特許を受ける権利を取得していない発明は出願と決めない（`RightsAcquired`）。決定は発明者に知らせる。"

// 先行技術調査依頼 (niigata-u-2023-hatsumei-flowchart.txt:129); 特許性、技術性、市場性調査 (chuo-u-hatsumei-flow.txt:95).
usecase RequestPriorArtSearch "先行技術調査の依頼"
  description "受け付けた発明の先行技術調査を依頼し、届出を調査中にする。"

// 先行技術調査結果通知 (niigata-u-2023-hatsumei-flowchart.txt:136-138).
usecase RecordPriorArtSearch "先行技術調査の結果の登録" description "調査の結果を届出に記録し、調査済にする。"

// 発明審査委員会 meets 原則毎月１回 (niigata-u-2023-hatsumei-flowchart.txt:20-28); 帰属等の決定 (:214).
usecase DecideFiling "出願可否の決定"
  description "発明審査委員会が、出願する、ノウハウとして秘匿する、出願しないのいずれかに決める。出願と決められるのは、会社が権利を持つ発明だけである。"

usecase NotifyInventorOfDecision "決定の発明者への通知" description "決定を発明者に知らせる（参照のみ）。"

screen PriorArtSearchScreen "先行技術調査画面"
screen FilingDecisionScreen "出願審議画面"

api PriorArtSearchApi "先行技術調査 API"
api FilingDecisionApi "出願可否 API"

performs(IpStaff, RequestPriorArtSearch)
performs(IpStaff, RecordPriorArtSearch)
performs(ReviewCommittee, DecideFiling)
performs(IpStaff, NotifyInventorOfDecision)
belongs(BucFilingDecision, InventionManagement).by(IpWorkstation)

contains(BucFilingDecision, RequestPriorArtSearch)
contains(BucFilingDecision, RecordPriorArtSearch)
contains(BucFilingDecision, DecideFiling)
contains(BucFilingDecision, NotifyInventorOfDecision)
contains(IpManagementSystem, PriorArtSearchApi)
contains(IpManagementSystem, FilingDecisionApi)

displays(RequestPriorArtSearch, PriorArtSearchScreen)
invokes(RequestPriorArtSearch, PriorArtSearchApi)
updates(PriorArtSearchApi, InventionDisclosure)
transitions(RequestPriorArtSearch, InventionDisclosure.status, accepted -> searching)

displays(RecordPriorArtSearch, PriorArtSearchScreen)
invokes(RecordPriorArtSearch, PriorArtSearchApi)
transitions(RecordPriorArtSearch, InventionDisclosure.status, searching -> searched)

// Three outcomes, one use case: the three `transitions` arms from `searched` are the committee's
// choice, and one run takes one. Only filing needs the company to own the right, so the guard sits
// on that arm (`.when`); keeping it secret or not filing needs nothing more.
displays(DecideFiling, FilingDecisionScreen)
invokes(DecideFiling, FilingDecisionApi)
updates(FilingDecisionApi, InventionDisclosure)
transitions(DecideFiling, InventionDisclosure.status, searched -> decided_file).when(RightsAcquired)
transitions(DecideFiling, InventionDisclosure.status, searched -> decided_secret)
transitions(DecideFiling, InventionDisclosure.status, searched -> decided_abandon)
raises(DecideFiling, EvFilingDecided)

condition RightsAcquired "会社が特許を受ける権利を取得している"
holds(RightsAcquired, InventionDisclosure.right_acquired == true)

forbidden(InventionDisclosure, status == decided_file, right_acquired == false).label("会社が特許を受ける権利を取得していない発明は出願を決めない")

displays(NotifyInventorOfDecision, FilingDecisionScreen)
reads(NotifyInventorOfDecision, InventionDisclosure)
triggers(EvFilingDecided, NotifyInventorOfDecision)

// Access constraints
requires_permission(RequestPriorArtSearch, PriorArtSearchManage)
requires_medium(RequestPriorArtSearch, IpWorkstation)
requires_permission(PriorArtSearchApi, PriorArtSearchManage)

requires_permission(RecordPriorArtSearch, PriorArtSearchManage)
requires_medium(RecordPriorArtSearch, IpWorkstation)

requires_permission(DecideFiling, FilingDecide)
requires_medium(DecideFiling, IpWorkstation)
requires_permission(FilingDecisionApi, FilingDecide)

requires_permission(NotifyInventorOfDecision, DisclosureReview)
requires_medium(NotifyInventorOfDecision, IpWorkstation)

// Screen transitions: the model's assumption. The search result goes to the committee's agenda.
navigates(PriorArtSearchScreen, FilingDecisionScreen).via(RecordPriorArtSearch)

// Screen fields
field SearchStatusField "調査の状況"
  access readonly
  required true
  source system

field DecisionField "出願可否"
  access editable
  required true
  source actor

contains(PriorArtSearchScreen, SearchStatusField)
contains(FilingDecisionScreen, DecisionField)
maps_field(SearchStatusField, InventionDisclosure.status)
maps_field(DecisionField, InventionDisclosure.status)

// Business flow
flow FilingDecisionFlow "出願可否の判断の流れ"
step SearchRequestStep "先行技術調査の依頼"
step SearchResultStep "調査結果の登録"
step CommitteeStep "発明審査委員会での審議"
step DecisionNoticeStep "発明者への通知"

contains(BucFilingDecision, FilingDecisionFlow)
contains(FilingDecisionFlow, SearchRequestStep)
contains(FilingDecisionFlow, SearchResultStep)
contains(FilingDecisionFlow, CommitteeStep)
contains(FilingDecisionFlow, DecisionNoticeStep)

precedes(SearchRequestStep, SearchResultStep)
precedes(SearchResultStep, CommitteeStep)
precedes(CommitteeStep, DecisionNoticeStep)

covers(SearchRequestStep, RequestPriorArtSearch)
covers(SearchResultStep, RecordPriorArtSearch)
covers(CommitteeStep, DecideFiling)
covers(DecisionNoticeStep, NotifyInventorOfDecision)

performs(IpStaff, SearchRequestStep)
performs(IpStaff, SearchResultStep)
performs(ReviewCommittee, CommitteeStep)
performs(IpStaff, DecisionNoticeStep)

// Requirement traceability
requirement ReqSearchBeforeDecision "先行技術を調べてから出願可否を決める"
  priority "must"
  source "先行技術調査依頼 (niigata-u-2023-hatsumei-flowchart.txt:129)"
  source "特許性、技術性、市場性調査 (chuo-u-hatsumei-flow.txt:95)"
  stakeholder "発明審査委員会"
  acceptance_criteria "出願・秘匿・不出願の決定は、先行技術調査の結果が出た届出についてだけ行う。"
  status "accepted"

motivates(ReqSearchBeforeDecision, BucFilingDecision)
achieves(ReqSearchBeforeDecision, LeanPortfolio)
achieves(ReqSearchBeforeDecision, PromptFiling)
