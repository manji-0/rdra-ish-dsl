%% rdra-ish diagram=usecase scope=buc:BucTokenMaintenance model=samples/oidc-auth
%% layers: value=システム価値 environment=システム外部環境 boundary=システム境界 system=システム
%% kinds: actor timer usecase screen event entity state condition
%% omitted: buc step medium permission field api
flowchart LR
  subgraph layer_value["システム価値"]
    actor__EndUser(["End-User"]):::actor
    %% desc actor__EndUser: Signs in to the OP in a user agent, consents to the claims a client asks for, approves a device or a backchannel request, ends the session, and withdraws a consent.
    actor__RelyingParty(["Relying Party (client application)"]):::actor
    %% desc actor__RelyingParty: Registers itself, sends the End-User to the authorization endpoint, redeems codes, refreshes and revokes tokens, calls UserInfo, polls for device and CIBA tokens, and starts a logout.
    actor__ResourceServer(["Resource Server"]):::actor
    %% desc actor__ResourceServer: Receives access tokens from clients and asks the OP whether each is active before serving the request.
  end
  subgraph layer_environment["システム外部環境"]
    timer__AccessTokenLifetime(("Access token lifetime (OP policy, e.g. 1 hour)")):::timer
    timer__RefreshTokenLifetime(("Refresh token lifetime (OP policy, e.g. 30 days idle)")):::timer
  end
  subgraph layer_boundary["システム境界"]
    usecase__DetectRefreshTokenReuse("Detect the reuse of a rotated refresh token"):::usecase
    %% desc usecase__DetectRefreshTokenReuse: A refresh token value that was already rotated comes back: revoke the family and the grant.
    usecase__ExpireAccessToken("Expire an access token"):::usecase
    %% desc usecase__ExpireAccessToken: An access token reaches its expires_in.
    usecase__ExpireRefreshToken("Expire a refresh token"):::usecase
    %% desc usecase__ExpireRefreshToken: A refresh token reaches the OP's lifetime for it.
    usecase__IntrospectToken("Introspect a token (RFC 7662)"):::usecase
    %% desc usecase__IntrospectToken: The resource server posts a token and receives active true with its scope, client_id, sub, and exp, or active false.
    usecase__RefreshTokens("Refresh the tokens"):::usecase
    %% desc usecase__RefreshTokens: POST grant_type=refresh_token and receive a new access token, a rotated refresh token, and optionally a new ID Token with the same sub (Core §12.2).
    usecase__RevokeAccessToken("Revoke an access token (RFC 7009)"):::usecase
    %% desc usecase__RevokeAccessToken: POST the access token to the revocation endpoint; the OP revokes it only.
    usecase__RevokeGrantAccessTokens("Revoke the access tokens of a revoked grant"):::usecase
    %% desc usecase__RevokeGrantAccessTokens: Invalidate every access token issued under a grant that was revoked.
    usecase__RevokeGrantOnWithdrawal("Revoke the grant of a withdrawn consent"):::usecase
    %% desc usecase__RevokeGrantOnWithdrawal: Revoke the grant of the client whose consent the End-User withdrew.
    usecase__RevokeGrantRefreshTokens("Revoke the refresh tokens of a revoked grant"):::usecase
    %% desc usecase__RevokeGrantRefreshTokens: Invalidate the refresh token family of a grant that was revoked.
    usecase__RevokeRefreshToken("Revoke a refresh token (RFC 7009)"):::usecase
    %% desc usecase__RevokeRefreshToken: POST the refresh token to the revocation endpoint; the OP revokes it and the grant behind it.
    usecase__WithdrawConsent("Withdraw a consent"):::usecase
    %% desc usecase__WithdrawConsent: The End-User removes a client from the OP's list of authorized applications.
    screen__AuthorizedAppsScreen["Authorized applications"]:::screen
    event__EvConsentWithdrawn>"A consent is withdrawn"]:::event
    event__EvFrontChannelAccessToken>"An access token is delivered in the fragment"]:::event
    event__EvGrantRevoked>"A grant is revoked"]:::event
    event__EvTokensIssued>"The token endpoint issued the tokens"]:::event
    event__EvTokensRefreshed>"The tokens were refreshed"]:::event
  end
  subgraph layer_system["システム"]
    entity__AccessToken[("Access token")]:::entity
    entity__Client[("Registered client")]:::entity
    entity__Consent[("Consent")]:::entity
    entity__Grant[("Authorization grant")]:::entity
    entity__RefreshToken[("Refresh token (rotation family)")]:::entity
    entity__UserAccount[("End-User account")]:::entity
    state__AccessToken_active((("Active"))):::state
    state__AccessToken_expired((("Expired"))):::state
    state__AccessToken_revoked((("Revoked"))):::state
    state__Consent_granted((("Granted"))):::state
    state__Consent_withdrawn((("Withdrawn"))):::state
    state__Grant_active((("Active"))):::state
    state__Grant_revoked((("Revoked"))):::state
    state__RefreshToken_active((("Active, never rotated"))):::state
    state__RefreshToken_expired((("Expired"))):::state
    state__RefreshToken_revoked((("Revoked"))):::state
    state__RefreshToken_rotated((("Active, rotated"))):::state
    condition__GrantRevoked{"The grant is revoked"}:::condition
    condition__RefreshAllowed{"The grant is not revoked"}:::condition
  end
  actor__EndUser -.-> usecase__WithdrawConsent
  actor__RelyingParty -.-> usecase__DetectRefreshTokenReuse
  actor__RelyingParty -.-> usecase__RefreshTokens
  actor__RelyingParty -.-> usecase__RevokeAccessToken
  actor__RelyingParty -.-> usecase__RevokeRefreshToken
  actor__ResourceServer -.-> usecase__IntrospectToken
  condition__GrantRevoked -.->|applies_to| usecase__RevokeGrantAccessTokens
  condition__GrantRevoked -.->|applies_to| usecase__RevokeGrantRefreshTokens
  condition__RefreshAllowed -.->|applies_to| usecase__RefreshTokens
  event__EvConsentWithdrawn -.-> usecase__RevokeGrantOnWithdrawal
  event__EvFrontChannelAccessToken -.-> usecase__IntrospectToken
  event__EvFrontChannelAccessToken -.-> usecase__RevokeAccessToken
  event__EvGrantRevoked -.-> usecase__RevokeGrantAccessTokens
  event__EvGrantRevoked -.-> usecase__RevokeGrantRefreshTokens
  event__EvTokensIssued -.-> usecase__IntrospectToken
  event__EvTokensIssued -.-> usecase__RefreshTokens
  event__EvTokensIssued -.-> usecase__RevokeAccessToken
  event__EvTokensIssued -.-> usecase__RevokeRefreshToken
  event__EvTokensRefreshed -.-> usecase__DetectRefreshTokenReuse
  screen__AuthorizedAppsScreen -.-> entity__Client
  screen__AuthorizedAppsScreen -.-> entity__Consent
  timer__AccessTokenLifetime -.-> usecase__ExpireAccessToken
  timer__RefreshTokenLifetime -.-> usecase__ExpireRefreshToken
  usecase__DetectRefreshTokenReuse -.-> event__EvGrantRevoked
  usecase__DetectRefreshTokenReuse -.->|transitions Grant.status active->revoked| state__Grant_revoked
  usecase__DetectRefreshTokenReuse -.->|transitions Grant.status revoked->revoked| state__Grant_revoked
  usecase__DetectRefreshTokenReuse -.->|transitions RefreshToken.status rotated->revoked| state__RefreshToken_revoked
  usecase__DetectRefreshTokenReuse -.->|updates| entity__Grant
  %% derived usecase__DetectRefreshTokenReuse -> entity__Grant via api__RevocationApi
  usecase__DetectRefreshTokenReuse -.->|updates| entity__RefreshToken
  %% derived usecase__DetectRefreshTokenReuse -> entity__RefreshToken via api__RevocationApi
  usecase__ExpireAccessToken -.->|transitions AccessToken.status active->expired| state__AccessToken_expired
  usecase__ExpireAccessToken -.->|updates| entity__AccessToken
  %% derived usecase__ExpireAccessToken -> entity__AccessToken via api__AccessTokenExpiryApi
  usecase__ExpireRefreshToken -.->|transitions RefreshToken.status active->expired| state__RefreshToken_expired
  usecase__ExpireRefreshToken -.->|transitions RefreshToken.status rotated->expired| state__RefreshToken_expired
  usecase__ExpireRefreshToken -.->|updates| entity__RefreshToken
  %% derived usecase__ExpireRefreshToken -> entity__RefreshToken via api__RefreshTokenExpiryApi
  usecase__IntrospectToken -.->|reads| entity__AccessToken
  %% derived usecase__IntrospectToken -> entity__AccessToken via api__IntrospectionApi
  usecase__IntrospectToken -.->|reads| entity__Grant
  %% derived usecase__IntrospectToken -> entity__Grant via api__IntrospectionApi
  usecase__IntrospectToken -.->|reads| entity__UserAccount
  %% derived usecase__IntrospectToken -> entity__UserAccount via api__IntrospectionApi
  usecase__RefreshTokens -.-> event__EvTokensRefreshed
  usecase__RefreshTokens -.->|transitions AccessToken.status active->active| state__AccessToken_active
  usecase__RefreshTokens -.->|transitions AccessToken.status expired->active| state__AccessToken_active
  usecase__RefreshTokens -.->|transitions AccessToken.status revoked->active| state__AccessToken_active
  usecase__RefreshTokens -.->|transitions RefreshToken.status active->rotated| state__RefreshToken_rotated
  usecase__RefreshTokens -.->|transitions RefreshToken.status rotated->rotated| state__RefreshToken_rotated
  usecase__RefreshTokens -.->|updates| entity__AccessToken
  %% derived usecase__RefreshTokens -> entity__AccessToken via api__RefreshApi
  usecase__RefreshTokens -.->|updates| entity__Grant
  %% derived usecase__RefreshTokens -> entity__Grant via api__RefreshApi
  usecase__RefreshTokens -.->|updates| entity__RefreshToken
  %% derived usecase__RefreshTokens -> entity__RefreshToken via api__RefreshApi
  usecase__RevokeAccessToken -.->|transitions AccessToken.status active->revoked| state__AccessToken_revoked
  usecase__RevokeAccessToken -.->|updates| entity__AccessToken
  %% derived usecase__RevokeAccessToken -> entity__AccessToken via api__AccessTokenRevocationApi
  usecase__RevokeGrantAccessTokens -.->|reads| entity__Grant
  %% derived usecase__RevokeGrantAccessTokens -> entity__Grant via api__AccessTokenCascadeApi
  usecase__RevokeGrantAccessTokens -.->|transitions AccessToken.status active->revoked| state__AccessToken_revoked
  usecase__RevokeGrantAccessTokens -.->|updates| entity__AccessToken
  %% derived usecase__RevokeGrantAccessTokens -> entity__AccessToken via api__AccessTokenCascadeApi
  usecase__RevokeGrantOnWithdrawal -.-> event__EvGrantRevoked
  usecase__RevokeGrantOnWithdrawal -.->|transitions Grant.status active->revoked| state__Grant_revoked
  usecase__RevokeGrantOnWithdrawal -.->|updates| entity__Grant
  %% derived usecase__RevokeGrantOnWithdrawal -> entity__Grant via api__GrantWithdrawalApi
  usecase__RevokeGrantRefreshTokens -.->|reads| entity__Grant
  %% derived usecase__RevokeGrantRefreshTokens -> entity__Grant via api__RefreshTokenCascadeApi
  usecase__RevokeGrantRefreshTokens -.->|transitions RefreshToken.status active->revoked| state__RefreshToken_revoked
  usecase__RevokeGrantRefreshTokens -.->|transitions RefreshToken.status rotated->revoked| state__RefreshToken_revoked
  usecase__RevokeGrantRefreshTokens -.->|updates| entity__RefreshToken
  %% derived usecase__RevokeGrantRefreshTokens -> entity__RefreshToken via api__RefreshTokenCascadeApi
  usecase__RevokeRefreshToken -.-> event__EvGrantRevoked
  usecase__RevokeRefreshToken -.->|transitions Grant.status active->revoked| state__Grant_revoked
  usecase__RevokeRefreshToken -.->|transitions Grant.status revoked->revoked| state__Grant_revoked
  usecase__RevokeRefreshToken -.->|transitions RefreshToken.status active->revoked| state__RefreshToken_revoked
  usecase__RevokeRefreshToken -.->|transitions RefreshToken.status rotated->revoked| state__RefreshToken_revoked
  usecase__RevokeRefreshToken -.->|updates| entity__Grant
  %% derived usecase__RevokeRefreshToken -> entity__Grant via api__RevocationApi
  usecase__RevokeRefreshToken -.->|updates| entity__RefreshToken
  %% derived usecase__RevokeRefreshToken -> entity__RefreshToken via api__RevocationApi
  usecase__WithdrawConsent -.-> screen__AuthorizedAppsScreen
  usecase__WithdrawConsent -.-> event__EvConsentWithdrawn
  usecase__WithdrawConsent -.->|transitions Consent.status granted->withdrawn| state__Consent_withdrawn
  usecase__WithdrawConsent -.->|updates| entity__Consent
  %% derived usecase__WithdrawConsent -> entity__Consent via api__ConsentManagementApi
