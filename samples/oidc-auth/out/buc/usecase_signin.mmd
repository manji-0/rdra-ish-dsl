    condition__SilentStepUp{"prompt=none, the request asks for a second factor, and the End-User is not authenticated at that level"}:::condition
    condition__SilentUnauthenticated{"prompt=none and the End-User is not authenticated"}:::condition
    condition__SilentWithoutConsent{"prompt=none, the End-User is authenticated, and no consent to the client is on record"}:::condition
    condition__SingleFactorEnough{"The OP session is authenticated and the request asks for no second factor"}:::condition
  end
