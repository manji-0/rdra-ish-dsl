%% rdra-ish diagram=usecase scope=buc:BucBrowserSignIn model=samples/oidc-auth
%% layers: value=システム価値 environment=システム外部環境 boundary=システム境界 system=システム
%% kinds: actor extsystem timer usecase screen event entity state condition
%% omitted: buc step medium permission field api
flowchart LR
  subgraph layer_value["システム価値"]
    actor__EndUser(["End-User"]):::actor
    %% desc actor__EndUser: Signs in to the OP in a user agent, consents to the claims a client asks for, approves a device or a backchannel request, ends the session, and withdraws a consent.
    actor__OpAdministrator(["OP Administrator"]):::actor
    %% desc actor__OpAdministrator: Suspends and reinstates clients, publishes, activates, and retires signing keys.
    actor__RelyingParty(["Relying Party (client application)"]):::actor
    %% desc actor__RelyingParty: Registers itself, sends the End-User to the authorization endpoint, redeems codes, refreshes and revokes tokens, calls UserInfo, polls for device and CIBA tokens, and starts a logout.
    extsystem__RpCallbackEndpoint[["RP callback endpoints (backchannel logout, CIBA notification, initiate login)"]]:::extsystem
  end
  subgraph layer_environment["システム外部環境"]
    timer__InteractionLifetime(("Login interaction lifetime (OP policy, e.g. 30 minutes)")):::timer
  end
  subgraph layer_boundary["システム境界"]
    usecase__AbandonRequest("Drop an abandoned request"):::usecase
    %% desc usecase__AbandonRequest: Discard a request whose End-User did not finish the login or the consent within the interaction lifetime.
    usecase__AuthenticateEndUser("Authenticate for the request at the login page"):::usecase
    %% desc usecase__AuthenticateEndUser: Show the login page for this request and take the session the End-User logs in to, at the level the request asks for.
    usecase__DenyConsent("Decline the client"):::usecase
    %% desc usecase__DenyConsent: The End-User declines; the OP answers access_denied on the redirect URI.
    usecase__GrantConsent("Consent to the client"):::usecase
    %% desc usecase__GrantConsent: Show the client, the scopes, and the claims requested, and record the End-User's consent.
    usecase__InitiateThirdPartyLogin("Start a sign-in from the OP (third-party initiated login)"):::usecase
    %% desc usecase__InitiateThirdPartyLogin: The End-User picks an application on the OP's launcher page; the OP redirects to the client's initiate_login_uri with iss, login_hint, and target_link_uri.
    usecase__IssueCodeResponse("Respond with a code (Authorization Code Flow)"):::usecase
    %% desc usecase__IssueCodeResponse: Redirect to the redirect_uri with the authorization code and state in the query.
    usecase__IssueHybridFullResponse("Respond with a code, an ID Token, and an access token (Hybrid Flow, code id_token token)"):::usecase
    %% desc usecase__IssueHybridFullResponse: Redirect with the code, the ID Token carrying c_hash and at_hash, the access token, and state in the fragment.
    usecase__IssueHybridIdTokenResponse("Respond with a code and an ID Token (Hybrid Flow, code id_token)"):::usecase
    %% desc usecase__IssueHybridIdTokenResponse: Redirect with the code, the ID Token carrying c_hash, and state in the fragment.
    usecase__IssueHybridTokenResponse("Respond with a code and an access token (Hybrid Flow, code token)"):::usecase
    %% desc usecase__IssueHybridTokenResponse: Redirect with the code, the access token, and state in the fragment.
    usecase__IssueIdTokenResponse("Respond with an ID Token (Implicit Flow, id_token)"):::usecase
    %% desc usecase__IssueIdTokenResponse: Redirect with the ID Token and state in the fragment.
    usecase__IssueImplicitTokenResponse("Respond with an ID Token and an access token (Implicit Flow, id_token token)"):::usecase
    %% desc usecase__IssueImplicitTokenResponse: Redirect with the ID Token, the access token, token_type, expires_in, and state in the fragment.
    usecase__LogIn("Log in at the OP"):::usecase
    %% desc usecase__LogIn: Enter the account identifier and the password on the OP's login page and start an OP session for the user agent.
    usecase__RecordAdministrativeConsent("Record administrative consent"):::usecase
    %% desc usecase__RecordAdministrativeConsent: The administrator consents for an End-User to a client the organization trusts, so the End-User sees no consent page for it.
    usecase__RejectInvalidRequest("Reject an invalid request"):::usecase
    %% desc usecase__RejectInvalidRequest: Answer invalid_request on the redirect URI: a public client asked for a code without an S256 code challenge.
    usecase__RequestAuthentication("Send the authentication request"):::usecase
    %% desc usecase__RequestAuthentication: Redirect the End-User to the authorization endpoint with scope openid, client_id, redirect_uri, response_type, state, nonce, prompt, max_age, acr_values, and the PKCE code_challenge.
    usecase__ReturnAccountSelectionRequired("Answer account_selection_required"):::usecase
    %% desc usecase__ReturnAccountSelectionRequired: prompt=none and the user agent holds several sessions the End-User must choose among.
    usecase__ReturnConsentRequired("Answer consent_required"):::usecase
    %% desc usecase__ReturnConsentRequired: prompt=none, the End-User is authenticated, and no recorded consent covers the request.
    usecase__ReturnInteractionRequired("Answer interaction_required"):::usecase
    %% desc usecase__ReturnInteractionRequired: prompt=none and the request asks for a multi-factor class the session does not have.
    usecase__ReturnLoginRequired("Answer login_required"):::usecase
    %% desc usecase__ReturnLoginRequired: prompt=none and the OP cannot authenticate the End-User without a login page.
    usecase__ReuseConsent("Reuse the recorded consent"):::usecase
    %% desc usecase__ReuseConsent: Skip the consent page when the End-User has already consented to this client and prompt is not consent.
    usecase__ReuseSession("Reuse the OP session (single sign-on)"):::usecase
    %% desc usecase__ReuseSession: Recognize the End-User from the OP session cookie and skip the login page. The session must still be authenticated, and multi-factor when the request asks for it.
    usecase__SelectAccount("Select an account"):::usecase
    %% desc usecase__SelectAccount: Show the accounts the user agent is signed in to and let the End-User pick the one to use.
    usecase__StepUpAuthentication("Add a second factor to the session"):::usecase
    %% desc usecase__StepUpAuthentication: Enter the second factor, because a request asks for a multi-factor class or the End-User chose to, and raise the OP session to multi-factor.
    usecase__ValidateRequest("Validate the request"):::usecase
    %% desc usecase__ValidateRequest: Check the client, the redirect_uri, the response_type the client registered, and that a public client asking for a code sends an S256 code challenge.
    screen__AccountChooserScreen["Account chooser"]:::screen
    screen__AppLauncherScreen["OP application launcher"]:::screen
    screen__ConsentAdminScreen["Administrative consents"]:::screen
    screen__ConsentScreen["Consent page"]:::screen
    screen__LoginScreen["Login page"]:::screen
    screen__RpSignInScreen["RP sign-in page"]:::screen
    screen__SecondFactorScreen["Second factor page"]:::screen
    event__EvCodeIssued>"An authorization code is delivered to the RP"]:::event
    event__EvEndUserAuthenticated>"The End-User is authenticated for the request"]:::event
    event__EvFrontChannelAccessToken>"An access token is delivered in the fragment"]:::event
    event__EvLoginInitiated>"The OP sends the browser to the client's initiate_login_uri"]:::event
    event__EvRequestAuthorized>"The authentication request is authorized"]:::event
    event__EvRequestReceived>"The authentication request arrived"]:::event
    event__EvRequestValidated>"The authentication request is valid"]:::event
  end
