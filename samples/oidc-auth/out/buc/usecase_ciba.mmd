%% rdra-ish diagram=usecase scope=buc:BucBackchannelSignIn model=samples/oidc-auth
%% layers: value=システム価値 environment=システム外部環境 boundary=システム境界 system=システム
%% kinds: actor extsystem timer usecase screen event entity state condition
%% omitted: buc step medium permission field api
flowchart LR
  subgraph layer_value["システム価値"]
    actor__RelyingParty(["Relying Party (client application)"]):::actor
    %% desc actor__RelyingParty: Registers itself, sends the End-User to the authorization endpoint, redeems codes, refreshes and revokes tokens, calls UserInfo, polls for device and CIBA tokens, and starts a logout.
    extsystem__AuthenticationDevice[["Authentication device (CIBA, out of band)"]]:::extsystem
    extsystem__RpCallbackEndpoint[["RP callback endpoints (backchannel logout, CIBA notification, initiate login)"]]:::extsystem
  end
  subgraph layer_environment["システム外部環境"]
    timer__CibaRequestLifetime(("Backchannel authentication request lifetime (expires_in of the response)")):::timer
  end
  subgraph layer_boundary["システム境界"]
    usecase__ExpireBackchannelRequest("Expire the backchannel request"):::usecase
    %% desc usecase__ExpireBackchannelRequest: The auth_req_id reaches expires_in before the tokens are delivered.
    usecase__PollBackchannelToken("Poll for the tokens"):::usecase
    %% desc usecase__PollBackchannelToken: POST the auth_req_id to the token endpoint and receive the ID Token, the access token, and the refresh token, or authorization_pending, slow_down, access_denied, or expired_token (CIBA §11).
    usecase__PushBackchannelTokens("Push the tokens to the client"):::usecase
    %% desc usecase__PushBackchannelTokens: POST the auth_req_id, the ID Token carrying urn:openid:params:jwt:claim:auth_req_id, the access token, and the refresh token to the client notification endpoint.
    usecase__RecordDeviceApproval("Record the End-User's approval"):::usecase
    %% desc usecase__RecordDeviceApproval: The authentication device reports that the End-User authenticated and approved the request, after checking the binding_message.
    usecase__RecordDeviceDenial("Record the End-User's denial"):::usecase
    %% desc usecase__RecordDeviceDenial: The authentication device reports that the End-User declined.
    usecase__SendPingCallback("Ping the client"):::usecase
    %% desc usecase__SendPingCallback: POST the auth_req_id to the client notification endpoint, bearing the client_notification_token.
    usecase__StartBackchannelAuthentication("Send a backchannel authentication request"):::usecase
    %% desc usecase__StartBackchannelAuthentication: POST scope openid, a login hint, a binding_message, and, for ping and push, the client_notification_token to the backchannel authentication endpoint, and receive the auth_req_id.
    screen__ConsumptionDeviceScreen["Client's consumption device"]:::screen
    event__EvBackchannelApproved>"The End-User approved on the device"]:::event
    event__EvBackchannelAuthenticationRequested>"The End-User is asked to authenticate on the device"]:::event
    event__EvBackchannelDenied>"The End-User declined on the device"]:::event
    event__EvPingSent>"The ping callback is sent"]:::event
    event__EvTokensPushed>"The tokens are pushed"]:::event
  end
  subgraph layer_system["システム"]
    entity__BackchannelRequest[("Backchannel authentication request")]:::entity
    entity__Client[("Registered client")]:::entity
    entity__UserAccount[("End-User account")]:::entity
    state__BackchannelRequest_approved((("Approved"))):::state
    state__BackchannelRequest_denied((("Denied"))):::state
    state__BackchannelRequest_expired((("Expired"))):::state
    state__BackchannelRequest_notified((("Ping sent"))):::state
    state__BackchannelRequest_pending((("Pending"))):::state
    state__BackchannelRequest_pushed((("Tokens pushed"))):::state
    state__BackchannelRequest_redeemed((("Tokens issued"))):::state
    condition__BackchannelClientActive{"The client is active"}:::condition
    condition__PingMode{"The client registered ping mode"}:::condition
    condition__PollMode{"The client registered poll mode"}:::condition
    condition__PushMode{"The client registered push mode"}:::condition
  end
  actor__RelyingParty -.-> usecase__PollBackchannelToken
  actor__RelyingParty -.-> usecase__StartBackchannelAuthentication
  condition__BackchannelClientActive -.->|applies_to| usecase__StartBackchannelAuthentication
  condition__PingMode -.->|applies_to| usecase__SendPingCallback
  condition__PingMode -.->|when| usecase__PollBackchannelToken
  %% derived condition__PingMode -> usecase__PollBackchannelToken via transitions BackchannelRequest.status notified->redeemed
  condition__PollMode -.->|when| usecase__PollBackchannelToken
  %% derived condition__PollMode -> usecase__PollBackchannelToken via transitions BackchannelRequest.status approved->redeemed
  condition__PushMode -.->|applies_to| usecase__PushBackchannelTokens
  event__EvBackchannelApproved -.-> usecase__PollBackchannelToken
  event__EvBackchannelApproved -.-> usecase__PushBackchannelTokens
  event__EvBackchannelApproved -.-> usecase__RecordDeviceApproval
  event__EvBackchannelApproved -.-> usecase__SendPingCallback
  event__EvBackchannelAuthenticationRequested -.-> extsystem__AuthenticationDevice
  event__EvBackchannelDenied -.-> usecase__RecordDeviceDenial
  event__EvPingSent -.-> extsystem__RpCallbackEndpoint
  event__EvPingSent -.-> usecase__PollBackchannelToken
  event__EvTokensPushed -.-> extsystem__RpCallbackEndpoint
  extsystem__AuthenticationDevice -.-> event__EvBackchannelApproved
  extsystem__AuthenticationDevice -.-> event__EvBackchannelDenied
  timer__CibaRequestLifetime -.-> usecase__ExpireBackchannelRequest
  usecase__ExpireBackchannelRequest -.->|transitions BackchannelRequest.status approved->expired| state__BackchannelRequest_expired
  usecase__ExpireBackchannelRequest -.->|transitions BackchannelRequest.status notified->expired| state__BackchannelRequest_expired
  usecase__ExpireBackchannelRequest -.->|transitions BackchannelRequest.status pending->expired| state__BackchannelRequest_expired
  usecase__ExpireBackchannelRequest -.->|updates| entity__BackchannelRequest
  %% derived usecase__ExpireBackchannelRequest -> entity__BackchannelRequest via api__BackchannelExpiryApi
  usecase__PollBackchannelToken -.->|transitions BackchannelRequest.status approved->redeemed| state__BackchannelRequest_redeemed
  usecase__PollBackchannelToken -.->|transitions BackchannelRequest.status notified->redeemed| state__BackchannelRequest_redeemed
  usecase__PollBackchannelToken -.->|updates| entity__BackchannelRequest
  %% derived usecase__PollBackchannelToken -> entity__BackchannelRequest via api__BackchannelTokenApi
  usecase__PushBackchannelTokens -.-> event__EvTokensPushed
  usecase__PushBackchannelTokens -.->|transitions BackchannelRequest.status approved->pushed| state__BackchannelRequest_pushed
  usecase__PushBackchannelTokens -.->|updates| entity__BackchannelRequest
  %% derived usecase__PushBackchannelTokens -> entity__BackchannelRequest via api__BackchannelNotificationApi
  usecase__RecordDeviceApproval -.->|transitions BackchannelRequest.status pending->approved| state__BackchannelRequest_approved
  usecase__RecordDeviceApproval -.->|updates| entity__BackchannelRequest
  %% derived usecase__RecordDeviceApproval -> entity__BackchannelRequest via api__BackchannelDecisionApi
  usecase__RecordDeviceDenial -.->|transitions BackchannelRequest.status pending->denied| state__BackchannelRequest_denied
  usecase__RecordDeviceDenial -.->|updates| entity__BackchannelRequest
  %% derived usecase__RecordDeviceDenial -> entity__BackchannelRequest via api__BackchannelDecisionApi
  usecase__SendPingCallback -.-> event__EvPingSent
  usecase__SendPingCallback -.->|transitions BackchannelRequest.status approved->notified| state__BackchannelRequest_notified
  usecase__SendPingCallback -.->|updates| entity__BackchannelRequest
  %% derived usecase__SendPingCallback -> entity__BackchannelRequest via api__BackchannelNotificationApi
  usecase__StartBackchannelAuthentication -.->|creates| entity__BackchannelRequest
  %% derived usecase__StartBackchannelAuthentication -> entity__BackchannelRequest via api__BackchannelAuthenticationApi
  usecase__StartBackchannelAuthentication -.-> screen__ConsumptionDeviceScreen
  usecase__StartBackchannelAuthentication -.-> event__EvBackchannelAuthenticationRequested
  usecase__StartBackchannelAuthentication -.->|reads| entity__Client
  %% derived usecase__StartBackchannelAuthentication -> entity__Client via api__BackchannelAuthenticationApi
  usecase__StartBackchannelAuthentication -.->|reads| entity__UserAccount
  %% derived usecase__StartBackchannelAuthentication -> entity__UserAccount via api__BackchannelAuthenticationApi
  classDef actor fill:#ffe3e3,stroke:#c92a2a,color:#000;
  classDef extsystem fill:#e9ecef,stroke:#495057,color:#000;
  classDef timer fill:#ffe8cc,stroke:#d9480f,color:#000;
  classDef usecase fill:#d0ebff,stroke:#1864ab,color:#000;
  classDef screen fill:#e5dbff,stroke:#5f3dc4,color:#000;
  classDef event fill:#ffdeeb,stroke:#a61e4d,color:#000;
  classDef entity fill:#fff9db,stroke:#5c940d,color:#000;
  classDef state fill:#f8f9fa,stroke:#5c940d,color:#000;
  classDef condition fill:#f3d9fa,stroke:#862e9c,color:#000;
