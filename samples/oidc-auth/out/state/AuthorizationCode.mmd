    state__AuthorizationCode_issued --> state__AuthorizationCode_expired : Expire an unused code
    %% transition usecase__RejectCodeReplay
    state__AuthorizationCode_redeemed --> state__AuthorizationCode_replayed : Reject a replayed code and revoke its grant
    state__AuthorizationCode_expired --> [*]
    state__AuthorizationCode_replayed --> [*]
  }
