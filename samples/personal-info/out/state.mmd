stateDiagram-v2
  [*] --> UserAccount_provisioned
  state "🔄 active" as UserAccount_active
  state "🔄 deleted" as UserAccount_deleted
  state "🔄 suspended" as UserAccount_suspended
  state "🔄 provisioned" as UserAccount_provisioned
  UserAccount_active --> UserAccount_deleted : ✅ Delete Account
  UserAccount_active --> UserAccount_suspended : ✅ Suspend Account
  UserAccount_provisioned --> UserAccount_active : ✅ Set Initial Password
  UserAccount_suspended --> UserAccount_active : ✅ Restore Account
