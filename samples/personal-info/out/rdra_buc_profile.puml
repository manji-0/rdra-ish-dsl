@startuml
!theme plain
left to right direction

rectangle "System Value" {
  actor "👤 User" as User
}

rectangle "External Environment" {
  rectangle "💼 Personal Data Management Business" as PersonalDataMgmt
  rectangle "📦 Manage Personal Information" as BucProfile
}

rectangle "System Boundary" {
  usecase "✅ Delete Account" as DeleteAccount
  usecase "✅ Delete Address" as DeleteAddress
  usecase "✅ Register Address" as RegisterAddress
  usecase "✅ Restore Account" as RestoreAccount
  usecase "✅ Set Primary Address" as SetPrimaryAddress
  usecase "✅ Suspend Account" as SuspendAccount
  usecase "✅ Update Address" as UpdateAddress
  usecase "✅ Update Personal Information" as UpdateProfile
  usecase "✅ View Personal Information" as ViewProfile
  boundary "🖥️ Address Edit Screen" as AddressEditScreen
  boundary "🖥️ Address List Screen" as AddressListScreen
  boundary "🖥️ Personal Information Screen" as ProfileScreen
}

rectangle "System" {
  control "🔌 Delete Address API" as DeleteAddressApi
  control "🔌 Register Address API" as RegisterAddressApi
  control "🔌 Set Primary Address API" as SetPrimaryAddressApi
  control "🔌 Update Address API" as UpdateAddressApi
  control "🔌 Update Profile API" as UpdateProfileApi
  control "🔌 View Profile API" as ViewProfileApi
  database "🗄️ Audit Log" as AuditLog
  database "🗄️ Personal Information" as PersonalInfo
  database "🗄️ Postal Address" as PostalAddress
  database "🗄️ User Account" as UserAccount
}

User --> BucProfile : performs
UpdateProfileApi ..> AuditLog : creates
UpdateProfileApi ..> PersonalInfo : reads
UpdateProfileApi ..> PersonalInfo : updates
RegisterAddressApi ..> PostalAddress : creates
RegisterAddressApi ..> AuditLog : creates
UpdateAddressApi ..> AuditLog : creates
UpdateAddressApi ..> PostalAddress : reads
UpdateAddressApi ..> PostalAddress : updates
DeleteAddressApi ..> AuditLog : creates
DeleteAddressApi ..> PostalAddress : deletes
SetPrimaryAddressApi ..> AuditLog : creates
SetPrimaryAddressApi ..> PostalAddress : reads
SetPrimaryAddressApi ..> PostalAddress : updates
ViewProfileApi ..> UserAccount : reads
ViewProfileApi ..> PersonalInfo : reads
BucProfile ..> PersonalDataMgmt : belongs
BucProfile --> UpdateProfile : contains
BucProfile --> RegisterAddress : contains
BucProfile --> UpdateAddress : contains
BucProfile --> DeleteAddress : contains
BucProfile --> SetPrimaryAddress : contains
BucProfile --> SuspendAccount : contains
BucProfile --> RestoreAccount : contains
BucProfile --> DeleteAccount : contains
BucProfile --> ViewProfile : contains
PersonalInfo -- UserAccount : 1:1
PostalAddress -- UserAccount : N:1
AuditLog -- UserAccount : N:1
UpdateProfile ..> ProfileScreen : displays
UpdateProfile ..> UpdateProfileApi : invokes
RegisterAddress ..> AddressEditScreen : displays
RegisterAddress ..> RegisterAddressApi : invokes
UpdateAddress ..> AddressEditScreen : displays
UpdateAddress ..> UpdateAddressApi : invokes
DeleteAddress ..> AddressListScreen : displays
DeleteAddress ..> DeleteAddressApi : invokes
SetPrimaryAddress ..> AddressListScreen : displays
SetPrimaryAddress ..> SetPrimaryAddressApi : invokes
SuspendAccount ..> UserAccount : updates
RestoreAccount ..> UserAccount : updates
DeleteAccount ..> UserAccount : updates
ViewProfile ..> ProfileScreen : displays
ViewProfile ..> ViewProfileApi : invokes
@enduml
