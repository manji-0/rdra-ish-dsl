@startuml
!theme plain
left to right direction

rectangle "System Value" {
  actor "👤 User" as User
}

rectangle "External Environment" {
  rectangle "💼 Personal Data Management Business" as PersonalDataMgmt
  rectangle "📦 Manage Credit Cards" as BucCard
}

rectangle "System Boundary" {
  usecase "✅ Delete Card" as DeleteCard
  usecase "✅ List Cards" as ListCards
  usecase "✅ Register Card" as RegisterCard
  usecase "✅ Set Primary Card" as SetPrimaryCard
  boundary "🖥️ Card Registration Screen" as CardAddScreen
  boundary "🖥️ Card List Screen" as CardListScreen
}

rectangle "System" {
  control "🔌 Delete Card API" as DeleteCardApi
  control "🔌 List Cards API" as ListCardsApi
  control "🔌 Register Card API" as RegisterCardApi
  control "🔌 Set Primary Card API" as SetPrimaryCardApi
  database "🗄️ Audit Log" as AuditLog
  database "🗄️ Credit Card" as CreditCard
}

User --> BucCard : performs
SetPrimaryCardApi ..> AuditLog : creates
SetPrimaryCardApi ..> CreditCard : reads
SetPrimaryCardApi ..> CreditCard : updates
ListCardsApi ..> CreditCard : reads
RegisterCardApi ..> CreditCard : creates
RegisterCardApi ..> AuditLog : creates
DeleteCardApi ..> AuditLog : creates
DeleteCardApi ..> CreditCard : deletes
BucCard ..> PersonalDataMgmt : belongs
BucCard --> ListCards : contains
BucCard --> RegisterCard : contains
BucCard --> DeleteCard : contains
BucCard --> SetPrimaryCard : contains
ListCards ..> CardListScreen : displays
ListCards ..> ListCardsApi : invokes
RegisterCard ..> CardAddScreen : displays
RegisterCard ..> RegisterCardApi : invokes
DeleteCard ..> CardListScreen : displays
DeleteCard ..> DeleteCardApi : invokes
SetPrimaryCard ..> CardListScreen : displays
SetPrimaryCard ..> SetPrimaryCardApi : invokes
@enduml
