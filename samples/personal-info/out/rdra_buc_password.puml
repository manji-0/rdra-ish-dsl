@startuml
!theme plain
left to right direction

rectangle "System Value" {
  actor "👤 User" as User
}

rectangle "External Environment" {
  rectangle "💼 Personal Data Management Business" as PersonalDataMgmt
  rectangle "📦 Manage Password" as BucPassword
}

rectangle "System Boundary" {
  usecase "✅ Change Password" as ChangePassword
  usecase "✅ Request Password Reset" as RequestPasswordReset
  usecase "✅ Reset Password" as ResetPassword
  usecase "✅ Set Initial Password" as SetInitialPassword
  boundary "🖥️ Password Change Screen" as PasswordChangeScreen
  boundary "🖥️ Password Reset Screen" as PasswordResetScreen
  boundary "🖥️ Password Setup Screen" as PasswordSetScreen
}

rectangle "System" {
  control "🔌 Change Password API" as ChangePasswordApi
  control "🔌 Request Password Reset API" as RequestPasswordResetApi
  control "🔌 Reset Password API" as ResetPasswordApi
  control "🔌 Set Initial Password API" as SetInitialPasswordApi
  database "🗄️ Audit Log" as AuditLog
  database "🗄️ Password Credential" as PasswordCredential
  database "🗄️ User Account" as UserAccount
}

User --> BucPassword : performs
SetInitialPasswordApi ..> PasswordCredential : creates
SetInitialPasswordApi ..> AuditLog : creates
SetInitialPasswordApi ..> UserAccount : updates
ChangePasswordApi ..> AuditLog : creates
ChangePasswordApi ..> PasswordCredential : reads
ChangePasswordApi ..> PasswordCredential : updates
RequestPasswordResetApi ..> AuditLog : creates
RequestPasswordResetApi ..> UserAccount : reads
ResetPasswordApi ..> AuditLog : creates
ResetPasswordApi ..> PasswordCredential : updates
BucPassword ..> PersonalDataMgmt : belongs
BucPassword --> SetInitialPassword : contains
BucPassword --> ChangePassword : contains
BucPassword --> RequestPasswordReset : contains
BucPassword --> ResetPassword : contains
PasswordCredential -- UserAccount : 1:1
AuditLog -- UserAccount : N:1
SetInitialPassword ..> PasswordSetScreen : displays
SetInitialPassword ..> SetInitialPasswordApi : invokes
ChangePassword ..> PasswordChangeScreen : displays
ChangePassword ..> ChangePasswordApi : invokes
RequestPasswordReset ..> PasswordResetScreen : displays
RequestPasswordReset ..> RequestPasswordResetApi : invokes
ResetPassword ..> PasswordResetScreen : displays
ResetPassword ..> ResetPasswordApi : invokes
@enduml
