@startuml
!theme plain
left to right direction

rectangle "System Value" {
  actor "👤 System Administrator" as SysAdmin
  actor "👤 User" as User
}

rectangle "External Environment" {
  rectangle "💼 Personal Data Management Business" as PersonalDataMgmt
  rectangle "📦 Manage Credit Cards" as BucCard
  rectangle "📦 Manage Password" as BucPassword
  rectangle "📦 Manage Personal Information" as BucProfile
}

rectangle "System Boundary" {
  usecase "✅ Change Password" as ChangePassword
  usecase "✅ Delete Address" as DeleteAddress
  usecase "✅ Delete Card" as DeleteCard
  usecase "✅ List Cards" as ListCards
  usecase "✅ Register Address" as RegisterAddress
  usecase "✅ Register Card" as RegisterCard
  usecase "✅ Request Password Reset" as RequestPasswordReset
  usecase "✅ Reset Password" as ResetPassword
  usecase "✅ Set Initial Password" as SetInitialPassword
  usecase "✅ Set Primary Address" as SetPrimaryAddress
  usecase "✅ Set Primary Card" as SetPrimaryCard
  usecase "✅ Update Address" as UpdateAddress
  usecase "✅ Update Personal Information" as UpdateProfile
  usecase "✅ View Personal Information" as ViewProfile
  boundary "🖥️ Address Edit Screen" as AddressEditScreen
  boundary "🖥️ Address List Screen" as AddressListScreen
  boundary "🖥️ Card Registration Screen" as CardAddScreen
  boundary "🖥️ Card List Screen" as CardListScreen
  boundary "🖥️ Password Change Screen" as PasswordChangeScreen
  boundary "🖥️ Password Reset Screen" as PasswordResetScreen
  boundary "🖥️ Password Setup Screen" as PasswordSetScreen
  boundary "🖥️ Personal Information Screen" as ProfileScreen
  control "⚡ Restore Account" as Active
  control "⚡ Delete Account" as Deleted
  control "⚡ Suspend Account" as Suspended
}

rectangle "System" {
  control "🔌 Change Password API" as ChangePasswordApi
  control "🔌 Delete Address API" as DeleteAddressApi
  control "🔌 Delete Card API" as DeleteCardApi
  control "🔌 List Cards API" as ListCardsApi
  control "🔌 Register Address API" as RegisterAddressApi
  control "🔌 Register Card API" as RegisterCardApi
  control "🔌 Request Password Reset API" as RequestPasswordResetApi
  control "🔌 Reset Password API" as ResetPasswordApi
  control "🔌 Set Initial Password API" as SetInitialPasswordApi
  control "🔌 Set Primary Address API" as SetPrimaryAddressApi
  control "🔌 Set Primary Card API" as SetPrimaryCardApi
  control "🔌 Update Address API" as UpdateAddressApi
  control "🔌 Update Profile API" as UpdateProfileApi
  control "🔌 View Profile API" as ViewProfileApi
  package "🧩 Personal Data System" as PersonalDataSystem
  database "🗄️ Audit Log" as AuditLog
  database "🗄️ Credit Card" as CreditCard
  database "🗄️ Password Credential" as PasswordCredential
  database "🗄️ Personal Information" as PersonalInfo
  database "🗄️ Postal Address" as PostalAddress
  database "🗄️ User Account" as UserAccount
  collections "🔄 active" as UserAccount_active
  collections "🔄 deleted" as UserAccount_deleted
  collections "🔄 suspended" as UserAccount_suspended
}

User --> BucProfile : performs
User --> BucCard : performs
User --> BucPassword : performs
SetPrimaryCardApi ..> AuditLog : creates
SetPrimaryCardApi ..> CreditCard : reads
SetPrimaryCardApi ..> CreditCard : updates
SetInitialPasswordApi ..> PasswordCredential : creates
SetInitialPasswordApi ..> AuditLog : creates
ChangePasswordApi ..> AuditLog : creates
ChangePasswordApi ..> PasswordCredential : reads
ChangePasswordApi ..> PasswordCredential : updates
RequestPasswordResetApi ..> AuditLog : creates
RequestPasswordResetApi ..> UserAccount : reads
ResetPasswordApi ..> AuditLog : creates
ResetPasswordApi ..> PasswordCredential : updates
ViewProfileApi ..> UserAccount : reads
ViewProfileApi ..> PersonalInfo : reads
UpdateProfileApi ..> AuditLog : creates
UpdateProfileApi ..> PersonalInfo : reads
UpdateProfileApi ..> PersonalInfo : updates
RegisterAddressApi ..> PostalAddress : creates
RegisterAddressApi ..> AuditLog : creates
UpdateAddressApi ..> AuditLog : creates
UpdateAddressApi ..> PostalAddress : reads
UpdateAddressApi ..> PostalAddress : updates
DeleteAddressApi ..> AuditLog : creates
DeleteAddressApi ..> PostalAddress : deletes
SetPrimaryAddressApi ..> AuditLog : creates
