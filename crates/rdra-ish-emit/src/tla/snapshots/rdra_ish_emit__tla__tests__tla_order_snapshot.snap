---- MODULE RdraSpec ----
\* Generated by rdra-ish. Do not edit manually.
\* Bounds: InstanceCount=2 IntRange=0..5; a verify OK says nothing outside them.

EXTENDS Integers

InstanceCount == 2
IntRange == 0..5
Order_Ids == 1..InstanceCount

\* The lowest absent slot: a create takes it, and a deleted slot is never reused.
FirstAbsent(ex, i) == ex[i] = "absent" /\ \A j \in DOMAIN ex : j < i => ex[j] # "absent"

VARIABLES Order_exists, Order_status, Order_delivered_at

vars == <<Order_exists, Order_status, Order_delivered_at>>

TypeOK ==
  /\ Order_exists \in [Order_Ids -> {"absent", "present", "deleted"}]
  /\ Order_status \in [Order_Ids -> {"pending", "paid", "shipped", "delivered", "cancelled"}]
  /\ Order_delivered_at \in [Order_Ids -> {"null", "present"}]

Init ==
  /\ Order_exists = [i \in Order_Ids |-> "absent"]
  /\ Order_status = [i \in Order_Ids |-> "pending"]
  /\ Order_delivered_at = [i \in Order_Ids |-> "null"]

CapturePay(p0) ==
  /\ Order_exists[p0] = "present"
  /\ Order_status[p0] = "pending"
  /\ Order_status' = [Order_status EXCEPT ![p0] = CASE Order_status[p0] = "pending" -> "paid" [] OTHER -> Order_status[p0]]
  /\ UNCHANGED <<Order_exists, Order_delivered_at>>

ShipOrder(p0) ==
  /\ Order_exists[p0] = "present"
  /\ Order_status[p0] = "paid"
  /\ Order_status' = [Order_status EXCEPT ![p0] = CASE Order_status[p0] = "paid" -> "shipped" [] OTHER -> Order_status[p0]]
  /\ UNCHANGED <<Order_exists, Order_delivered_at>>

DeliverOrder(p0) ==
  /\ Order_exists[p0] = "present"
  /\ Order_status[p0] = "shipped"
  /\ Order_status' = [Order_status EXCEPT ![p0] = CASE Order_status[p0] = "shipped" -> "delivered" [] OTHER -> Order_status[p0]]
  /\ Order_delivered_at' = [Order_delivered_at EXCEPT ![p0] = "present"]
  /\ UNCHANGED Order_exists

CancelOrder(p0) ==
  /\ Order_exists[p0] = "present"
  /\ Order_status[p0] = "pending"
  /\ Order_status' = [Order_status EXCEPT ![p0] = CASE Order_status[p0] = "pending" -> "cancelled" [] OTHER -> Order_status[p0]]
  /\ UNCHANGED <<Order_exists, Order_delivered_at>>

PlaceOrder(p0) ==
  /\ FirstAbsent(Order_exists, p0)
  /\ Order_exists' = [Order_exists EXCEPT ![p0] = "present"]
  /\ UNCHANGED <<Order_status, Order_delivered_at>>

Next ==
  \/ \E p0 \in Order_Ids : CapturePay(p0)
  \/ \E p0 \in Order_Ids : ShipOrder(p0)
  \/ \E p0 \in Order_Ids : DeliverOrder(p0)
  \/ \E p0 \in Order_Ids : CancelOrder(p0)
  \/ \E p0 \in Order_Ids : PlaceOrder(p0)

Spec == Init /\ [][Next]_vars /\ WF_vars(Next)

Forbidden_Order_0 == \A b0 \in Order_Ids : (Order_exists[b0] = "present") => (~((Order_status[b0] = "cancelled") /\ (Order_delivered_at[b0] = "present")))
Inv_Order_0 == \A b0 \in Order_Ids : (Order_exists[b0] = "present") => ((~(Order_status[b0] = "delivered")) \/ (Order_delivered_at[b0] = "present"))
AfterAssert_DeliverOrder_0 == [][(\A p0 \in Order_Ids : DeliverOrder(p0) => ((Order_status'[p0] = "delivered") /\ (Order_delivered_at'[p0] = "present")))]_vars
PaidLeadsToShipped == \A b0 \in Order_Ids : ((Order_exists[b0] = "present") /\ (Order_status[b0] = "paid")) ~> (Order_status[b0] = "shipped")
EventuallyTerminal == \A b0 \in Order_Ids : []((Order_exists[b0] = "present") => <>((Order_status[b0] = "delivered") \/ (Order_status[b0] = "cancelled")))

