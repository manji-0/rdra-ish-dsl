---- MODULE RdraSpec ----
\* Generated by rdra-ish. Do not edit manually.
\* Bounds: InstanceCount=2 IntRange=0..5; a verify OK says nothing outside them.

EXTENDS Integers

InstanceCount == 2
IntRange == 0..5
Session_Ids == 1..InstanceCount

\* The lowest absent slot: a create takes it, and a deleted slot is never reused.
FirstAbsent(ex, i) == ex[i] = "absent" /\ \A j \in DOMAIN ex : j < i => ex[j] # "absent"

VARIABLES Session_exists, Session_status

vars == <<Session_exists, Session_status>>

TypeOK ==
  /\ Session_exists \in [Session_Ids -> {"absent", "present", "deleted"}]
  /\ Session_status \in [Session_Ids -> {"active", "revoked"}]

Init ==
  /\ Session_exists = [i \in Session_Ids |-> "absent"]
  /\ Session_status = [i \in Session_Ids |-> "active"]

Login(p0) ==
  /\ FirstAbsent(Session_exists, p0)
  /\ Session_exists' = [Session_exists EXCEPT ![p0] = "present"]
  /\ UNCHANGED Session_status

Next ==
  \/ \E p0 \in Session_Ids : Login(p0)

Spec == Init /\ [][Next]_vars

