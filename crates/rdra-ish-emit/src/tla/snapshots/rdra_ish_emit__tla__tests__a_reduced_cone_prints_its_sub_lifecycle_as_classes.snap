EXTENDS Integers, TLC

InstanceCount == 2
IntRange == 0..5
Gate_Ids == 1..InstanceCount
Job_Ids == 1..InstanceCount
Key_Ids == 1..InstanceCount

\* The lowest absent slot: a create takes it, and a deleted slot is never reused.
FirstAbsent(ex, i) == ex[i] = "absent" /\ \A j \in DOMAIN ex : j < i => ex[j] # "absent"

VARIABLES Job_exists, Job_status, Job_owner_Gate, S_class

vars == <<Job_exists, Job_status, Job_owner_Gate, S_class>>

\* The independent sub-lifecycle, reduced: S_class is the class of its state under
\* stuttering equivalence with respect to what the rest reads of it, one of 9 classes
\* (docs/formal-verification.md, "Reduction by an independent sub-lifecycle").
Rep_Gate_exists == <<<<"present", "present">>, <<"present", "present">>, <<"present", "present">>, <<"present", "present">>, <<"present", "present">>, <<"present", "present">>, <<"present", "present">>, <<"present", "present">>, <<"present", "present">>>>
Gate_exists == Rep_Gate_exists[S_class]
Rep_Gate_status == <<<<"shut", "shut">>, <<"half", "shut">>, <<"shut", "half">>, <<"half", "half">>, <<"open", "shut">>, <<"shut", "open">>, <<"open", "half">>, <<"half", "open">>, <<"open", "open">>>>
Gate_status == Rep_Gate_status[S_class]
Succ_Unlock == <<>>
Succ_Crack == (1 :> {2, 3}) @@ (2 :> {4}) @@ (3 :> {4}) @@ (5 :> {7}) @@ (6 :> {8})
Succ_Swing == (2 :> {5}) @@ (3 :> {6}) @@ (4 :> {7, 8}) @@ (7 :> {9}) @@ (8 :> {9})
Succ_Unlatch == <<>>

TypeOK ==
  /\ S_class \in 1..9
  /\ Job_exists \in [Job_Ids -> {"absent", "present", "deleted"}]
  /\ Job_status \in [Job_Ids -> {"waiting", "running"}]
  /\ Job_owner_Gate \in [Job_Ids -> Gate_Ids]

Init ==
  /\ S_class \in {1}
  /\ Job_exists = [i \in Job_Ids |-> "absent"]
  /\ Job_status = [i \in Job_Ids |-> "waiting"]
  /\ Job_owner_Gate = [i \in Job_Ids |-> 1]

Unlock ==
  /\ S_class \in DOMAIN Succ_Unlock
  /\ S_class' \in Succ_Unlock[S_class]
  /\ UNCHANGED <<Job_exists, Job_status, Job_owner_Gate>>

Crack ==
  /\ S_class \in DOMAIN Succ_Crack
  /\ S_class' \in Succ_Crack[S_class]
  /\ UNCHANGED <<Job_exists, Job_status, Job_owner_Gate>>

Swing ==
  /\ S_class \in DOMAIN Succ_Swing
  /\ S_class' \in Succ_Swing[S_class]
  /\ UNCHANGED <<Job_exists, Job_status, Job_owner_Gate>>

Start(p0) ==
  /\ Job_exists[p0] = "present"
  /\ Job_status[p0] = "waiting"
  /\ \E b0 \in Gate_Ids : (Gate_exists[b0] = "present") /\ ((Job_owner_Gate[p0] = b0) /\ (Gate_status[b0] = "open"))
  /\ Job_status' = [Job_status EXCEPT ![p0] = CASE Job_status[p0] = "waiting" -> "running" [] OTHER -> Job_status[p0]]
  /\ UNCHANGED <<Job_exists, Job_owner_Gate, S_class>>

Submit(p0, p1) ==
  /\ FirstAbsent(Job_exists, p0)
  /\ Gate_exists[p1] = "present"
  /\ Job_exists' = [Job_exists EXCEPT ![p0] = "present"]
  /\ Job_owner_Gate' = [Job_owner_Gate EXCEPT ![p0] = p1]
  /\ UNCHANGED <<Job_status, S_class>>

Unlatch ==
  /\ S_class \in DOMAIN Succ_Unlatch
  /\ S_class' \in Succ_Unlatch[S_class]
  /\ UNCHANGED <<Job_exists, Job_status, Job_owner_Gate>>

Next ==
  \/ Unlock
  \/ Crack
  \/ Swing
  \/ \E p0 \in Job_Ids : Start(p0)
  \/ \E p0 \in Job_Ids, p1 \in Gate_Ids : Submit(p0, p1)
  \/ Unlatch

Spec == Init /\ [][Next]_vars

