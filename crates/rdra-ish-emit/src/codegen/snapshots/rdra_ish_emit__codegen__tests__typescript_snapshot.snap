    total: state.total,
    status: state.status,
    paid_at: state.paid_at,
    method: state.method,
    delivered_at: state.delivered_at,
    type: state.type,
    customer_id: state.customer_id,
  };
}

// ── Dispatch: run a use case from whatever states its rows are in ──

/** The rows are in states the use case does not run from. */
