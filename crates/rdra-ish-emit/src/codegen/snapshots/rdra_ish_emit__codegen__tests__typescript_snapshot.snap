// ── Rule checks ──

/** The rules a Customer row breaks, by the names `check` reports: empty when it keeps them all. */
export function customerRuleViolations(_row: Customer): readonly string[] {
  return [];
}

/** The rules a OrderLine row breaks, by the names `check` reports: empty when it keeps them all. */
