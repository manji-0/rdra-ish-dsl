function $invalidValue(type: string, reason: string): Result<never, InvalidValue> {
  return { ok: false, error: { kind: "InvalidValue", type, reason } };
}

function $isObject(value: unknown): value is Readonly<Record<string, unknown>> {
  return typeof value === "object" && value !== null;
}

function $int(value: unknown): Result<number, InvalidValue> {
  return typeof value === "number" && globalThis.Number.isSafeInteger(value)
    ? { ok: true, value }
    : $invalidValue("Int", "not an integer");
}

function $string(value: unknown): Result<string, InvalidValue> {
  return typeof value === "string" ? { ok: true, value } : $invalidValue("String", "not a string");
}

function $nullable<T>(read: (value: unknown) => Result<T, InvalidValue>): (value: unknown) => Result<T | null, InvalidValue> {
  return (value) => (value === null ? { ok: true, value: null } : read(value));
}

function $column(entity: string, column: string, error: InvalidValue): Result<never, InvalidRow> {
  return { ok: false, error: { kind: "InvalidRow", entity, column, reason: `${error.type}: ${error.reason}` } };
