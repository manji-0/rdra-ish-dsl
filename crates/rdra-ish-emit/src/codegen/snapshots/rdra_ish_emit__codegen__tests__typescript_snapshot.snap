// ── Use cases ──

/** The rows are in states the use case does not run from. Only a dispatcher returns it. */
export type NotEnabled = Readonly<{ kind: "NotEnabled"; usecase: string }>;

/** A row the call names does not exist. Only the service's load returns it; the functions take rows already loaded. */
export type NotFound = Readonly<{ kind: "NotFound"; usecase: string; entity: string; id: string }>;

/** A condition of the use case did not hold: the use case does not run. */
export type Rejected = Readonly<{ kind: "Rejected"; condition: string; label: string; site: string | null }>;

/**
 * The arguments break what the verified model keeps: a child row that does not name the
 * parent passed with it, a row that is not the event's, a column the target state keeps null
 * that holds a value. The model never reaches such rows; a caller that passes them has a bug.
 */
