/** What runPay returns when the use case runs. */
export type PayOutcome = PayResult;

/** Runs Pay from whatever states its rows are in: the transition function of those states, or NotEnabled. */
export function runPay(order: Order, orderPaidAt: DateTime): PayOutcome | NotEnabled {
  if (order.status === "pending") {
    return pay(order, orderPaidAt);
  }
  return { notEnabled: "Pay" };
}

/** What runCancelOrder returns when the use case runs. */
export type CancelOrderOutcome = CancelOrderResult;

/** Runs CancelOrder from whatever states its rows are in: the transition function of those states, or NotEnabled. */
export function runCancelOrder(order: Order): CancelOrderOutcome | NotEnabled {
  if (order.status === "pending") {
    return cancelOrder(order);
  }
  return { notEnabled: "CancelOrder" };
}
