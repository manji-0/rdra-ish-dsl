/** The store failed: no answer of the use case. Only the service's load or commit returns it; `cause` is the store's error. */
export type StoreFailed = Readonly<{ kind: "StoreFailed"; usecase: string; cause: unknown }>;

/**
 * What a row a result writes must still be when the write commits, so the store can write it
 * conditionally and take a write that matches no row as NotEnabled (see the obligations).
 */
export type ExpectedSource =
  | Readonly<{ kind: "absent" }>
  | Readonly<{ kind: "present" }>
  | Readonly<{ kind: "in"; column: string; value: string }>;

/** What Pay can fail with: NotEnabled from a dispatcher, NotFound from the service's load, StoreFailed from the service's store. */
export type PayError = NotEnabled | NotFound | StoreFailed;

/** What CancelOrder can fail with: NotEnabled from a dispatcher, NotFound from the service's load, StoreFailed from the service's store. */
export type CancelOrderError = NotEnabled | NotFound | StoreFailed;

/** What Place can fail with: NotEnabled from a dispatcher, NotFound from the service's load, StoreFailed from the service's store. */
export type PlaceError = NotEnabled | NotFound | StoreFailed;

/** What pay returns. */
export type PayResult = Readonly<{
  order: OrderPaid;
  order_expected: ExpectedSource;
}>;

/**
 * Pay (Pay).
 * One run of the use case, from the states of the arguments' types. It requires what `Pay` requires and writes what it writes; the values the model leaves open are the inputs.
 */
export function pay(order: OrderPending, orderPaidAt: DateTime): Result<PayResult, PayError> {
  return {
    ok: true,
    value: {
      order: {
        kind: "Paid",
        id: order.id,
        total: order.total,
        paid_at: orderPaidAt,
        method: order.method,
        delivered_at: order.delivered_at,
        type: order.type,
        customer_id: order.customer_id,
      },
      order_expected: { kind: "in", column: "status", value: "pending" },
    },
  };
}

