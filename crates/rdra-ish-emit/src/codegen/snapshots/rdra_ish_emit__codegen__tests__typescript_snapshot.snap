// ── Rows: the flat shape a store or the wire holds ──

/** A row that breaks what the type of its state requires. */
export interface InvalidRow {
  readonly invalid: string;
  readonly column: string;
  readonly reason: string;
}

/** Every column of Order as the data layer declares it. */
export interface OrderRow {
  id: OrderId;
  total: Money;
  status: OrderStatus;
  paid_at: DateTime | null;
  method: PaymentMethod;
  delivered_at: DateTime | null;
  type: string | null;
  customer_id: CustomerId;
}

/** The state of a Order row, or why the row fits none. */
export function orderFromRow(row: OrderRow): Order | InvalidRow {
  switch (row.status) {
    case "pending": {
      if (row.paid_at !== null) {
        return { invalid: "Order", column: "paid_at", reason: "null in the state pending" };
      }
      return {
        status: "pending",
        id: row.id,
        total: row.total,
        method: row.method,
        delivered_at: row.delivered_at,
        type: row.type,
        customer_id: row.customer_id,
        paid_at: null,
      };
    }
    case "paid": {
      if (row.paid_at === null) {
        return { invalid: "Order", column: "paid_at", reason: "present in the state paid" };
      }
      return {
        status: "paid",
        id: row.id,
        total: row.total,
        paid_at: row.paid_at,
        method: row.method,
        delivered_at: row.delivered_at,
        type: row.type,
        customer_id: row.customer_id,
      };
    }
    case "cancelled": {
      return {
        status: "cancelled",
        id: row.id,
        total: row.total,
        paid_at: row.paid_at,
        method: row.method,
        delivered_at: row.delivered_at,
        type: row.type,
        customer_id: row.customer_id,
      };
    }
  }
}

/** The flat row of a Order. */
