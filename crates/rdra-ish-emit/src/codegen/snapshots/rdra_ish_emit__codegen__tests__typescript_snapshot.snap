}

/** The rules a OrderCancelled row breaks, by the names `check` reports: empty when it keeps them all. */
export function orderCancelledRuleViolations(_row: OrderCancelled): readonly string[] {
  return [];
}

/** The rules a Order row breaks, by its state: empty when it keeps them all. */
export function orderRuleViolations(row: Order): readonly string[] {
  const kind = row.kind;
  switch (kind) {
    case "Pending":
      return orderPendingRuleViolations(row);
    case "Paid":
      return orderPaidRuleViolations(row);
    case "Cancelled":
      return orderCancelledRuleViolations(row);
    default:
      return assertNever(kind);
  }
}

