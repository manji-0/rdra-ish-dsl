}

/// Place (Place).
/// One run of the use case, from the states of the arguments' types. It requires what `Place` requires and writes what it writes; the values the model leaves open are the inputs.
pub fn place(parent_customer: Customer, order_id: OrderId, order_method: PaymentMethod) -> ::core::result::Result<PlaceResult, PlaceError> {
    ::core::result::Result::Ok(PlaceResult {
        order: OrderPending {
            id: order_id,
            total: Money(::std::string::String::from("0")),
