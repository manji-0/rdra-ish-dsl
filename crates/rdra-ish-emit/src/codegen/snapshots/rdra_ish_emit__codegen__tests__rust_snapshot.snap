impl Order {
    /// The rules this row breaks, by its state: empty when it keeps them all.
    pub fn rule_violations(&self) -> ::std::vec::Vec<&'static str> {
        match self {
            Self::Pending(state) => state.rule_violations(),
            Self::Paid(state) => state.rule_violations(),
            Self::Cancelled(state) => state.rule_violations(),
        }
    }
}

// ── Rows: the flat shape a store or the wire holds ──

/// A row that fits no state of its entity: `from_row` refuses it.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct InvalidRow {
    /// The entity.
    pub entity: &'static str,
    /// The column that breaks what the state requires.
    pub column: &'static str,
    /// What the state requires of it.
    pub reason: &'static str,
}

impl ::core::fmt::Display for InvalidRow {
    fn fmt(&self, f: &mut ::core::fmt::Formatter<'_>) -> ::core::fmt::Result {
        write!(f, "{}.{}: {}", self.entity, self.column, self.reason)
    }
}

impl ::std::error::Error for InvalidRow {}

/// Every column of Order as the data layer declares it: the shape a store or the wire holds. The
/// scalars it holds were parsed when it was built.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct OrderRow {
    /// The column `id`.
    pub id: OrderId,
    /// The column `total`.
    pub total: Money,
    /// The column `status`.
    pub status: OrderStatus,
    /// The column `paid_at`.
    pub paid_at: ::core::option::Option<DateTime>,
    /// The column `method`.
    pub method: PaymentMethod,
    /// The column `delivered_at`.
    pub delivered_at: ::core::option::Option<DateTime>,
    /// The column `type`.
    pub r#type: ::core::option::Option<::std::string::String>,
    /// The column `customer_id`.
    pub customer_id: CustomerId,
}

impl ::core::convert::TryFrom<OrderRow> for Order {
    type Error = InvalidRow;

    /// The state of a row, or why the row fits none.
    fn try_from(row: OrderRow) -> ::core::result::Result<Self, InvalidRow> {
        match row.status {
            OrderStatus::Pending => {
                if row.paid_at.is_some() {
                    return ::core::result::Result::Err(InvalidRow { entity: "Order", column: "paid_at", reason: "null in the state pending" });
                }
                ::core::result::Result::Ok(Self::Pending(OrderPending { id: row.id, total: row.total, method: row.method, delivered_at: row.delivered_at, r#type: row.r#type, customer_id: row.customer_id }))
            }
            OrderStatus::Paid => {
                let ::core::option::Option::Some(present_paid_at) = row.paid_at else {
                    return ::core::result::Result::Err(InvalidRow { entity: "Order", column: "paid_at", reason: "present in the state paid" });
                };
                ::core::result::Result::Ok(Self::Paid(OrderPaid { id: row.id, total: row.total, paid_at: present_paid_at, method: row.method, delivered_at: row.delivered_at, r#type: row.r#type, customer_id: row.customer_id }))
            }
            OrderStatus::Cancelled => {
                ::core::result::Result::Ok(Self::Cancelled(OrderCancelled { id: row.id, total: row.total, paid_at: row.paid_at, method: row.method, delivered_at: row.delivered_at, r#type: row.r#type, customer_id: row.customer_id }))
            }
        }
    }
}

impl ::core::convert::From<Order> for OrderRow {
    /// The flat row of a state.
    fn from(state: Order) -> Self {
        match state {
            Order::Pending(s) => Self { id: s.id, total: s.total, status: OrderStatus::Pending, paid_at: ::core::option::Option::None, method: s.method, delivered_at: s.delivered_at, r#type: s.r#type, customer_id: s.customer_id },
            Order::Paid(s) => Self { id: s.id, total: s.total, status: OrderStatus::Paid, paid_at: ::core::option::Option::Some(s.paid_at), method: s.method, delivered_at: s.delivered_at, r#type: s.r#type, customer_id: s.customer_id },
            Order::Cancelled(s) => Self { id: s.id, total: s.total, status: OrderStatus::Cancelled, paid_at: s.paid_at, method: s.method, delivered_at: s.delivered_at, r#type: s.r#type, customer_id: s.customer_id },
        }
    }
}

impl Order {
    /// The state of a row, or why the row fits none: [`TryFrom`] by name.
    ///
    /// # Errors
    ///
    /// [`InvalidRow`] when the row fits no state.
    pub fn from_row(row: OrderRow) -> ::core::result::Result<Self, InvalidRow> {
        <Self as ::core::convert::TryFrom<OrderRow>>::try_from(row)
    }

    /// The flat row of this state: [`From`] by name.
    pub fn into_row(self) -> OrderRow {
        OrderRow::from(self)
    }
}

// ── Dispatch: run a use case from whatever states its rows are in ──

/// What `run_pay` returns when the use case runs.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum PayOutcome {
    /// `pay` ran.
    Ran(PayResult),
}

/// Runs Pay from whatever states its rows are in: the transition function of those states.
///
/// # Errors
///
/// `NotEnabled` when the rows are in states it does not run from, and what the transition
/// function returns.
pub fn run_pay(order: Order, order_paid_at: DateTime) -> ::core::result::Result<PayOutcome, PayError> {
    match (order,) {
        (Order::Pending(order),) => pay(order, order_paid_at).map(PayOutcome::Ran),
        _ => ::core::result::Result::Err(PayError::NotEnabled(NotEnabled { usecase: "Pay" })),
    }
}

/// What `run_cancel_order` returns when the use case runs.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum CancelOrderOutcome {
    /// `cancel_order` ran.
    Ran(CancelOrderResult),
}

/// Runs CancelOrder from whatever states its rows are in: the transition function of those states.
///
/// # Errors
///
/// `NotEnabled` when the rows are in states it does not run from, and what the transition
/// function returns.
pub fn run_cancel_order(order: Order) -> ::core::result::Result<CancelOrderOutcome, CancelOrderError> {
    match (order,) {
        (Order::Pending(order),) => cancel_order(order).map(CancelOrderOutcome::Ran),
        _ => ::core::result::Result::Err(CancelOrderError::NotEnabled(NotEnabled { usecase: "CancelOrder" })),
    }
}

// ── Contracts: one per use case, which the service implements ──

/// The use case Pay: Pay.
/// Each action is two calls: `prepare_*` loads its rows by id and calls the dispatcher or transition function, writing nothing; the matching `commit_*` stores the rows, marks, and events the result holds in one transaction, each row only where it still is what the result's `<row>_expected` names. Either returns the use case's error and changes nothing when the use case does not run.
pub trait PayUseCase {
    /// Loads the rows of Pay (the action Pay) and runs it, writing nothing.
    fn prepare_pay(&mut self, order: OrderId, order_paid_at: DateTime) -> ::core::result::Result<PayOutcome, PayError>;
    /// Stores what `prepare_pay` returned in one transaction.
    fn commit_pay(&mut self, write: PayOutcome) -> ::core::result::Result<(), PayError>;
}

/// The use case CancelOrder: Cancel.
/// Each action is two calls: `prepare_*` loads its rows by id and calls the dispatcher or transition function, writing nothing; the matching `commit_*` stores the rows, marks, and events the result holds in one transaction, each row only where it still is what the result's `<row>_expected` names. Either returns the use case's error and changes nothing when the use case does not run.
pub trait CancelOrderUseCase {
    /// Loads the rows of CancelOrder (the action CancelOrder) and runs it, writing nothing.
    fn prepare_cancel_order(&mut self, order: OrderId) -> ::core::result::Result<CancelOrderOutcome, CancelOrderError>;
    /// Stores what `prepare_cancel_order` returned in one transaction.
    fn commit_cancel_order(&mut self, write: CancelOrderOutcome) -> ::core::result::Result<(), CancelOrderError>;
}

/// The use case Place: Place.
/// Each action is two calls: `prepare_*` loads its rows by id and calls the dispatcher or transition function, writing nothing; the matching `commit_*` stores the rows, marks, and events the result holds in one transaction, each row only where it still is what the result's `<row>_expected` names. Either returns the use case's error and changes nothing when the use case does not run.
pub trait PlaceUseCase {
    /// Loads the rows of Place (the action Place) and runs it, writing nothing.
    fn prepare_place(&mut self, parent_customer: CustomerId, order_id: OrderId, order_method: PaymentMethod) -> ::core::result::Result<PlaceResult, PlaceError>;
    /// Stores what `prepare_place` returned in one transaction.
    fn commit_place(&mut self, write: PlaceResult) -> ::core::result::Result<(), PlaceError>;
}
