pub enum Order {
    /// The state `pending`.
    Pending(OrderPending),
    /// The state `paid`.
    Paid(OrderPaid),
    /// The state `cancelled`.
    Cancelled(OrderCancelled),
}

impl Order {
    /// The state it is in.
    pub fn kind(&self) -> OrderKind {
        match self {
            Self::Pending(_) => OrderKind::Pending,
            Self::Paid(_) => OrderKind::Paid,
            Self::Cancelled(_) => OrderKind::Cancelled,
        }
    }
}

impl ::core::convert::From<OrderPending> for Order {
    fn from(state: OrderPending) -> Self {
        Self::Pending(state)
    }
}

impl ::core::convert::From<OrderPaid> for Order {
    fn from(state: OrderPaid) -> Self {
        Self::Paid(state)
    }
}

impl ::core::convert::From<OrderCancelled> for Order {
    fn from(state: OrderCancelled) -> Self {
        Self::Cancelled(state)
    }
}

