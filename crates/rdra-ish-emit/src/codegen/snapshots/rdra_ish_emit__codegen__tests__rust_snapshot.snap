/// What a row a result writes must still be when the write commits, so the store can write
/// it conditionally and take a write that matches no row as `NotEnabled` (see the obligations).
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum ExpectedSource {
    /// The row is created: no row has its id.
    Absent,
    /// The row exists.
    Present,
    /// The row exists, and its `column` holds `value`.
    In {
        /// The column, as the row spells it.
        column: &'static str,
        /// The value, as the model spells it.
        value: &'static str,
    },
}

/// What `pay` returns.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct PayResult {
    /// The row `order` to write.
    pub order: OrderPaid,
    /// What `order` must still be when it is written.
    pub order_expected: ExpectedSource,
}

/// Pay (Pay).
/// One run of the use case, from the states of the arguments' types. It requires what `Pay` requires and writes what it writes; the values the model leaves open are the inputs.
pub fn pay(order: OrderPending, order_paid_at: DateTime) -> ::core::result::Result<PayResult, PayError> {
    ::core::result::Result::Ok(PayResult {
        order: OrderPaid {
            id: order.id,
            total: order.total,
            paid_at: order_paid_at,
            method: order.method,
            delivered_at: order.delivered_at,
            r#type: order.r#type,
            customer_id: order.customer_id,
        },
        order_expected: ExpectedSource::In { column: "status", value: "pending" },
    })
}

/// What `cancel_order` returns.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct CancelOrderResult {
    /// The row `order` to write.
    pub order: OrderCancelled,
