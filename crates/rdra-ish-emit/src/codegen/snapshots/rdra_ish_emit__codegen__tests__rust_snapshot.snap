    pub order_expected: ExpectedSource,
}

/// Cancel (CancelOrder).
/// One run of the use case, from the states of the arguments' types. It requires what `CancelOrder` requires and writes what it writes; the values the model leaves open are the inputs.
pub fn cancel_order(order: OrderPending) -> ::core::result::Result<CancelOrderResult, CancelOrderError> {
    ::core::result::Result::Ok(CancelOrderResult {
        order: OrderCancelled {
            id: order.id,
            total: order.total,
            paid_at: ::core::option::Option::None,
            method: order.method,
            delivered_at: order.delivered_at,
            r#type: order.r#type,
            customer_id: order.customer_id,
        },
        order_expected: ExpectedSource::In { column: "status", value: "pending" },
    })
}

/// What `place` returns.
