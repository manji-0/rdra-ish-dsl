/** The outcome of a call that can fail: its value, or an error value. No generated function throws. */
export type Result<T, E> = Readonly<{ ok: true; value: T }> | Readonly<{ ok: false; error: E }>;

/** Makes a Result: `Result.ok(value)`, `Result.err(error)`. */
export const Result = {
  ok: <T>(value: T): Result<T, never> => ({ ok: true, value }),
  err: <E>(error: E): Result<never, E> => ({ ok: false, error }),
} as const;

/**
 * Ends a `switch` that has a case for every value: the compiler fails it when a value has none.
 * It throws only if a value outside the type gets in, which the types rule out.
 */
export function assertNever(value: never): never {
  throw new globalThis.Error(`rdra-ish: a value outside its type: ${globalThis.JSON.stringify(value)}`);
}

/** A value that is not one of its type's: the type's name, and why. */
export type InvalidValue = Readonly<{ kind: "InvalidValue"; type: string; reason: string }>;

/**
 * A row that is not one of its type's: the entity, the column (null when the value is no
 * object at all), and why, such as a column its state rules out.
 */
export type InvalidRow = Readonly<{ kind: "InvalidRow"; entity: string; column: string | null; reason: string }>;

// ── Reading values from outside (private) ──

function $invalidValue(type: string, reason: string): Result<never, InvalidValue> {
  return { ok: false, error: { kind: "InvalidValue", type, reason } };
}

function $isObject(value: unknown): value is Readonly<Record<string, unknown>> {
  return typeof value === "object" && value !== null;
}

function $column(entity: string, column: string, error: InvalidValue): Result<never, InvalidRow> {
  return { ok: false, error: { kind: "InvalidRow", entity, column, reason: `${error.type}: ${error.reason}` } };
}

