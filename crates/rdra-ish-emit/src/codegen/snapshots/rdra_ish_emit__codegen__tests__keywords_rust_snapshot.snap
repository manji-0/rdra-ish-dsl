/// Which state a Match is in: its discriminant.
/// The domain's own: the tag column `status` lives only in [`MatchRow`].
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, PartialOrd, Ord)]
pub enum MatchKind {
    /// The state `new`.
    New,
    /// The state `return`.
    Return,
    /// The state `self`.
    Self_,
    /// The state `super`.
    Super,
    /// The state `crate`.
    Crate,
    /// The state `default`.
    Default,
}

/// M
/// One of its states, told apart by `kind()`. A store holds it as [`MatchRow`]: `from_row` (or `TryFrom`) reads one, `into_row` (or `From`) writes one.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum Match {
    /// The state `new`.
    New(MatchNew),
    /// The state `return`.
    Return(MatchReturn),
    /// The state `self`.
    Self_(MatchSelf),
    /// The state `super`.
    Super(MatchSuper),
    /// The state `crate`.
    Crate(MatchCrate),
    /// The state `default`.
    Default(MatchDefault),
}

impl Match {
    /// The state it is in.
    pub fn kind(&self) -> MatchKind {
        match self {
            Self::New(_) => MatchKind::New,
            Self::Return(_) => MatchKind::Return,
            Self::Self_(_) => MatchKind::Self_,
            Self::Super(_) => MatchKind::Super,
            Self::Crate(_) => MatchKind::Crate,
            Self::Default(_) => MatchKind::Default,
        }
    }
}

impl ::core::convert::From<MatchNew> for Match {
    fn from(state: MatchNew) -> Self {
        Self::New(state)
    }
}

impl ::core::convert::From<MatchReturn> for Match {
    fn from(state: MatchReturn) -> Self {
        Self::Return(state)
    }
}

impl ::core::convert::From<MatchSelf> for Match {
    fn from(state: MatchSelf) -> Self {
        Self::Self_(state)
    }
}

impl ::core::convert::From<MatchSuper> for Match {
    fn from(state: MatchSuper) -> Self {
        Self::Super(state)
    }
}

impl ::core::convert::From<MatchCrate> for Match {
    fn from(state: MatchCrate) -> Self {
        Self::Crate(state)
    }
}

impl ::core::convert::From<MatchDefault> for Match {
    fn from(state: MatchDefault) -> Self {
        Self::Default(state)
    }
}

