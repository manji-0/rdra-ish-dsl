            Self::Return(state) => state.rule_violations(),
            Self::Self_(state) => state.rule_violations(),
            Self::Super(state) => state.rule_violations(),
            Self::Crate(state) => state.rule_violations(),
            Self::Default(state) => state.rule_violations(),
