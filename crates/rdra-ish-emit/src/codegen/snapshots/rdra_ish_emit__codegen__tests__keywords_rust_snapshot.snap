// ── Rows: the flat shape a store or the wire holds ──

/// A row that fits no state of its entity: `from_row` refuses it.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct InvalidRow {
    /// The entity.
    pub entity: &'static str,
    /// The column that breaks what the state requires.
    pub column: &'static str,
    /// What the state requires of it.
    pub reason: &'static str,
}

impl ::core::fmt::Display for InvalidRow {
    fn fmt(&self, f: &mut ::core::fmt::Formatter<'_>) -> ::core::fmt::Result {
        write!(f, "{}.{}: {}", self.entity, self.column, self.reason)
    }
}

impl ::std::error::Error for InvalidRow {}

/// Every column of Func as the data layer declares it: the shape a store or the wire holds. The
/// scalars it holds were parsed when it was built.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct FuncRow {
    /// The column `id`.
    pub id: FuncId,
    /// The column `type`.
    pub r#type: FuncType,
}

impl ::core::convert::TryFrom<FuncRow> for Func {
    type Error = InvalidRow;

    /// The state of a row, or why the row fits none.
    fn try_from(row: FuncRow) -> ::core::result::Result<Self, InvalidRow> {
        match row.r#type {
            FuncType::New => {
                ::core::result::Result::Ok(Self::New(FuncNew { id: row.id }))
            }
            FuncType::Return => {
                ::core::result::Result::Ok(Self::Return(FuncReturn { id: row.id }))
            }
            FuncType::Func => {
                ::core::result::Result::Ok(Self::Func(FuncFunc { id: row.id }))
            }
        }
    }
}

impl ::core::convert::From<Func> for FuncRow {
    /// The flat row of a state.
    fn from(state: Func) -> Self {
        match state {
            Func::New(s) => Self { id: s.id, r#type: FuncType::New },
            Func::Return(s) => Self { id: s.id, r#type: FuncType::Return },
            Func::Func(s) => Self { id: s.id, r#type: FuncType::Func },
        }
    }
}

impl Func {
    /// The state of a row, or why the row fits none: [`TryFrom`] by name.
    ///
    /// # Errors
    ///
    /// [`InvalidRow`] when the row fits no state.
    pub fn from_row(row: FuncRow) -> ::core::result::Result<Self, InvalidRow> {
        <Self as ::core::convert::TryFrom<FuncRow>>::try_from(row)
    }

    /// The flat row of this state: [`From`] by name.
    pub fn into_row(self) -> FuncRow {
        FuncRow::from(self)
    }
}

/// Every column of Match as the data layer declares it: the shape a store or the wire holds. The
/// scalars it holds were parsed when it was built.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct MatchRow {
    /// The column `id`.
