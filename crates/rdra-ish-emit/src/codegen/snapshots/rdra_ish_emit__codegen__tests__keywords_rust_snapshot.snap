impl IntoWrites for StaticResult {
    fn into_writes(self) -> Writes {
        let row_0 = self.function;
        Writes {
            usecase: "Static",
            rows: ::std::vec![
                RowWrite::Put { id: StoredId::Function(row_0.id), row: StoredRow::Function(row_0), expected: self.function_expected },
            ],
            marks: ::std::vec::Vec::new(),
            events: ::std::vec::Vec::new(),
        }
