/// What a row a result writes must still be when the write commits, so the store can write
/// it conditionally and take a write that matches no row as `NotEnabled` (see the obligations).
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum ExpectedSource {
    /// The row is created: no row has its id.
    Absent,
    /// The row exists.
    Present,
    /// The row exists, and its `column` holds `value`.
    In {
        /// The column, as the row spells it.
        column: &'static str,
        /// The value, as the model spells it.
        value: &'static str,
    },
}

/// What `r#return` returns.
