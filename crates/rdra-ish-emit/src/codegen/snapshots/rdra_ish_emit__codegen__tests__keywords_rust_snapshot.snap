/// What a row a result writes must still be when the write commits, so the store can write
/// it conditionally and take a write that matches no row as `NotEnabled` (see the obligations).
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum ExpectedSource {
    /// The row is created: no row has its id.
    Absent,
    /// The row exists.
    Present,
    /// The row exists, and its `column` holds `value`.
    In { column: &'static str, value: &'static str },
}

/// What `r#return` returns.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct ReturnResult {
    pub r#match: MatchReturn,
    /// What `match` must still be when it is written.
    pub match_expected: ExpectedSource,
    pub switch: Switch,
}

/// Return (Return).
/// One run of the use case, from the states of the arguments' types. It requires what `Return` requires and writes what it writes; the values the model leaves open are the inputs.
pub fn r#return(r#match: MatchNew) -> ReturnResult {
    let out_switch = Switch { match_id: r#match.id.clone() };
    ReturnResult {
        r#match: MatchReturn {
            id: r#match.id,
            r#type: r#match.r#type,
            default: r#match.default,
            new: r#match.new,
            func: r#match.func,
            self_: r#match.self_,
            crate_: r#match.crate_,
            super_: r#match.super_,
            kind: r#match.kind,
            function_id: r#match.function_id,
            func_id: r#match.func_id,
            mod_id: r#match.mod_id,
        },
        match_expected: ExpectedSource::In { column: "status", value: "new" },
        switch: out_switch,
    }
}

