}

impl IntoWrites for ReturnOutcome {
    fn into_writes(self) -> Writes {
        match self {
            Self::Ran(r) => r.into_writes(),
        }
    }
}

impl IntoWrites for DeleteOutcome {
    fn into_writes(self) -> Writes {
        match self {
            Self::Ran(r) => r.into_writes(),
        }
    }
}

impl IntoWrites for SuperOutcome {
    fn into_writes(self) -> Writes {
