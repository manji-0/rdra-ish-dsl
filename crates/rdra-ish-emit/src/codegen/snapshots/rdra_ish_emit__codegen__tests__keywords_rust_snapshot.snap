/// Delete (Delete).
/// One run of the use case, from the states of the arguments' types. It requires what `Delete` requires and writes what it writes; the values the model leaves open are the inputs.
pub fn delete(r#match: MatchReturn, switch: Switch) -> DeleteResult {
    if r#match.id != switch.match_id {
        panic!("rdra-ish: the Match row is not the row the event was raised on");
    }
    DeleteResult {
