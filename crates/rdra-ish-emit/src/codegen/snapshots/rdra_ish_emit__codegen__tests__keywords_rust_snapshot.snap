    pub mod_id: ModId,
}

impl ::core::convert::TryFrom<MatchRow> for Match {
    type Error = InvalidRow;

    /// The state of a row, or why the row fits none.
    fn try_from(row: MatchRow) -> ::core::result::Result<Self, InvalidRow> {
        match row.status {
            MatchStatus::New => {
                ::core::result::Result::Ok(Self::New(MatchNew { id: row.id, r#type: row.r#type, default: row.default, new: row.new, func: row.func, self_: row.self_, crate_: row.crate_, super_: row.super_, kind_: row.kind, function_id: row.function_id, func_id: row.func_id, mod_id: row.mod_id }))
            }
            MatchStatus::Return => {
                ::core::result::Result::Ok(Self::Return(MatchReturn { id: row.id, r#type: row.r#type, default: row.default, new: row.new, func: row.func, self_: row.self_, crate_: row.crate_, super_: row.super_, kind_: row.kind, function_id: row.function_id, func_id: row.func_id, mod_id: row.mod_id }))
            }
            MatchStatus::Self_ => {
                ::core::result::Result::Ok(Self::Self_(MatchSelf { id: row.id, r#type: row.r#type, default: row.default, new: row.new, func: row.func, self_: row.self_, crate_: row.crate_, super_: row.super_, kind_: row.kind, function_id: row.function_id, func_id: row.func_id, mod_id: row.mod_id }))
            }
            MatchStatus::Super => {
                ::core::result::Result::Ok(Self::Super(MatchSuper { id: row.id, r#type: row.r#type, default: row.default, new: row.new, func: row.func, self_: row.self_, crate_: row.crate_, super_: row.super_, kind_: row.kind, function_id: row.function_id, func_id: row.func_id, mod_id: row.mod_id }))
            }
            MatchStatus::Crate => {
                ::core::result::Result::Ok(Self::Crate(MatchCrate { id: row.id, r#type: row.r#type, default: row.default, new: row.new, func: row.func, self_: row.self_, crate_: row.crate_, super_: row.super_, kind_: row.kind, function_id: row.function_id, func_id: row.func_id, mod_id: row.mod_id }))
            }
            MatchStatus::Default => {
                ::core::result::Result::Ok(Self::Default(MatchDefault { id: row.id, r#type: row.r#type, default: row.default, new: row.new, func: row.func, self_: row.self_, crate_: row.crate_, super_: row.super_, kind_: row.kind, function_id: row.function_id, func_id: row.func_id, mod_id: row.mod_id }))
            }
        }
    }
}

impl ::core::convert::From<Match> for MatchRow {
    /// The flat row of a state.
    fn from(state: Match) -> Self {
        match state {
            Match::New(s) => Self { id: s.id, status: MatchStatus::New, r#type: s.r#type, default: s.default, new: s.new, func: s.func, self_: s.self_, crate_: s.crate_, super_: s.super_, kind: s.kind_, function_id: s.function_id, func_id: s.func_id, mod_id: s.mod_id },
            Match::Return(s) => Self { id: s.id, status: MatchStatus::Return, r#type: s.r#type, default: s.default, new: s.new, func: s.func, self_: s.self_, crate_: s.crate_, super_: s.super_, kind: s.kind_, function_id: s.function_id, func_id: s.func_id, mod_id: s.mod_id },
            Match::Self_(s) => Self { id: s.id, status: MatchStatus::Self_, r#type: s.r#type, default: s.default, new: s.new, func: s.func, self_: s.self_, crate_: s.crate_, super_: s.super_, kind: s.kind_, function_id: s.function_id, func_id: s.func_id, mod_id: s.mod_id },
            Match::Super(s) => Self { id: s.id, status: MatchStatus::Super, r#type: s.r#type, default: s.default, new: s.new, func: s.func, self_: s.self_, crate_: s.crate_, super_: s.super_, kind: s.kind_, function_id: s.function_id, func_id: s.func_id, mod_id: s.mod_id },
            Match::Crate(s) => Self { id: s.id, status: MatchStatus::Crate, r#type: s.r#type, default: s.default, new: s.new, func: s.func, self_: s.self_, crate_: s.crate_, super_: s.super_, kind: s.kind_, function_id: s.function_id, func_id: s.func_id, mod_id: s.mod_id },
            Match::Default(s) => Self { id: s.id, status: MatchStatus::Default, r#type: s.r#type, default: s.default, new: s.new, func: s.func, self_: s.self_, crate_: s.crate_, super_: s.super_, kind: s.kind_, function_id: s.function_id, func_id: s.func_id, mod_id: s.mod_id },
        }
    }
}

impl Match {
    /// The state of a row, or why the row fits none: [`TryFrom`] by name.
    ///
    /// # Errors
    ///
    /// [`InvalidRow`] when the row fits no state.
    pub fn from_row(row: MatchRow) -> ::core::result::Result<Self, InvalidRow> {
        <Self as ::core::convert::TryFrom<MatchRow>>::try_from(row)
    }

    /// The flat row of this state: [`From`] by name.
    pub fn into_row(self) -> MatchRow {
        MatchRow::from(self)
    }
}

// ── Dispatch: run a use case from whatever states its rows are in ──

/// What `run_return` returns when the use case runs.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum ReturnOutcome {
    /// `r#return` ran.
    Ran(ReturnResult),
}

/// Runs Return from whatever states its rows are in: the transition function of those states.
///
/// # Errors
///
/// `NotEnabled` when the rows are in states it does not run from, and what the transition
/// function returns.
pub fn run_return(r#match: Match) -> ::core::result::Result<ReturnOutcome, ReturnError> {
    match (r#match,) {
        (Match::New(r#match),) => r#return(r#match).map(ReturnOutcome::Ran),
        _ => ::core::result::Result::Err(ReturnError::NotEnabled(NotEnabled { usecase: "Return" })),
    }
}

/// What `run_delete` returns when the use case runs.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum DeleteOutcome {
    /// `delete` ran.
    Ran(DeleteResult),
}

/// Runs Delete from whatever states its rows are in: the transition function of those states.
///
/// # Errors
///
/// `NotEnabled` when the rows are in states it does not run from, and what the transition
/// function returns.
pub fn run_delete(r#match: Match, switch: Switch) -> ::core::result::Result<DeleteOutcome, DeleteError> {
    match (r#match,) {
        (Match::Return(r#match),) => delete(r#match, switch).map(DeleteOutcome::Ran),
        _ => ::core::result::Result::Err(DeleteError::NotEnabled(NotEnabled { usecase: "Delete" })),
    }
}

/// What `run_super` returns when the use case runs.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum SuperOutcome {
    /// `super_` ran.
    Ran(SuperResult),
}

/// Runs Super from whatever states its rows are in: the transition function of those states.
///
/// # Errors
///
/// `NotEnabled` when the rows are in states it does not run from, and what the transition
/// function returns.
pub fn run_super(r#match: Match) -> ::core::result::Result<SuperOutcome, SuperError> {
    match (r#match,) {
        (Match::Self_(r#match),) => super_(r#match).map(SuperOutcome::Ran),
        _ => ::core::result::Result::Err(SuperError::NotEnabled(NotEnabled { usecase: "Super" })),
    }
}

/// What `run_crate` returns when the use case runs.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum CrateOutcome {
    /// `crate_` ran.
    Ran(CrateResult),
}

/// Runs Crate from whatever states its rows are in: the transition function of those states.
///
/// # Errors
///
/// `NotEnabled` when the rows are in states it does not run from, and what the transition
/// function returns.
pub fn run_crate(r#match: Match) -> ::core::result::Result<CrateOutcome, CrateError> {
    match (r#match,) {
        (Match::Super(r#match),) => crate_(r#match).map(CrateOutcome::Ran),
        _ => ::core::result::Result::Err(CrateError::NotEnabled(NotEnabled { usecase: "Crate" })),
    }
}

/// What `run_default` returns when the use case runs.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum DefaultOutcome {
    /// `default` ran.
    Ran(DefaultResult),
}

/// Runs Default from whatever states its rows are in: the transition function of those states.
///
/// # Errors
///
/// `NotEnabled` when the rows are in states it does not run from, and what the transition
/// function returns.
pub fn run_default(r#match: Match) -> ::core::result::Result<DefaultOutcome, DefaultError> {
    match (r#match,) {
        (Match::Crate(r#match),) => default(r#match).map(DefaultOutcome::Ran),
        _ => ::core::result::Result::Err(DefaultError::NotEnabled(NotEnabled { usecase: "Default" })),
    }
}

/// What `run_type` returns when the use case runs.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum TypeOutcome {
    /// `r#type` ran.
    Ran(TypeResult),
}

/// Runs Type from whatever states its rows are in: the transition function of those states.
///
/// # Errors
///
/// `NotEnabled` when the rows are in states it does not run from, and what the transition
/// function returns.
pub fn run_type(func: Func) -> ::core::result::Result<TypeOutcome, TypeError> {
    match (func,) {
        (Func::New(func),) => r#type(func).map(TypeOutcome::Ran),
        _ => ::core::result::Result::Err(TypeError::NotEnabled(NotEnabled { usecase: "Type" })),
    }
}

/// What `run_class` returns when the use case runs.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum ClassOutcome {
    /// `class` ran.
    Ran(ClassResult),
}

/// Runs Class from whatever states its rows are in: the transition function of those states.
///
/// # Errors
///
/// `NotEnabled` when the rows are in states it does not run from, and what the transition
/// function returns.
pub fn run_class(func: Func) -> ::core::result::Result<ClassOutcome, ClassError> {
    match (func,) {
        (Func::Return(func),) => class(func).map(ClassOutcome::Ran),
        _ => ::core::result::Result::Err(ClassError::NotEnabled(NotEnabled { usecase: "Class" })),
    }
}

/// What `run_new` returns when the use case runs.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum NewOutcome {
    /// `new_from_new` ran.
    FromNew(NewFromNewResult),
    /// `new_from_return` ran.
    FromReturn(NewFromReturnResult),
    /// `new_from_func` ran.
    FromFunc(NewFromFuncResult),
}

/// Runs New from whatever states its rows are in: the transition function of those states.
///
/// # Errors
///
/// `NotEnabled` when the rows are in states it does not run from, and what the transition
/// function returns.
#[allow(clippy::too_many_arguments)] // one argument per row and input of the use case
pub fn run_new(parent_function: Function, parent_func: Func, parent_mod: Mod, match_id: MatchId, match_type: ::std::string::String, match_new: ::std::string::String, match_func: ::std::string::String, match_self: ::std::string::String, match_crate: ::std::string::String, match_super: ::std::string::String, match_kind: Kind) -> ::core::result::Result<NewOutcome, NewError> {
    match (parent_function, parent_func, parent_mod,) {
        (parent_function, Func::New(parent_func), parent_mod,) => new_from_new(parent_function, parent_func, parent_mod, match_id, match_type, match_new, match_func, match_self, match_crate, match_super, match_kind).map(NewOutcome::FromNew),
        (parent_function, Func::Return(parent_func), parent_mod,) => new_from_return(parent_function, parent_func, parent_mod, match_id, match_type, match_new, match_func, match_self, match_crate, match_super, match_kind).map(NewOutcome::FromReturn),
        (parent_function, Func::Func(parent_func), parent_mod,) => new_from_func(parent_function, parent_func, parent_mod, match_id, match_type, match_new, match_func, match_self, match_crate, match_super, match_kind).map(NewOutcome::FromFunc),
    }
}

// ── Commit: what a result writes ──

/// A row of any entity, as a store holds it: the case names the entity.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum StoredRow {
    /// A row of Function.
    Function(Function),
    /// A row of Mod.
    Mod(Mod),
    /// A row of Func.
    Func(FuncRow),
    /// A row of Match.
    Match(MatchRow),
}

impl StoredRow {
    /// The entity of the row, as the model names it.
    pub fn entity(&self) -> &'static str {
        match *self {
            Self::Function(_) => "Function",
            Self::Mod(_) => "Mod",
            Self::Func(_) => "Func",
            Self::Match(_) => "Match",
        }
    }
}

/// The id of a row of any entity: the case names the entity.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum StoredId {
    /// An id of Function.
    Function(FunctionId),
    /// An id of Mod.
    Mod(ModId),
    /// An id of Func.
    Func(FuncId),
    /// An id of Match.
    Match(MatchId),
}

impl StoredId {
    /// The entity of the row, as the model names it.
    pub fn entity(&self) -> &'static str {
        match *self {
            Self::Function(_) => "Function",
            Self::Mod(_) => "Mod",
            Self::Func(_) => "Func",
            Self::Match(_) => "Match",
        }
    }
}

/// One row a commit writes, only where the row is still what `expected` names: when it is
/// not, the commit writes nothing and the call is `NotEnabled`.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum RowWrite {
    /// Store the row: insert it when `expected` is `Absent`, else update it.
    Put {
        /// The row's id.
        id: StoredId,
        /// The row.
        row: StoredRow,
        /// What the row must still be.
        expected: ExpectedSource,
    },
    /// Delete the row.
    Delete {
        /// The row's id.
        id: StoredId,
        /// What the row must still be.
        expected: ExpectedSource,
    },
}

/// A run mark of a use case split into transactions, on one row: the case names the use
/// case and the entity.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum RunMark {}

impl RunMark {
    /// The use case of the run, as the model names it.
    pub fn usecase(&self) -> &'static str {
        match *self {
        }
    }

    /// The entity of the marked row, as the model names it.
    pub fn entity(&self) -> &'static str {
        match *self {
        }
    }

    /// The step of the run that last wrote the row.
    pub fn step(&self) -> u8 {
        match *self {
        }
    }
}

/// One run mark a commit writes.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum MarkWrite {
    /// Store the mark: insert it at step 1, where the row holds no mark of the use case;
    /// at a later step, advance the row's mark from the step before.
    Put(RunMark),
    /// Delete the mark, which is at the step it names: the run ends on the row.
    Delete(RunMark),
}

/// An event of any type a use case raises: the case names the event.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum RaisedEvent {
    /// The event Switch.
    Switch(Switch),
}

/// What one commit stores, in order: the rows, then the run marks, then the events.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct Writes {
    /// The use case whose result it is.
    pub usecase: &'static str,
    /// The rows to write.
    pub rows: ::std::vec::Vec<RowWrite>,
    /// The run marks to store, advance, or delete.
    pub marks: ::std::vec::Vec<MarkWrite>,
    /// The events raised.
    pub events: ::std::vec::Vec<RaisedEvent>,
}

/// A result or an outcome a commit stores: every row, run mark, and event it writes.
pub trait IntoWrites {
    /// The writes, in the order a commit makes them.
    fn into_writes(self) -> Writes;
}

impl IntoWrites for ReturnResult {
    fn into_writes(self) -> Writes {
        let row_0 = Match::from(self.r#match).into_row();
        Writes {
            usecase: "Return",
            rows: ::std::vec![
                RowWrite::Put { id: StoredId::Match(row_0.id), row: StoredRow::Match(row_0), expected: self.match_expected },
            ],
            marks: ::std::vec::Vec::new(),
            events: ::std::vec![
                RaisedEvent::Switch(self.switch),
            ],
        }
    }
}

impl IntoWrites for DeleteResult {
    fn into_writes(self) -> Writes {
        let row_0 = Match::from(self.r#match).into_row();
        Writes {
            usecase: "Delete",
            rows: ::std::vec![
                RowWrite::Put { id: StoredId::Match(row_0.id), row: StoredRow::Match(row_0), expected: self.match_expected },
            ],
            marks: ::std::vec::Vec::new(),
            events: ::std::vec::Vec::new(),
        }
    }
}

impl IntoWrites for SuperResult {
    fn into_writes(self) -> Writes {
        let row_0 = Match::from(self.r#match).into_row();
        Writes {
            usecase: "Super",
            rows: ::std::vec![
