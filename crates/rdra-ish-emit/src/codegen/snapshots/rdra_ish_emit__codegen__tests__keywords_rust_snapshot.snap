}

impl IntoWrites for NewOutcome {
    fn into_writes(self) -> Writes {
        match self {
            Self::FromNew(r) => r.into_writes(),
            Self::FromReturn(r) => r.into_writes(),
            Self::FromFunc(r) => r.into_writes(),
        }
    }
}

/// A store that commits a result, inside the transaction of the call: [`commit_writes`] calls it
/// once per write, in order. Each method writes one item only where it is still what it names.
pub trait CommitStore {
    /// The store's own error: a failure of the store, not an answer of the use case.
    type Error;

    /// Writes the row where it is still what its `expected` names: `Ok(false)`, and nothing
    /// written, when it is not.
    ///
    /// # Errors
    ///
    /// The store's error when the store fails.
    fn write_row(&mut self, write: RowWrite) -> ::core::result::Result<bool, Self::Error>;

    /// Writes the run mark where the row's mark is still what the step needs: none of the
    /// use case for a put at step 1, the step before for a later put, the mark's own step for
    /// a delete. `Ok(false)`, and nothing written, when it is not.
    ///
    /// # Errors
    ///
    /// The store's error when the store fails.
    fn write_mark(&mut self, write: MarkWrite) -> ::core::result::Result<bool, Self::Error>;

    /// Records a raised event.
    ///
    /// # Errors
    ///
    /// The store's error when the store fails.
    fn record_event(&mut self, event: RaisedEvent) -> ::core::result::Result<(), Self::Error>;
}

/// Why [`commit_writes`] stopped. Either way the caller rolls the transaction back.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum CommitFailed<E> {
    /// A row or a run mark is no longer what the result expects: another call changed it,
    /// and the use case does not run from the state it left.
    NotEnabled(NotEnabled),
    /// The store failed.
    Store(E),
}

impl<E: ::core::fmt::Display> ::core::fmt::Display for CommitFailed<E> {
    fn fmt(&self, f: &mut ::core::fmt::Formatter<'_>) -> ::core::fmt::Result {
        match self {
            Self::NotEnabled(e) => ::core::fmt::Display::fmt(e, f),
            Self::Store(e) => write!(f, "the store failed: {e}"),
        }
    }
}

impl<E: ::std::error::Error + 'static> ::std::error::Error for CommitFailed<E> {
    fn source(&self) -> ::core::option::Option<&(dyn ::std::error::Error + 'static)> {
        match self {
            Self::NotEnabled(e) => ::core::option::Option::Some(e),
            Self::Store(e) => ::core::option::Option::Some(e),
        }
    }
}

/// Commits `writes` through `store`: every row, then every run mark, then every event, and
/// stops at the first row or mark that is no longer what it names. It begins and ends no
/// transaction: call it inside the transaction of the call, and roll back on an error.
///
/// # Errors
///
/// `NotEnabled` when a row or a run mark is no longer what the result expects, and the store's
/// error when the store fails.
pub fn commit_writes<S: CommitStore + ?Sized>(store: &mut S, writes: impl IntoWrites) -> ::core::result::Result<(), CommitFailed<S::Error>> {
    let writes = writes.into_writes();
    let not_enabled = NotEnabled { usecase: writes.usecase };
    for write in writes.rows {
        if !store.write_row(write).map_err(CommitFailed::Store)? {
            return ::core::result::Result::Err(CommitFailed::NotEnabled(not_enabled));
        }
    }
    for write in writes.marks {
        if !store.write_mark(write).map_err(CommitFailed::Store)? {
            return ::core::result::Result::Err(CommitFailed::NotEnabled(not_enabled));
        }
    }
    for event in writes.events {
        store.record_event(event).map_err(CommitFailed::Store)?;
    }
    ::core::result::Result::Ok(())
}

// ── Contracts: one per use case, which the service implements ──

/// The use case Return: Return.
/// Each action with functions is two calls: `prepare_*` loads its rows by id and calls the dispatcher or transition function, writing nothing; the matching `commit_*` stores the rows, marks, and events the result holds in one transaction, each row only where it still is what the result's `<row>_expected` names. Either returns the use case's error and changes nothing when the use case does not run.
pub trait ReturnUseCase {
    /// Loads the rows of Return (the action Return) and runs it, writing nothing.
    fn prepare_return(&mut self, r#match: MatchId) -> ::core::result::Result<ReturnOutcome, ReturnError>;
    /// Stores what `prepare_return` returned in one transaction.
    fn commit_return(&mut self, write: ReturnOutcome) -> ::core::result::Result<(), ReturnError>;
}

/// Implement it for a service that does not implement `ReturnUseCase` yet: the service then has `ReturnUseCase`, each method of which panics as `unimplemented!` does. `conform` stops a trace at such a call and reports the calls by use case; `rdra-ish check --code=run` lists them, and `--deny-incomplete` fails on any. Remove the impl when the service implements `ReturnUseCase`.
pub trait UnimplementedReturnUseCase {}

impl<T: UnimplementedReturnUseCase> ReturnUseCase for T {
    fn prepare_return(&mut self, _: MatchId) -> ::core::result::Result<ReturnOutcome, ReturnError> {
        unimplemented!("rdra-ish unimplemented port")
    }
    fn commit_return(&mut self, _: ReturnOutcome) -> ::core::result::Result<(), ReturnError> {
        unimplemented!("rdra-ish unimplemented port")
    }
