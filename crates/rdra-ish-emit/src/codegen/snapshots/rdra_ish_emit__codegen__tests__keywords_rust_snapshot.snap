pub fn delete(r#match: MatchReturn, switch: Switch) -> ::core::result::Result<DeleteResult, DeleteError> {
    if r#match.id != switch.match_id {
        return ::core::result::Result::Err(DeleteError::InvalidArgument(InvalidArgument { usecase: "Delete", reason: "rdra-ish: the Match row is not the row the event was raised on" }));
