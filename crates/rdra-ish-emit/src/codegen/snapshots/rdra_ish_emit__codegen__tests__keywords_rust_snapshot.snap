impl IntoWrites for NewFromReturnResult {
    fn into_writes(self) -> Writes {
        let row_0 = Match::from(self.r#match).into_row();
        Writes {
            usecase: "New",
            rows: ::std::vec![
                RowWrite::Put { id: StoredId::Match(row_0.id), row: StoredRow::Match(row_0), expected: self.match_expected },
            ],
