/// Return (Return).
/// One run of the use case, from the states of the arguments' types. It requires what `Return` requires and writes what it writes; the values the model leaves open are the inputs.
pub fn r#return(r#match: MatchNew) -> ::core::result::Result<ReturnResult, ReturnError> {
    let out_switch = Switch { match_id: r#match.id };
    ::core::result::Result::Ok(ReturnResult {
        r#match: MatchReturn {
            id: r#match.id,
            r#type: r#match.r#type,
            default: r#match.default,
            new: r#match.new,
            func: r#match.func,
            self_: r#match.self_,
            crate_: r#match.crate_,
            super_: r#match.super_,
            kind_: r#match.kind_,
            function_id: r#match.function_id,
            func_id: r#match.func_id,
            mod_id: r#match.mod_id,
        },
        match_expected: ExpectedSource::In { column: "status", value: "new" },
        switch: out_switch,
    })
}

