// ── Rows: the flat shape a store or the wire holds ──

/// A row that breaks what the type of its state requires.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct InvalidRow {
    pub entity: &'static str,
    pub column: &'static str,
    pub reason: &'static str,
}

/// Every column of Func as the data layer declares it.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct FuncRow {
    pub id: FuncId,
    pub r#type: FuncType,
}

impl Func {
    /// The state of a row, or why the row fits none.
    pub fn from_row(row: FuncRow) -> ::core::result::Result<Self, InvalidRow> {
        match row.r#type {
            FuncType::New => {
                ::core::result::Result::Ok(Self::New(FuncNew { id: row.id }))
            }
            FuncType::Return => {
                ::core::result::Result::Ok(Self::Return(FuncReturn { id: row.id }))
            }
            FuncType::Func => {
                ::core::result::Result::Ok(Self::Func(FuncFunc { id: row.id }))
            }
        }
    }

    /// The flat row of this state.
    pub fn into_row(self) -> FuncRow {
        match self {
            Self::New(state) => FuncRow { id: state.id, r#type: FuncType::New },
            Self::Return(state) => FuncRow { id: state.id, r#type: FuncType::Return },
            Self::Func(state) => FuncRow { id: state.id, r#type: FuncType::Func },
        }
    }
}

/// Every column of Match as the data layer declares it.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct MatchRow {
    pub id: MatchId,
    pub status: MatchStatus,
    pub r#type: ::std::string::String,
    pub default: i64,
    pub new: ::std::string::String,
    pub func: ::std::string::String,
    pub self_: ::std::string::String,
    pub crate_: ::std::string::String,
    pub super_: ::std::string::String,
    pub kind: Kind,
    pub function_id: FunctionId,
    pub func_id: FuncId,
    pub mod_id: ModId,
}

impl Match {
    /// The state of a row, or why the row fits none.
    pub fn from_row(row: MatchRow) -> ::core::result::Result<Self, InvalidRow> {
        match row.status {
            MatchStatus::New => {
                ::core::result::Result::Ok(Self::New(MatchNew { id: row.id, r#type: row.r#type, default: row.default, new: row.new, func: row.func, self_: row.self_, crate_: row.crate_, super_: row.super_, kind: row.kind, function_id: row.function_id, func_id: row.func_id, mod_id: row.mod_id }))
            }
            MatchStatus::Return => {
                ::core::result::Result::Ok(Self::Return(MatchReturn { id: row.id, r#type: row.r#type, default: row.default, new: row.new, func: row.func, self_: row.self_, crate_: row.crate_, super_: row.super_, kind: row.kind, function_id: row.function_id, func_id: row.func_id, mod_id: row.mod_id }))
            }
            MatchStatus::Self_ => {
                ::core::result::Result::Ok(Self::Self_(MatchSelf { id: row.id, r#type: row.r#type, default: row.default, new: row.new, func: row.func, self_: row.self_, crate_: row.crate_, super_: row.super_, kind: row.kind, function_id: row.function_id, func_id: row.func_id, mod_id: row.mod_id }))
            }
            MatchStatus::Super => {
                ::core::result::Result::Ok(Self::Super(MatchSuper { id: row.id, r#type: row.r#type, default: row.default, new: row.new, func: row.func, self_: row.self_, crate_: row.crate_, super_: row.super_, kind: row.kind, function_id: row.function_id, func_id: row.func_id, mod_id: row.mod_id }))
            }
            MatchStatus::Crate => {
                ::core::result::Result::Ok(Self::Crate(MatchCrate { id: row.id, r#type: row.r#type, default: row.default, new: row.new, func: row.func, self_: row.self_, crate_: row.crate_, super_: row.super_, kind: row.kind, function_id: row.function_id, func_id: row.func_id, mod_id: row.mod_id }))
            }
            MatchStatus::Default => {
                ::core::result::Result::Ok(Self::Default(MatchDefault { id: row.id, r#type: row.r#type, default: row.default, new: row.new, func: row.func, self_: row.self_, crate_: row.crate_, super_: row.super_, kind: row.kind, function_id: row.function_id, func_id: row.func_id, mod_id: row.mod_id }))
            }
        }
    }

    /// The flat row of this state.
    pub fn into_row(self) -> MatchRow {
        match self {
            Self::New(state) => MatchRow { id: state.id, status: MatchStatus::New, r#type: state.r#type, default: state.default, new: state.new, func: state.func, self_: state.self_, crate_: state.crate_, super_: state.super_, kind: state.kind, function_id: state.function_id, func_id: state.func_id, mod_id: state.mod_id },
            Self::Return(state) => MatchRow { id: state.id, status: MatchStatus::Return, r#type: state.r#type, default: state.default, new: state.new, func: state.func, self_: state.self_, crate_: state.crate_, super_: state.super_, kind: state.kind, function_id: state.function_id, func_id: state.func_id, mod_id: state.mod_id },
            Self::Self_(state) => MatchRow { id: state.id, status: MatchStatus::Self_, r#type: state.r#type, default: state.default, new: state.new, func: state.func, self_: state.self_, crate_: state.crate_, super_: state.super_, kind: state.kind, function_id: state.function_id, func_id: state.func_id, mod_id: state.mod_id },
            Self::Super(state) => MatchRow { id: state.id, status: MatchStatus::Super, r#type: state.r#type, default: state.default, new: state.new, func: state.func, self_: state.self_, crate_: state.crate_, super_: state.super_, kind: state.kind, function_id: state.function_id, func_id: state.func_id, mod_id: state.mod_id },
            Self::Crate(state) => MatchRow { id: state.id, status: MatchStatus::Crate, r#type: state.r#type, default: state.default, new: state.new, func: state.func, self_: state.self_, crate_: state.crate_, super_: state.super_, kind: state.kind, function_id: state.function_id, func_id: state.func_id, mod_id: state.mod_id },
            Self::Default(state) => MatchRow { id: state.id, status: MatchStatus::Default, r#type: state.r#type, default: state.default, new: state.new, func: state.func, self_: state.self_, crate_: state.crate_, super_: state.super_, kind: state.kind, function_id: state.function_id, func_id: state.func_id, mod_id: state.mod_id },
        }
    }
}

// ── Dispatch: run a use case from whatever states its rows are in ──

/// The rows are in states the use case does not run from.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct NotEnabled {
    pub usecase: &'static str,
}

/// Why a use case did not run.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum Refused {
    Rejected(Rejected),
    NotEnabled(NotEnabled),
}

/// What `run_return` returns when the use case runs.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum ReturnOutcome {
    Ran(ReturnResult),
}

/// Runs Return from whatever states its rows are in: the transition function of those states, or `NotEnabled`.
pub fn run_return(r#match: Match) -> ::core::result::Result<ReturnOutcome, Refused> {
    match (r#match,) {
        (Match::New(r#match),) => ::core::result::Result::Ok(ReturnOutcome::Ran(r#return(r#match))),
        _ => ::core::result::Result::Err(Refused::NotEnabled(NotEnabled { usecase: "Return" })),
    }
}

/// What `run_delete` returns when the use case runs.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum DeleteOutcome {
    Ran(DeleteResult),
}

/// Runs Delete from whatever states its rows are in: the transition function of those states, or `NotEnabled`.
pub fn run_delete(r#match: Match, switch: Switch) -> ::core::result::Result<DeleteOutcome, Refused> {
    match (r#match,) {
        (Match::Return(r#match),) => ::core::result::Result::Ok(DeleteOutcome::Ran(delete(r#match, switch))),
        _ => ::core::result::Result::Err(Refused::NotEnabled(NotEnabled { usecase: "Delete" })),
    }
}

/// What `run_super` returns when the use case runs.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum SuperOutcome {
    Ran(SuperResult),
}

/// Runs Super from whatever states its rows are in: the transition function of those states, or `NotEnabled`.
pub fn run_super(r#match: Match) -> ::core::result::Result<SuperOutcome, Refused> {
    match (r#match,) {
        (Match::Self_(r#match),) => super_(r#match).map(SuperOutcome::Ran).map_err(Refused::Rejected),
        _ => ::core::result::Result::Err(Refused::NotEnabled(NotEnabled { usecase: "Super" })),
    }
}

/// What `run_crate` returns when the use case runs.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum CrateOutcome {
    Ran(CrateResult),
}

/// Runs Crate from whatever states its rows are in: the transition function of those states, or `NotEnabled`.
pub fn run_crate(r#match: Match) -> ::core::result::Result<CrateOutcome, Refused> {
    match (r#match,) {
        (Match::Super(r#match),) => ::core::result::Result::Ok(CrateOutcome::Ran(crate_(r#match))),
        _ => ::core::result::Result::Err(Refused::NotEnabled(NotEnabled { usecase: "Crate" })),
    }
}

/// What `run_default` returns when the use case runs.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum DefaultOutcome {
    Ran(DefaultResult),
}

/// Runs Default from whatever states its rows are in: the transition function of those states, or `NotEnabled`.
pub fn run_default(r#match: Match) -> ::core::result::Result<DefaultOutcome, Refused> {
    match (r#match,) {
        (Match::Crate(r#match),) => ::core::result::Result::Ok(DefaultOutcome::Ran(default(r#match))),
        _ => ::core::result::Result::Err(Refused::NotEnabled(NotEnabled { usecase: "Default" })),
    }
}

/// What `run_type` returns when the use case runs.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum TypeOutcome {
    Ran(TypeResult),
}

/// Runs Type from whatever states its rows are in: the transition function of those states, or `NotEnabled`.
pub fn run_type(func: Func) -> ::core::result::Result<TypeOutcome, Refused> {
    match (func,) {
        (Func::New(func),) => ::core::result::Result::Ok(TypeOutcome::Ran(r#type(func))),
        _ => ::core::result::Result::Err(Refused::NotEnabled(NotEnabled { usecase: "Type" })),
    }
}

/// What `run_class` returns when the use case runs.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum ClassOutcome {
    Ran(ClassResult),
}

/// Runs Class from whatever states its rows are in: the transition function of those states, or `NotEnabled`.
pub fn run_class(func: Func) -> ::core::result::Result<ClassOutcome, Refused> {
    match (func,) {
        (Func::Return(func),) => ::core::result::Result::Ok(ClassOutcome::Ran(class(func))),
        _ => ::core::result::Result::Err(Refused::NotEnabled(NotEnabled { usecase: "Class" })),
    }
}

/// What `run_new` returns when the use case runs.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum NewOutcome {
    FromNew(NewFromNewResult),
    FromReturn(NewFromReturnResult),
    FromFunc(NewFromFuncResult),
}

/// Runs New from whatever states its rows are in: the transition function of those states, or `NotEnabled`.
pub fn run_new(parent_function: Function, parent_func: Func, parent_mod: Mod, match_id: MatchId, match_type: ::std::string::String, match_new: ::std::string::String, match_func: ::std::string::String, match_self: ::std::string::String, match_crate: ::std::string::String, match_super: ::std::string::String, match_kind: Kind) -> ::core::result::Result<NewOutcome, Refused> {
    match (parent_function, parent_func, parent_mod,) {
        (parent_function, Func::New(parent_func), parent_mod,) => ::core::result::Result::Ok(NewOutcome::FromNew(new_from_new(parent_function, parent_func, parent_mod, match_id, match_type, match_new, match_func, match_self, match_crate, match_super, match_kind))),
        (parent_function, Func::Return(parent_func), parent_mod,) => ::core::result::Result::Ok(NewOutcome::FromReturn(new_from_return(parent_function, parent_func, parent_mod, match_id, match_type, match_new, match_func, match_self, match_crate, match_super, match_kind))),
        (parent_function, Func::Func(parent_func), parent_mod,) => ::core::result::Result::Ok(NewOutcome::FromFunc(new_from_func(parent_function, parent_func, parent_mod, match_id, match_type, match_new, match_func, match_self, match_crate, match_super, match_kind))),
    }
}
