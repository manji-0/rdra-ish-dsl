// Place runs Place (Place). One run of the use case, from the states of the arguments' types. It requires what `Place` requires and writes what it writes; the values the model leaves open are the inputs.
// It returns new values and changes none of its arguments; its error is a *PlaceError: InvalidArgument when its arguments break what the verified model keeps.
func Place(parentCustomer Customer, orderId OrderId, orderMethod PaymentMethod) (PlaceResult, error) {
	if !orderMethod.Valid() {
		return PlaceResult{}, &PlaceError{Kind: PlaceErrorInvalidArgument, Err: &InvalidArgument{Reason: "order_method is not a value of PaymentMethod"}}
	}
	return PlaceResult{Order: orderPendingState{id: orderId, total: 0, method: orderMethod, deliveredAt: nil, type_: nil, customerId: parentCustomer.Id}, OrderExpected: ExpectedSource{Absent: true}}, nil
}

// ── Rule checks ──

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row Customer) RuleViolations() []string {
	var out []string
	return out
}

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row OrderLine) RuleViolations() []string {
	var out []string
	return out
}

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row orderPendingState) RuleViolations() []string {
	var out []string
	return out
}

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row orderPaidState) RuleViolations() []string {
	var out []string
	return out
}

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row orderCancelledState) RuleViolations() []string {
	var out []string
	return out
}

// ── Rows: the flat shape a store or the wire holds ──

// InvalidRow reports a row whose values no state of its entity holds, by the column.
type InvalidRow struct {
	Entity string
	Column string
	Reason string
}

// Error names the entity, the column, and the reason.
func (e *InvalidRow) Error() string {
	return e.Entity + "." + e.Column + ": " + e.Reason
}

// OrderRow holds every column of Order as the data layer declares it, the tag status among them.
type OrderRow struct {
	Id          OrderId       `json:"id"`
	Total       Money         `json:"total"`
	Status      OrderStatus   `json:"status"`
	PaidAt      *DateTime     `json:"paid_at"`
	Method      PaymentMethod `json:"method"`
	DeliveredAt *DateTime     `json:"delivered_at"`
	Type        *string       `json:"type"`
	CustomerId  CustomerId    `json:"customer_id"`
}

// OrderFromRow returns the state row holds, or an *InvalidRow naming the column whose value no
// state of Order takes: a tag or a value outside its value set, a text not in its scalar's shape,
// or a null or a value where the state's rules say otherwise.
func OrderFromRow(row OrderRow) (Order, error) {
	switch row.Status {
	case OrderStatusPending:
		if row.PaidAt != nil {
			return nil, &InvalidRow{Entity: "Order", Column: "paid_at", Reason: "null in the state pending"}
		}
		if !row.Total.Valid() {
			return nil, &InvalidRow{Entity: "Order", Column: "total", Reason: "not a value of Money"}
		}
		if !row.Method.Valid() {
			return nil, &InvalidRow{Entity: "Order", Column: "method", Reason: "not a value of PaymentMethod"}
		}
		if row.DeliveredAt != nil && !row.DeliveredAt.Valid() {
			return nil, &InvalidRow{Entity: "Order", Column: "delivered_at", Reason: "not a value of DateTime"}
		}
		return orderPendingState{id: row.Id, total: row.Total, method: row.Method, deliveredAt: copyOf(row.DeliveredAt), type_: copyOf(row.Type), customerId: row.CustomerId}, nil
	case OrderStatusPaid:
		if !row.Total.Valid() {
			return nil, &InvalidRow{Entity: "Order", Column: "total", Reason: "not a value of Money"}
		}
		if row.PaidAt == nil {
			return nil, &InvalidRow{Entity: "Order", Column: "paid_at", Reason: "present in the state paid"}
		}
		if !row.PaidAt.Valid() {
			return nil, &InvalidRow{Entity: "Order", Column: "paid_at", Reason: "not a value of DateTime"}
		}
		if !row.Method.Valid() {
			return nil, &InvalidRow{Entity: "Order", Column: "method", Reason: "not a value of PaymentMethod"}
		}
		if row.DeliveredAt != nil && !row.DeliveredAt.Valid() {
			return nil, &InvalidRow{Entity: "Order", Column: "delivered_at", Reason: "not a value of DateTime"}
		}
		return orderPaidState{id: row.Id, total: row.Total, paidAt: *row.PaidAt, method: row.Method, deliveredAt: copyOf(row.DeliveredAt), type_: copyOf(row.Type), customerId: row.CustomerId}, nil
	case OrderStatusCancelled:
		if !row.Total.Valid() {
			return nil, &InvalidRow{Entity: "Order", Column: "total", Reason: "not a value of Money"}
		}
		if row.PaidAt != nil && !row.PaidAt.Valid() {
			return nil, &InvalidRow{Entity: "Order", Column: "paid_at", Reason: "not a value of DateTime"}
		}
		if !row.Method.Valid() {
			return nil, &InvalidRow{Entity: "Order", Column: "method", Reason: "not a value of PaymentMethod"}
		}
		if row.DeliveredAt != nil && !row.DeliveredAt.Valid() {
			return nil, &InvalidRow{Entity: "Order", Column: "delivered_at", Reason: "not a value of DateTime"}
		}
		return orderCancelledState{id: row.Id, total: row.Total, paidAt: copyOf(row.PaidAt), method: row.Method, deliveredAt: copyOf(row.DeliveredAt), type_: copyOf(row.Type), customerId: row.CustomerId}, nil
	}
	return nil, &InvalidRow{Entity: "Order", Column: "status", Reason: "not a value of OrderStatus"}
}

// OrderToRow returns the flat row of a state; a nil state gives the zero OrderRow.
func OrderToRow(state Order) OrderRow {
	if state == nil {
		return OrderRow{}
	}
	return state.row()
}

func (s orderPendingState) row() OrderRow {
	return OrderRow{Id: s.id, Total: s.total, Status: OrderStatusPending, PaidAt: nil, Method: s.method, DeliveredAt: copyOf(s.deliveredAt), Type: copyOf(s.type_), CustomerId: s.customerId}
}

func (s orderPaidState) row() OrderRow {
	return OrderRow{Id: s.id, Total: s.total, Status: OrderStatusPaid, PaidAt: ptrTo(s.paidAt), Method: s.method, DeliveredAt: copyOf(s.deliveredAt), Type: copyOf(s.type_), CustomerId: s.customerId}
}

func (s orderCancelledState) row() OrderRow {
	return OrderRow{Id: s.id, Total: s.total, Status: OrderStatusCancelled, PaidAt: copyOf(s.paidAt), Method: s.method, DeliveredAt: copyOf(s.deliveredAt), Type: copyOf(s.type_), CustomerId: s.customerId}
}

// ── Dispatch: run a use case from whatever states its rows are in ──

// PayOutcome is what RunPay returns when the use case runs: one case is set.
type PayOutcome struct {
	Ran *PayResult
}

// RunPay runs Pay from whatever states its rows are in: the transition function of those states.
// Its error is a *PayError: NotEnabled when no function runs from them, or the function's error.
func RunPay(order Order, orderPaidAt DateTime) (PayOutcome, error) {
	if order == nil {
		return PayOutcome{}, &PayError{Kind: PayErrorInvalidArgument, Err: &InvalidArgument{Reason: "order is nil: no state"}}
	}
	if order, ok := order.(OrderPending); ok {
		r, err := Pay(order, orderPaidAt)
		if err != nil {
			return PayOutcome{}, err
		}
		return PayOutcome{Ran: &r}, nil
	}
	return PayOutcome{}, &PayError{Kind: PayErrorNotEnabled, Err: &NotEnabled{UseCase: "Pay"}}
}

// CancelOrderOutcome is what RunCancelOrder returns when the use case runs: one case is set.
type CancelOrderOutcome struct {
	Ran *CancelOrderResult
}

// RunCancelOrder runs CancelOrder from whatever states its rows are in: the transition function of those states.
// Its error is a *CancelOrderError: NotEnabled when no function runs from them, or the function's error.
func RunCancelOrder(order Order) (CancelOrderOutcome, error) {
	if order == nil {
		return CancelOrderOutcome{}, &CancelOrderError{Kind: CancelOrderErrorInvalidArgument, Err: &InvalidArgument{Reason: "order is nil: no state"}}
	}
	if order, ok := order.(OrderPending); ok {
		r, err := CancelOrder(order)
		if err != nil {
			return CancelOrderOutcome{}, err
		}
		return CancelOrderOutcome{Ran: &r}, nil
	}
	return CancelOrderOutcome{}, &CancelOrderError{Kind: CancelOrderErrorNotEnabled, Err: &NotEnabled{UseCase: "CancelOrder"}}
}

// ── Commit: what a result writes ──

// StoredRow is a row of any entity as a store holds it: its type names the entity.
type StoredRow interface {
	isStoredRow()
}

func (Customer) isStoredRow() {}

func (OrderLine) isStoredRow() {}

func (OrderRow) isStoredRow() {}

// StoredId is the id of a row of any entity: its type names the entity.
type StoredId interface {
	isStoredId()
}

func (CustomerId) isStoredId() {}

func (OrderLineId) isStoredId() {}

func (OrderId) isStoredId() {}

// RowWrite is one row a commit writes, only where the row is still what Expected names: when
// it is not, the commit writes nothing and the call is NotEnabled. Row is stored (inserted when
// Expected is Absent, else updated), or the row is deleted when Delete is set.
type RowWrite struct {
	// Entity is the entity of the row, as the model names it.
	Entity string
	// Id is the row's id: nil when the entity has no one-column key.
	Id StoredId
	// Row is the row to store: nil for a delete.
	Row StoredRow
	// Delete says the row is deleted.
	Delete bool
	// Expected is what the row must still be.
	Expected ExpectedSource
}

// RunMark is a run mark of a use case split into transactions, on one row.
type RunMark struct {
	// UseCase is the use case of the run, as the model names it.
	UseCase string
	// Entity is the entity of the marked row, as the model names it.
	Entity string
	// Id is the id of the marked row.
	Id StoredId
	// Step is the step of the run that last wrote the row.
	Step int
}

// MarkWrite is one run mark a commit writes. A put at step 1 inserts the mark, where the
// row holds no mark of the use case; a put at a later step advances the row's mark from the
// step before; a delete removes the mark at its step, and the run ends on the row.
type MarkWrite struct {
	// Mark is the mark.
	Mark RunMark
	// Delete says the mark is deleted.
	Delete bool
}

// RaisedEvent is an event of any type a use case raises: its type names the event.
type RaisedEvent interface {
	isRaisedEvent()
}

// Writes is what one commit stores, in order: the rows, then the run marks, then the events.
type Writes struct {
	// UseCase is the use case whose result it is.
	UseCase string
	// Rows are the rows to write.
	Rows []RowWrite
	// Marks are the run marks to store, advance, or delete.
	Marks []MarkWrite
	// Events are the events raised.
	Events []RaisedEvent
}

// Committable is a result or an outcome a commit stores: every result and outcome type is one.
type Committable interface {
	// Writes returns every row, run mark, and event the commit writes, in order.
	Writes() Writes
}

// Writes returns what a commit of the result stores.
func (r PayResult) Writes() Writes {
	row0 := OrderToRow(r.Order)
	return Writes{UseCase: "Pay", Rows: []RowWrite{{Entity: "Order", Id: row0.Id, Row: row0, Expected: r.OrderExpected}}}
}

// Writes returns what a commit of the result stores.
func (r CancelOrderResult) Writes() Writes {
	row0 := OrderToRow(r.Order)
	return Writes{UseCase: "CancelOrder", Rows: []RowWrite{{Entity: "Order", Id: row0.Id, Row: row0, Expected: r.OrderExpected}}}
}

// Writes returns what a commit of the result stores.
func (r PlaceResult) Writes() Writes {
	row0 := OrderToRow(r.Order)
	return Writes{UseCase: "Place", Rows: []RowWrite{{Entity: "Order", Id: row0.Id, Row: row0, Expected: r.OrderExpected}}}
}

// Writes returns what a commit of the case that ran stores: nothing when no case is set.
func (o PayOutcome) Writes() Writes {
	if o.Ran != nil {
		return o.Ran.Writes()
	}
	return Writes{UseCase: "Pay"}
}

// Writes returns what a commit of the case that ran stores: nothing when no case is set.
func (o CancelOrderOutcome) Writes() Writes {
	if o.Ran != nil {
		return o.Ran.Writes()
	}
	return Writes{UseCase: "CancelOrder"}
}

// CommitStore is a store that commits a result inside the transaction of the call: CommitWrites calls
// it once per write, in order. Each method writes one item only where it is still what it names.
type CommitStore interface {
	// WriteRow writes the row where it is still what w.Expected names: false, and nothing
	// written, when it is not. Its error is the store's own.
	WriteRow(w RowWrite) (bool, error)
	// WriteMark writes the run mark where the row's mark is still what the step needs: none of
	// the use case for a put at step 1, the step before for a later put, the mark's own step
	// for a delete. False, and nothing written, when it is not. Its error is the store's own.
	WriteMark(w MarkWrite) (bool, error)
	// RecordEvent records a raised event. Its error is the store's own.
	RecordEvent(e RaisedEvent) error
}

// CommitWrites commits what w writes through store: every row, then every run mark, then every
// event, and stops at the first row or mark that is no longer what it names. It begins and
// ends no transaction: call it inside the transaction of the call, and roll back on an error.
// Its error is a *NotEnabled when a row or a run mark is no longer what the result expects,
// or a *StoreFailed whose Cause is the store's error when the store fails.
func CommitWrites(store CommitStore, w Committable) error {
	writes := w.Writes()
	for _, row := range writes.Rows {
		ok, err := store.WriteRow(row)
		if err != nil {
			return &StoreFailed{UseCase: writes.UseCase, Cause: err}
		}
		if !ok {
			return &NotEnabled{UseCase: writes.UseCase}
		}
	}
	for _, mark := range writes.Marks {
		ok, err := store.WriteMark(mark)
		if err != nil {
			return &StoreFailed{UseCase: writes.UseCase, Cause: err}
		}
		if !ok {
			return &NotEnabled{UseCase: writes.UseCase}
		}
	}
	for _, event := range writes.Events {
		if err := store.RecordEvent(event); err != nil {
			return &StoreFailed{UseCase: writes.UseCase, Cause: err}
		}
	}
	return nil
}

// ── Helpers ──

func isDigits(s string) bool {
	if s == "" {
		return false
	}
	for i := 0; i < len(s); i++ {
		if s[i] < '0' || s[i] > '9' {
			return false
		}
	}
	return true
}

// isDecimalText reports whether s is -?[0-9]+(.[0-9]+)?.
func isDecimalText(s string) bool {
	if len(s) > 0 && s[0] == '-' {
		s = s[1:]
	}
	for i := 0; i < len(s); i++ {
		if s[i] == '.' {
			return isDigits(s[:i]) && isDigits(s[i+1:])
		}
	}
	return isDigits(s)
}

// isDateText reports whether s is YYYY-MM-DD.
func isDateText(s string) bool {
	return len(s) == 10 && isDigits(s[0:4]) && s[4] == '-' && isDigits(s[5:7]) && s[7] == '-' && isDigits(s[8:10])
}

// isDateTimeText reports whether s is YYYY-MM-DDTHH:MM, then :SS and a fraction if given,
// then Z or an offset ±HH:MM.
func isDateTimeText(s string) bool {
	if len(s) < 17 || !isDateText(s[:10]) || s[10] != 'T' || !isDigits(s[11:13]) || s[13] != ':' || !isDigits(s[14:16]) {
		return false
	}
	rest := s[16:]
	if len(rest) >= 3 && rest[0] == ':' && isDigits(rest[1:3]) {
		rest = rest[3:]
		if len(rest) > 1 && rest[0] == '.' {
			i := 1
			for i < len(rest) && rest[i] >= '0' && rest[i] <= '9' {
				i++
			}
			if i == 1 {
				return false
			}
			rest = rest[i:]
		}
	}
	if rest == "Z" {
		return true
	}
	return len(rest) == 6 && (rest[0] == '+' || rest[0] == '-') && isDigits(rest[1:3]) && rest[3] == ':' && isDigits(rest[4:6])
}

func ptrTo[T any](v T) *T { return &v }

// copyOf returns a pointer to a copy of *p, or nil: a state shares no value with a row.
func copyOf[T any](p *T) *T {
	if p == nil {
		return nil
	}
	v := *p
	return &v
}

// ── Contracts: one per use case, which the service implements ──

// PayUseCase is the use case Pay: Pay.
// Each action is two calls: Prepare* loads its rows by id and calls the dispatcher or transition function, writing nothing; the matching Commit* stores the rows, marks, and events the result holds in one transaction, each row only where it still is what the result's <Row>Expected names. Either returns an error, a *PayError where the use case does not run, and changes nothing then.
type PayUseCase interface {
	// PreparePay loads the rows of Pay (the action Pay) and runs it, writing nothing.
	PreparePay(order OrderId, orderPaidAt DateTime) (PayOutcome, error)
	// CommitPay stores what PreparePay returned in one transaction.
	CommitPay(write PayOutcome) error
}

// CancelOrderUseCase is the use case CancelOrder: Cancel.
// Each action is two calls: Prepare* loads its rows by id and calls the dispatcher or transition function, writing nothing; the matching Commit* stores the rows, marks, and events the result holds in one transaction, each row only where it still is what the result's <Row>Expected names. Either returns an error, a *CancelOrderError where the use case does not run, and changes nothing then.
type CancelOrderUseCase interface {
	// PrepareCancelOrder loads the rows of CancelOrder (the action CancelOrder) and runs it, writing nothing.
	PrepareCancelOrder(order OrderId) (CancelOrderOutcome, error)
	// CommitCancelOrder stores what PrepareCancelOrder returned in one transaction.
	CommitCancelOrder(write CancelOrderOutcome) error
}

// PlaceUseCase is the use case Place: Place.
// Each action is two calls: Prepare* loads its rows by id and calls the dispatcher or transition function, writing nothing; the matching Commit* stores the rows, marks, and events the result holds in one transaction, each row only where it still is what the result's <Row>Expected names. Either returns an error, a *PlaceError where the use case does not run, and changes nothing then.
type PlaceUseCase interface {
	// PreparePlace loads the rows of Place (the action Place) and runs it, writing nothing.
	PreparePlace(parentCustomer CustomerId, orderId OrderId, orderMethod PaymentMethod) (PlaceResult, error)
	// CommitPlace stores what PreparePlace returned in one transaction.
	CommitPlace(write PlaceResult) error
}
