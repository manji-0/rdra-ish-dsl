// OrderFromRow returns the state of a row, or why the row fits none.
func OrderFromRow(row OrderRow) (Order, error) {
	switch row.Status {
	case OrderStatusPending:
		if row.PaidAt != nil {
			return nil, &InvalidRow{Entity: "Order", Column: "paid_at", Reason: "null in the state pending"}
		}
		return OrderPending{Id: row.Id, Total: row.Total, Method: row.Method, DeliveredAt: row.DeliveredAt, Type: row.Type, CustomerId: row.CustomerId}, nil
	case OrderStatusPaid:
		if row.PaidAt == nil {
			return nil, &InvalidRow{Entity: "Order", Column: "paid_at", Reason: "present in the state paid"}
		}
		return OrderPaid{Id: row.Id, Total: row.Total, PaidAt: *row.PaidAt, Method: row.Method, DeliveredAt: row.DeliveredAt, Type: row.Type, CustomerId: row.CustomerId}, nil
	case OrderStatusCancelled:
		return OrderCancelled{Id: row.Id, Total: row.Total, PaidAt: row.PaidAt, Method: row.Method, DeliveredAt: row.DeliveredAt, Type: row.Type, CustomerId: row.CustomerId}, nil
	}
	return nil, &InvalidRow{Entity: "Order", Column: "status", Reason: "not a value of OrderStatus"}
}

// OrderToRow returns the flat row of a state.
func OrderToRow(state Order) OrderRow {
	switch v := state.(type) {
	case OrderPending:
		return OrderRow{Id: v.Id, Total: v.Total, Status: OrderStatusPending, PaidAt: nil, Method: v.Method, DeliveredAt: v.DeliveredAt, Type: v.Type, CustomerId: v.CustomerId}
	case OrderPaid:
		return OrderRow{Id: v.Id, Total: v.Total, Status: OrderStatusPaid, PaidAt: ptrTo(v.PaidAt), Method: v.Method, DeliveredAt: v.DeliveredAt, Type: v.Type, CustomerId: v.CustomerId}
	case OrderCancelled:
		return OrderRow{Id: v.Id, Total: v.Total, Status: OrderStatusCancelled, PaidAt: v.PaidAt, Method: v.Method, DeliveredAt: v.DeliveredAt, Type: v.Type, CustomerId: v.CustomerId}
	}
	panic("rdra-ish: a state of Order this package does not declare")
}

