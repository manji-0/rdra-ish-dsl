// ShipUseCase is the use case Ship: Ship.
// Each action is two calls: Prepare* loads its rows by id and calls the dispatcher or transition function, writing nothing; the matching Commit* stores the rows, marks, and events the result holds in one transaction, each row only where it still is what the result's <Row>Expected names. Either returns an error, a *ShipError where the use case does not run, and changes nothing then.
type ShipUseCase interface {
	// RunShip runs the action Ship of Ship whole, by the ids of its rows: the generator prints no
	// function for it, so the service writes it and keeps the obligations.
	RunShip(order OrderId) error
}

// PlaceUseCase is the use case Place: Place.
// Each action is two calls: Prepare* loads its rows by id and calls the dispatcher or transition function, writing nothing; the matching Commit* stores the rows, marks, and events the result holds in one transaction, each row only where it still is what the result's <Row>Expected names. Either returns an error, a *PlaceError where the use case does not run, and changes nothing then.
type PlaceUseCase interface {
	// RunPlace runs the action Place of Place whole, by the ids of its rows: the generator prints no
	// function for it, so the service writes it and keeps the obligations.
	RunPlace(order OrderId) error
}

