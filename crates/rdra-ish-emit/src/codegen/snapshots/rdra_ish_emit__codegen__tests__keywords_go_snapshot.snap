// FuncFromRow returns the state of a row, or why the row fits none.
func FuncFromRow(row FuncRow) (Func, error) {
	switch row.Type {
	case FuncTypeNew:
		return FuncNew{Id: row.Id}, nil
	case FuncTypeReturn:
		return FuncReturn{Id: row.Id}, nil
	case FuncTypeFunc:
		return FuncFunc{Id: row.Id}, nil
	}
	return nil, &InvalidRow{Entity: "Func", Column: "type", Reason: "not a value of FuncType"}
}

// FuncToRow returns the flat row of a state.
func FuncToRow(state Func) FuncRow {
	switch v := state.(type) {
	case FuncNew:
		return FuncRow{Id: v.Id, Type: FuncTypeNew}
	case FuncReturn:
		return FuncRow{Id: v.Id, Type: FuncTypeReturn}
	case FuncFunc:
		return FuncRow{Id: v.Id, Type: FuncTypeFunc}
	}
	panic("rdra-ish: a state of Func this package does not declare")
}

