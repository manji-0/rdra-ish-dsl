	return NewFromReturnResult{
		Match: MatchNew{
			id: matchId,
			type_: matchType,
			default_: int64(0),
			new: matchNew,
			func_: matchFunc,
			self: matchSelf,
			crate: matchCrate,
			super: matchSuper,
			kind: matchKind,
			functionId: parentFunction.Id,
			funcId: parentFunc.id,
			modId: parentMod.Id,
			valid_: true,
		},
	}
}

// NewFromFuncResult is what NewFromFunc returns.
type NewFromFuncResult struct {
	Match MatchNew
}

// NewFromFunc runs New (New). One run of the use case, from the states of the arguments' types. It requires what `New` requires and writes what it writes; the values the model leaves open are the inputs.
func NewFromFunc(parentFunction Function, parentFunc FuncFunc, parentMod Mod, matchId MatchId, matchType string, matchNew string, matchFunc string, matchSelf string, matchCrate string, matchSuper string, matchKind Kind) NewFromFuncResult {
	if !parentFunc.valid_ {
		panic("rdra-ish: FuncFunc not made by this package (the zero value)")
	}
	if !matchKind.Valid() {
		panic("rdra-ish: match_kind is not a value of Kind")
	}
	return NewFromFuncResult{
		Match: MatchNew{
			id: matchId,
			type_: matchType,
			default_: int64(0),
			new: matchNew,
			func_: matchFunc,
			self: matchSelf,
			crate: matchCrate,
			super: matchSuper,
			kind: matchKind,
			functionId: parentFunction.Id,
			funcId: parentFunc.id,
			modId: parentMod.Id,
			valid_: true,
		},
	}
}

// StaticResult is what Static returns.
type StaticResult struct {
	Function Function
}

// Static runs Static (Static). One run of the use case, from the states of the arguments' types. It requires what `Static` requires and writes what it writes; the values the model leaves open are the inputs.
func Static(function Function, functionDefault string) StaticResult {
	return StaticResult{
		Function: Function{
			Id: function.Id,
			Default: ptrTo(functionDefault),
		},
	}
}

// ── Rule checks ──

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row Function) RuleViolations() []string {
	var out []string
	return out
}

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row Mod) RuleViolations() []string {
	var out []string
	return out
}

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row FuncNew) RuleViolations() []string {
	var out []string
	return out
}

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row FuncReturn) RuleViolations() []string {
	var out []string
	return out
}

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row FuncFunc) RuleViolations() []string {
	var out []string
	return out
}

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row MatchNew) RuleViolations() []string {
	var out []string
	// default > 4
	if row.default_ > 4 {
		out = append(out, "Forbidden_Match_0")
	}
	return out
}

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row MatchReturn) RuleViolations() []string {
	var out []string
	// default > 4
	if row.default_ > 4 {
		out = append(out, "Forbidden_Match_0")
	}
	return out
}

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row MatchSelf) RuleViolations() []string {
	var out []string
	// default > 4
	if row.default_ > 4 {
		out = append(out, "Forbidden_Match_0")
	}
	// when status=self then default <= 4
	if !(row.default_ <= 4) {
		out = append(out, "Inv_Match_0")
	}
	return out
}

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row MatchSuper) RuleViolations() []string {
	var out []string
	// default > 4
	if row.default_ > 4 {
		out = append(out, "Forbidden_Match_0")
	}
	return out
}

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row MatchCrate) RuleViolations() []string {
	var out []string
	// default > 4
	if row.default_ > 4 {
		out = append(out, "Forbidden_Match_0")
	}
	return out
}

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row MatchDefault) RuleViolations() []string {
	var out []string
	// default > 4
	if row.default_ > 4 {
		out = append(out, "Forbidden_Match_0")
	}
	return out
}

// ── Rows: the flat shape a store or the wire holds ──

// InvalidRow reports a row that breaks what the type of its state requires.
type InvalidRow struct {
	Entity string
	Column string
	Reason string
}

// Error names the entity, the column, and the reason.
func (e *InvalidRow) Error() string {
	return e.Entity + "." + e.Column + ": " + e.Reason
}

// FuncRow holds every column of Func as the data layer declares it.
type FuncRow struct {
	Id FuncId `json:"id"`
	Type FuncType `json:"type"`
}

// FuncFromRow returns the state of a row, or why the row fits none.
func FuncFromRow(row FuncRow) (Func, error) {
	switch row.Type {
	case FuncTypeNew:
		return FuncNew{id: row.Id, valid_: true}, nil
	case FuncTypeReturn:
		return FuncReturn{id: row.Id, valid_: true}, nil
	case FuncTypeFunc:
		return FuncFunc{id: row.Id, valid_: true}, nil
	}
	return nil, &InvalidRow{Entity: "Func", Column: "type", Reason: "not a value of FuncType"}
}

// FuncToRow returns the flat row of a state.
func FuncToRow(state Func) FuncRow {
	switch v := state.(type) {
	case FuncNew:
		if !v.valid_ {
			panic("rdra-ish: FuncNew not made by this package (the zero value)")
		}
		return FuncRow{Id: v.id, Type: FuncTypeNew}
	case FuncReturn:
		if !v.valid_ {
			panic("rdra-ish: FuncReturn not made by this package (the zero value)")
		}
		return FuncRow{Id: v.id, Type: FuncTypeReturn}
	case FuncFunc:
		if !v.valid_ {
			panic("rdra-ish: FuncFunc not made by this package (the zero value)")
		}
		return FuncRow{Id: v.id, Type: FuncTypeFunc}
	}
	panic("rdra-ish: a state of Func this package does not declare")
}

// MatchRow holds every column of Match as the data layer declares it.
type MatchRow struct {
	Id MatchId `json:"id"`
	Status MatchStatus `json:"status"`
	Type string `json:"type"`
	Default int64 `json:"default"`
	New string `json:"new"`
	Func string `json:"func"`
	Self string `json:"self"`
	Crate string `json:"crate"`
	Super string `json:"super"`
	Kind Kind `json:"kind"`
	FunctionId FunctionId `json:"function_id"`
	FuncId FuncId `json:"func_id"`
	ModId ModId `json:"mod_id"`
}

// MatchFromRow returns the state of a row, or why the row fits none.
func MatchFromRow(row MatchRow) (Match, error) {
	switch row.Status {
	case MatchStatusNew:
		if !row.Kind.Valid() {
			return nil, &InvalidRow{Entity: "Match", Column: "kind", Reason: "not a value of Kind"}
		}
		return MatchNew{id: row.Id, type_: row.Type, default_: row.Default, new: row.New, func_: row.Func, self: row.Self, crate: row.Crate, super: row.Super, kind: row.Kind, functionId: row.FunctionId, funcId: row.FuncId, modId: row.ModId, valid_: true}, nil
	case MatchStatusReturn:
		if !row.Kind.Valid() {
			return nil, &InvalidRow{Entity: "Match", Column: "kind", Reason: "not a value of Kind"}
		}
		return MatchReturn{id: row.Id, type_: row.Type, default_: row.Default, new: row.New, func_: row.Func, self: row.Self, crate: row.Crate, super: row.Super, kind: row.Kind, functionId: row.FunctionId, funcId: row.FuncId, modId: row.ModId, valid_: true}, nil
	case MatchStatusSelf:
		if !row.Kind.Valid() {
			return nil, &InvalidRow{Entity: "Match", Column: "kind", Reason: "not a value of Kind"}
		}
		return MatchSelf{id: row.Id, type_: row.Type, default_: row.Default, new: row.New, func_: row.Func, self: row.Self, crate: row.Crate, super: row.Super, kind: row.Kind, functionId: row.FunctionId, funcId: row.FuncId, modId: row.ModId, valid_: true}, nil
	case MatchStatusSuper:
		if !row.Kind.Valid() {
			return nil, &InvalidRow{Entity: "Match", Column: "kind", Reason: "not a value of Kind"}
		}
		return MatchSuper{id: row.Id, type_: row.Type, default_: row.Default, new: row.New, func_: row.Func, self: row.Self, crate: row.Crate, super: row.Super, kind: row.Kind, functionId: row.FunctionId, funcId: row.FuncId, modId: row.ModId, valid_: true}, nil
	case MatchStatusCrate:
		if !row.Kind.Valid() {
			return nil, &InvalidRow{Entity: "Match", Column: "kind", Reason: "not a value of Kind"}
		}
		return MatchCrate{id: row.Id, type_: row.Type, default_: row.Default, new: row.New, func_: row.Func, self: row.Self, crate: row.Crate, super: row.Super, kind: row.Kind, functionId: row.FunctionId, funcId: row.FuncId, modId: row.ModId, valid_: true}, nil
	case MatchStatusDefault:
		if !row.Kind.Valid() {
			return nil, &InvalidRow{Entity: "Match", Column: "kind", Reason: "not a value of Kind"}
		}
		return MatchDefault{id: row.Id, type_: row.Type, default_: row.Default, new: row.New, func_: row.Func, self: row.Self, crate: row.Crate, super: row.Super, kind: row.Kind, functionId: row.FunctionId, funcId: row.FuncId, modId: row.ModId, valid_: true}, nil
	}
	return nil, &InvalidRow{Entity: "Match", Column: "status", Reason: "not a value of MatchStatus"}
}

// MatchToRow returns the flat row of a state.
func MatchToRow(state Match) MatchRow {
	switch v := state.(type) {
	case MatchNew:
		if !v.valid_ {
			panic("rdra-ish: MatchNew not made by this package (the zero value)")
		}
		return MatchRow{Id: v.id, Status: MatchStatusNew, Type: v.type_, Default: v.default_, New: v.new, Func: v.func_, Self: v.self, Crate: v.crate, Super: v.super, Kind: v.kind, FunctionId: v.functionId, FuncId: v.funcId, ModId: v.modId}
	case MatchReturn:
		if !v.valid_ {
			panic("rdra-ish: MatchReturn not made by this package (the zero value)")
		}
		return MatchRow{Id: v.id, Status: MatchStatusReturn, Type: v.type_, Default: v.default_, New: v.new, Func: v.func_, Self: v.self, Crate: v.crate, Super: v.super, Kind: v.kind, FunctionId: v.functionId, FuncId: v.funcId, ModId: v.modId}
	case MatchSelf:
		if !v.valid_ {
			panic("rdra-ish: MatchSelf not made by this package (the zero value)")
		}
		return MatchRow{Id: v.id, Status: MatchStatusSelf, Type: v.type_, Default: v.default_, New: v.new, Func: v.func_, Self: v.self, Crate: v.crate, Super: v.super, Kind: v.kind, FunctionId: v.functionId, FuncId: v.funcId, ModId: v.modId}
	case MatchSuper:
		if !v.valid_ {
			panic("rdra-ish: MatchSuper not made by this package (the zero value)")
		}
		return MatchRow{Id: v.id, Status: MatchStatusSuper, Type: v.type_, Default: v.default_, New: v.new, Func: v.func_, Self: v.self, Crate: v.crate, Super: v.super, Kind: v.kind, FunctionId: v.functionId, FuncId: v.funcId, ModId: v.modId}
	case MatchCrate:
		if !v.valid_ {
			panic("rdra-ish: MatchCrate not made by this package (the zero value)")
		}
		return MatchRow{Id: v.id, Status: MatchStatusCrate, Type: v.type_, Default: v.default_, New: v.new, Func: v.func_, Self: v.self, Crate: v.crate, Super: v.super, Kind: v.kind, FunctionId: v.functionId, FuncId: v.funcId, ModId: v.modId}
	case MatchDefault:
		if !v.valid_ {
			panic("rdra-ish: MatchDefault not made by this package (the zero value)")
		}
		return MatchRow{Id: v.id, Status: MatchStatusDefault, Type: v.type_, Default: v.default_, New: v.new, Func: v.func_, Self: v.self, Crate: v.crate, Super: v.super, Kind: v.kind, FunctionId: v.functionId, FuncId: v.funcId, ModId: v.modId}
	}
	panic("rdra-ish: a state of Match this package does not declare")
}

// ── Dispatch: run a use case from whatever states its rows are in ──

// NotEnabled reports rows in states the use case does not run from.
type NotEnabled struct {
	UseCase string
}

// Error names the use case.
func (e *NotEnabled) Error() string {
	return "the use case " + e.UseCase + " does not run from these states"
}

// ReturnOutcome is what RunReturn returns when the use case runs: one case is set.
type ReturnOutcome struct {
	Ran *ReturnResult
}

// RunReturn runs Return from whatever states its rows are in: the transition function of those states, or NotEnabled.
func RunReturn(match Match) (ReturnOutcome, error) {
	if match, ok := match.(MatchNew); ok {
		r := Return(match)
		return ReturnOutcome{Ran: &r}, nil
	}
	return ReturnOutcome{}, &NotEnabled{UseCase: "Return"}
}

// DeleteOutcome is what RunDelete returns when the use case runs: one case is set.
type DeleteOutcome struct {
	Ran *DeleteResult
}

// RunDelete runs Delete from whatever states its rows are in: the transition function of those states, or NotEnabled.
func RunDelete(match Match, switch_ Switch) (DeleteOutcome, error) {
	if match, ok := match.(MatchReturn); ok {
		r := Delete(match, switch_)
		return DeleteOutcome{Ran: &r}, nil
	}
	return DeleteOutcome{}, &NotEnabled{UseCase: "Delete"}
}

// SuperOutcome is what RunSuper returns when the use case runs: one case is set.
type SuperOutcome struct {
	Ran *SuperResult
}

// RunSuper runs Super from whatever states its rows are in: the transition function of those states, or NotEnabled.
func RunSuper(match Match) (SuperOutcome, error) {
	if match, ok := match.(MatchSelf); ok {
		r, err := Super(match)
		if err != nil {
			return SuperOutcome{}, err
		}
		return SuperOutcome{Ran: &r}, nil
	}
	return SuperOutcome{}, &NotEnabled{UseCase: "Super"}
}

// CrateOutcome is what RunCrate returns when the use case runs: one case is set.
type CrateOutcome struct {
	Ran *CrateResult
}

// RunCrate runs Crate from whatever states its rows are in: the transition function of those states, or NotEnabled.
func RunCrate(match Match) (CrateOutcome, error) {
	if match, ok := match.(MatchSuper); ok {
		r := Crate(match)
		return CrateOutcome{Ran: &r}, nil
	}
	return CrateOutcome{}, &NotEnabled{UseCase: "Crate"}
}

// DefaultOutcome is what RunDefault returns when the use case runs: one case is set.
type DefaultOutcome struct {
	Ran *DefaultResult
}

// RunDefault runs Default from whatever states its rows are in: the transition function of those states, or NotEnabled.
func RunDefault(match Match) (DefaultOutcome, error) {
	if match, ok := match.(MatchCrate); ok {
		r := Default(match)
		return DefaultOutcome{Ran: &r}, nil
	}
	return DefaultOutcome{}, &NotEnabled{UseCase: "Default"}
}

// TypeOutcome is what RunType returns when the use case runs: one case is set.
type TypeOutcome struct {
	Ran *TypeResult
}

// RunType runs Type from whatever states its rows are in: the transition function of those states, or NotEnabled.
func RunType(func_ Func) (TypeOutcome, error) {
	if func_, ok := func_.(FuncNew); ok {
		r := Type(func_)
		return TypeOutcome{Ran: &r}, nil
	}
	return TypeOutcome{}, &NotEnabled{UseCase: "Type"}
}

// ClassOutcome is what RunClass returns when the use case runs: one case is set.
type ClassOutcome struct {
	Ran *ClassResult
}

// RunClass runs Class from whatever states its rows are in: the transition function of those states, or NotEnabled.
func RunClass(func_ Func) (ClassOutcome, error) {
	if func_, ok := func_.(FuncReturn); ok {
		r := Class(func_)
		return ClassOutcome{Ran: &r}, nil
	}
	return ClassOutcome{}, &NotEnabled{UseCase: "Class"}
}

// NewOutcome is what RunNew returns when the use case runs: one case is set.
type NewOutcome struct {
	FromNew *NewFromNewResult
	FromReturn *NewFromReturnResult
	FromFunc *NewFromFuncResult
}

// RunNew runs New from whatever states its rows are in: the transition function of those states, or NotEnabled.
func RunNew(parentFunction Function, parentFunc Func, parentMod Mod, matchId MatchId, matchType string, matchNew string, matchFunc string, matchSelf string, matchCrate string, matchSuper string, matchKind Kind) (NewOutcome, error) {
	if parentFunc, ok := parentFunc.(FuncNew); ok {
		r := NewFromNew(parentFunction, parentFunc, parentMod, matchId, matchType, matchNew, matchFunc, matchSelf, matchCrate, matchSuper, matchKind)
		return NewOutcome{FromNew: &r}, nil
	}
	if parentFunc, ok := parentFunc.(FuncReturn); ok {
		r := NewFromReturn(parentFunction, parentFunc, parentMod, matchId, matchType, matchNew, matchFunc, matchSelf, matchCrate, matchSuper, matchKind)
		return NewOutcome{FromReturn: &r}, nil
	}
	if parentFunc, ok := parentFunc.(FuncFunc); ok {
		r := NewFromFunc(parentFunction, parentFunc, parentMod, matchId, matchType, matchNew, matchFunc, matchSelf, matchCrate, matchSuper, matchKind)
		return NewOutcome{FromFunc: &r}, nil
	}
	return NewOutcome{}, &NotEnabled{UseCase: "New"}
}

// ── Helpers ──

func ptrTo[T any](v T) *T { return &v }

// mustPresent reads a value the verified model keeps present; nil means the rows broke a rule.
func mustPresent[T any](p *T, message string) T {
	if p == nil {
		panic(message)
	}
	return *p
}
