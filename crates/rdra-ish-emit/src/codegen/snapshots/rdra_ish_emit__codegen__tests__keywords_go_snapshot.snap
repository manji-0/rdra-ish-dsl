// MatchVisitor has one method per state of Match, which MatchMatch calls. When the model gains a
// state, MatchVisitor gains its method, and an implementation that lacks it no longer compiles
// where MatchMatch takes it: Go's type switch says nothing of a state it misses.
type MatchVisitor[R any] interface {
	// New is called on a state of kind MatchKindNew.
	New(MatchNew) R
	// Return is called on a state of kind MatchKindReturn.
	Return(MatchReturn) R
	// Self is called on a state of kind MatchKindSelf.
	Self(MatchSelf) R
	// Super is called on a state of kind MatchKindSuper.
	Super(MatchSuper) R
	// Crate is called on a state of kind MatchKindCrate.
	Crate(MatchCrate) R
	// Default is called on a state of kind MatchKindDefault.
	Default(MatchDefault) R
}

// MatchMatch calls the method of v for the state of state and returns what it returns. A nil
// state, or a value of another type that embeds a state, is an *InvalidArgument.
func MatchMatch[R any](state Match, v MatchVisitor[R]) (R, error) {
	switch s := state.(type) {
	case matchNewState:
		return v.New(s), nil
	case matchReturnState:
		return v.Return(s), nil
	case matchSelfState:
		return v.Self(s), nil
	case matchSuperState:
		return v.Super(s), nil
	case matchCrateState:
		return v.Crate(s), nil
	case matchDefaultState:
		return v.Default(s), nil
	}
	var zero R
	return zero, &InvalidArgument{Reason: "no state of Match this package made"}
}

