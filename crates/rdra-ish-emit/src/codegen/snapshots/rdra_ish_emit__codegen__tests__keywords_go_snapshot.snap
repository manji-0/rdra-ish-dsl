// Writes returns what a commit of the case that ran stores: nothing when no case is set.
func (o NewOutcome) Writes() Writes {
	if o.FromNew != nil {
		return o.FromNew.Writes()
	}
	if o.FromReturn != nil {
		return o.FromReturn.Writes()
	}
	if o.FromFunc != nil {
		return o.FromFunc.Writes()
	}
	return Writes{UseCase: "New"}
}

// CommitStore is a store that commits a result inside the transaction of the call: CommitWrites calls
// it once per write, in order. Each method writes one item only where it is still what it names.
type CommitStore interface {
	// WriteRow writes the row where it is still what w.Expected names: false, and nothing
	// written, when it is not. Its error is the store's own.
	WriteRow(w RowWrite) (bool, error)
	// WriteMark writes the run mark where the row's mark is still what the step needs: none of
	// the use case for a put at step 1, the step before for a later put, the mark's own step
	// for a delete. False, and nothing written, when it is not. Its error is the store's own.
	WriteMark(w MarkWrite) (bool, error)
	// RecordEvent records a raised event. Its error is the store's own.
	RecordEvent(e RaisedEvent) error
}

// CommitWrites commits what w writes through store: every row, then every run mark, then every
// event, and stops at the first row or mark that is no longer what it names. It begins and
// ends no transaction: call it inside the transaction of the call, and roll back on an error.
// Its error is a *NotEnabled when a row or a run mark is no longer what the result expects,
// or a *StoreFailed whose Cause is the store's error when the store fails.
func CommitWrites(store CommitStore, w Committable) error {
	writes := w.Writes()
	for _, row := range writes.Rows {
		ok, err := store.WriteRow(row)
		if err != nil {
			return &StoreFailed{UseCase: writes.UseCase, Cause: err}
		}
		if !ok {
			return &NotEnabled{UseCase: writes.UseCase}
		}
	}
	for _, mark := range writes.Marks {
		ok, err := store.WriteMark(mark)
		if err != nil {
			return &StoreFailed{UseCase: writes.UseCase, Cause: err}
		}
		if !ok {
			return &NotEnabled{UseCase: writes.UseCase}
		}
	}
	for _, event := range writes.Events {
		if err := store.RecordEvent(event); err != nil {
			return &StoreFailed{UseCase: writes.UseCase, Cause: err}
		}
	}
	return nil
}

// ── Helpers ──

func isDigits(s string) bool {
	if s == "" {
		return false
	}
	for i := 0; i < len(s); i++ {
		if s[i] < '0' || s[i] > '9' {
			return false
		}
	}
	return true
}

// isDecimalText reports whether s is -?[0-9]+(.[0-9]+)?.
func isDecimalText(s string) bool {
	if len(s) > 0 && s[0] == '-' {
		s = s[1:]
	}
	for i := 0; i < len(s); i++ {
		if s[i] == '.' {
			return isDigits(s[:i]) && isDigits(s[i+1:])
		}
	}
	return isDigits(s)
}

// isDateText reports whether s is YYYY-MM-DD.
func isDateText(s string) bool {
	return len(s) == 10 && isDigits(s[0:4]) && s[4] == '-' && isDigits(s[5:7]) && s[7] == '-' && isDigits(s[8:10])
}

// isDateTimeText reports whether s is YYYY-MM-DDTHH:MM, then :SS and a fraction if given,
// then Z or an offset ±HH:MM.
func isDateTimeText(s string) bool {
	if len(s) < 17 || !isDateText(s[:10]) || s[10] != 'T' || !isDigits(s[11:13]) || s[13] != ':' || !isDigits(s[14:16]) {
		return false
	}
	rest := s[16:]
	if len(rest) >= 3 && rest[0] == ':' && isDigits(rest[1:3]) {
		rest = rest[3:]
		if len(rest) > 1 && rest[0] == '.' {
			i := 1
			for i < len(rest) && rest[i] >= '0' && rest[i] <= '9' {
				i++
			}
			if i == 1 {
				return false
			}
			rest = rest[i:]
		}
	}
	if rest == "Z" {
		return true
	}
	return len(rest) == 6 && (rest[0] == '+' || rest[0] == '-') && isDigits(rest[1:3]) && rest[3] == ':' && isDigits(rest[4:6])
}

func ptrTo[T any](v T) *T { return &v }

// ── Contracts: one per use case, which the service implements ──

// ReturnUseCase is the use case Return: Return.
// Each action is two calls: Prepare* loads its rows by id and calls the dispatcher or transition function, writing nothing; the matching Commit* stores the rows, marks, and events the result holds in one transaction, each row only where it still is what the result's <Row>Expected names. Either returns an error, a *ReturnError where the use case does not run, and changes nothing then.
type ReturnUseCase interface {
	// PrepareReturn loads the rows of Return (the action Return) and runs it, writing nothing.
	PrepareReturn(match MatchId) (ReturnOutcome, error)
	// CommitReturn stores what PrepareReturn returned in one transaction.
	CommitReturn(write ReturnOutcome) error
}

// DeleteUseCase is the use case Delete: Delete.
// Each action is two calls: Prepare* loads its rows by id and calls the dispatcher or transition function, writing nothing; the matching Commit* stores the rows, marks, and events the result holds in one transaction, each row only where it still is what the result's <Row>Expected names. Either returns an error, a *DeleteError where the use case does not run, and changes nothing then.
type DeleteUseCase interface {
	// PrepareDelete loads the rows of Delete (the action Delete) and runs it, writing nothing.
	PrepareDelete(match MatchId, switch_ Switch) (DeleteOutcome, error)
	// CommitDelete stores what PrepareDelete returned in one transaction.
	CommitDelete(write DeleteOutcome) error
}

// SuperUseCase is the use case Super: Super.
// Each action is two calls: Prepare* loads its rows by id and calls the dispatcher or transition function, writing nothing; the matching Commit* stores the rows, marks, and events the result holds in one transaction, each row only where it still is what the result's <Row>Expected names. Either returns an error, a *SuperError where the use case does not run, and changes nothing then.
