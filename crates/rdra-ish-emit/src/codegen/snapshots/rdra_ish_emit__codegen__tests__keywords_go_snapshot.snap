func (matchDefaultState) isMatchDefault() {}

// ── Events ──

// Switch is the event Switch.
type Switch struct {
	// MatchId is the Match row the event was raised on.
	MatchId MatchId
}

// ── Use cases ──

// ErrNotEnabled is what errors.Is matches a *NotEnabled with.
var ErrNotEnabled = errors.New("the use case does not run from these states")

// NotEnabled reports rows in states the use case does not run from, or a commit that found a row it writes changed since the read.
type NotEnabled struct {
	UseCase string
}

// Error says what happened.
func (e *NotEnabled) Error() string {
	return "the use case " + e.UseCase + " does not run from these states"
}

// Is reports whether target is ErrNotEnabled.
func (e *NotEnabled) Is(target error) bool {
	return target == ErrNotEnabled
}

// ErrRejected is what errors.Is matches a *Rejected with.
var ErrRejected = errors.New("rejected by a condition")

// Rejected reports a condition of a use case that did not hold: the use case does not run.
type Rejected struct {
	Condition string
	Label     string
	Site      string
}

// Error says what happened.
func (e *Rejected) Error() string {
	return "rejected by the condition " + e.Condition + ": " + e.Label
}

// Is reports whether target is ErrRejected.
func (e *Rejected) Is(target error) bool {
	return target == ErrRejected
}

// ErrInvalidArgument is what errors.Is matches a *InvalidArgument with.
var ErrInvalidArgument = errors.New("an argument the verified model never holds")

// InvalidArgument reports arguments that break what the verified model keeps: a nil state or one this package did not make, a text that is no value of its type, a row that does not name the row passed with it, a column the state keeps null that holds a value.
type InvalidArgument struct {
	Reason string
}

// Error says what happened.
func (e *InvalidArgument) Error() string {
	return "invalid argument: " + e.Reason
}

// Is reports whether target is ErrInvalidArgument.
func (e *InvalidArgument) Is(target error) bool {
	return target == ErrInvalidArgument
}

// ExpectedSource is what a row a result writes must still be when the write commits, so the
// store can write it conditionally and take a write that matches no row as NotEnabled (see the
// obligations). Absent: the row is created, and no row has its id. Otherwise the row exists,
// and when Column is set, it holds Value.
type ExpectedSource struct {
	Absent bool
	Column string
	Value  string
}

// ReturnErrorKind is the case of a ReturnError.
type ReturnErrorKind string

// The cases of ReturnError.
const (
	// ReturnErrorNotEnabled: the rows are in states Return does not run from (only its dispatcher says so), or a store's commit found a row changed.
	ReturnErrorNotEnabled ReturnErrorKind = "NotEnabled"
	// ReturnErrorInvalidArgument: the arguments break what the verified model keeps.
	ReturnErrorInvalidArgument ReturnErrorKind = "InvalidArgument"
)

// ReturnError is why Return did not run. Kind is its case, and Err the case's detail (*NotEnabled, *InvalidArgument), which errors.As reaches and errors.Is matches with ErrNotEnabled, ErrInvalidArgument.
type ReturnError struct {
	Kind ReturnErrorKind
	Err  error
}

// Error names the use case and the case.
func (e *ReturnError) Error() string {
	if e.Err == nil {
		return "Return: " + string(e.Kind)
	}
	return "Return: " + e.Err.Error()
}

// Unwrap returns the case's detail.
func (e *ReturnError) Unwrap() error {
	return e.Err
}

