// Writes returns what a commit of the case that ran stores: nothing when no case is set.
func (o ReturnOutcome) Writes() Writes {
	if o.Ran != nil {
		return o.Ran.Writes()
	}
	return Writes{UseCase: "Return"}
}

// Writes returns what a commit of the case that ran stores: nothing when no case is set.
