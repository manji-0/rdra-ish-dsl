// Static runs Static (Static). One run of the use case, from the states of the arguments' types. It requires what `Static` requires and writes what it writes; the values the model leaves open are the inputs.
// It returns new values and changes none of its arguments; its error is always nil.
func Static(function Function, functionDefault string) (StaticResult, error) {
	return StaticResult{Function: Function{Id: function.Id, Default: ptrTo(functionDefault)}, FunctionExpected: ExpectedSource{}}, nil
}

// ── Rule checks ──

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row Function) RuleViolations() []string {
	var out []string
	return out
}

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row Mod) RuleViolations() []string {
	var out []string
	return out
}

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row funcNewState) RuleViolations() []string {
	var out []string
	return out
}

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row funcReturnState) RuleViolations() []string {
	var out []string
	return out
}

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row funcFuncState) RuleViolations() []string {
	var out []string
	return out
}

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row matchNewState) RuleViolations() []string {
	var out []string
	// default > 4
	if row.default_ > 4 {
		out = append(out, "Forbidden_Match_0")
	}
	return out
}

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row matchReturnState) RuleViolations() []string {
	var out []string
	// default > 4
	if row.default_ > 4 {
		out = append(out, "Forbidden_Match_0")
	}
	return out
}

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row matchSelfState) RuleViolations() []string {
	var out []string
	// default > 4
	if row.default_ > 4 {
		out = append(out, "Forbidden_Match_0")
	}
	// when status=self then default <= 4
	if !(row.default_ <= 4) {
		out = append(out, "Inv_Match_0")
	}
	return out
}

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row matchSuperState) RuleViolations() []string {
	var out []string
	// default > 4
	if row.default_ > 4 {
		out = append(out, "Forbidden_Match_0")
	}
	return out
}

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row matchCrateState) RuleViolations() []string {
	var out []string
	// default > 4
	if row.default_ > 4 {
		out = append(out, "Forbidden_Match_0")
	}
	return out
}

// RuleViolations returns the rules row breaks, by the names `check` reports: empty when it keeps them all.
func (row matchDefaultState) RuleViolations() []string {
	var out []string
	// default > 4
	if row.default_ > 4 {
		out = append(out, "Forbidden_Match_0")
	}
	return out
}

// ── Rows: the flat shape a store or the wire holds ──

// InvalidRow reports a row whose values no state of its entity holds, by the column.
type InvalidRow struct {
	Entity string
	Column string
	Reason string
}

// Error names the entity, the column, and the reason.
func (e *InvalidRow) Error() string {
	return e.Entity + "." + e.Column + ": " + e.Reason
}

// FuncRow holds every column of Func as the data layer declares it, the tag type among them.
type FuncRow struct {
	Id   FuncId   `json:"id"`
	Type FuncType `json:"type"`
}

// FuncFromRow returns the state row holds, or an *InvalidRow naming the column whose value no
// state of Func takes: a tag or a value outside its value set, a text not in its scalar's shape,
// or a null or a value where the state's rules say otherwise.
func FuncFromRow(row FuncRow) (Func, error) {
	switch row.Type {
	case FuncTypeNew:
		return funcNewState{id: row.Id}, nil
	case FuncTypeReturn:
		return funcReturnState{id: row.Id}, nil
	case FuncTypeFunc:
		return funcFuncState{id: row.Id}, nil
	}
	return nil, &InvalidRow{Entity: "Func", Column: "type", Reason: "not a value of FuncType"}
}

// FuncToRow returns the flat row of a state; a nil state gives the zero FuncRow.
func FuncToRow(state Func) FuncRow {
	if state == nil {
		return FuncRow{}
	}
	return state.row()
}

func (s funcNewState) row() FuncRow {
	return FuncRow{Id: s.id, Type: FuncTypeNew}
}

func (s funcReturnState) row() FuncRow {
	return FuncRow{Id: s.id, Type: FuncTypeReturn}
}

func (s funcFuncState) row() FuncRow {
	return FuncRow{Id: s.id, Type: FuncTypeFunc}
}

// MatchRow holds every column of Match as the data layer declares it, the tag status among them.
type MatchRow struct {
	Id         MatchId     `json:"id"`
	Status     MatchStatus `json:"status"`
	Type       string      `json:"type"`
	Default    int64       `json:"default"`
	New        string      `json:"new"`
	Func       string      `json:"func"`
	Self       string      `json:"self"`
	Crate      string      `json:"crate"`
	Super      string      `json:"super"`
	Kind       Kind        `json:"kind"`
	FunctionId FunctionId  `json:"function_id"`
	FuncId     FuncId      `json:"func_id"`
	ModId      ModId       `json:"mod_id"`
}

// MatchFromRow returns the state row holds, or an *InvalidRow naming the column whose value no
// state of Match takes: a tag or a value outside its value set, a text not in its scalar's shape,
// or a null or a value where the state's rules say otherwise.
func MatchFromRow(row MatchRow) (Match, error) {
	switch row.Status {
	case MatchStatusNew:
		if !row.Kind.Valid() {
			return nil, &InvalidRow{Entity: "Match", Column: "kind", Reason: "not a value of Kind"}
		}
		return matchNewState{id: row.Id, type_: row.Type, default_: row.Default, new: row.New, func_: row.Func, self: row.Self, crate: row.Crate, super: row.Super, kind_: row.Kind, functionId: row.FunctionId, funcId: row.FuncId, modId: row.ModId}, nil
	case MatchStatusReturn:
		if !row.Kind.Valid() {
			return nil, &InvalidRow{Entity: "Match", Column: "kind", Reason: "not a value of Kind"}
		}
		return matchReturnState{id: row.Id, type_: row.Type, default_: row.Default, new: row.New, func_: row.Func, self: row.Self, crate: row.Crate, super: row.Super, kind_: row.Kind, functionId: row.FunctionId, funcId: row.FuncId, modId: row.ModId}, nil
	case MatchStatusSelf:
		if !row.Kind.Valid() {
			return nil, &InvalidRow{Entity: "Match", Column: "kind", Reason: "not a value of Kind"}
		}
		return matchSelfState{id: row.Id, type_: row.Type, default_: row.Default, new: row.New, func_: row.Func, self: row.Self, crate: row.Crate, super: row.Super, kind_: row.Kind, functionId: row.FunctionId, funcId: row.FuncId, modId: row.ModId}, nil
	case MatchStatusSuper:
		if !row.Kind.Valid() {
			return nil, &InvalidRow{Entity: "Match", Column: "kind", Reason: "not a value of Kind"}
		}
		return matchSuperState{id: row.Id, type_: row.Type, default_: row.Default, new: row.New, func_: row.Func, self: row.Self, crate: row.Crate, super: row.Super, kind_: row.Kind, functionId: row.FunctionId, funcId: row.FuncId, modId: row.ModId}, nil
	case MatchStatusCrate:
		if !row.Kind.Valid() {
			return nil, &InvalidRow{Entity: "Match", Column: "kind", Reason: "not a value of Kind"}
		}
		return matchCrateState{id: row.Id, type_: row.Type, default_: row.Default, new: row.New, func_: row.Func, self: row.Self, crate: row.Crate, super: row.Super, kind_: row.Kind, functionId: row.FunctionId, funcId: row.FuncId, modId: row.ModId}, nil
	case MatchStatusDefault:
		if !row.Kind.Valid() {
			return nil, &InvalidRow{Entity: "Match", Column: "kind", Reason: "not a value of Kind"}
		}
		return matchDefaultState{id: row.Id, type_: row.Type, default_: row.Default, new: row.New, func_: row.Func, self: row.Self, crate: row.Crate, super: row.Super, kind_: row.Kind, functionId: row.FunctionId, funcId: row.FuncId, modId: row.ModId}, nil
	}
	return nil, &InvalidRow{Entity: "Match", Column: "status", Reason: "not a value of MatchStatus"}
}

// MatchToRow returns the flat row of a state; a nil state gives the zero MatchRow.
func MatchToRow(state Match) MatchRow {
	if state == nil {
		return MatchRow{}
	}
	return state.row()
}

func (s matchNewState) row() MatchRow {
	return MatchRow{Id: s.id, Status: MatchStatusNew, Type: s.type_, Default: s.default_, New: s.new, Func: s.func_, Self: s.self, Crate: s.crate, Super: s.super, Kind: s.kind_, FunctionId: s.functionId, FuncId: s.funcId, ModId: s.modId}
}

func (s matchReturnState) row() MatchRow {
	return MatchRow{Id: s.id, Status: MatchStatusReturn, Type: s.type_, Default: s.default_, New: s.new, Func: s.func_, Self: s.self, Crate: s.crate, Super: s.super, Kind: s.kind_, FunctionId: s.functionId, FuncId: s.funcId, ModId: s.modId}
}

func (s matchSelfState) row() MatchRow {
	return MatchRow{Id: s.id, Status: MatchStatusSelf, Type: s.type_, Default: s.default_, New: s.new, Func: s.func_, Self: s.self, Crate: s.crate, Super: s.super, Kind: s.kind_, FunctionId: s.functionId, FuncId: s.funcId, ModId: s.modId}
}

func (s matchSuperState) row() MatchRow {
	return MatchRow{Id: s.id, Status: MatchStatusSuper, Type: s.type_, Default: s.default_, New: s.new, Func: s.func_, Self: s.self, Crate: s.crate, Super: s.super, Kind: s.kind_, FunctionId: s.functionId, FuncId: s.funcId, ModId: s.modId}
}

func (s matchCrateState) row() MatchRow {
	return MatchRow{Id: s.id, Status: MatchStatusCrate, Type: s.type_, Default: s.default_, New: s.new, Func: s.func_, Self: s.self, Crate: s.crate, Super: s.super, Kind: s.kind_, FunctionId: s.functionId, FuncId: s.funcId, ModId: s.modId}
}

func (s matchDefaultState) row() MatchRow {
	return MatchRow{Id: s.id, Status: MatchStatusDefault, Type: s.type_, Default: s.default_, New: s.new, Func: s.func_, Self: s.self, Crate: s.crate, Super: s.super, Kind: s.kind_, FunctionId: s.functionId, FuncId: s.funcId, ModId: s.modId}
}

// ── Dispatch: run a use case from whatever states its rows are in ──

// ReturnOutcome is what RunReturn returns when the use case runs: one case is set.
type ReturnOutcome struct {
	Ran *ReturnResult
}

// RunReturn runs Return from whatever states its rows are in: the transition function of those states.
// Its error is a *ReturnError: NotEnabled when no function runs from them, or the function's error.
func RunReturn(match Match) (ReturnOutcome, error) {
	if match == nil {
		return ReturnOutcome{}, &ReturnError{Kind: ReturnErrorInvalidArgument, Err: &InvalidArgument{Reason: "match is nil: no state"}}
	}
	if match, ok := match.(MatchNew); ok {
		r, err := Return(match)
		if err != nil {
			return ReturnOutcome{}, err
		}
		return ReturnOutcome{Ran: &r}, nil
	}
	return ReturnOutcome{}, &ReturnError{Kind: ReturnErrorNotEnabled, Err: &NotEnabled{UseCase: "Return"}}
}

// DeleteOutcome is what RunDelete returns when the use case runs: one case is set.
type DeleteOutcome struct {
	Ran *DeleteResult
}

// RunDelete runs Delete from whatever states its rows are in: the transition function of those states.
// Its error is a *DeleteError: NotEnabled when no function runs from them, or the function's error.
func RunDelete(match Match, switch_ Switch) (DeleteOutcome, error) {
	if match == nil {
		return DeleteOutcome{}, &DeleteError{Kind: DeleteErrorInvalidArgument, Err: &InvalidArgument{Reason: "match is nil: no state"}}
	}
	if match, ok := match.(MatchReturn); ok {
		r, err := Delete(match, switch_)
		if err != nil {
			return DeleteOutcome{}, err
		}
		return DeleteOutcome{Ran: &r}, nil
	}
	return DeleteOutcome{}, &DeleteError{Kind: DeleteErrorNotEnabled, Err: &NotEnabled{UseCase: "Delete"}}
}

// SuperOutcome is what RunSuper returns when the use case runs: one case is set.
type SuperOutcome struct {
	Ran *SuperResult
}

// RunSuper runs Super from whatever states its rows are in: the transition function of those states.
// Its error is a *SuperError: NotEnabled when no function runs from them, or the function's error.
func RunSuper(match Match) (SuperOutcome, error) {
	if match == nil {
		return SuperOutcome{}, &SuperError{Kind: SuperErrorInvalidArgument, Err: &InvalidArgument{Reason: "match is nil: no state"}}
	}
	if match, ok := match.(MatchSelf); ok {
		r, err := Super(match)
		if err != nil {
			return SuperOutcome{}, err
		}
		return SuperOutcome{Ran: &r}, nil
	}
	return SuperOutcome{}, &SuperError{Kind: SuperErrorNotEnabled, Err: &NotEnabled{UseCase: "Super"}}
}

// CrateOutcome is what RunCrate returns when the use case runs: one case is set.
type CrateOutcome struct {
	Ran *CrateResult
}

// RunCrate runs Crate from whatever states its rows are in: the transition function of those states.
// Its error is a *CrateError: NotEnabled when no function runs from them, or the function's error.
func RunCrate(match Match) (CrateOutcome, error) {
	if match == nil {
		return CrateOutcome{}, &CrateError{Kind: CrateErrorInvalidArgument, Err: &InvalidArgument{Reason: "match is nil: no state"}}
	}
	if match, ok := match.(MatchSuper); ok {
		r, err := Crate(match)
		if err != nil {
			return CrateOutcome{}, err
		}
		return CrateOutcome{Ran: &r}, nil
	}
	return CrateOutcome{}, &CrateError{Kind: CrateErrorNotEnabled, Err: &NotEnabled{UseCase: "Crate"}}
}

// DefaultOutcome is what RunDefault returns when the use case runs: one case is set.
type DefaultOutcome struct {
	Ran *DefaultResult
}

// RunDefault runs Default from whatever states its rows are in: the transition function of those states.
// Its error is a *DefaultError: NotEnabled when no function runs from them, or the function's error.
func RunDefault(match Match) (DefaultOutcome, error) {
	if match == nil {
		return DefaultOutcome{}, &DefaultError{Kind: DefaultErrorInvalidArgument, Err: &InvalidArgument{Reason: "match is nil: no state"}}
	}
	if match, ok := match.(MatchCrate); ok {
		r, err := Default(match)
		if err != nil {
			return DefaultOutcome{}, err
		}
		return DefaultOutcome{Ran: &r}, nil
	}
	return DefaultOutcome{}, &DefaultError{Kind: DefaultErrorNotEnabled, Err: &NotEnabled{UseCase: "Default"}}
}

// TypeOutcome is what RunType returns when the use case runs: one case is set.
type TypeOutcome struct {
	Ran *TypeResult
}

// RunType runs Type from whatever states its rows are in: the transition function of those states.
// Its error is a *TypeError: NotEnabled when no function runs from them, or the function's error.
func RunType(func_ Func) (TypeOutcome, error) {
	if func_ == nil {
		return TypeOutcome{}, &TypeError{Kind: TypeErrorInvalidArgument, Err: &InvalidArgument{Reason: "func is nil: no state"}}
	}
	if func_, ok := func_.(FuncNew); ok {
		r, err := Type(func_)
		if err != nil {
			return TypeOutcome{}, err
		}
		return TypeOutcome{Ran: &r}, nil
	}
	return TypeOutcome{}, &TypeError{Kind: TypeErrorNotEnabled, Err: &NotEnabled{UseCase: "Type"}}
}

// ClassOutcome is what RunClass returns when the use case runs: one case is set.
type ClassOutcome struct {
	Ran *ClassResult
}

// RunClass runs Class from whatever states its rows are in: the transition function of those states.
// Its error is a *ClassError: NotEnabled when no function runs from them, or the function's error.
func RunClass(func_ Func) (ClassOutcome, error) {
	if func_ == nil {
		return ClassOutcome{}, &ClassError{Kind: ClassErrorInvalidArgument, Err: &InvalidArgument{Reason: "func is nil: no state"}}
	}
	if func_, ok := func_.(FuncReturn); ok {
		r, err := Class(func_)
		if err != nil {
			return ClassOutcome{}, err
		}
		return ClassOutcome{Ran: &r}, nil
	}
	return ClassOutcome{}, &ClassError{Kind: ClassErrorNotEnabled, Err: &NotEnabled{UseCase: "Class"}}
}

// NewOutcome is what RunNew returns when the use case runs: one case is set.
type NewOutcome struct {
	FromNew    *NewFromNewResult
	FromReturn *NewFromReturnResult
	FromFunc   *NewFromFuncResult
}

// RunNew runs New from whatever states its rows are in: the transition function of those states.
// Its error is a *NewError: NotEnabled when no function runs from them, or the function's error.
func RunNew(parentFunction Function, parentFunc Func, parentMod Mod, matchId MatchId, matchType string, matchNew string, matchFunc string, matchSelf string, matchCrate string, matchSuper string, matchKind Kind) (NewOutcome, error) {
	if parentFunc == nil {
		return NewOutcome{}, &NewError{Kind: NewErrorInvalidArgument, Err: &InvalidArgument{Reason: "parent_func is nil: no state"}}
	}
	if parentFunc, ok := parentFunc.(FuncNew); ok {
		r, err := NewFromNew(parentFunction, parentFunc, parentMod, matchId, matchType, matchNew, matchFunc, matchSelf, matchCrate, matchSuper, matchKind)
		if err != nil {
			return NewOutcome{}, err
		}
		return NewOutcome{FromNew: &r}, nil
	}
	if parentFunc, ok := parentFunc.(FuncReturn); ok {
		r, err := NewFromReturn(parentFunction, parentFunc, parentMod, matchId, matchType, matchNew, matchFunc, matchSelf, matchCrate, matchSuper, matchKind)
		if err != nil {
			return NewOutcome{}, err
		}
		return NewOutcome{FromReturn: &r}, nil
	}
	if parentFunc, ok := parentFunc.(FuncFunc); ok {
		r, err := NewFromFunc(parentFunction, parentFunc, parentMod, matchId, matchType, matchNew, matchFunc, matchSelf, matchCrate, matchSuper, matchKind)
		if err != nil {
			return NewOutcome{}, err
		}
		return NewOutcome{FromFunc: &r}, nil
	}
	return NewOutcome{}, &NewError{Kind: NewErrorNotEnabled, Err: &NotEnabled{UseCase: "New"}}
}

// ── Commit: what a result writes ──

// StoredRow is a row of any entity as a store holds it: its type names the entity.
type StoredRow interface {
	isStoredRow()
}

func (Function) isStoredRow() {}

func (Mod) isStoredRow() {}

func (FuncRow) isStoredRow() {}

func (MatchRow) isStoredRow() {}

// StoredId is the id of a row of any entity: its type names the entity.
type StoredId interface {
	isStoredId()
}

func (FunctionId) isStoredId() {}

func (ModId) isStoredId() {}

func (FuncId) isStoredId() {}

func (MatchId) isStoredId() {}

// RowWrite is one row a commit writes, only where the row is still what Expected names: when
// it is not, the commit writes nothing and the call is NotEnabled. Row is stored (inserted when
// Expected is Absent, else updated), or the row is deleted when Delete is set.
type RowWrite struct {
	// Entity is the entity of the row, as the model names it.
	Entity string
	// Id is the row's id: nil when the entity has no one-column key.
	Id StoredId
	// Row is the row to store: nil for a delete.
	Row StoredRow
	// Delete says the row is deleted.
	Delete bool
	// Expected is what the row must still be.
	Expected ExpectedSource
}

// RunMark is a run mark of a use case split into transactions, on one row.
type RunMark struct {
	// UseCase is the use case of the run, as the model names it.
	UseCase string
	// Entity is the entity of the marked row, as the model names it.
	Entity string
	// Id is the id of the marked row.
	Id StoredId
	// Step is the step of the run that last wrote the row.
	Step int
}

// MarkWrite is one run mark a commit writes. A put at step 1 inserts the mark, where the
// row holds no mark of the use case; a put at a later step advances the row's mark from the
// step before; a delete removes the mark at its step, and the run ends on the row.
type MarkWrite struct {
	// Mark is the mark.
	Mark RunMark
	// Delete says the mark is deleted.
	Delete bool
}

// RaisedEvent is an event of any type a use case raises: its type names the event.
type RaisedEvent interface {
	isRaisedEvent()
}

func (Switch) isRaisedEvent() {}

// Writes is what one commit stores, in order: the rows, then the run marks, then the events.
type Writes struct {
	// UseCase is the use case whose result it is.
	UseCase string
	// Rows are the rows to write.
	Rows []RowWrite
	// Marks are the run marks to store, advance, or delete.
	Marks []MarkWrite
	// Events are the events raised.
	Events []RaisedEvent
}

// Committable is a result or an outcome a commit stores: every result and outcome type is one.
type Committable interface {
	// Writes returns every row, run mark, and event the commit writes, in order.
	Writes() Writes
}

// Writes returns what a commit of the result stores.
func (r ReturnResult) Writes() Writes {
	row0 := MatchToRow(r.Match)
	return Writes{UseCase: "Return", Rows: []RowWrite{{Entity: "Match", Id: row0.Id, Row: row0, Expected: r.MatchExpected}}, Events: []RaisedEvent{r.Switch}}
}

