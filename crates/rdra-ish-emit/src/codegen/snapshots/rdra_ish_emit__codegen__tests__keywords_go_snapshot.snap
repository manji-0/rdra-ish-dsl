// It returns new values and changes none of its arguments; its error is a *NewError: InvalidArgument when its arguments break what the verified model keeps.
func NewFromNew(parentFunction Function, parentFunc FuncNew, parentMod Mod, matchId MatchId, matchType string, matchNew string, matchFunc string, matchSelf string, matchCrate string, matchSuper string, matchKind Kind) (NewFromNewResult, error) {
	if _, ok := parentFunc.(funcNewState); !ok {
		return NewFromNewResult{}, &NewError{Kind: NewErrorInvalidArgument, Err: &InvalidArgument{Reason: "parent_func is no FuncNew this package made"}}
	}
	if !matchKind.Valid() {
		return NewFromNewResult{}, &NewError{Kind: NewErrorInvalidArgument, Err: &InvalidArgument{Reason: "match_kind is not a value of Kind"}}
	}
	return NewFromNewResult{Match: matchNewState{id: matchId, type_: matchType, default_: int64(0), new: matchNew, func_: matchFunc, self: matchSelf, crate: matchCrate, super: matchSuper, kind_: matchKind, functionId: parentFunction.Id, funcId: parentFunc.Id(), modId: parentMod.Id}, MatchExpected: ExpectedSource{Absent: true}}, nil
}

// NewFromReturnResult is what NewFromReturn returns.
type NewFromReturnResult struct {
	Match         MatchNew
	MatchExpected ExpectedSource
}

// NewFromReturn runs New (New). One run of the use case, from the states of the arguments' types. It requires what `New` requires and writes what it writes; the values the model leaves open are the inputs.
// It returns new values and changes none of its arguments; its error is a *NewError: InvalidArgument when its arguments break what the verified model keeps.
