// ReturnResult is what Return returns.
type ReturnResult struct {
	Match         MatchReturn
	MatchExpected ExpectedSource
	Switch        Switch
}

// Return runs Return (Return). One run of the use case, from the states of the arguments' types. It requires what `Return` requires and writes what it writes; the values the model leaves open are the inputs.
// It returns new values and changes none of its arguments; its error is a *ReturnError: InvalidArgument when its arguments break what the verified model keeps.
func Return(match MatchNew) (ReturnResult, error) {
	if _, ok := match.(matchNewState); !ok {
		return ReturnResult{}, &ReturnError{Kind: ReturnErrorInvalidArgument, Err: &InvalidArgument{Reason: "match is no MatchNew this package made"}}
	}
	return ReturnResult{Match: matchReturnState{id: match.Id(), type_: match.Type(), default_: match.Default(), new: match.New(), func_: match.Func(), self: match.Self(), crate: match.Crate(), super: match.Super(), kind_: match.Kind_(), functionId: match.FunctionId(), funcId: match.FuncId(), modId: match.ModId()}, MatchExpected: ExpectedSource{Column: "status", Value: "new"}, Switch: Switch{MatchId: match.Id()}}, nil
}

// DeleteResult is what Delete returns.
type DeleteResult struct {
	Match         MatchSelf
	MatchExpected ExpectedSource
}

// Delete runs Delete (Delete). One run of the use case, from the states of the arguments' types. It requires what `Delete` requires and writes what it writes; the values the model leaves open are the inputs.
// It returns new values and changes none of its arguments; its error is a *DeleteError: InvalidArgument when its arguments break what the verified model keeps.
func Delete(match MatchReturn, switch_ Switch) (DeleteResult, error) {
	if _, ok := match.(matchReturnState); !ok {
		return DeleteResult{}, &DeleteError{Kind: DeleteErrorInvalidArgument, Err: &InvalidArgument{Reason: "match is no MatchReturn this package made"}}
	}
	if match.Id() != switch_.MatchId {
		return DeleteResult{}, &DeleteError{Kind: DeleteErrorInvalidArgument, Err: &InvalidArgument{Reason: "rdra-ish: the Match row is not the row the event was raised on"}}
	}
	return DeleteResult{Match: matchSelfState{id: match.Id(), type_: match.Type(), default_: match.Default(), new: match.New(), func_: match.Func(), self: match.Self(), crate: match.Crate(), super: match.Super(), kind_: match.Kind_(), functionId: match.FunctionId(), funcId: match.FuncId(), modId: match.ModId()}, MatchExpected: ExpectedSource{Column: "status", Value: "return"}}, nil
}

// SuperResult is what Super returns.
type SuperResult struct {
	Match         MatchSuper
	MatchExpected ExpectedSource
}

// Super runs Super (Super). One run of the use case, from the states of the arguments' types. It requires what `Super` requires and writes what it writes; the values the model leaves open are the inputs.
// Requires the condition Small (Small default).
// It returns new values and changes none of its arguments; its error is a *SuperError: InvalidArgument when its arguments break what the verified model keeps, Rejected when a condition does not hold.
func Super(match MatchSelf) (SuperResult, error) {
	if _, ok := match.(matchSelfState); !ok {
		return SuperResult{}, &SuperError{Kind: SuperErrorInvalidArgument, Err: &InvalidArgument{Reason: "match is no MatchSelf this package made"}}
	}
	if !(match.Default() <= 4) {
		return SuperResult{}, &SuperError{Kind: SuperErrorRejected, Err: &Rejected{Condition: "Small", Label: "Small default", Site: ""}}
	}
	return SuperResult{Match: matchSuperState{id: match.Id(), type_: match.Type(), default_: match.Default(), new: match.New(), func_: match.Func(), self: match.Self(), crate: match.Crate(), super: match.Super(), kind_: match.Kind_(), functionId: match.FunctionId(), funcId: match.FuncId(), modId: match.ModId()}, MatchExpected: ExpectedSource{Column: "status", Value: "self"}}, nil
}

// CrateResult is what Crate returns.
type CrateResult struct {
	Match         MatchCrate
	MatchExpected ExpectedSource
}

// Crate runs Crate (Crate). One run of the use case, from the states of the arguments' types. It requires what `Crate` requires and writes what it writes; the values the model leaves open are the inputs.
// It returns new values and changes none of its arguments; its error is a *CrateError: InvalidArgument when its arguments break what the verified model keeps.
func Crate(match MatchSuper) (CrateResult, error) {
	if _, ok := match.(matchSuperState); !ok {
		return CrateResult{}, &CrateError{Kind: CrateErrorInvalidArgument, Err: &InvalidArgument{Reason: "match is no MatchSuper this package made"}}
	}
	return CrateResult{Match: matchCrateState{id: match.Id(), type_: match.Type(), default_: int64(2), new: match.New(), func_: match.Func(), self: match.Self(), crate: match.Crate(), super: match.Super(), kind_: match.Kind_(), functionId: match.FunctionId(), funcId: match.FuncId(), modId: match.ModId()}, MatchExpected: ExpectedSource{Column: "status", Value: "super"}}, nil
}

