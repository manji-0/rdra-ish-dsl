// ── Use cases ──

// ExpectedSource is what a row a result writes must still be when the write commits, so the
// store can write it conditionally and take a write that matches no row as NotEnabled (see the
// obligations). Absent: the row is created, and no row has its id. Otherwise the row exists,
// and when Column is set, it holds Value.
type ExpectedSource struct {
	Absent bool
	Column string
	Value  string
}

// ReturnErrorKind is the case of a ReturnError.
type ReturnErrorKind string

// The cases of ReturnError.
const (
	// ReturnErrorNotEnabled: the rows are in states Return does not run from (only its dispatcher says so), or a store's commit found a row changed.
	ReturnErrorNotEnabled ReturnErrorKind = "NotEnabled"
	// ReturnErrorNotFound: a row the call names does not exist (only the service's load says so).
	ReturnErrorNotFound ReturnErrorKind = "NotFound"
	// ReturnErrorInvalidArgument: the arguments break what the verified model keeps.
	ReturnErrorInvalidArgument ReturnErrorKind = "InvalidArgument"
	// ReturnErrorStoreFailed: the store failed (only the service's load or commit says so).
	ReturnErrorStoreFailed ReturnErrorKind = "StoreFailed"
)

// ReturnError is why Return did not run. Kind is its case, and Err the case's detail (*NotEnabled, *NotFound, *InvalidArgument, *StoreFailed), which errors.As reaches and errors.Is matches with ErrNotEnabled, ErrNotFound, ErrInvalidArgument, ErrStoreFailed.
type ReturnError struct {
	Kind ReturnErrorKind
	Err  error
}

// Error names the use case and the case.
func (e *ReturnError) Error() string {
	if e.Err == nil {
		return "Return: " + string(e.Kind)
	}
	return "Return: " + e.Err.Error()
}

// Unwrap returns the case's detail.
func (e *ReturnError) Unwrap() error {
	return e.Err
}

