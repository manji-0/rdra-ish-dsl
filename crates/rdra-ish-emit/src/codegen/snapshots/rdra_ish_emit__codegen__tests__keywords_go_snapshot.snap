}

// NewFromFunc runs New (New). One run of the use case, from the states of the arguments' types. It requires what `New` requires and writes what it writes; the values the model leaves open are the inputs.
// It returns new values and changes none of its arguments; its error is a *NewError: InvalidArgument when its arguments break what the verified model keeps.
func NewFromFunc(parentFunction Function, parentFunc FuncFunc, parentMod Mod, matchId MatchId, matchType string, matchNew string, matchFunc string, matchSelf string, matchCrate string, matchSuper string, matchKind Kind) (NewFromFuncResult, error) {
	if _, ok := parentFunc.(funcFuncState); !ok {
