	}
	return NewFromReturnResult{Match: matchNewState{id: matchId, type_: matchType, default_: int64(0), new: matchNew, func_: matchFunc, self: matchSelf, crate: matchCrate, super: matchSuper, kind_: matchKind, functionId: parentFunction.Id, funcId: parentFunc.Id(), modId: parentMod.Id}, MatchExpected: ExpectedSource{Absent: true}}, nil
}

// NewFromFuncResult is what NewFromFunc returns.
type NewFromFuncResult struct {
