		return MatchRow{Id: v.Id, Status: MatchStatusSelf, Type: v.Type, Default: v.Default, New: v.New, Func: v.Func, Self: v.Self, Crate: v.Crate, Super: v.Super, Kind: v.Kind, FunctionId: v.FunctionId, FuncId: v.FuncId, ModId: v.ModId}
	case MatchSuper:
		return MatchRow{Id: v.Id, Status: MatchStatusSuper, Type: v.Type, Default: v.Default, New: v.New, Func: v.Func, Self: v.Self, Crate: v.Crate, Super: v.Super, Kind: v.Kind, FunctionId: v.FunctionId, FuncId: v.FuncId, ModId: v.ModId}
	case MatchCrate:
		return MatchRow{Id: v.Id, Status: MatchStatusCrate, Type: v.Type, Default: v.Default, New: v.New, Func: v.Func, Self: v.Self, Crate: v.Crate, Super: v.Super, Kind: v.Kind, FunctionId: v.FunctionId, FuncId: v.FuncId, ModId: v.ModId}
	case MatchDefault:
		return MatchRow{Id: v.Id, Status: MatchStatusDefault, Type: v.Type, Default: v.Default, New: v.New, Func: v.Func, Self: v.Self, Crate: v.Crate, Super: v.Super, Kind: v.Kind, FunctionId: v.FunctionId, FuncId: v.FuncId, ModId: v.ModId}
	}
	panic("rdra-ish: a state of Match this package does not declare")
}

// ── Dispatch: run a use case from whatever states its rows are in ──

// NotEnabled reports rows in states the use case does not run from.
type NotEnabled struct {
	UseCase string
}

// Error names the use case.
func (e *NotEnabled) Error() string {
	return "the use case " + e.UseCase + " does not run from these states"
}

// ReturnOutcome is what RunReturn returns when the use case runs: one case is set.
type ReturnOutcome struct {
	Ran *ReturnResult
}

// RunReturn runs Return from whatever states its rows are in: the transition function of those states, or NotEnabled.
func RunReturn(match Match) (ReturnOutcome, error) {
	if match, ok := match.(MatchNew); ok {
		r := Return(match)
		return ReturnOutcome{Ran: &r}, nil
	}
	return ReturnOutcome{}, &NotEnabled{UseCase: "Return"}
}

// DeleteOutcome is what RunDelete returns when the use case runs: one case is set.
type DeleteOutcome struct {
	Ran *DeleteResult
}

// RunDelete runs Delete from whatever states its rows are in: the transition function of those states, or NotEnabled.
func RunDelete(match Match, switch_ Switch) (DeleteOutcome, error) {
	if match, ok := match.(MatchReturn); ok {
		r := Delete(match, switch_)
		return DeleteOutcome{Ran: &r}, nil
	}
	return DeleteOutcome{}, &NotEnabled{UseCase: "Delete"}
}

// SuperOutcome is what RunSuper returns when the use case runs: one case is set.
type SuperOutcome struct {
	Ran *SuperResult
}

// RunSuper runs Super from whatever states its rows are in: the transition function of those states, or NotEnabled.
func RunSuper(match Match) (SuperOutcome, error) {
	if match, ok := match.(MatchSelf); ok {
		r := Super(match)
		return SuperOutcome{Ran: &r}, nil
	}
	return SuperOutcome{}, &NotEnabled{UseCase: "Super"}
}

// CrateOutcome is what RunCrate returns when the use case runs: one case is set.
type CrateOutcome struct {
	Ran *CrateResult
}

// RunCrate runs Crate from whatever states its rows are in: the transition function of those states, or NotEnabled.
func RunCrate(match Match) (CrateOutcome, error) {
	if match, ok := match.(MatchSuper); ok {
		r := Crate(match)
		return CrateOutcome{Ran: &r}, nil
	}
	return CrateOutcome{}, &NotEnabled{UseCase: "Crate"}
}

// DefaultOutcome is what RunDefault returns when the use case runs: one case is set.
type DefaultOutcome struct {
	Ran *DefaultResult
}

// RunDefault runs Default from whatever states its rows are in: the transition function of those states, or NotEnabled.
func RunDefault(match Match) (DefaultOutcome, error) {
	if match, ok := match.(MatchCrate); ok {
		r := Default(match)
		return DefaultOutcome{Ran: &r}, nil
	}
	return DefaultOutcome{}, &NotEnabled{UseCase: "Default"}
}

// TypeOutcome is what RunType returns when the use case runs: one case is set.
type TypeOutcome struct {
	Ran *TypeResult
}

// RunType runs Type from whatever states its rows are in: the transition function of those states, or NotEnabled.
func RunType(func_ Func) (TypeOutcome, error) {
	if func_, ok := func_.(FuncNew); ok {
		r := Type(func_)
		return TypeOutcome{Ran: &r}, nil
	}
	return TypeOutcome{}, &NotEnabled{UseCase: "Type"}
}

// ClassOutcome is what RunClass returns when the use case runs: one case is set.
type ClassOutcome struct {
	Ran *ClassResult
}

// RunClass runs Class from whatever states its rows are in: the transition function of those states, or NotEnabled.
func RunClass(func_ Func) (ClassOutcome, error) {
	if func_, ok := func_.(FuncReturn); ok {
		r := Class(func_)
		return ClassOutcome{Ran: &r}, nil
	}
	return ClassOutcome{}, &NotEnabled{UseCase: "Class"}
}

// NewOutcome is what RunNew returns when the use case runs: one case is set.
type NewOutcome struct {
	FromNew *NewFromNewResult
	FromReturn *NewFromReturnResult
	FromFunc *NewFromFuncResult
}

// RunNew runs New from whatever states its rows are in: the transition function of those states, or NotEnabled.
func RunNew(parentFunction Function, parentFunc Func, parentMod Mod, matchId MatchId, matchType string, matchDefault int64, matchNew string, matchFunc string, matchSelf string, matchCrate string, matchSuper string, matchKind Kind) (NewOutcome, error) {
	if parentFunc, ok := parentFunc.(FuncNew); ok {
		r := NewFromNew(parentFunction, parentFunc, parentMod, matchId, matchType, matchDefault, matchNew, matchFunc, matchSelf, matchCrate, matchSuper, matchKind)
		return NewOutcome{FromNew: &r}, nil
	}
	if parentFunc, ok := parentFunc.(FuncReturn); ok {
		r := NewFromReturn(parentFunction, parentFunc, parentMod, matchId, matchType, matchDefault, matchNew, matchFunc, matchSelf, matchCrate, matchSuper, matchKind)
		return NewOutcome{FromReturn: &r}, nil
	}
	if parentFunc, ok := parentFunc.(FuncFunc); ok {
		r := NewFromFunc(parentFunction, parentFunc, parentMod, matchId, matchType, matchDefault, matchNew, matchFunc, matchSelf, matchCrate, matchSuper, matchKind)
		return NewOutcome{FromFunc: &r}, nil
	}
	return NewOutcome{}, &NotEnabled{UseCase: "New"}
}

// ── Helpers ──

func ptrTo[T any](v T) *T { return &v }

// mustPresent reads a value the verified model keeps present; nil means the rows broke a rule.
func mustPresent[T any](p *T, message string) T {
	if p == nil {
		panic(message)
	}
	return *p
}
