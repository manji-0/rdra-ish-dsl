        status: "default",
        id: row.id,
        type: row.type,
        default: row.default,
        new: row.new,
        func: row.func,
        self: row.self,
        crate: row.crate,
        super: row.super,
        kind: row.kind,
        function_id: row.function_id,
        func_id: row.func_id,
        mod_id: row.mod_id,
      };
    }
  }
}

/** The flat row of a Match. */
export function matchToRow(state: Match): MatchRow {
  return {
    id: state.id,
    status: state.status,
    type: state.type,
    default: state.default,
    new: state.new,
    func: state.func,
    self: state.self,
    crate: state.crate,
    super: state.super,
    kind: state.kind,
    function_id: state.function_id,
    func_id: state.func_id,
    mod_id: state.mod_id,
  };
}

// ── Dispatch: run a use case from whatever states its rows are in ──

/** The rows are in states the use case does not run from. */
export interface NotEnabled {
  readonly notEnabled: string;
}

/** What runReturn returns when the use case runs. */
export type ReturnOutcome = ReturnResult;

/** Runs Return from whatever states its rows are in: the transition function of those states, or NotEnabled. */
export function runReturn(match: Match): ReturnOutcome | NotEnabled {
  if (match.status === "new") {
    return return_(match);
  }
  return { notEnabled: "Return" };
}

/** What runDelete returns when the use case runs. */
export type DeleteOutcome = DeleteResult;

/** Runs Delete from whatever states its rows are in: the transition function of those states, or NotEnabled. */
export function runDelete(match: Match, switch_: Switch): DeleteOutcome | NotEnabled {
  if (match.status === "return") {
    return delete_(match, switch_);
  }
  return { notEnabled: "Delete" };
}

/** What runSuper returns when the use case runs. */
export type SuperOutcome = SuperResult;

/** Runs Super from whatever states its rows are in: the transition function of those states, or NotEnabled. */
export function runSuper(match: Match): SuperOutcome | Rejected | NotEnabled {
  if (match.status === "self") {
    return super_(match);
  }
  return { notEnabled: "Super" };
}

/** What runCrate returns when the use case runs. */
export type CrateOutcome = CrateResult;

/** Runs Crate from whatever states its rows are in: the transition function of those states, or NotEnabled. */
export function runCrate(match: Match): CrateOutcome | NotEnabled {
  if (match.status === "super") {
    return crate(match);
  }
  return { notEnabled: "Crate" };
}

/** What runDefault returns when the use case runs. */
export type DefaultOutcome = DefaultResult;

/** Runs Default from whatever states its rows are in: the transition function of those states, or NotEnabled. */
export function runDefault(match: Match): DefaultOutcome | NotEnabled {
  if (match.status === "crate") {
    return default_(match);
  }
  return { notEnabled: "Default" };
}

/** What runType returns when the use case runs. */
export type TypeOutcome = TypeResult;

/** Runs Type from whatever states its rows are in: the transition function of those states, or NotEnabled. */
export function runType(func: Func): TypeOutcome | NotEnabled {
  if (func.type === "new") {
    return type(func);
  }
  return { notEnabled: "Type" };
}

/** What runClass returns when the use case runs. */
export type ClassOutcome = ClassResult;

/** Runs Class from whatever states its rows are in: the transition function of those states, or NotEnabled. */
export function runClass(func: Func): ClassOutcome | NotEnabled {
  if (func.type === "return") {
    return class_(func);
  }
  return { notEnabled: "Class" };
}

/** What runNew returns when the use case runs. */
export type NewOutcome = NewFromNewResult | NewFromReturnResult | NewFromFuncResult;

/** Runs New from whatever states its rows are in: the transition function of those states, or NotEnabled. */
export function runNew(parentFunction: Function, parentFunc: Func, parentMod: Mod, matchId: MatchId, matchType: string, matchNew: string, matchFunc: string, matchSelf: string, matchCrate: string, matchSuper: string, matchKind: Kind): NewOutcome | NotEnabled {
  if (parentFunc.type === "new") {
    return newFromNew(parentFunction, parentFunc, parentMod, matchId, matchType, matchNew, matchFunc, matchSelf, matchCrate, matchSuper, matchKind);
  }
  if (parentFunc.type === "return") {
    return newFromReturn(parentFunction, parentFunc, parentMod, matchId, matchType, matchNew, matchFunc, matchSelf, matchCrate, matchSuper, matchKind);
  }
  if (parentFunc.type === "func") {
    return newFromFunc(parentFunction, parentFunc, parentMod, matchId, matchType, matchNew, matchFunc, matchSelf, matchCrate, matchSuper, matchKind);
  }
  return { notEnabled: "New" };
}
