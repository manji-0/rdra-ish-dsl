  const $func_id = FuncId.parse(value["func_id"]);
  if (!$func_id.ok) {
    return $column("Match", "func_id", $func_id.error);
  }
  const $mod_id = ModId.parse(value["mod_id"]);
  if (!$mod_id.ok) {
    return $column("Match", "mod_id", $mod_id.error);
  }
  return {
    ok: true,
    value: {
      id: $id.value,
      status: $status.value,
      type: $type.value,
      default: $default.value,
      new: $new.value,
      func: $func.value,
      self: $self.value,
      crate: $crate.value,
      super: $super.value,
      kind: $kind.value,
      function_id: $function_id.value,
      func_id: $func_id.value,
      mod_id: $mod_id.value,
    },
  };
}

// ── Events ──

/** Switch */
export type Switch = Readonly<{
  kind: "Switch";
  /** The Match row the event was raised on. */
  match_id: MatchId;
}>;

// ── Use cases ──

/** The rows are in states the use case does not run from. Only a dispatcher returns it. */
export type NotEnabled = Readonly<{ kind: "NotEnabled"; usecase: string }>;

/** A condition of the use case did not hold: the use case does not run. */
export type Rejected = Readonly<{ kind: "Rejected"; condition: string; label: string; site: string | null }>;

/**
 * The arguments break what the verified model keeps: a child row that does not name the
 * parent passed with it, a row that is not the event's, a column the target state keeps null
 * that holds a value. The model never reaches such rows; a caller that passes them has a bug.
 */
export type InvalidArgument = Readonly<{ kind: "InvalidArgument"; message: string }>;

/**
 * What a row a result writes must still be when the write commits, so the store can write it
 * conditionally and take a write that matches no row as NotEnabled (see the obligations).
 */
export type ExpectedSource =
  | Readonly<{ kind: "absent" }>
  | Readonly<{ kind: "present" }>
  | Readonly<{ kind: "in"; column: string; value: string }>;

/** What Return can fail with: NotEnabled from a dispatcher. */
export type ReturnError = NotEnabled;

/** What Delete can fail with: NotEnabled from a dispatcher, InvalidArgument for rows the model never reaches. */
export type DeleteError = NotEnabled | InvalidArgument;

/** What Super can fail with: NotEnabled from a dispatcher, Rejected by a condition. */
export type SuperError = NotEnabled | Rejected;

/** What Crate can fail with: NotEnabled from a dispatcher. */
export type CrateError = NotEnabled;

/** What Default can fail with: NotEnabled from a dispatcher. */
export type DefaultError = NotEnabled;

/** What Type can fail with: NotEnabled from a dispatcher. */
export type TypeError = NotEnabled;

/** What Class can fail with: NotEnabled from a dispatcher. */
export type ClassError = NotEnabled;

/** What New can fail with: NotEnabled from a dispatcher. */
export type NewError = NotEnabled;

/** What Static can fail with: NotEnabled from a dispatcher. */
export type StaticError = NotEnabled;

/** What return_ returns. */
export type ReturnResult = Readonly<{
  match: MatchReturn;
  match_expected: ExpectedSource;
  switch: Switch;
}>;

/**
 * Return (Return).
 * One run of the use case, from the states of the arguments' types. It requires what `Return` requires and writes what it writes; the values the model leaves open are the inputs.
 */
export function return_(match: MatchNew): Result<ReturnResult, ReturnError> {
  return {
    ok: true,
    value: {
      match: {
        kind: "Return",
        id: match.id,
        type: match.type,
        default: match.default,
        new: match.new,
        func: match.func,
        self: match.self,
        crate: match.crate,
        super: match.super,
        kind_: match.kind_,
        function_id: match.function_id,
        func_id: match.func_id,
        mod_id: match.mod_id,
      },
      match_expected: { kind: "in", column: "status", value: "new" },
      switch: { kind: "Switch", match_id: match.id },
    },
  };
}

/** What delete_ returns. */
export type DeleteResult = Readonly<{
  match: MatchSelf;
  match_expected: ExpectedSource;
}>;

/**
 * Delete (Delete).
 * One run of the use case, from the states of the arguments' types. It requires what `Delete` requires and writes what it writes; the values the model leaves open are the inputs.
 */
export function delete_(match: MatchReturn, switch_: Switch): Result<DeleteResult, DeleteError> {
  if (match.id !== switch_.match_id) {
    return { ok: false, error: { kind: "InvalidArgument", message: "rdra-ish: the Match row is not the row the event was raised on" } };
  }
  return {
    ok: true,
    value: {
      match: {
        kind: "Self",
        id: match.id,
        type: match.type,
        default: match.default,
        new: match.new,
        func: match.func,
        self: match.self,
        crate: match.crate,
        super: match.super,
        kind_: match.kind_,
        function_id: match.function_id,
        func_id: match.func_id,
        mod_id: match.mod_id,
      },
      match_expected: { kind: "in", column: "status", value: "return" },
    },
  };
}

/** What super_ returns. */
export type SuperResult = Readonly<{
  match: MatchSuper;
  match_expected: ExpectedSource;
}>;

/**
 * Super (Super).
 * One run of the use case, from the states of the arguments' types. It requires what `Super` requires and writes what it writes; the values the model leaves open are the inputs.
 * Requires the condition Small (Small default); Rejected when it does not hold.
 */
export function super_(match: MatchSelf): Result<SuperResult, SuperError> {
  if (!(match.default <= 4)) {
    return { ok: false, error: { kind: "Rejected", condition: "Small", label: "Small default", site: null } };
  }
  return {
    ok: true,
    value: {
      match: {
        kind: "Super",
        id: match.id,
        type: match.type,
        default: match.default,
        new: match.new,
        func: match.func,
        self: match.self,
        crate: match.crate,
        super: match.super,
        kind_: match.kind_,
        function_id: match.function_id,
        func_id: match.func_id,
        mod_id: match.mod_id,
      },
      match_expected: { kind: "in", column: "status", value: "self" },
    },
  };
}

/** What crate returns. */
export type CrateResult = Readonly<{
  match: MatchCrate;
  match_expected: ExpectedSource;
}>;

/**
 * Crate (Crate).
 * One run of the use case, from the states of the arguments' types. It requires what `Crate` requires and writes what it writes; the values the model leaves open are the inputs.
 */
export function crate(match: MatchSuper): Result<CrateResult, CrateError> {
  return {
    ok: true,
    value: {
      match: {
        kind: "Crate",
        id: match.id,
        type: match.type,
        default: 2,
        new: match.new,
        func: match.func,
        self: match.self,
        crate: match.crate,
        super: match.super,
        kind_: match.kind_,
        function_id: match.function_id,
        func_id: match.func_id,
        mod_id: match.mod_id,
      },
      match_expected: { kind: "in", column: "status", value: "super" },
    },
  };
}

/** What default_ returns. */
export type DefaultResult = Readonly<{
  match: MatchDefault;
  match_expected: ExpectedSource;
}>;

/**
 * Default (Default).
 * One run of the use case, from the states of the arguments' types. It requires what `Default` requires and writes what it writes; the values the model leaves open are the inputs.
 */
export function default_(match: MatchCrate): Result<DefaultResult, DefaultError> {
  return {
    ok: true,
    value: {
      match: {
        kind: "Default",
        id: match.id,
        type: match.type,
        default: match.default,
        new: match.new,
        func: match.func,
        self: match.self,
        crate: match.crate,
        super: match.super,
        kind_: match.kind_,
        function_id: match.function_id,
        func_id: match.func_id,
        mod_id: match.mod_id,
      },
      match_expected: { kind: "in", column: "status", value: "crate" },
    },
  };
}

/** What type returns. */
export type TypeResult = Readonly<{
  func: FuncReturn;
  func_expected: ExpectedSource;
}>;

/**
 * Type (Type).
 * One run of the use case, from the states of the arguments' types. It requires what `Type` requires and writes what it writes; the values the model leaves open are the inputs.
 */
export function type(func: FuncNew): Result<TypeResult, TypeError> {
  return {
    ok: true,
    value: {
      func: {
        kind: "Return",
        id: func.id,
      },
      func_expected: { kind: "in", column: "type", value: "new" },
    },
  };
}

/** What class_ returns. */
export type ClassResult = Readonly<{
  func: FuncFunc;
  func_expected: ExpectedSource;
}>;

/**
 * Class (Class).
 * One run of the use case, from the states of the arguments' types. It requires what `Class` requires and writes what it writes; the values the model leaves open are the inputs.
 */
export function class_(func: FuncReturn): Result<ClassResult, ClassError> {
  return {
    ok: true,
    value: {
      func: {
        kind: "Func",
        id: func.id,
      },
      func_expected: { kind: "in", column: "type", value: "return" },
    },
  };
}

/** What newFromNew returns. */
export type NewFromNewResult = Readonly<{
  match: MatchNew;
  match_expected: ExpectedSource;
}>;

/**
 * New (New).
 * One run of the use case, from the states of the arguments' types. It requires what `New` requires and writes what it writes; the values the model leaves open are the inputs.
 */
export function newFromNew(parentFunction: Function, parentFunc: FuncNew, parentMod: Mod, matchId: MatchId, matchType: string, matchNew: string, matchFunc: string, matchSelf: string, matchCrate: string, matchSuper: string, matchKind: Kind): Result<NewFromNewResult, NewError> {
  return {
    ok: true,
    value: {
      match: {
        kind: "New",
        id: matchId,
        type: matchType,
        default: 0,
        new: matchNew,
        func: matchFunc,
        self: matchSelf,
        crate: matchCrate,
        super: matchSuper,
        kind_: matchKind,
        function_id: parentFunction.id,
        func_id: parentFunc.id,
        mod_id: parentMod.id,
      },
      match_expected: { kind: "absent" },
    },
  };
}

/** What newFromReturn returns. */
export type NewFromReturnResult = Readonly<{
  match: MatchNew;
  match_expected: ExpectedSource;
}>;

/**
 * New (New).
 * One run of the use case, from the states of the arguments' types. It requires what `New` requires and writes what it writes; the values the model leaves open are the inputs.
 */
export function newFromReturn(parentFunction: Function, parentFunc: FuncReturn, parentMod: Mod, matchId: MatchId, matchType: string, matchNew: string, matchFunc: string, matchSelf: string, matchCrate: string, matchSuper: string, matchKind: Kind): Result<NewFromReturnResult, NewError> {
  return {
    ok: true,
    value: {
      match: {
        kind: "New",
        id: matchId,
        type: matchType,
        default: 0,
        new: matchNew,
        func: matchFunc,
        self: matchSelf,
        crate: matchCrate,
        super: matchSuper,
        kind_: matchKind,
        function_id: parentFunction.id,
        func_id: parentFunc.id,
        mod_id: parentMod.id,
      },
      match_expected: { kind: "absent" },
    },
  };
}

/** What newFromFunc returns. */
export type NewFromFuncResult = Readonly<{
  match: MatchNew;
  match_expected: ExpectedSource;
}>;

/**
 * New (New).
 * One run of the use case, from the states of the arguments' types. It requires what `New` requires and writes what it writes; the values the model leaves open are the inputs.
 */
export function newFromFunc(parentFunction: Function, parentFunc: FuncFunc, parentMod: Mod, matchId: MatchId, matchType: string, matchNew: string, matchFunc: string, matchSelf: string, matchCrate: string, matchSuper: string, matchKind: Kind): Result<NewFromFuncResult, NewError> {
  return {
    ok: true,
    value: {
      match: {
        kind: "New",
        id: matchId,
        type: matchType,
        default: 0,
        new: matchNew,
        func: matchFunc,
        self: matchSelf,
        crate: matchCrate,
        super: matchSuper,
        kind_: matchKind,
        function_id: parentFunction.id,
        func_id: parentFunc.id,
        mod_id: parentMod.id,
      },
      match_expected: { kind: "absent" },
    },
  };
}

/** What static_ returns. */
export type StaticResult = Readonly<{
  function: Function;
  function_expected: ExpectedSource;
}>;

/**
 * Static (Static).
 * One run of the use case, from the states of the arguments' types. It requires what `Static` requires and writes what it writes; the values the model leaves open are the inputs.
 */
export function static_(function_: Function, functionDefault: string): Result<StaticResult, StaticError> {
  return {
    ok: true,
    value: {
      function: {
        id: function_.id,
        default: functionDefault,
      },
      function_expected: { kind: "present" },
    },
  };
}

// ── Rule checks ──

/** The rules a Function row breaks, by the names `check` reports: empty when it keeps them all. */
export function functionRuleViolations(_row: Function): readonly string[] {
  return [];
}

/** The rules a Mod row breaks, by the names `check` reports: empty when it keeps them all. */
export function modRuleViolations(_row: Mod): readonly string[] {
  return [];
}

/** The rules a FuncNew row breaks, by the names `check` reports: empty when it keeps them all. */
export function funcNewRuleViolations(_row: FuncNew): readonly string[] {
  return [];
}

/** The rules a FuncReturn row breaks, by the names `check` reports: empty when it keeps them all. */
export function funcReturnRuleViolations(_row: FuncReturn): readonly string[] {
  return [];
}

/** The rules a FuncFunc row breaks, by the names `check` reports: empty when it keeps them all. */
export function funcFuncRuleViolations(_row: FuncFunc): readonly string[] {
  return [];
}

/** The rules a MatchNew row breaks, by the names `check` reports: empty when it keeps them all. */
export function matchNewRuleViolations(row: MatchNew): readonly string[] {
  const out: string[] = [];
  if (row.default > 4) {
    out.push("Forbidden_Match_0"); // default > 4
  }
  return out;
}

/** The rules a MatchReturn row breaks, by the names `check` reports: empty when it keeps them all. */
export function matchReturnRuleViolations(row: MatchReturn): readonly string[] {
  const out: string[] = [];
  if (row.default > 4) {
    out.push("Forbidden_Match_0"); // default > 4
  }
  return out;
}

/** The rules a MatchSelf row breaks, by the names `check` reports: empty when it keeps them all. */
export function matchSelfRuleViolations(row: MatchSelf): readonly string[] {
  const out: string[] = [];
  if (row.default > 4) {
    out.push("Forbidden_Match_0"); // default > 4
  }
  if (!(row.default <= 4)) {
    out.push("Inv_Match_0"); // when status=self then default <= 4
  }
  return out;
}

/** The rules a MatchSuper row breaks, by the names `check` reports: empty when it keeps them all. */
export function matchSuperRuleViolations(row: MatchSuper): readonly string[] {
  const out: string[] = [];
  if (row.default > 4) {
    out.push("Forbidden_Match_0"); // default > 4
  }
  return out;
}

/** The rules a MatchCrate row breaks, by the names `check` reports: empty when it keeps them all. */
export function matchCrateRuleViolations(row: MatchCrate): readonly string[] {
  const out: string[] = [];
  if (row.default > 4) {
    out.push("Forbidden_Match_0"); // default > 4
  }
  return out;
}

/** The rules a MatchDefault row breaks, by the names `check` reports: empty when it keeps them all. */
export function matchDefaultRuleViolations(row: MatchDefault): readonly string[] {
  const out: string[] = [];
  if (row.default > 4) {
    out.push("Forbidden_Match_0"); // default > 4
  }
  return out;
}

/** The rules a Func row breaks, by its state: empty when it keeps them all. */
export function funcRuleViolations(row: Func): readonly string[] {
  const kind = row.kind;
  switch (kind) {
    case "New":
      return funcNewRuleViolations(row);
    case "Return":
      return funcReturnRuleViolations(row);
    case "Func":
      return funcFuncRuleViolations(row);
    default:
      return assertNever(kind);
  }
}

/** The rules a Match row breaks, by its state: empty when it keeps them all. */
export function matchRuleViolations(row: Match): readonly string[] {
  const kind = row.kind;
  switch (kind) {
    case "New":
      return matchNewRuleViolations(row);
    case "Return":
      return matchReturnRuleViolations(row);
    case "Self":
      return matchSelfRuleViolations(row);
    case "Super":
      return matchSuperRuleViolations(row);
    case "Crate":
      return matchCrateRuleViolations(row);
    case "Default":
      return matchDefaultRuleViolations(row);
    default:
      return assertNever(kind);
  }
}

// ── Dispatch: run a use case from whatever states its rows are in ──

/** What runReturn returns when the use case runs. */
export type ReturnOutcome = ReturnResult;

/** Runs Return from whatever states its rows are in: the transition function of those states, or NotEnabled. */
export function runReturn(match: Match): Result<ReturnOutcome, ReturnError> {
  if (match.kind === "New") {
    return return_(match);
  }
  return { ok: false, error: { kind: "NotEnabled", usecase: "Return" } };
}

/** What runDelete returns when the use case runs. */
export type DeleteOutcome = DeleteResult;

/** Runs Delete from whatever states its rows are in: the transition function of those states, or NotEnabled. */
export function runDelete(match: Match, switch_: Switch): Result<DeleteOutcome, DeleteError> {
  if (match.kind === "Return") {
    return delete_(match, switch_);
  }
  return { ok: false, error: { kind: "NotEnabled", usecase: "Delete" } };
}

/** What runSuper returns when the use case runs. */
export type SuperOutcome = SuperResult;

/** Runs Super from whatever states its rows are in: the transition function of those states, or NotEnabled. */
export function runSuper(match: Match): Result<SuperOutcome, SuperError> {
  if (match.kind === "Self") {
    return super_(match);
  }
  return { ok: false, error: { kind: "NotEnabled", usecase: "Super" } };
}

/** What runCrate returns when the use case runs. */
export type CrateOutcome = CrateResult;

/** Runs Crate from whatever states its rows are in: the transition function of those states, or NotEnabled. */
export function runCrate(match: Match): Result<CrateOutcome, CrateError> {
  if (match.kind === "Super") {
    return crate(match);
  }
  return { ok: false, error: { kind: "NotEnabled", usecase: "Crate" } };
}

/** What runDefault returns when the use case runs. */
export type DefaultOutcome = DefaultResult;

/** Runs Default from whatever states its rows are in: the transition function of those states, or NotEnabled. */
export function runDefault(match: Match): Result<DefaultOutcome, DefaultError> {
  if (match.kind === "Crate") {
    return default_(match);
  }
  return { ok: false, error: { kind: "NotEnabled", usecase: "Default" } };
}

/** What runType returns when the use case runs. */
export type TypeOutcome = TypeResult;

/** Runs Type from whatever states its rows are in: the transition function of those states, or NotEnabled. */
export function runType(func: Func): Result<TypeOutcome, TypeError> {
  if (func.kind === "New") {
    return type(func);
  }
  return { ok: false, error: { kind: "NotEnabled", usecase: "Type" } };
}

/** What runClass returns when the use case runs. */
export type ClassOutcome = ClassResult;

/** Runs Class from whatever states its rows are in: the transition function of those states, or NotEnabled. */
export function runClass(func: Func): Result<ClassOutcome, ClassError> {
  if (func.kind === "Return") {
    return class_(func);
  }
  return { ok: false, error: { kind: "NotEnabled", usecase: "Class" } };
}

/** What runNew returns when the use case runs. */
export type NewOutcome = NewFromNewResult | NewFromReturnResult | NewFromFuncResult;

/** Runs New from whatever states its rows are in: the transition function of those states, or NotEnabled. */
export function runNew(parentFunction: Function, parentFunc: Func, parentMod: Mod, matchId: MatchId, matchType: string, matchNew: string, matchFunc: string, matchSelf: string, matchCrate: string, matchSuper: string, matchKind: Kind): Result<NewOutcome, NewError> {
  if (parentFunc.kind === "New") {
    return newFromNew(parentFunction, parentFunc, parentMod, matchId, matchType, matchNew, matchFunc, matchSelf, matchCrate, matchSuper, matchKind);
  }
  if (parentFunc.kind === "Return") {
    return newFromReturn(parentFunction, parentFunc, parentMod, matchId, matchType, matchNew, matchFunc, matchSelf, matchCrate, matchSuper, matchKind);
  }
  if (parentFunc.kind === "Func") {
    return newFromFunc(parentFunction, parentFunc, parentMod, matchId, matchType, matchNew, matchFunc, matchSelf, matchCrate, matchSuper, matchKind);
  }
  return { ok: false, error: { kind: "NotEnabled", usecase: "New" } };
}

// ── Commit: what a result writes ──

/** One row a commit writes, only where the row is still what `expected` names: when it is not, the commit writes nothing and the call is NotEnabled. A put stores the row (inserts it when `expected` is absent, else updates it); a delete removes it. `id` is null for an entity with no one-column key. */
export type RowWrite =
  | Readonly<{ kind: "put"; entity: "Function"; id: FunctionId; row: Function; expected: ExpectedSource }>
  | Readonly<{ kind: "delete"; entity: "Function"; id: FunctionId; expected: ExpectedSource }>
  | Readonly<{ kind: "put"; entity: "Mod"; id: ModId; row: Mod; expected: ExpectedSource }>
  | Readonly<{ kind: "delete"; entity: "Mod"; id: ModId; expected: ExpectedSource }>
  | Readonly<{ kind: "put"; entity: "Func"; id: FuncId; row: FuncRow; expected: ExpectedSource }>
  | Readonly<{ kind: "delete"; entity: "Func"; id: FuncId; expected: ExpectedSource }>
  | Readonly<{ kind: "put"; entity: "Match"; id: MatchId; row: MatchRow; expected: ExpectedSource }>
  | Readonly<{ kind: "delete"; entity: "Match"; id: MatchId; expected: ExpectedSource }>;

/** A run mark of a use case split into transactions, on one row: `step` is the step of the run that last wrote the row. */
export type RunMark = never;

/** One run mark a commit writes. A put at step 1 inserts the mark, where the row holds no mark of the use case; a put at a later step advances the row's mark from the step before; a delete removes the mark at its step, and the run ends on the row. */
export type MarkWrite = Readonly<{ kind: "put" | "delete"; mark: RunMark }>;

/** An event of any type a use case raises. */
export type RaisedEvent = Switch;

/** What one commit stores, in order: the rows, then the run marks, then the events. */
export type Writes = Readonly<{
  usecase: string;
  rows: readonly RowWrite[];
  marks: readonly MarkWrite[];
  events: readonly RaisedEvent[];
}>;

/** The companion of ReturnResult. */
export const ReturnResult = {
  /** What a commit of it stores: every row, run mark, and event it writes, in order. */
  writes: (r: ReturnResult): Writes => {
    const row0 = Match.toRow(r.match);
    return { usecase: "Return", rows: [{ kind: "put", entity: "Match", id: row0.id, row: row0, expected: r.match_expected }], marks: [], events: [r.switch] };
  },
};

/** The companion of DeleteResult. */
export const DeleteResult = {
  /** What a commit of it stores: every row, run mark, and event it writes, in order. */
  writes: (r: DeleteResult): Writes => {
    const row0 = Match.toRow(r.match);
    return { usecase: "Delete", rows: [{ kind: "put", entity: "Match", id: row0.id, row: row0, expected: r.match_expected }], marks: [], events: [] };
  },
};

/** The companion of SuperResult. */
export const SuperResult = {
  /** What a commit of it stores: every row, run mark, and event it writes, in order. */
  writes: (r: SuperResult): Writes => {
    const row0 = Match.toRow(r.match);
    return { usecase: "Super", rows: [{ kind: "put", entity: "Match", id: row0.id, row: row0, expected: r.match_expected }], marks: [], events: [] };
  },
};

/** The companion of CrateResult. */
export const CrateResult = {
  /** What a commit of it stores: every row, run mark, and event it writes, in order. */
  writes: (r: CrateResult): Writes => {
    const row0 = Match.toRow(r.match);
    return { usecase: "Crate", rows: [{ kind: "put", entity: "Match", id: row0.id, row: row0, expected: r.match_expected }], marks: [], events: [] };
  },
};

/** The companion of DefaultResult. */
export const DefaultResult = {
  /** What a commit of it stores: every row, run mark, and event it writes, in order. */
  writes: (r: DefaultResult): Writes => {
    const row0 = Match.toRow(r.match);
    return { usecase: "Default", rows: [{ kind: "put", entity: "Match", id: row0.id, row: row0, expected: r.match_expected }], marks: [], events: [] };
  },
};

/** The companion of TypeResult. */
export const TypeResult = {
  /** What a commit of it stores: every row, run mark, and event it writes, in order. */
  writes: (r: TypeResult): Writes => {
    const row0 = Func.toRow(r.func);
    return { usecase: "Type", rows: [{ kind: "put", entity: "Func", id: row0.id, row: row0, expected: r.func_expected }], marks: [], events: [] };
  },
};

