// trap: an Enum or Bool column marked `@null` starts null and holds null as a value (#359).
// Make creates an Item without setting k or f, so both start null, as the SQL export's
// nullable columns do; d and e start at their defaults. Paint sets k to red and Clear sets
// it back to null; nothing writes f, d, or e, and nothing writes blue. An engine that gave
// these columns no null would start k at red and f at false: Forbidden_Item_0 (k == null)
// and Forbidden_Item_3 (k not in (red, blue)) would hold, Forbidden_Item_1 (f == false),
// Forbidden_Item_2 (f != null), and Forbidden_Item_4 (f in (true, false)) would fail, and
// so would Unique_Tag_color, where two tags left null agree in no value, as in SQL. The
// logical `@derived(k == red)` is neither true nor false while k is null, so dk == true
// fails after Make, and dk == false never holds because k is never blue. A broken shift of
// the declared values past the null would break the defaults (Required_Item_1/2) or the set
// that names null (Required_Item_0).
// expect Forbidden_Item_0: native=counterexample tlc=counterexample z3=unproved
// expect Forbidden_Item_1: native=ok tlc=ok z3=proved bfs=ok,ok,ok
// expect Forbidden_Item_2: native=ok tlc=ok z3=proved bfs=ok,ok,ok
// expect Forbidden_Item_3: native=counterexample tlc=counterexample z3=unproved
// expect Forbidden_Item_4: native=ok tlc=ok z3=proved bfs=ok,ok,ok
// expect Forbidden_Item_5: native=ok tlc=ok z3=proved bfs=ok,ok,ok
// expect Required_Item_0: native=ok tlc=ok z3=proved bfs=ok,ok,ok
// expect Required_Item_1: native=ok tlc=ok z3=proved bfs=ok,ok,ok
// expect Required_Item_2: native=ok tlc=ok z3=proved bfs=ok,ok,ok
// expect Required_Item_3: native=counterexample tlc=counterexample z3=unproved
// expect Unique_Tag_color: native=ok tlc=ok z3=proved bfs=ok,ok,ok
entity Item "品目" {
  id: Int @pk
  k: Enum(red, blue) @null
  f: Bool @null
  d: Enum(red, blue) @null @default(blue)
  e: Bool @null @default(true)
  dk: Bool @null @derived(k == red)
}

entity Tag "札" {
  id: Int @pk
  color: Enum(red, blue) @null @unique
}

usecase Make "作成"
usecase Paint "塗装"
usecase Clear "消去"
usecase Label "札付け"

creates(Make, Item)
sets(Paint, Item.k == red)
sets(Clear, Item.k == null)
creates(Label, Tag)

forbidden(Item, k == null)
forbidden(Item, f == false)
forbidden(Item, f != null)
forbidden(Item, k not in (red, blue))
forbidden(Item, f in (true, false))
forbidden(Item, dk == false)
required(Item, k in (red, null))
required(Item, d == blue)
required(Item, e == true)
required(Item, dk == true)
