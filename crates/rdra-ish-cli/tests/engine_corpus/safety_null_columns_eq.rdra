// trap: the reverse of #355: `==` on two null columns never holds, and `!=` always does.
// Nothing writes qty or lim, so every Item keeps null in both. By the language reference
// (§ Null) qty == lim never holds and qty != lim always does, so Forbidden_Item_0,
// Required_Item_0 and the property LimNeverMet hold, and z3 proves the two rules: no step
// writes either column and the creation leaves both null. An engine that read null == null
// as true would find all three broken by Make. SetA and SetB each write 2, so after Make,
// SetA, SetB the columns a and b are equal and present: Forbidden_Item_1 and the property
// ABNeverMet fail there, which an engine that made every column `==` false would miss.
// After Make, SetA alone, a is 2 and b is null, which a == b does not meet either.
// expect Forbidden_Item_0: native=ok tlc=ok z3=proved bfs=ok,ok,ok
// expect Required_Item_0: native=ok tlc=ok z3=proved bfs=ok,ok,ok
// expect Forbidden_Item_1: native=counterexample tlc=counterexample z3=unproved
// expect LimNeverMet: native=ok tlc=ok
// expect ABNeverMet: native=counterexample tlc=counterexample
entity Item "品目" {
  id: Int @pk
  qty: Int @null
  lim: Int @null
  a: Int @null
  b: Int @null
}
usecase Make "作成"
usecase SetA "A設定"
usecase SetB "B設定"
creates(Make, Item)
sets(SetA, Item.a == 2)
sets(SetB, Item.b == 2)
forbidden(Item, qty == lim)
required(Item, qty != lim)
forbidden(Item, a == b)
property LimNeverMet always(Item.qty != lim)
property ABNeverMet always(Item.a != b)
