// trap: an Int default outside the bounded range, which every engine reads the same wrong way.
// `@default("7")` is outside Int 0..5. Like a literal outside the range, it is
// IntLiteralOutOfBounds (docs/formal-verification.md, "Approximations and limitations"),
// and the error stops the run before any engine explores. Until #180 the builder dropped
// the default and started the column at 0, so BFS and TLC agreed that a new item breaks
// `stock == 0`, a state the model cannot reach, and z3 could not prove the rule from the
// same Init. The engines agreed with each other, so only the stated verdicts caught it.
// expect IntLiteralOutOfBounds_Item_7: native=counterexample tlc=none
// expect Forbidden_Item_0: native=none tlc=none
entity Item "商品" { id: Int @pk  stock: Int @default("7") }
usecase Stock "商品登録"
usecase Restock "補充"
creates(Stock, Item)
sets(Restock, Item.stock == 3)
forbidden(Item, stock == 0)
