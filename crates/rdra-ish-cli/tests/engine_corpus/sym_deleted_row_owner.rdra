// trap: a deleted row holds its key's base value, slot 0, which names no row and does not
// move with its parent; a split use case that reads that key in a later step reads slot 0.
// Cancel deletes an item in its first step and flags, in its second, the shop the item's key
// names: after the delete that is always the first shop's slot, so only that shop is ever
// flagged and the mall never has two flagged shops. The group would move the shops while the
// deleted item's key stays at slot 0, so the second step would flag whichever shop the
// canonical form puts first: two flagged shops, a counterexample the model does not have,
// whose lifted trace does not replay. The scan finds the read (a key of a row an earlier
// step may have deleted) and leaves Shop out of the group, which a note under the cone line
// says; the items still permute.
// flags: --instances Mall=1
// expect Quantifier_Mall_0: native=ok tlc=ok z3=unproved
// expect DanglingKey_Item_Shop: native=ok tlc=ok z3=proved bfs=ok,ok,ok
entity Mall "館" {
  id: Int @pk
}

entity Shop "店" {
  id: Int @pk
  st: Enum(open, flagged) @default(open)
}

entity Item "品" {
  id: Int @pk
}

relate(Shop, Mall, N:1)
relate(Item, Shop, N:1)

usecase OpenShop "開店"
usecase CloseShop "閉店"
usecase AddItem "追加"
usecase Cancel "取消"

api ItemApi "品 API"
api ShopApi "店 API"

creates(OpenShop, Shop)
deletes(CloseShop, Shop)
creates(AddItem, Item)
invokes(Cancel, ItemApi)
deletes(ItemApi, Item)
invokes(Cancel, ShopApi)
updates(ShopApi, Shop)
transitions(Cancel, Shop.st, open -> flagged)

invariant(Mall).at_most(1, Shop.st == flagged)
