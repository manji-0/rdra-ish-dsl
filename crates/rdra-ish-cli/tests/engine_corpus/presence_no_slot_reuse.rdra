// trap: a deleted slot is never reused, so creating and deleting cannot go on forever.
// Spawn and Drop make tickets and throw them away. With slot reuse they would loop forever
// and meet WF_vars(Next) while the order waits at `paid`. Without it they run out after 2
// tickets, Ship is then the only move left, and WF_vars(Next) forces it: the whole model
// decides ok. The property's cone leaves the tickets out, so its WF_vars(Next) is not the
// whole model's and the cone does not decide.
// expect PaidShips: native=ok tlc=ok
entity Order "注文" { id: Int @pk  status: Enum(pending, paid, shipped) @default(pending) }
entity Ticket "札" { id: Int @pk }
usecase Place "注文"
usecase Pay "支払い"
usecase Ship "出荷"
usecase Spawn "発行"
usecase Drop "破棄"
creates(Place, Order)
transitions(Pay, Order.status, pending -> paid)
transitions(Ship, Order.status, paid -> shipped)
creates(Spawn, Ticket)
deletes(Drop, Ticket)
property PaidShips leads_to(Order.status == paid, Order.status == shipped)
