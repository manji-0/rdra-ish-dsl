// trap: per-entity slot counts give each entity its own slot set, in both directions.
// The run has one slot per entity except Loan and Room, which have three. Loan is a child
// with more slots than its parent Member: two loans agree on `tag`, while Member has one
// row and no pair to compare. Room is a parent with more slots than its child Booking: the
// three rooms start present with one `tag`, and the one pre-existing booking starts owned
// by any of the three, so its owner ranges over Room's slots, not its own. An engine that
// sized every entity by one count would find no Loan pair, or a Member pair, or give the
// booking's owner one value.
// flags: --instance-count 1 --instances Loan=3 --instances Room=3
// expect Unique_Loan_tag: native=counterexample tlc=counterexample
// expect Unique_Member_tag: native=ok tlc=ok
// expect Unique_Room_tag: native=counterexample tlc=counterexample
// expect Unique_Booking_tag: native=ok tlc=ok
entity Member "会員" {
  id: Int @pk
  tag: Enum(a, b) @default(a) @unique
}

entity Loan "貸出" {
  id: Int @pk
  tag: Enum(a, b) @default(a) @unique
}

entity Room "会議室" {
  id: Int @pk
  tag: Enum(a, b) @default(a) @unique
}

entity Booking "予約" {
  id: Int @pk
  tag: Enum(a, b) @default(a) @unique
}

usecase Join "入会"
usecase Borrow "貸出"
usecase Retag "予約変更"

creates(Join, Member)
creates(Borrow, Loan)
updates(Borrow, Member)
updates(Retag, Booking)
updates(Retag, Room)
sets(Retag, Booking.tag == b)

relate(Loan, Member, N:1)
relate(Booking, Room, N:1)
