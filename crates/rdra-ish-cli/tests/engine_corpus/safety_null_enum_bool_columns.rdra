// trap: two Enum or Bool columns marked `@null` that both hold null are not equal (#359).
// The model of #359: Make leaves k1, k2, f1, and f2 null, so by the language reference
// (§ Null) k1 != k2 and f1 != f2 hold there and Forbidden_Item_0 and Forbidden_Item_1 fail,
// while k1 == k2 never holds (Forbidden_Item_2). An engine that gave the columns no null
// would start them at red and false and find the reverse. The logical
// `@derived(k1 == Item.k2)` stays null, so Required_Item_0 holds. a (with null) and b
// (without) number their values apart by the null: after Make, SetA, SetB both are blue and
// Forbidden_Item_3 fails, as Forbidden_Item_4 does after Make, SetG, where g and h are both
// false. An engine that compared the two columns' value numbers would miss both.
// expect Forbidden_Item_0: native=counterexample tlc=counterexample z3=refuted
// expect Forbidden_Item_1: native=counterexample tlc=counterexample z3=refuted
// expect Forbidden_Item_2: native=ok tlc=ok z3=proved bfs=ok,ok,ok
// expect Forbidden_Item_3: native=counterexample tlc=counterexample z3=refuted
// expect Forbidden_Item_4: native=counterexample tlc=counterexample z3=refuted
// expect Required_Item_0: native=ok tlc=ok z3=proved bfs=ok,ok,ok
entity Item "品目" {
  id: Int @pk
  k1: Enum(red, blue) @null
  k2: Enum(red, blue) @null
  f1: Bool @null
  f2: Bool @null
  a: Enum(red, blue) @null
  b: Enum(red, blue)
  g: Bool @null
  h: Bool
  dkk: Bool @null @derived(k1 == Item.k2)
}

usecase Make "作成"
usecase SetA "A設定"
usecase SetB "B設定"
usecase SetG "G設定"

creates(Make, Item)
sets(SetA, Item.a == blue)
sets(SetB, Item.b == blue)
sets(SetG, Item.g == false)

forbidden(Item, k1 != Item.k2)
forbidden(Item, f1 != Item.f2)
forbidden(Item, k1 == Item.k2)
forbidden(Item, a == Item.b)
forbidden(Item, g == Item.h)
required(Item, dkk == null)
