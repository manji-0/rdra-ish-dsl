export type Money = string & { readonly __brand: "Money" };

export type Decimal = string & { readonly __brand: "Decimal" };

export type Date = string & { readonly __brand: "Date" };

export type DateTime = string & { readonly __brand: "DateTime" };

export type CustomerId = string & { readonly __brand: "CustomerId" };

export type OrderId = number & { readonly __brand: "OrderId" };

export type ShipmentId = number & { readonly __brand: "ShipmentId" };

export type PaymentMethod =
  "credit_card"
  | "bank_transfer"
;

export const PaymentMethodValues: readonly PaymentMethod[] = ["credit_card", "bank_transfer"];

export type OrderStatus =
  "pending"
  | "paid"
  | "shipped"
  | "on_hold"
  | "onHold"
  | "_2day"
;

export const OrderStatusValues: readonly OrderStatus[] = ["pending", "paid", "shipped", "on_hold", "onHold", "_2day"];

export type OrderChannel =
  "web"
  | "shop"
;

export const OrderChannelValues: readonly OrderChannel[] = ["web", "shop"];

export type ShipmentPhase =
  "packing"
  | "sealed"
;

export const ShipmentPhaseValues: readonly ShipmentPhase[] = ["packing", "sealed"];

export type ShipmentDeliveryStatus =
  "waiting"
  | "delivered"
;

export const ShipmentDeliveryStatusValues: readonly ShipmentDeliveryStatus[] = ["waiting", "delivered"];

