// `check --guards` on guards whose removal grows the rule's cone past the state cap. BFirst
// keeps a at x0, and ReadyForC keeps c at z0, until b reaches y1, so the rule's cone holds 6
// states. Without either guard the cone holds 7 and the rule still holds: it fails only
// with both gone. Under `--max-states 6` the rule is not decided without either guard,
// which is neither protected nor unprotected; under `--max-states 7` no rule depends on
// either alone.
entity Item "品目" {
  id: Int @pk
  a: Enum(x0, x1) @default(x0)
  b: Enum(y0, y1) @default(y0)
  c: Enum(z0, z1) @default(z0)
}

usecase Make "作成"
usecase FlipA "A変更"
usecase FlipB "B変更"
usecase FlipC "C変更"

buc BucItem "Item"
contains(BucItem, Make)
contains(BucItem, FlipA)
contains(BucItem, FlipB)
contains(BucItem, FlipC)

creates(Make, Item)
transitions(FlipA, Item.a, x0 -> x1)
transitions(FlipB, Item.b, y0 -> y1)
transitions(FlipC, Item.c, z0 -> z1)

condition BFirst "Bが先"
holds(BFirst, Item.b == y1)
applies_to(BFirst, FlipA)

condition ReadyForC "C準備"
holds(ReadyForC, Item.b == y1)
applies_to(ReadyForC, FlipC)

forbidden(Item, a == x1, b == y0, c == z1).label("c moves only after b")
