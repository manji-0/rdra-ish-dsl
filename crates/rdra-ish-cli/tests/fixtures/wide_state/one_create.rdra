  c16: Int @default(0)
  c17: Int @default(0)
  c18: Int @default(0)
  c19: Int @default(0)
  c20: Int @default(0)
  c21: Int @default(0)
  c22: Int @default(0)
  c23: Int @default(0)
  c24: Int @default(0)
  c25: Int @default(0)
  c26: Int @default(0)
  c27: Int @default(0)
  c28: Int @default(0)
  c29: Int @default(0)
  c30: Int @default(0)
  c31: Int @default(0)
  c32: Int @default(0)
  c33: Int @default(0)
}
usecase Create "作成"
buc B "B"
contains(B, Create)
creates(Create, Row)
sets(Create, Row.c0 == 1)
sets(Create, Row.c1 == 1)
sets(Create, Row.c2 == 1)
