// Claim N2: every row is created with c0 .. c33 = 1, so no reachable state has c33 = 0: ok at
// every bound, 255 instances included, where the state passes bit 65,535.
entity Row "行" {
  id: Int @pk
  c0: Int @default(0)
  c1: Int @default(0)
  c2: Int @default(0)
  c3: Int @default(0)
  c4: Int @default(0)
  c5: Int @default(0)
  c6: Int @default(0)
