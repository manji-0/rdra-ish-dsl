// Claim N2: 34 Int columns; at --instance-count 255 --int-range-max 255 a state packs into
// 255 x (34 x 8 + 2) = 69,870 bits, past bit 65,535. CreateB makes a row with c32 = 2, which
// the rule forbids: a counterexample at every bound.
entity Row "行" {
  id: Int @pk
  c0: Int @default(0)
  c1: Int @default(0)
  c2: Int @default(0)
  c3: Int @default(0)
  c4: Int @default(0)
  c5: Int @default(0)
  c6: Int @default(0)
  c7: Int @default(0)
  c8: Int @default(0)
  c9: Int @default(0)
  c10: Int @default(0)
  c11: Int @default(0)
  c12: Int @default(0)
  c13: Int @default(0)
  c14: Int @default(0)
  c15: Int @default(0)
  c16: Int @default(0)
  c17: Int @default(0)
  c18: Int @default(0)
  c19: Int @default(0)
  c20: Int @default(0)
  c21: Int @default(0)
  c22: Int @default(0)
  c23: Int @default(0)
  c24: Int @default(0)
  c25: Int @default(0)
  c26: Int @default(0)
  c27: Int @default(0)
  c28: Int @default(0)
  c29: Int @default(0)
  c30: Int @default(0)
  c31: Int @default(0)
  c32: Int @default(0)
  c33: Int @default(0)
}
usecase CreateA "作成A"
usecase CreateB "作成B"
buc B "B"
contains(B, CreateA)
contains(B, CreateB)
creates(CreateA, Row)
creates(CreateB, Row)
sets(CreateA, Row.c0 == 1)
sets(CreateB, Row.c0 == 1)
