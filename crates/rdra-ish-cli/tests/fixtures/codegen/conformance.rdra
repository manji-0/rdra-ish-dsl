// Fixture of tests/codegen_conformance.rs: a reference service built on the generated core
// passes the conformance harness, and services with planted faults fail it. Ship writes two
// rows and raises an event Send runs on; Pay and Cancel narrow and reject.
variation Method "M" { card cash }
entity Customer "C" { id: Int @pk }
entity Order "O" {
  id: Int @pk
  status: Enum(pending, paid, shipped, cancelled) @default(pending)
  paid_at: DateTime @null
  method: Method
  qty: Int @default("1")
  note: String
}
entity Shipment "S" {
  id: Int @pk
  status: Enum(packed, sent) @default(packed)
}
relate(Order, Customer, N:1)
relate(Shipment, Order, 1:1)
usecase Place "P"
usecase Pay "Pay"
usecase Ship "Ship"
usecase Send "Send"
usecase Cancel "C"
event EvShipped "shipped"
creates(Place, Order)
transitions(Pay, Order.status, pending -> paid)
sets(Pay, Order.paid_at == present)
sets(Pay, Order.qty == 2)
transitions(Ship, Order.status, paid -> shipped)
creates(Ship, Shipment)
raises(Ship, EvShipped)
triggers(EvShipped, Send)
transitions(Send, Shipment.status, packed -> sent)
transitions(Cancel, Order.status, (pending, paid) -> cancelled)
condition Big "big"
holds(Big, Order.qty >= 2)
applies_to(Big, Cancel)
forbidden(Order, qty > 4)
invariant(Order).when(status == paid).then(paid_at == present)
forbidden(Order, status == pending, paid_at == present)
