// relate(OrderLine, Order, 1..*:1) adds the invariant MinCard_OrderLine_Order: every Order
// has at least one OrderLine. TLC intent: expected FAIL at InstanceCount == 1. Place creates
// an Order without a line (info MinCardNeedsCreate), so the state after Place breaks it;
// min_card_met.rdra creates both in one transaction and passes.
// expect check: fail MinCard_OrderLine_Order
// expect verify: tlc=counterexample fail MinCard_OrderLine_Order
entity Order "注文" {
  id: Int @pk
}
entity OrderLine "注文明細" {
  id: Int @pk
}

usecase Place "注文確定"
usecase AddLine "明細追加"

buc BucOrdering "Ordering"
contains(BucOrdering, Place)
contains(BucOrdering, AddLine)

creates(Place, Order)
creates(AddLine, OrderLine)

relate(OrderLine, Order, 1..*:1)
