// .along with relate → quantified Safety over Order_Ids × Payment_Ids linked by Payment_owner.
// TLC intent: expected PASS. Pay is one atomic action that needs the linked Order pending, so
// Cancel and Pay cannot both act on one link (docs/vision.md, rule 6).
entity Order "注文" {
  id: Int @pk
  status: Enum(pending, paid, cancelled) @default(pending)
}
entity Payment "決済" {
  id: Int @pk
  status: Enum(pending, captured) @default(pending)
}

usecase Place "注文確定"
usecase Pay "決済確定"
usecase Cancel "キャンセル"

buc BucOrderPayment "Order and payment"
contains(BucOrderPayment, Place)
contains(BucOrderPayment, Pay)
contains(BucOrderPayment, Cancel)

creates(Place, Order)
creates(Place, Payment)
updates(Pay, Order)
updates(Pay, Payment)
updates(Cancel, Order)

transitions(Order.status, Pay, pending -> paid)
transitions(Order.status, Cancel, pending -> cancelled)
transitions(Payment.status, Pay, pending -> captured)

relate(Payment, Order, N:1)

// Cancelled order must not coexist with a captured payment on the same link.
forbidden(Order, Payment,
  Order.status == cancelled,
  Payment.status == captured)
  .along(Order, Payment)
