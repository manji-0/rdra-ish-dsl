// The model of none_any_child with a second creator. Reissue creates an Invoice under a closed
// Order without the `.none(...)` guard, so a closed Order that already has an Invoice gets a
// second one: Unique_Invoice_Order fails at InstanceCount == 2 on a path through the Order's
// status (Place, Issue, Close, Reissue). The cone that decides it holds the link and
// Order.status, not Invoice.status. At one instance the invariant holds vacuously, so
// `check` passes.
// expect check: ok
// expect verify: tlc=counterexample fail Unique_Invoice_Order
entity Order "注文" {
  id: Int @pk
  status: Enum(open, closed) @default(open)
}

entity Invoice "請求書" {
  id: Int @pk
  status: Enum(draft, issued, paid) @default(draft)
}

usecase Place "注文確定"
usecase Issue "請求書発行"
usecase Reissue "請求書再発行"
usecase Send "請求書送付"
usecase Pay "支払"
usecase Close "注文終了"

buc BucBilling "Billing"
contains(BucBilling, Place)
contains(BucBilling, Issue)
contains(BucBilling, Reissue)
contains(BucBilling, Send)
contains(BucBilling, Pay)
contains(BucBilling, Close)

creates(Place, Order)
creates(Issue, Invoice)
creates(Reissue, Invoice)
updates(Send, Invoice)
updates(Pay, Invoice)
updates(Close, Order)

transitions(Send, Invoice.status, draft -> issued)
transitions(Pay, Invoice.status, issued -> paid)
transitions(Close, Order.status, open -> closed)

relate(Invoice, Order, 1:1)

condition NoInvoiceYet "請求書のない注文"
holds(NoInvoiceYet, Order.status == open).none(Invoice.status in (draft, issued, paid))
applies_to(NoInvoiceYet, Issue)

// Reissue checks the order, not whether it already has an invoice.
condition OrderClosed "終了した注文"
holds(OrderClosed, Order.status == closed)
applies_to(OrderClosed, Reissue)
