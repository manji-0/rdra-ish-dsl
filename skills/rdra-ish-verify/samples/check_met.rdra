// The model of check_unmet.rdra with a use case that keeps qty in range: Check_CartLine_qty_0
// holds. TLC intent: expected PASS. `bulk` is derived from qty and is no state var; the
// forbidden reads it as its expression, qty >= 3, which no use case reaches.
entity CartLine "カート明細" {
  id: Int @pk
  qty: Int @default(1) @check(qty >= 1)
  bulk: Bool @derived(qty >= 3)
}

usecase AddLine "明細追加"
usecase DoubleQty "数量変更"

buc BucCart "Cart"
contains(BucCart, AddLine)
contains(BucCart, DoubleQty)

creates(AddLine, CartLine)
sets(DoubleQty, CartLine, qty == 2)

forbidden(CartLine, bulk == true)
