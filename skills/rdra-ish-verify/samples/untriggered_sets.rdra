// `sets` from a use case that drives no transition (Flag), next to a
// lifecycle with transitions. Place creates the Order at `placed`, so
// Flag then Ship reaches the forbidden state
// (expected TLC fail / counterexample; `check`/`states` also report it).
// expect check: fail Forbidden_Order_0
// expect verify: tlc=counterexample fail Forbidden_Order_0
entity Order "注文" {
  id: Int @pk
  status: Enum(draft, placed, shipped) @default(draft)
  flagged: Bool @default(false)
}

usecase Place "注文"
usecase Ship "発送"
usecase Flag "要確認"

buc BucOrderFlagging "Order flagging"
contains(BucOrderFlagging, Place)
contains(BucOrderFlagging, Ship)
contains(BucOrderFlagging, Flag)

creates(Place, Order)
sets(Place, Order, status == placed)
updates(Ship, Order)
updates(Flag, Order)
sets(Flag, Order, flagged == true)

transitions(Order.status, Ship, placed -> shipped)

forbidden(Order, status == shipped, flagged == true)
