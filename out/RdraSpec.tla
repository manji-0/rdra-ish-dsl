---- MODULE RdraSpec ----
\* Generated by rdra-ish. Do not edit manually.
\* Bounds: InstanceCount=2 IntRange=0..5; a verify OK says nothing outside them.

EXTENDS Integers

InstanceCount == 2
IntRange == 0..5
Card_Ids == 1..InstanceCount
Loan_Ids == 1..InstanceCount
Member_Ids == 1..InstanceCount

\* The lowest absent slot: a create takes it, and a deleted slot is never reused.
FirstAbsent(ex, i) == ex[i] = "absent" /\ \A j \in DOMAIN ex : j < i => ex[j] # "absent"

VARIABLES Card_exists, Card_status, Loan_exists, Loan_status, Member_exists, Member_status, Card_owner_Member, Loan_owner_Card

vars == <<Card_exists, Card_status, Loan_exists, Loan_status, Member_exists, Member_status, Card_owner_Member, Loan_owner_Card>>

TypeOK ==
  /\ Card_exists \in [Card_Ids -> {"absent", "present", "deleted"}]
  /\ Card_status \in [Card_Ids -> {"valid", "lost"}]
  /\ Loan_exists \in [Loan_Ids -> {"absent", "present", "deleted"}]
  /\ Loan_status \in [Loan_Ids -> {"open", "returned"}]
  /\ Member_exists \in [Member_Ids -> {"absent", "present", "deleted"}]
  /\ Member_status \in [Member_Ids -> {"active", "withdrawn"}]
  /\ Card_owner_Member \in [Card_Ids -> Member_Ids]
  /\ Loan_owner_Card \in [Loan_Ids -> Card_Ids]

Init ==
  /\ Card_exists = [i \in Card_Ids |-> "absent"]
  /\ Card_status = [i \in Card_Ids |-> "valid"]
  /\ Loan_exists = [i \in Loan_Ids |-> "absent"]
  /\ Loan_status = [i \in Loan_Ids |-> "open"]
  /\ Member_exists = [i \in Member_Ids |-> "absent"]
  /\ Member_status = [i \in Member_Ids |-> "active"]
  /\ Card_owner_Member = [i \in Card_Ids |-> 1]
  /\ Loan_owner_Card = [i \in Loan_Ids |-> 1]

Return(p0) ==
  /\ Loan_exists[p0] = "present"
  /\ Loan_status[p0] = "open"
  /\ Loan_status' = [Loan_status EXCEPT ![p0] = CASE Loan_status[p0] = "open" -> "returned" [] OTHER -> Loan_status[p0]]
  /\ UNCHANGED <<Card_exists, Card_status, Loan_exists, Member_exists, Member_status, Card_owner_Member, Loan_owner_Card>>

Withdraw(p0) ==
  /\ Member_exists[p0] = "present"
  /\ Member_status[p0] = "active"
  /\ \E b0 \in Card_Ids : (Card_exists[b0] = "present") /\ (\E b1 \in Loan_Ids : (Loan_exists[b1] = "present") /\ ((Card_owner_Member[b0] = p0) /\ (Loan_owner_Card[b1] = b0) /\ (Member_status[p0] = "active") /\ (\A b2 \in Loan_Ids : (Loan_exists[b2] = "present") => ((~(Loan_owner_Card[b2] = b0)) \/ (~(Loan_status[b2] = "open"))))))
  /\ Member_status' = [Member_status EXCEPT ![p0] = CASE Member_status[p0] = "active" -> "withdrawn" [] OTHER -> Member_status[p0]]
  /\ UNCHANGED <<Card_exists, Card_status, Loan_exists, Loan_status, Member_exists, Card_owner_Member, Loan_owner_Card>>

IssueCard(p0, p1) ==
  /\ FirstAbsent(Card_exists, p0)
  /\ Member_exists[p1] = "present"
  /\ Card_exists' = [Card_exists EXCEPT ![p0] = "present"]
  /\ Card_owner_Member' = [Card_owner_Member EXCEPT ![p0] = p1]
  /\ UNCHANGED <<Card_status, Loan_exists, Loan_status, Member_exists, Member_status, Loan_owner_Card>>

Lend(p0, p1) ==
  /\ FirstAbsent(Loan_exists, p0)
  /\ Card_exists[p1] = "present"
  /\ Loan_exists' = [Loan_exists EXCEPT ![p0] = "present"]
  /\ Loan_owner_Card' = [Loan_owner_Card EXCEPT ![p0] = p1]
  /\ UNCHANGED <<Card_exists, Card_status, Loan_status, Member_exists, Member_status, Card_owner_Member>>

Register(p0) ==
  /\ FirstAbsent(Member_exists, p0)
  /\ Member_exists' = [Member_exists EXCEPT ![p0] = "present"]
  /\ UNCHANGED <<Card_exists, Card_status, Loan_exists, Loan_status, Member_status, Card_owner_Member, Loan_owner_Card>>

Next ==
  \/ \E p0 \in Loan_Ids : Return(p0)
  \/ \E p0 \in Member_Ids : Withdraw(p0)
  \/ \E p0 \in Card_Ids, p1 \in Member_Ids : IssueCard(p0, p1)
  \/ \E p0 \in Loan_Ids, p1 \in Card_Ids : Lend(p0, p1)
  \/ \E p0 \in Member_Ids : Register(p0)

Spec == Init /\ [][Next]_vars

